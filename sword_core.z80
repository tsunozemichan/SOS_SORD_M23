;=======================
;スクリーン制御補助
;=======================


;論理桁位置を得ます
;入力	x座標、桁数参照
;出力	HL←論理桁位置
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;E	桁数
;C	現在y座標
;BC	ライン･ターミナル･テーブルの先頭＋y座標
;HL	論理桁位置カウンタ
get_logical_column:
	CALL GET_X_Y_FROM_VRAM_ADDRESS ; VRAMアドレスからX,Y座標を求める。
	LD L,C
	LD H,0
	RET

;論理行頭の座標を得ます
;入力	なし
;出力	L←0、H←論理行頭のy座標
;破壊	AF，HL
get_Y_top_of_logical_line:
	CALL GET_X_Y_FROM_VRAM_ADDRESS ; VRAMアドレスからX,Y座標を求める。
	LD H,B
	LD L,0
	RET


;次の論理行の座標を得ます
;入力	なし
;出力	L←0、H←論理行頭のy座標
;破壊	AF，HL
get_Y_next_logical_line:
	CALL GET_X_Y_FROM_VRAM_ADDRESS ; VRAMアドレスからX,Y座標を求める。
	INC B
	LD H,B
	LD L,0
	RET


;カーソル座標からオフセット･アドレスを求めます
;入力	L←x座標、H←y座標
;出力	HL←オフセット
;破壊	AF，HL
;注：cursor_offset_for_Y_tableは、y座標→カーソル･オフセット対応表。
get_offset_from_cursor_XY:
	RET


;オフセット･アドレスからカーソル座標を求めます
;入力	HL←カーソル･オフセット
;出力	L←x座標,H←y座標
;破壊	AF，HL
get_cursor_XY_from_offset_address:
	RET


;カーソルのオフセット計算用テーブルを生成します
;入力	[_WIDTH]参照
;出力	[cursor_offset_for_Y_table～]←オフセット
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;DE	テーブル･アドレス
;BC	定数[_WIDTH]
;HL	カーソル･オフセット
;Acc	ループ･カウンタ
generate_cursor_offset_table:
	RET


;カーソル制御用ワークの初期化
;入力	[_WIDTH]、[_WIDTH]、[_MXLIN]、[vram_address_of_top]参照
;出力	[CSRADD]、[CSRNXI]、[CSRNYI]、[cursor_offset_last_top_of_line]、[total_number_of_character_display]、[vram_address_of_top_of_last_line]、
;	ライン･ターミナル･テーブル初期化
;破壊	AF，HL，DE，BC
initialize_cursor_control_work_area:
	RET


;-------------------------------
;S-OSルーチン（機種依存）
;-------------------------------


;===============
;I／O入出力
;===============


;#INP（202AH）の本体
; I／Oポートにデータを出力。
;入力	なし
;出力	Acc←データ
;破壊	AF
INP:
	PUSH BC
	LD	B,0
	IN	A,(C)
	POP	BC
	RET


;#OUT（202DH）の本体
; I／Oポートからデータを入力。
;入力	Acc←データ
;出力	なし
;破壊	なし
OUTP:
	PUSH BC
	LD	B,0
	OUT	(C),A
	POP	BC
	RET


;=======================
;特殊ワーク（機種依存）
;=======================


;#POKE（1F9AH）の本体
; 特殊ワーク･エリアに1バイト書き込みます。
;入力	HL←アドレス、Acc←データ
;出力	なし
;破壊	なし
;〈旧SWORDとの速度比較〉
;POKE	 97ts→ 83ts	1.169倍
;#POKE	107ts→ 93ts	1.151倍
;＋CALL	124ts→110ts	1.127倍
POKE:
	PUSH	BC	;11ts
	PUSH	AF	;11ts
	LD	C,L	; 4ts
	LD	A,40H	; 7ts '特殊ワーク先頭（4000H）
	ADD	A,H	; 4ts 'CY←0
	LD	B,A	; 4ts 'BC←実アドレス
	POP	AF	;10ts
	OUT	(C),A	;12ts '特殊ワークへの書き込み
	POP	BC	;10ts
	RET		;10ts


;#PEEK（1F94H）の本体
; 特殊ワーク･エリアから1バイト読み込みます。
;入力	HL←アドレス
;出力	Acc←データ
;破壊	AF
;〈旧SWORDとの速度比較〉
;POKE	109ts→ 62ts	1.758倍
;#POKE	119ts→ 72ts	1.653倍
;＋CALL	136ts→ 89ts	1.528倍
;注：CYをクリアします。
PEEK:
	PUSH	BC	;11ts
	LD	C,L	; 4ts
	LD	A,40H	; 7ts '特殊ワーク先頭（4000H）
	ADD	A,H	; 4ts 'CY←0
	LD	B,A	; 4ts 'BC←実アドレス
	IN	A,(C)	;12ts '特殊ワークからの読み込み
	POP	BC	;10ts
	RET		;10ts


;#poke_entity（1F97H）の本体
; 特殊ワーク･エリアにブロック書き込みします。
;入力	HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
;	BC←転送バイト数
;出力	なし
;破壊	AF，HL，DE，BC
;〈旧SWORDとの速度比較〉
;ループ	 57ts→ 40ts	1.425倍
;注：「WINER」などでCYクリアが必要。
poke_entity:
	LD	A,40H	;特殊ワーク先頭（4000H）
	ADD	A,D	;CY←0
	LD	D,A
	PUSH	DE

;	高速ループ･カウンタの設定（BC→AD版）
	XOR	A
	CP	C	;下位カウンタ＝0ならCY＝0
	ADC	A,B	;Acc←新上位ループ･カウンタ
	LD	D,C	;D←下位ループ･カウンタ

	POP	BC	;BC←実アドレス

POKE_LP:	INC	B	; 4ts '先行デクリメントのため
	OUTI		;16ts '特殊ワークへの書き込み
	INC	BC	; 6ts
	DEC	D	; 4ts
	JP	NZ,POKE_LP	;10ts
	DEC	A
	JR	NZ,POKE_LP

;	OR	A	;CY←0
	RET


;#peek_entity（1F91H）の本体
; 特殊ワーク･エリアからブロック読み込みします。
;入力	HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
;	BC←転送バイト数
;出力	なし
;破壊	AF，HL，DE，BC
;〈旧SWORDとの速度比較〉
;ループ	 57ts→ 40ts	1.425倍
;注：「WINER」などでCYクリアが必要。
peek_entity:
	LD	A,40H	;特殊ワーク先頭（4000H）
	ADD	A,D	;CY←0
	LD	D,A
	PUSH	DE

;	高速ループ･カウンタの設定（BC→AD版）
	XOR	A
	CP	C	;下位カウンタ＝0ならCY＝0
	ADC	A,B	;Acc←新上位ループ･カウンタ
	LD	D,C	;D←下位ループ･カウンタ

	POP	BC	;BC←実アドレス

PEEK_LP:	INC	B	; 4ts '先行デクリメントのため
	INI		;16ts '特殊ワークからの読み込み
	INC	BC	; 6ts
	DEC	D	; 4ts
	JP	NZ,peek_lp	;10ts
	DEC	A
	JR	NZ,peek_lp

;	OR	A	;CY←0
	RET


;---------------------------------------
;フィジカル･ルーチン（機種依存）
;---------------------------------------


;===============================
;システム･ルーチン（機種依存）
;===============================

;ブートします
;入力	なし
;出力	なし
;破壊	AF，HL，DE，BC
boot_entity:
	CALL	SOSSF		;仮想ディスク全クローズ

	LD	HL,00D3H	;「OUT (0),A」
	LD	(0FFFEH),HL
	LD	A,1DH
	JP	0FFFEH


;===============================================
;フィジカル･ルーチン･プリンタ関係（機種依存）
;===============================================


;プリンタへ1文字出力します
;入力	Acc←文字
;出力	エラーが起こればCY＝1
;破壊	AF
lprint_entity:
	PUSH	HL
	PUSH	BC
	LD	L,A	;L←文字（保存用）
	LD	H,A	;H←文字
	LD	BC,1A01H

;	プリンタREADYを待ちます
lplp_entity:	IN	A,(C)
	RRCA
	JR	NC,lpbrk_entity	;^C
	IN	A,(C)
	AND	00001000B
	JR	NZ,lplp_entity

	OR	A	;CY←0

;	文字を出力
;注：CYは保存します。
lp1_entity:	DEC	C	;BC←1A00H
	OUT	(C),H
;	受け取り指示
	LD	C,3	;BC←1A03H
	LD	A,00001110B	;b7リセット
	OUT	(C),A
	INC	A	;b7セット
	OUT	(C),A

;	終了
	LD	A,L	;Acc←文字
	POP	BC
	POP	HL
	RET

;	^C処理
lpbrk_entity:	LD	H,0DH	;RET
	SCF
	JR	lp1_entity


;=======================
;音声（機種依存）
;=======================


;ビープ音を鳴らします
;入力	なし
;出力	なし
;破壊	AF，HL，DE，BC
bell_entity:
	DI
	EI
	RET

;===============================
;スクリーン関係（機種依存）
;===============================


;カーソル座標を読み出します
;入力	なし
;出力	L←x座標、H←y座標
;破壊	AF，HL，DE，BC
get_cursor_XY_entity:
	LD	DE,(CSRADD) ; CSRADDの値をDEへ
	LD	HL,(CSRNX) ; CSRNXの値をHLへ
	ADD	HL,DE
	RET

;カーソルを指定座標へ移動します
;入力	L←x座標、H←y座標
;出力	なし
;破壊	AF，HL，DE，BC
move_cursor_XY_entity:
	LD	DE,(CSRNXI)	;256-桁数 '[CSRNX]の初期値
	ADD	HL,DE
	LD	(CSRNX),HL ;ｘ座標-[_WIDTH]
	JP	SETPRN

;指定座標の文字を読み込みます
;入力	L←x座標、H←y座標
;出力	Acc←文字
;破壊	AF，HL，DE，BC
get_character_XY_entity:
	CALL get_offset_from_cursor_XY
	JP read_character_offset_address

;画面のクリア
;入力	[screen_width]、[total_number_of_character_display]、[attribute_data]参照
;出力	なし
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;E	クリア･データ（定数）
;BC	現在アトリビュートVRAMアドレス
;AD	高速ループ･カウンタ
; 画面左上のアドレスはf800hです。
; そこから、ffd0hまでをスペースキャラクタ(アスキーコード20h)で埋めて、画面をクリアするコードを書いて下さい。

CLS:
	PUSH HL
	PUSH BC
	LD A,NP ; 画面全体をスペースでクリアします。
	CALL CONOUT_PROCESS
	POP BC
	POP HL
	RET


;===============================
;1文字表示ルーチン（機種依存）
;===============================


;コントロール･コード制御（PRINTルーチンの一部）
;入力	Acc←コントロール･コード（00H～1FH）
PRNCTL:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
	LD	HL,control_code_jump_tabel
	ADD	A,A	;Acc←コントロール･コード×2
	ADD	A,L
	LD	L,A	;HL←control_code_jump_tabel＋コントロール･コード×2
	LD	A,(HL)
	INC	L
	LD	H,(HL)
	LD	L,A	;HL←[control_code_jump_tabel＋コントロール･コード×2]

	LD	DE,PRCRET
	PUSH	DE	;リータン･アドレスの設定
	JP	(HL)	;「CALL コントロール制御」相当
PRCRET:	CALL	SETPRN
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	OR	A	;CY←0
	RET

;1文字プリント前処理
PREPR:	PUSH	HL
	POP	HL

;#PRINT（1FF4H）本体
; 1文字プリント･ルーチン。
;入力	Acc←文字
;出力	なし
;破壊	F
;注：
; [#LPSW]がオンならプリンタにも出力します。
; インサート･モードと論理改行は、1行入力ルーチンで制御します。
; CYフラグをクリアします。
;〈実行時間〉
;PRINT	149ts（37.250μs）
;#PRINT	159ts（39.750μs）
;＋CALL	176ts（44.000μs）
PRINT:
	PUSH AF
	PUSH HL
	PUSH DE
	PUSH BC
	CALL CONOUT_PROCESS
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

;===============================
;キー入力関係（機種依存）
;===============================


;1文字入力ルーチン（入力待ちあり、エコー･バックなし、カーソル表示なし）
;入力	なし
;出力	Acc←アスキー･コード
;破壊	AF，HL，DE，BC
;注：DEL（7FH）コードは、^D（04H）に変換します。
INKEY_entity:

;	キー入力バッファに文字が溜るまで待ちます
INKLP_entity:
	EI
	OR	A
	RET	NZ
	EI		;念のため
	LD	A,(pointer_for_write_key_buffer)
	OR	A
	JR	Z,INKLP_entity

;	文字入力バッファから1文字取り出します
	LD	HL,pointer_for_write_key_buffer
	DI
	LD	A,(HL)
	OR	A	;念のためもう1度チェック
	JR	Z,INKLP_entity
	DEC	(HL)	;[pointer_for_write_key_buffer]をデクリメントします
	LD	C,(HL)
	LD	B,0	;BC←バッファに溜った文字数－1（0～254）
	LD	E,B
	LD	D,H	;DE←input_key_buffer
	LD	L,1	;HL←input_key_buffer+1
	LD	A,(DE)	;Acc←入力文字
	JR	Z,INKRT
	LDIR
INKRT:
	EI
	RET


;リアル･タイム･キー入力（入力待ちなし、エコー･バックなし、カーソル表示なし）
;入力	なし
;出力	Acc←アスキー･コード
;破壊	AF，HL，DE，BC
;注：ジョイスティック対応。
real_time_input_key_entity:
	OR	A
	RET	NZ

	DI
	CALL	clear_key_buffer
	EI
	LD	A,(real_time_key)
	RET


;キー入力バッファをクリアします
;入力	なし
;出力	なし
;破壊	AF，HL，DE，BC
;注：割り込み禁止して実行してください。
clear_key_buffer:
	XOR	A
	LD	(pointer_for_write_key_buffer),A	;キー入力バッファをクリアします
	RET



;===============================
;スクリーン制御補助（機種依存）
;===============================


;指定オフセット･アドレスに文字を書き込みます
;入力	HL←オフセット･アドレス、Acc←文字
;出力	なし
;破壊	AF，HL，DE，BC
write_character_offset_address:
	RET


;指定カーソル･オフセットの文字を読み込みます
;入力	HL←カーソル･オフセット
;出力	Acc←文字
;破壊	AF，HL，DE，BC
read_character_offset_address:
	RET


;カーソルを表示します
;入力	[insert_mode_flag]参照
;出力	[locate_of_cursor_overlap_character]←カーソル位置の文字
;破壊	AF，HL，DE，BC
display_cursor:
	CALL PRINT_CURSOR
	RET


;カーソルを消去します
;入力	[locate_of_cursor_overlap_character]、[insert_mode_flag]参照
;出力	なし
;破壊	AF，HL，DE，BC
erase_cursor:
	RET


;表示色を変更します
;入力	[foreground_color]、[background_color]、[BDR_color]参照
;出力	[attribute_data]←アトリビュート･データ
;破壊	AF，HL，DE，BC
change_color:
	RET


;===============================
;特殊ルーチン（機種依存）
;===============================

;60分の1秒単位で時間待ちします
;入力	Acc←カウンタ
;出力	なし
;破壊	AF
;注：割り込み禁止して実行してください。
WAIT60:
	PUSH BC
	LD	B,A
W60LP:
	CALL	VBLANK
	DJNZ	W60LP

	POP	BC
	RET


;垂直帰線信号の立ち下がりを待ちます
;入力	なし
;出力	なし
;破壊	AF
;注：割り込み禁止して実行してください。
VBLANK:
; 垂直帰線信号が無効になる場合があるので、CPU実行速度依存に書き直します。
; 1／60秒、66,667ステートの15／16、62,500ステート待ちます。
	PUSH	BC	;11ts
	LD	BC,2402	;10ts

;	1ループ26ts
VBLLP:
	DEC	BC	; 6ts
	LD	A,C	; 4ts
	OR	B	; 4ts
	JR	NZ,VBLLP	;12ts

	POP	BC	;10ts
	RET		;10ts



;===============================
;スクリーン制御補助（機種固有）
;===============================


;カーソルのテキストVRAMアドレスを求めます
;入力	L←x座標、H←y座標
;出力	BC←テキストVRAMアドレス
;破壊	AF，HL，BC
get_vram_address_from_cursor_XY:
	CALL GET_X_Y_FROM_VRAM_ADDRESS ; VRAMアドレスからX,Y座標を求める。
	LD B,H
	LD C,L
	RET


;---------------
;汎用ルーチン
;---------------


;文字列から文字を取り出します（スペースはスキップ）
;入力	DE←文字列の先頭アドレス
;出力	Acc←文字
;	DEはカウント･アップ
;破壊	AF，DE
;注：小文字を大文字に変換します。
get_character_from_string:
	CALL space_char_skip
	LD A,(DE)
	OR A
	RET	Z	;文字列の終わりの達した
	INC	DE
	JP convert_lower_case_to_upper_case


;文字列のスペース･キャラをスキップします
;入力	DE←文字列の先頭アドレス
;出力	DE←カウント･アップ
;破壊	AF，DE
space_char_skip_loop:
	INC	DE
space_char_skip:
	LD A,(DE)
	CP ' '
	JR Z,space_char_skip_loop
	CP 09H	;TAB
	JR Z,space_char_skip_loop
	RET


;小文字を大文字に変換します
;入力	Acc←アスキー･コード
;出力	Acc←変換したアスキー･コード
;破壊	AF
convert_lower_case_to_upper_case:
	CP	'a'
	RET	C
	CP	'z'+1
	RET	NC
	SUB	20H
	RET


;convert_decimal_character_to_number V1.00  Copyright (C) T.Chikushi  1994-06-18
;10進文字を数値に変換します
;入力	Acc←文字
;出力	AL←数値、CY←変換状態
;CF=0	AL←数値（0～9）
;CF=1	10進文字ではなかった（ALは、呼び出し前の値）
;破壊	AF
convert_decimal_character_to_number:
	CP	'0'
	RET	C
	CP	'9'+1
	CCF
	RET	C
;	「0」～「9」
	SUB	'0'	;Acc←0～9，CY←0
	RET


;Copyright (C) T.Chikushi  1991-01-04
;HL÷Acc→商HL...余りAcc
;入力	HL←被除数、Acc←除数
;出力	HL←商、Acc←余り
;破壊	AF，HL，DE，BC
DIV68:
	PUSH	BC
	LD	C,A	;C←除数
	XOR	A
	LD	B,16

DIV68L:
	ADD	HL,HL
	RLA
	CP	C
	JR	C,DIV681
	SUB	C
	INC	L
DIV681:	DJNZ DIV68L

	POP	BC
	RET


;Copyright (C) T.Chikushi  1990
;DEHL÷BC→商DEHL...余りBC
;入力	DEHL←被除数、BC←除数
;出力	DEHL←商、BC←余り
;破壊	インデックス･レジスタ以外
;	min 3,452ts max 3,600ts s1
DIV26:
	PUSH	BC
	EXX
	POP	BC	;BC'←除数
	LD	HL,0	;HL'←0
	EXX
	LD	B,32
DIV26L:	ADD	HL,HL
	EX	DE,HL
	ADC	HL,HL
	EX	DE,HL
	EXX
	ADC	HL,HL	;HL'DEHLを左シフト
	JR	C,DIV262	;必ず引けます
	SBC	HL,BC	;HL←HL－BC
	JR	NC,DIV263	;引けた
	ADD	HL,BC	;引けない場合はHL'を元に戻します
	EXX
	DJNZ	DIV26L
DIV261:	EXX
	PUSH	HL
	EXX
	POP	BC
	RET
;	必ず引ける場合
DIV262:	OR	A
	SBC	HL,BC
;	引けた場合
DIV263:	EXX
	INC	L	;INC HL'DEHL
	DJNZ	DIV26L
	JR	DIV261


;-----------------------
;割り込みルーチン
;-----------------------


; 省メモリのため、テーブル･エリアに移動しました。


;-----------------------
;オリジナル･モニタ
;-----------------------


;#MON（1F8EH）の本体
;CY＝0でリターンします（ディスク･モジュールのため）
MON:
	LD	(monitor_reserve_stack_pointer),SP
	LD	HL,(_MEMAX)
	LD	DE,3000H
	OR	A
	SBC	HL,DE
	LD	(monitor_size_of_user_area),HL	;ユーザー･エリアのサイズ

;	コマンド待ちループ
	CALL carriage_return_and_line_feed ;CRLF
monitor_command_waiting_loop:
	LD	SP,0100H	;オリジナル･モニタのスタック･トップ
	LD	A,'*'
	CALL	PRINT
	LD	DE,(_KBFAD)
	CALL	GETL
	CALL	get_character_from_string

; コマンドを解析して、それぞれの処理ルーチンへ。
;出力	DE←次の文字のアドレス
MON2:
	CP	':'
	JP	Z,monitor_memory_edit	;メモリ･エディット
	CP	'*'
	CALL Z,get_character_from_string
	CP	'R'
	JP	Z,terminate_monitor		;モニタを終えます
	CP	'#'
	JP	Z,monitor_dump_memory	;メモリダンプ
	CP	'F'
	JP	Z,monitor_search_data	;メモリサーチ
	CP	'A'
	JP	Z,monitor_go_command	;ジャンプ
	CP	'I'
	JP	Z,monitor_initialize_disk	;ディスクの初期化
	CP	'M'
	JP	Z,monitor_set_data_to_memory;メモリ･セット
	DS	4,00H	;ダミー
	CALL BELL
	JP	monitor_command_waiting_loop

;オリジナル･モニタを終えます
terminate_monitor:
	CALL carriage_return_and_line_feed ;CRLF
	XOR	A	;CY←0（Acc←0）
	LD	SP,(monitor_reserve_stack_pointer)
	RET


;オリジナル･モニタ サブルーチン･コール
monitor_go_command:
	CALL space_char_skip
	CALL convert_4_digit_data_to_hex_binary_ascii_code
	JR C, monitor_go_command_end
	LD BC, monitor_command_waiting_loop
	PUSH BC	;スタック←monitor_command_waiting_loop
	JP (HL)

monitor_go_command_end:
	CALL BELL
	JP	monitor_command_waiting_loop


;オリジナル･モニタ サーチ･ルーチン
;〈使用法〉
;「F 先頭アドレス 最終アドレス データ…」
;〈サーチするデータ列〉
;keyboard_buffer～
monitor_search_data:
;	アドレス情報を取り出します
	CALL space_char_skip
	CALL convert_4_digit_data_to_hex_binary_ascii_code
	JR	C, MONFIE
	LD	(MONFTP),HL	;先頭アドレス
	CALL space_char_skip
	CALL convert_4_digit_data_to_hex_binary_ascii_code
	JR	C, MONFIE
	INC	HL
	LD	(MONFEN),HL	;最終アドレス＋1

;	データを取り出します
	LD	HL, keyboard_buffer	;データ列の先頭

MONFL1:
	CALL space_char_skip
	CALL convert_2_digit_data_to_hex_binary_ascii_code
	JR	C, MNFL1E
	LD	(HL),A	;←データ
	INC	L	;現在アドレス＆現在データ数
	JR	MONFL1

MNFL1E:	LD	A,L
	OR	A
	JR	Z,MONFIE	;データがなかった
	LD	(MONFCT),A	;データ数（1～）
	LD	HL,(MONFEN)
	LD	DE,(MONFTP)
;	OR	A
	SBC	HL,DE
	DEC	HL	;HL←サイズ－1 '0～65,535
	LD	E,A
	LD	D,0
	DEC	DE	;DE←データ数－1 '0～
	OR	A
	SBC	HL,DE	;HL←サイズ－データ数
	JR	C, MONFIE
	INC	HL
	LD	(MONFSZ),HL	;検索カウンタ（1～）

;	検索します
	LD	HL,(MONFTP)	;先頭アドレス
	LD	BC,(MONFSZ)	;検索カウンタ
	LD	A,(keyboard_buffer)	;最初の検索バイト

MONFL2:	CPIR
	PUSH	AF
	PUSH	HL
	PUSH	BC
	CALL	Z, MONFSB	;最初のバイトが一致しました
	POP	BC
	POP	HL
	POP	AF
	JP	PE, MONFL2

MONFES:
	LD	A,0DH
	CALL	PRINT
MONFRT:
	JP	monitor_command_waiting_loop

MONFIE:
	CALL	_BELL
	JR	MONFRT


;最初のバイト以降を比較し、一致すれば、そのアドレスを表示します
;入力	HL←最初のバイトが一致した次のアドレス
;出力	なし
;破壊	全レジスタ
MONFSB:
	PUSH	HL	;スタック←比較されるアドレス＋1
	LD	DE, keyboard_buffer+1	;データ列先頭＋1
	LD	A,(MONFCT)
	LD	B,A
	DEC	B	;B←チェックする残りのバイト数
	JR	Z, MNFSBR	;比較は1バイトのみで、一致しました

MNFSBL:
	LD	A,(DE)
	INC	E
	CP	(HL)
	INC	HL
	JR	NZ,MNFSBB
	DJNZ	MNFSBL

MNFSBR:
	CALL	_PAUSE
	DW	MONFES
	LD	A,' '
	CALL	PRINT
	POP	HL	;HL←比較されるアドレス＋1
	DEC	HL
	JP	print_hex_4_digit

MNFSBB:
	POP	HL
	RET


;	サーチ･コマンド用ワーク
MONFTP:	DS	2	;検索先頭アドレス
MONFEN:	DS	2	;検索最終アドレス＋1
MONFSZ:	DS	2	;検索バイト数（[MONFEN]－[MONFTP]－[MONFCT]＋1）
MONFCT:	DS	1	;データ数


;オリジナル･モニタ ダンプ（可変行、可変桁対応）
;〈ダンプの桁数〉
; ダンプの桁数は、「横バイト数×4＋7」文字。
;72桁以上、71文字
;「:AAAA=HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH /CCCCCCCCCCCCCCCC」
;40桁以上、39文字
;「:AAAA=HH HH HH HH HH HH HH HH /CCCCCCCC」
;24桁以上、23文字
;「:AAAA=HH HH HH HH /CCCC」
;〈レジスタ･マップ〉
;HL	メモリのアドレス
;B	汎用カウンタ
;C	横バイト数
;DE	縦表示数
;注：DIV26（インデックス･レジスタ以外破壊）を呼び出します。
monitor_dump_memory:
	CALL	space_char_skip ; キー入力バッファのスペースをスキップ
	;DEレジスタの示すアドレスから4バイトの内容を、4桁の16進数で表現するアスキーコードとしてバイナリに変換しHLに格納する。
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	JR	C,$+5
	LD	(monitor_operation_address),HL
	CALL	space_char_skip ; キー入力バッファのスペースをスキップ
	;DEレジスタの示すアドレスから4バイトの内容を、4桁の16進数で表現するアスキーコードとしてバイナリに変換しHLに格納する。
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	LD	(monitor_dump_end_address),HL
	CCF
	SBC	A,A	;最終アドレスが指定されていたらAcc＝FFH
	LD	(MONDF),A
	CALL	initialize_monitor_memory_dump	;初期化
	JP	C,monitor_command_waiting_loop	;初期化失敗
	CALL	MNDILC	;表示ライン数の設定
	EX	DE,HL	;DE←縦ライン数
	LD	A,(MONDX)
	LD	C,A	;C←横バイト数

;入力	C←横バイト数、DE←縦ライン数
;	[monitor_operation_address]参照
;出力	[monitor_operation_address]更新
;破壊	AF，HL，DE，B
;〈レジスタ･マップ〉
;HL	現在メモリのアドレス
;B	横ループ･カウンタ
;DE	縦ループ･カウンタ
MDPLP1:
	LD	A,':'
	CALL	PRINT
	LD	HL,(monitor_operation_address)
	PUSH	HL	;スタック←アドレス（行頭）
	CALL	print_hex_4_digit
	LD	A,'='
	CALL	PRINT
	LD	B,C	;B←横バイト数

;入力	HL←メモリのアドレス、B←横バイト数
;出力	HLはカウント･アップされます
;破壊	AF，HL，B
;〈レジスタ･マップ〉
;HL	現在メモリのアドレス
;B	ループ･カウンタ
MDPL21:
	LD	A,(HL)	;Acc←メモリのデータ
	INC	HL
	CALL	print_hex_2_digit
	LD	A,' '
	CALL	PRINT
	DJNZ	MDPL21

	LD	A,'/'
	CALL	PRINT
	POP	HL	;HL←アドレス（行頭）
	LD	B,C	;B←横バイト数

;入力	HL←メモリのアドレス、B←横バイト数
;出力	HLはカウント･アップされます
;破壊	AF，HL，B
;〈レジスタ･マップ〉
;HL	現在メモリのアドレス
;B	ループ･カウンタ
MDPL22:
	LD	A,(HL)	;Acc←メモリのデータ
	INC	HL
;	CP	7FH
;	JR	Z,$+6	;DELコードだった
	CP	20H
	JR	NC,$+4	;コントロール･コードだった
	LD	A,' '	;Acc←「 」
	CALL	PRINT
	DJNZ	MDPL22

	LD	(monitor_operation_address),HL
	CALL	carriage_return_and_line_feed
	CALL	PAUSE
	DW	monitor_command_waiting_loop
	DEC	DE
	LD	A,E
	OR	D
	JR	NZ,MDPLP1

	JP	monitor_command_waiting_loop


;表示ライン数を得ます
;入力	[MONDE]←最終アドレス、[MONDF]←[MONDE]有効のフラグ
;出力	HL←ライン数
;破壊	全レジスタ
MNDILC:
	LD	A,(MONDF)
	OR	A
	JR	NZ,MNDLC1

;	最終アドレスが設定されていない場合
	LD	A,(MONDY)
	LD	L,A
	LD	H,0	;HL←縦ライン数（1画面分）
	RET

;	最終アドレスが設定されている場合
MNDLC1:
	LD	A,(MONDX)
	LD	C,A
	LD	B,0	;BC←横バイト数（2～）
	LD	HL,(monitor_dump_end_address)
	LD	DE,(monitor_operation_address)
	XOR	A
	SBC	HL,DE	;HL←ダンプするバイト数－1
	ADD	HL,BC
	RLA		;Acc←CY
	LD	E,A
	LD	D,B	;DEHL←ダンプするバイト数＋横バイト数－1
	JP	DIV26


;ダンプ･コマンドの初期化処理
;入力	[_MXLIN]、[_WIDTH]参照
;出力	[MONDX]、[MONDY]設定
;	CY＝1なら初期化に失敗しました
;破壊	全レジスタ
; MNDINI:
initialize_monitor_memory_dump:
;	[MONDXの設定]
	LD	A,(_WIDTH)
	SUB	8	;アドレスなどの8文字を除きます
	RET	C
	CP	4*2
	RET	C	;2バイト分の表示にも足りない
	AND	11111100B
	RRCA
	RRCA		;Acc←表示可能横バイト数
	CALL	MNDN2
	LD	(MONDX),A	;[MONDY]←横バイト数（2～）

;	[MONDYの設定]
	LD	A,(_MXLIN)
	SUB	1	;1行のアキを作るため
	RET	C
	CP	2
	RET	C	;2行分の表示にも足りない
	CALL	MNDN2
	LD	(MONDY),A	;[MONDY]←縦ライン数（2～）

	XOR	A
	RET


;データをn^2化します
;入力	Acc←処理するデータ（0～255）
;出力	Acc←n^2化されたデータ（8、16など）
;破壊	全レジスタ
MNDN2:
	LD	BC,8*100H	;B←8，C←0

MNDN21:
	RLCA
	INC	C	;カウント･アップ
	JR	C,$+4
	DJNZ	MNDN21

	LD	A,0	;CYA←1_00000000B
	LD	B,C

MNDN22:
	RRA
	DJNZ	MNDN22

	RET


;	ダンプ･コマンド用ワーク
; MONDE:	DS	2	;ユーザーが指定したダンプの最終アドレス
monitor_dump_end_address:	DS	2	;ユーザーが指定したダンプの最終アドレス
MONDF:	DS	1	;＝FFHで、[MONDE]が有効
MONDX:	DS	1	;ダンプする横バイト数（2～）
MONDY:	DS	1	;ダンプする縦バイト数（2～）


;オリジナル･モニタ メモリ･セット
monitor_set_data_to_memory:
	CALL	space_char_skip
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	JR	C,$+5
	LD	(monitor_operation_address),HL

MMSLP:	LD	A,':'
	CALL	PRINT
	LD	HL,(monitor_operation_address)
	CALL	print_hex_4_digit
	LD	A,'='
	CALL	PRINT
	LD	A,(HL)
	CALL	_print_hex_2_digit
	LD	A,1DH	;Acc←「←」
	CALL	PRINT
	CALL	PRINT
	CALL	MEMEDT
	JP	C,MON2
	JR	MMSLP


;オリジナル･モニタ メモリ･エディット
monitor_memory_edit:
	CALL	MEMED1
	JP	C,monitor_command_waiting_loop

MONELP:	CALL	MEMEDT
	JP	C,MON2
	JR	MONELP


;1行メモリ･エディット･ルーチン
;入力	[monitor_operation_address]参照
;出力	CY＝1ならエディットを終了しました
;破壊	AF，HL，DE
MEMEDT:
	LD	DE,(_KBFAD)
	CALL	_GETL
	CALL	get_character_from_string

;	既に先頭1文字を取り出した時のエントリ
MEMED1:
	CP	':'	;メモリ･エディット用ヘッダ
	SCF
	RET	NZ	;ヘッダが不正
	CALL	space_char_skip
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	RET	C	;アドレスが不正
	CALL	get_character_from_string
	CP	'='
	SCF
	RET	NZ	;セパレータが不正

MEMELP:	CALL	space_char_skip
	LD	A,(DE)
	CP	'.'
	SCF
	RET	Z	;エディット終了
	CALL	convert_2_digit_data_to_hex_binary_ascii_code
	CCF
	RET	NC	;入力終了
	LD	(HL),A
	INC	HL
	LD	(monitor_operation_address),HL
	JR	MEMELP


;===============================================
;オリジナル･モニタ Ok、Errorメッセージ
;===============================================


;処理が正常終了しました
monitor_normal_end:
	CALL	print_string_from_next_call_address
	DB	'Ok',0DH,00H
MNOKRT:
	JP	monitor_command_waiting_loop


;処理が異常終了しました
monitor_error_termination:
	CALL	print_string_from_next_call_address
	DB	'Error !',0DH,00H
	JR	MNOKRT


;=======================================
;オリジナル･モニタ･ディスク初期化処理
;=======================================


;S-OSディスク･イメージの初期化
monitor_initialize_disk:
	CALL	space_char_skip
	CALL	MONDEV
	OR	A
	JR	NZ,MONIDI

;	S-OSディスク･イメージのクローズ
	CALL SOSSF
	JP	C,monitor_error_termination
	JP	monitor_normal_end

;	論理フォーマット
MONIDI:
	DEC	A	;Acc←ユニット番号
	LD	(disk_unit_number),A
	ADD	A,'A'
	LD	C,A	;C←デバイス名
	CALL	print_string_from_next_call_address
	DB	'DEVICE ',00H
	LD	A,C
	CALL	PRINT
	CALL	print_string_from_next_call_address
	DB	': initialize (Y/N)?',00H
	CALL	FLGET ;Y/Nキー入力
	CALL	convert_lower_case_to_upper_case
	CP	'Y'
	JR	Z,MONIDY

;	初期化しません
	LD	A,'N'
	CALL	PRINT
	LD	A,0DH
	CALL	PRINT
	JP	monitor_command_waiting_loop

;	初期化します
MONIDY:
	CALL	PRINT
	LD	A,CR ; Acc←改行コード
	CALL	PRINT

	CALL	SOSDI
	JP	NC,monitor_normal_end

;	物理的フォーマット（論理フォーマットに失敗しました）
	CALL	SOSDF
	JP	NC,monitor_normal_end

;	物理的フォーマットにも失敗しました
	JP	monitor_error_termination


;=======================================
;オリジナル･モニタ･ディスク･ルーチン
;=======================================


;ファイル名からデバイスを抜き出します
;入力	DE←ファイル名の先頭アドレス
;出力	Acc←デバイス（0，1～）、DE←カウント･アップ
;破壊	AF，DE
;注：デフォルト･デバイスは0、ドライブAは1に対応します。
MONDEV:
	LD	A,(DE)
	OR	A
	RET	Z	;文字列の終わりに達していました

	INC	DE
	LD	A,(DE)
	DEC	DE
	CP	':'
	LD	A,0	;Acc←デフォルト･デバイス
	RET	NZ	;デバイスが指定されています

;	デバイスが指定されています
	LD	A,(DE)
	CALL	convert_lower_case_to_upper_case
	SUB	'A'-1	;Acc←1～
	INC	DE
	INC	DE
	RET



;-------------------------------
;オリジナル･モニタ ワーク
;-------------------------------


monitor_operation_address:		DW	0	;操作アドレス
monitor_reserve_stack_pointer:	DW	0	;SPの保存
monitor_size_of_user_area:		DW	0	;ユーザー･エリアの大きさ


;---------------------------------------
;SWXCDIOを使わないための処理
;---------------------------------------


SOSSI:
SOSSF:
	OR	A
	RET
SOSDI:
SOSDF:
	SCF
	RET
DIOETP:
	DS	2


CRT_INIT:
	LD HL,0F000H ; VRAMの左上のアトリビュートアドレス
	LD BC,0800H
; カーソル座標を00Hに設定する。
; 注：画面左上がカーソル座標では0000Hになる。VRAMにおけるテキスト画面左上(F800H)ではないことに注意。
	LD A,0EH ; R14 (cursor H)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,0H
	OUT (CRTC_VALUE_PORT),A
	LD A,0FH ; R15 (cursor L)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,00H
	OUT (CRTC_VALUE_PORT),A

; カーソルの形状と点滅の設定
	LD A,0AH ; R10 (cursor start address)
	OUT (CRTC_ADDRESS_PORT),A
;	LD A,C0H ; 点滅、豆腐カーソル
	LD A,C7H ; 点滅、アンスコカーソル
;	LD A,0H ; 表示せず。
	OUT (CRTC_VALUE_PORT),A
	LD A,0BH ; R11 (cursor end address)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,0AH
;	LD A,0H ; 表示せず。
	OUT (CRTC_VALUE_PORT),A

;
; 	一度画面全てを消す(スペースで埋める)。
;
	LD B,050H
	LD DE,0FFFFH
	LD A,20H ; 20Hはアスキーコードでスペース
CLEAR_LOOP:
; CLEAR_ALL_LINE:
	OUT (0D2H),A ; D2Hポートになにか書くと次の命令は別のページ(この場合はVRAMのページ)に行う。
	LD (HL),A ; F000H～FFFFHまで20Hで埋めている。アトリビュートに20H書いても問題ないみたい。
	INC HL
	SBC HL,DE
	; JR NZ,CLEAR_ALL_LINE
	JR NZ,CLEAR_LOOP


	XOR A ; コントロールコードの処理が行われたことを示すフラグをリセットする
	LD (CURSOR_X),A ; カーソルのX座標を0にする
	LD (CURSOR_Y),A ; カーソルのY座標を0にする

	RET ; 初期化処理終了

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; CRTCコントロールサブルーチン群
;

;
; VRAM_TXT_TOP : VRAMテキストエリアの先頭(F800H)
; CURSOR_LOCATE : 現在のカーソル位置
; CR_NOW_CURSOR_LOCATE : CRコードが入った時のカーソル位置
; TOP_VIEW : 画面左上端のアドレス(スクロールによって動的に変化する)
; CR_BASE_ADDRESS : CR後のカーソル位置
; CR_NEW_ORIGIN : FFFFHの境界を越え、更に画面右端を超えた時にCRアドレス計算の原点になるアドレス


;==============================================================
; SORD M23 CP/M ディスプレイドライバ
; CPU:  Z80
; CRTC: HD46505 (MC6845)
; テキストモード: 80桁 × 25行
;==============================================================
;
; [提供サブルーチン一覧]
;
;   GET_VRAM_ADDRESS_FROM_X_Y  … (X,Y) → VRAM アドレス
;   GET_X_Y_FROM_VRAM_ADDRESS  … VRAM アドレス → (X,Y)
;   SCROLL_UP                  … 画面を 1行上スクロール
;   WRITE_CHAR_AT_XY           … (X,Y) の位置に 1文字書き込む
;
;==============================================================


;--------------------------------------------------------------
; 定数 ― I/O ポート
;--------------------------------------------------------------
VRAM_BANK_PORT      EQU 0D2H    ; VRAMバンク切替ポート
                                ;   → このポートに書くと【次の1命令】が
                                ;     VRAM ページへのアクセスになる

;--------------------------------------------------------------
; 定数 ― HD46505 レジスタ番号
;--------------------------------------------------------------
CRTC_R12_START_H    EQU 0CH     ; Start Address High  (画面先頭アドレス上位)
CRTC_R13_START_L    EQU 0DH     ; Start Address Low   (画面先頭アドレス下位)
CRTC_R14_CURSOR_H   EQU 0EH     ; Cursor Address High
CRTC_R15_CURSOR_L   EQU 0FH     ; Cursor Address Low

;--------------------------------------------------------------
; データ領域
;--------------------------------------------------------------

;------------------------------------------------------------
; CURRENT_TOP_LEFT_ADDRESS  (2 バイト)
;
; 現在の画面左上端の VRAM 絶対アドレス。
; 初期値 = F800H。
; スクロールのたびに +80 進み、FFFFH を超えると
; 旧コードの算法で F800H 付近へ折り返す。
;
; TLA は常に 16 の倍数のオフセットを持つ:
;   F800H, F810H, F820H, ..., FFFOH の 128 種類が循環する。
;   (GCD(80, 2048) = 16 より)
;------------------------------------------------------------
CURRENT_TOP_LEFT_ADDRESS:
    DW  VRAM_TXT_TOP        ; 初期値: F800H


;==============================================================
; GET_VRAM_ADDRESS_FROM_X_Y
;
; 仮想座標 (X, Y) から VRAM アドレスを計算する。
; VRAM リング (F800H-FFFFH = 2048 バイト) の折り返しを考慮。
;
; 入力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
; 出力:  HL = VRAM アドレス
; 破壊:  A, DE
;
; 計算式:
;   offset  = Y × 80 + X              [0 ～ 1999]
;   raw     = TLA + offset             [16 ビット加算]
;
;   キャリーなし: VRAM = raw           (raw ∈ F800H..FFFFH)
;   キャリーあり: VRAM = raw + F800H   (raw = TLA+offset-10000H を
;                                       VRAM_TXT_TOP で補正)
;
; [Y × 80 の計算]
;   80 = 64 + 16 = 2^6 + 2^4
;   Y × 80 = Y×64 + Y×16
;   中間値 Y×16 を DE に保存し、Y×64 後に加算する。
;==============================================================
GET_VRAM_ADDRESS_FROM_X_Y:

    ;----------------------------------------------------------
    ; ① Y × 80 (シフト + 加算)
    ;----------------------------------------------------------
    LD  H, 0
    LD  L, B            ; HL = Y
    ADD HL, HL          ; HL = 2Y
    ADD HL, HL          ; HL = 4Y
    ADD HL, HL          ; HL = 8Y
    ADD HL, HL          ; HL = 16Y
    LD  D, H
    LD  E, L            ; DE = 16Y を保存
    ADD HL, HL          ; HL = 32Y
    ADD HL, HL          ; HL = 64Y
    ADD HL, DE          ; HL = 64Y + 16Y = 80Y

    ;----------------------------------------------------------
    ; ② X を加算 → offset (0 ～ 1999)
    ;----------------------------------------------------------
    LD  D, 0
    LD  E, C
    ADD HL, DE          ; HL = Y×80 + X

    ;----------------------------------------------------------
    ; ③ CURRENT_TOP_LEFT_ADDRESS (TLA) を加算
    ;----------------------------------------------------------
    LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
    ADD HL, DE          ; HL = TLA + offset  [16 ビット加算]

    ;----------------------------------------------------------
    ; ④ VRAM リング折り返し補正
    ;
    ;   キャリーなし: HL ∈ [F800H, FFFFH] → そのまま返す
    ;   キャリーあり: HL = TLA + offset - 10000H  (∈ [0000H, ~07CEH])
    ;                 正しい VRAM = HL + F800H
    ;
    ;   例: TLA=F850H, Y=24, X=0 → offset=1920
    ;     F850H + 0780H = FFD0H (キャリーなし) → FFD0H ✓
    ;   例: TLA=FF80H, Y=24, X=0 → offset=1920
    ;     FF80H + 0780H = 10700H (キャリーあり) → HL=0700H
    ;     0700H + F800H = FF00H ✓
    ;----------------------------------------------------------
    RET NC                      ; キャリーなし → HL は有効 VRAM アドレス
    LD  DE, VRAM_TXT_TOP        ; F800H
    ADD HL, DE                  ; HL = (TLA + offset - 10000H) + F800H
    RET

;==============================================================
; GET_X_Y_FROM_VRAM_ADDRESS
;
; VRAM アドレスから仮想座標 (X, Y) を逆算する。
; (表示中の有効な VRAM アドレスを入力すること)
;
; 入力:  HL = VRAM アドレス
; 出力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
; 破壊:  A, DE, HL
;
; 計算式:
;   CRTC_offset = (VRAM - TLA) mod 2048
;
;   VRAM >= TLA のとき: CRTC_offset = VRAM - TLA
;   VRAM <  TLA のとき: CRTC_offset = VRAM - TLA + 2048
;                                    = (VRAM - TLA + 10000H) - F800H
;
;   Y = CRTC_offset ÷ 80  (繰り返し減算、最大 24 回)
;   X = CRTC_offset mod 80
;
;   例: TLA=F850H, VRAM=FFD0H
;     FFD0H - F850H = 0780H = 1920 (キャリーなし)
;     Y = 24, X = 0 ✓
;   例: TLA=FF80H, VRAM=F800H
;     F800H - FF80H → ボロー → HL=F880H, +2048-補正:
;     F880H - F800H = 0080H = 128 (キャリーあり)
;     Y = 1, X = 48 ✓
;==============================================================
GET_X_Y_FROM_VRAM_ADDRESS:

    ;----------------------------------------------------------
    ; ① CRTC_offset = (VRAM - TLA) mod 2048
    ;----------------------------------------------------------
    LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
    XOR A                       ; キャリークリア (かつ A=0)
    SBC HL, DE                  ; HL = VRAM - TLA

    JR  NC, GXYVA_OFFSET_OK     ; VRAM >= TLA: HL = CRTC_offset

    ; VRAM < TLA (リング折り返し):
    ;   HL = VRAM - TLA + 10000H  (∈ F801H..FFFFH)
    ;   CRTC_offset = HL - F800H  = VRAM - TLA + 800H
    ;
    ;   OR A で CY=0 を保証したうえで SBC することで
    ;   A の値を変えずに正確に F800H を引く。
    LD  DE, VRAM_TXT_TOP        ; F800H
    OR  A                       ; キャリークリア (A=0 のまま保持)
    SBC HL, DE                  ; HL = (VRAM - TLA + 10000H) - F800H
                                ;    = VRAM - TLA + 800H = CRTC_offset

GXYVA_OFFSET_OK:
    ; HL = CRTC_offset  (0 ～ 1999)

    ;----------------------------------------------------------
    ; ② CRTC_offset ÷ 80 → Y (商),  X (余り)
    ;    繰り返し減算: 最大 24 回のループで完了
    ;----------------------------------------------------------
    LD  B, 0                    ; Y カウンタ
GXYVA_DIV:
    LD  A, H
    OR  A
    JR  NZ, GXYVA_SUB          ; H ≠ 0 → HL ≧ 256 > 80 → まだ引ける
    LD  A, L
    CP  NUMBER_OF_CHARACTER_AT_LINE               ; L < 80 ?
    JR  C,  GXYVA_DONE         ; L < 80 → 除算完了
GXYVA_SUB:
    LD  A, L
    SUB NUMBER_OF_CHARACTER_AT_LINE               ; A = L - 80
    LD  L, A
    JR  NC, GXYVA_INC
    DEC H                       ; ボロー補正
GXYVA_INC:
    INC B                       ; Y++
    JR  GXYVA_DIV
GXYVA_DONE:
    LD  C, L                    ; C = X (余り = 論理列)
    ; B = Y (商 = 論理行) ← 出力確定
    RET



;==============================================================
; SCROLL_UP
;
; 画面を 1 行上スクロールする。
;
; [処理概要]
;   [1] CURRENT_TOP_LEFT_ADDRESS から 80 文字をスペースで消去
;       (FFFFH → F800H の境界越えを考慮)
;   [2] CURRENT_TOP_LEFT_ADDRESS を 80 進める
;       (境界越え時は旧コードの算法 + -2 補正)
;   [3] HD46505 R12/R13 に新 TLA を書き込む (絶対 VRAM アドレス)
;
; 入力:  なし
; 出力:  なし
; 破壊:  なし (AF, BC, DE, HL をすべて保存・復元)
;
; [TLA 進め方の算法 --- 境界越え時]
;   TLA + 50H > FFFFH のとき、旧コードの算法を用いる:
;     A      = FFFFH - TLA - 1  (CY=1 を受け取って SBC)
;     result = 50H - A - CY2    (CY2 は上記 SBC の繰り越し)
;     new_TLA = VRAM_TXT_TOP + result - 2
;   末尾の -2 はキャリー伝播に起因する算法固有の補正値。
;
;   例: TLA=FFD0H → new_TLA=F820H
;     FFFFH - FFD0H - 1 = 2EH
;     50H - 2EH = 22H
;     F800H + 22H - 2 = F820H ✓  (期待値: (2000+80) mod 2048 = 32 → F820H)
;==============================================================
SCROLL_UP:
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL

    ;----------------------------------------------------------
    ; [1] 旧最上行 (TLA から 80 文字) をスペースで消去
    ;
    ;     1 文字書くたびに PUSH HL / OR A / SBC HL, FFFFH / POP HL で
    ;     HL = FFFFH かどうかを判定する (OR A で CY=0 を保証)。
    ;     FFFFH 書き込み後: DJNZ が未実行のため DEC B で補正してから
    ;     F800H へ折り返し、残り文字数分を書き続ける。
    ;----------------------------------------------------------
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
    LD  DE, 0FFFFH          ; 境界判定用
    LD  B, NUMBER_OF_CHARACTER_AT_LINE        ; B = 80 (ループカウンタ)
    LD  A, 20H              ; スペース文字

SU_CLEAR:
    OUT (VRAM_BANK_PORT), A ; 次の命令 (LD(HL),A) を VRAM ページへ
    LD  (HL), A             ; VRAM にスペースを書き込む
    PUSH HL
    OR  A                   ; キャリークリア (OR A は A=20H を保持, CY=0 保証)
    SBC HL, DE              ; HL - FFFFH: Z=1 のとき HL=FFFFH
    POP HL
    JR  Z, SU_CLEAR_WRAP    ; FFFFH に達したら折り返し
    INC HL
SU_CLEAR_NEXT:
    DJNZ SU_CLEAR           ; B--、B≠0 ならループ
    JR  SU_CLEAR_DONE

SU_CLEAR_WRAP:
    ; FFFFH への書き込みは完了。この反復では DJNZ を実行していないため
    ; B をデクリメントして補正する。
    DEC B
    JR  Z, SU_CLEAR_DONE    ; B=0 → 80 文字消去完了
    LD  HL, VRAM_TXT_TOP    ; F800H へ折り返し
SU_CLEAR_WRAP_LOOP:
    OUT (VRAM_BANK_PORT), A
    LD  (HL), A
    INC HL
    DJNZ SU_CLEAR_WRAP_LOOP

SU_CLEAR_DONE:

    ;----------------------------------------------------------
    ; [2] CURRENT_TOP_LEFT_ADDRESS を NUMBER_OF_CHARACTER_AT_LINE (80) 進める
    ;----------------------------------------------------------
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
    LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H = 80
    ADD HL, DE                  ; HL = TLA + 80
    JR  NC, SU_UPDATE_TLA       ; オーバーフローなし → そのまま

    ; TLA + 80 > FFFFH の場合 (CY=1 を保持したまま以降の SBC へ渡す)
    LD  DE, 0FFFFH
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)  ; TLA を再ロード
    EX  DE, HL                  ; HL = FFFFH,  DE = TLA
    SBC HL, DE                  ; HL = FFFFH - TLA - 1  (CY=1 を使用)
    LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H
    EX  DE, HL                  ; HL = 50H,  DE = (FFFFH - TLA - 1)
    SBC HL, DE                  ; HL = 50H - (FFFFH-TLA-1) - CY
    LD  DE, VRAM_TXT_TOP        ; F800H
    ADD HL, DE
    DEC HL                      ; -2 補正 (算法固有)
    DEC HL

SU_UPDATE_TLA:
    LD  (CURRENT_TOP_LEFT_ADDRESS), HL

    ;----------------------------------------------------------
    ; [3] HD46505 R12/R13 に新 TLA を書き込む
    ;     H → R12 (上位),  L → R13 (下位)
    ;     絶対 VRAM アドレスをそのまま書き込む (旧コードと同方式)
    ;----------------------------------------------------------
    LD  A, CRTC_R12_START_H
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, H
    OUT (CRTC_VALUE_PORT), A

    LD  A, CRTC_R13_START_L
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, L
    OUT (CRTC_VALUE_PORT), A

    POP HL
    POP DE
    POP BC
    POP AF
    RET


;==============================================================
; WRITE_CHAR_AT_X_Y
;
; 仮想座標 (X, Y) の位置に 1文字を VRAM へ書き込む。
; カーソル位置は変更しない。
;
; 入力:	B = Y 論理行 (0-24)
;		C = X 論理列 (0-79)
;      	A = 書き込む文字コード
; 出力:  なし
; 破壊:  A, DE, HL
;         (BC は GET_VRAM_ADDRESS_FROM_X_Y が保存するため変化なし)
;
; 【カーソル表示との連携について】
;   本ルーチンは VRAM への文字書き込みのみ行う。
;   画面上のカーソル位置を更新したい場合は、呼び出し側が
;   CURRENT_CURSOR_LOCATE を更新したうえで PRINT_CURSOR を呼ぶこと。
;==============================================================
WRITE_CHAR_AT_X_Y:
    ;----------------------------------------------------------
    ; GET_VRAM_ADDRESS_FROM_X_Y は A を破壊するため、
    ; 書き込む文字コードを PUSH AF でスタックに退避する。
    ; CALL 後に POP AF で復元してから VRAM へ書き込む。
    ;----------------------------------------------------------
    PUSH AF                         ; 文字コード (A) を退避
    CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = VRAM アドレス  (A, DE 破壊)
    POP  AF                         ; A = 文字コード を復元

    OUT  (VRAM_BANK_PORT), A        ; 次の命令 (LD(HL),A) を VRAM ページへ
    LD   (HL), A                    ; VRAM に文字を書き込む
    RET


;==============================================================
; CONOUT_PROCESS  (S-OS BIOS コンソール出力)
;
; S-OS BIOS インターフェース:
;   C = 出力文字コード
;
; 破壊: なし (AF, BC, DE, HL をすべて保存・復元)
;
; 制御コード処理:
;   0AH (LF) : X = 0 (行頭へ)、Y 変化なし
;   0DH (CR) : Y += 1 (次行へ)、X 変化なし
;              Y = 24 (最下行) の場合は SCROLL_UP を呼び Y を 24 に維持
;   20H 未満の他の制御コード : 無視 (カーソル位置更新のみ)
;   20H 以上の印字文字       : 現在位置に書き込み後 X += 1
;              X = 80 (行末超え) の場合: X=0 にして CR 相当の処理
;==============================================================
CONOUT_PROCESS:
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL

    ;----------------------------------------------------------
    ; 制御コード分岐
    ;----------------------------------------------------------
	CP  BEL
	JP  Z, CO_BEL   ; BEL (07H): 無視
	CP  HT
	JP  Z, CO_HT    ; 水平タブ
    CP  LF
    JP  Z, CO_LF    ; LF (0AH): X=0、Y 変化なし
    CP  VT
    JP  Z, CO_VT    ; 垂直タブ
    CP  NP
    JP  Z, CO_FF    ; NewPage = フォームフィード(FF)
    CP  CR
    JP  Z, CO_CR    ; CR (0DH): Y+1 (最下行ならスクロール)
	CP  BS
	JP  Z, CO_BS    ; BS (08H): バックスペース
    CP  20H
    JP  C, CO_CURSOR_UPDATE    ; 00H-19H のその他の制御コード: 無視

    ;----------------------------------------------------------
    ; 印字可能文字 (20H 以上)
    ;
    ; WRITE_CHAR_AT_X_Y は A, DE, HL を破壊するため
    ; 文字コードを D に退避してから呼ぶ
    ;----------------------------------------------------------
    LD  D, A                    ; D = 文字コードを退避
    LD  A, (CURSOR_Y)
    LD  B, A                    ; B = Y
    LD  A, (CURSOR_X)
    LD  C, A                    ; C = X
    LD  A, D                    ; A = 文字コードを復元
    CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置に文字を書き込む

    ; X を進める
    LD  A, (CURSOR_X)
    INC A
    CP  80                      ; X = 80 (行末超え)?
    JR  C, CO_SAVE_X            ; X < 80: そのまま保存してカーソル更新へ
    ; 行末折り返し: X=0 にして CR 相当の処理 (Y+1 またはスクロール) へ
    XOR A
    LD  (CURSOR_X), A
    JR  CO_CR

CO_SAVE_X:
    LD  (CURSOR_X), A
    JP  CO_CURSOR_UPDATE

    ;----------------------------------------------------------
    ; LF (0AH): X = 0、Y 変化なし
    ;----------------------------------------------------------
CO_LF:
    XOR A
    LD  (CURSOR_X), A
    JP  CO_CURSOR_UPDATE

    ;----------------------------------------------------------
    ; CR (0DH): Y += 1、X = 0 ; S-OSのCRはCR+LFの動作なので、CRのときはLFの処理も行う
    ; ※ 行末折り返し (X=80) のときもここに合流する
    ;----------------------------------------------------------
CO_CR:
    LD  A, (CURSOR_Y)
    CP  24                      ; 最下行 (Y=24)?
    JR  Z, CO_SCROLL            ; Yes → スクロール (Y は 24 のまま)
    INC A
    LD  (CURSOR_Y), A
	; S-OSのCRはCR+LFの動作なので、CRのときはLFの処理も行う
    XOR A
    LD  (CURSOR_X), A
	;
    JR  CO_CURSOR_UPDATE

;----------------------------------------------------------
    ; CO_BS  バックスペース (08H)
    ;
    ; カーソルを 1 つ戻し、その位置をスペースで消去する。
    ;
    ; 処理:
    ;   X > 0          : X -= 1
    ;   X = 0, Y > 0   : X = 79, Y -= 1  (前行末へ折り返し)
    ;   X = 0, Y = 0   : 何もしない (画面左上端、戻れない)
    ;----------------------------------------------------------
CO_BS:
    LD  A, (CURSOR_X)
    OR  A                       ; X = 0?
    JR  NZ, CO_BS_DEC_X        ; No → X を 1 減らすだけ

    ; X = 0 のとき
    LD  A, (CURSOR_Y)
    OR  A                       ; Y = 0?
    JR  Z, CO_BS_IGNORE        ; Yes → 左上端、何もしない

    ; X=0, Y>0: 前行末 (X=79, Y-1) へ
    DEC A
    LD  (CURSOR_Y), A           ; Y -= 1
    LD  A, 79
    LD  (CURSOR_X), A           ; X = 79
    JR  CO_BS_ERASE

CO_BS_DEC_X:
    DEC A
    LD  (CURSOR_X), A           ; X -= 1

    ;----------------------------------------------------------
    ; 戻った位置をスペース (20H) で消去
    ; 参考コードの OUT(D2H)+LD(DE),A に相当する処理を
    ; WRITE_CHAR_AT_X_Y 経由で行う
    ;----------------------------------------------------------
CO_BS_ERASE:
    LD  A, (CURSOR_Y)
    LD  B, A                    ; B = Y
    LD  A, (CURSOR_X)
    LD  C, A                    ; C = X
    LD  A, 20H                  ; A = スペース
    CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置をスペースで消去

CO_BS_IGNORE:
    JP  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ

;----------------------------------------------------------
    ; CO_HT  水平タブ (09H)  タブ幅 4
    ;
    ; 次の 4 の倍数列へ X を進める。
    ;
    ; タブストップ: X = 0, 4, 8, 12, ... , 76
    ;
    ; 計算式:
    ;   new_X = (CURSOR_X & FCH) + 4
    ;   ※ AND FCH で下 2 ビットをクリア(4 の倍数へ切り捨て)
    ;     → そこに 4 を加えて次のタブストップを得る
    ;
    ;   例: X=0  → (00H & FCH)+4 = 04H
    ;       X=3  → (00H & FCH)+4 = 04H
    ;       X=4  → (04H & FCH)+4 = 08H
    ;       X=77 → (4CH & FCH)+4 = 50H=80 → 行末超え → X=0 かつ CO_CR へ
    ;----------------------------------------------------------
CO_HT:
    LD  A, (CURSOR_X)
    AND 0FCH                    ; X を 4 の倍数に切り捨て
    ADD A, 4                    ; 次のタブストップ (4..80)
    CP  80                      ; 80 以上 (行末超え)?
    JR  C, CO_HT_SAVE           ; No → そのまま保存してカーソル更新へ
    ; 行末超え: X=0 にして CR 相当 (Y+1 またはスクロール) へ
    XOR A
    LD  (CURSOR_X), A
    JR  CO_CR                   ; CONOUT の CO_CR ラベルへ
CO_HT_SAVE:
    LD  (CURSOR_X), A
    JR  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ


    ;----------------------------------------------------------
    ; CO_VT  垂直タブ (0BH)
    ;
    ; Y を 1 増やす。X は変化しない。
    ; 最下行 (Y=24) の場合は SCROLL_UP。
    ; → CR (0DH) と動作が同じなので CO_CR に合流する。
    ;----------------------------------------------------------
CO_VT:
    JR  CO_CR                   ; CONOUT の CO_CR ラベルへ

	;----------------------------------------------------------
    ; CO_FF  フォームフィード (0CH)
    ;
    ; 画面全消去 + カーソルを (0,0) へ。
    ;
    ; 処理内容:
    ;   [1] CURRENT_TOP_LEFT_ADDRESS を F800H にリセット
    ;   [2] HD46505 R12/R13 を F800H に戻す
    ;   [3] VRAM テキスト領域 (F800H-FFFFH, 2048 バイト) を
    ;       スペース (20H) で埋める
    ;       ※ 余り領域 (FFD0H-FFFFH, 48 バイト) も含めて全消去
    ;   [4] CURSOR_X, CURSOR_Y を 0 にリセット
    ;----------------------------------------------------------
CO_FF:
    ; [1] CURRENT_TOP_LEFT_ADDRESS を F800H にリセット
    LD  HL, VRAM_TXT_TOP
    LD  (CURRENT_TOP_LEFT_ADDRESS), HL

    ; [2] HD46505 R12/R13 を F800H に戻す (絶対アドレス)
    LD  A, CRTC_R12_START_H
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, 0F8H                 ; F800H 上位
    OUT (CRTC_VALUE_PORT), A
    LD  A, CRTC_R13_START_L
    OUT (CRTC_ADDRESS_PORT), A
    XOR A                       ; F800H 下位 = 00H
    OUT (CRTC_VALUE_PORT), A

    ; [3] VRAM テキスト領域を全消去 (F800H-FFFFH = 2048 バイト)
    ;     2000 バイトではなく 2048 バイトを消去する。
    ;     余り領域 (FFD0H-FFFFH) をクリアしないと、
    ;     スクロール後にその 48 バイトが行頭に見えてしまうため。
    LD  HL, VRAM_TXT_TOP        ; HL = F800H
    ; LD  BC, VRAM_SIZE           ; BC = 0800H (2048 バイト)
    LD  BC, 0800H           ; BC = 0800H (2048 バイト)
CO_FF_CLEAR:
    LD  A, 20H
    OUT (VRAM_BANK_PORT), A     ; 次の命令を VRAM ページへ
    LD  (HL), A
    INC HL                      ; FFFFH の後は 0000H へ (16 ビット折り返し)
    DEC BC                      ; BC=0000H になったとき HL=0000H だが未使用
    LD  A, B
    OR  C
    JR  NZ, CO_FF_CLEAR

    ; [4] カーソルを (0,0) へ
    XOR A
    LD  (CURSOR_X), A
    LD  (CURSOR_Y), A
    JR  CO_CURSOR_UPDATE



CO_BEL:
	; BEL (07H): 無視
	JR  CO_CURSOR_UPDATE        ; カーソル位置は変わらないが、更新しておく


    ;----------------------------------------------------------
    ; スクロール
    ; CURSOR_Y は 24 のまま。SCROLL_UP が最下行をクリアする。
    ;----------------------------------------------------------
CO_SCROLL:
    CALL SCROLL_UP
    ; fall through

    ;----------------------------------------------------------
    ; ハードウェアカーソル更新
    ; (X,Y) → VRAM アドレス → CURRENT_CURSOR_LOCATE → PRINT_CURSOR
    ;----------------------------------------------------------
CO_CURSOR_UPDATE:
    LD  A, (CURSOR_Y)
    LD  B, A
    LD  A, (CURSOR_X)
    LD  C, A
    CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = カーソル位置の VRAM アドレス
    LD  (CURRENT_CURSOR_LOCATE), HL
    CALL PRINT_CURSOR

    POP HL
    POP DE
    POP BC
    POP AF
    RET


;==============================================================
; PRINT_CURSOR
;
; カーソルをCURRENT_CURSOR_LOCATEの位置に表示する(HD46505Sの機能)
;
;==============================================================
PRINT_CURSOR:
	PUSH AF
	PUSH DE
	PUSH HL
	LD HL,(CURRENT_CURSOR_LOCATE) ; 現在のカーソル位置をHLにロード
	LD A,0EH ; R14 (cursor H)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,H
	OUT (CRTC_VALUE_PORT),A ; カーソルの上位アドレス設定
	LD A,0FH ; R15 (cursor L)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,L
	OUT (CRTC_VALUE_PORT),A ; カーソルの下位アドレス設定
	POP HL
	POP DE
	POP AF
	RET

;==============================================================
; STRING_OUT
;
; 文字列をヌル終端 (00H) まで連続して VRAM へ書き込む。
; 1文字ごとに WRITE_CHAR_AT_XY を呼ぶ。
;
; 入力:
;   B  = Y  論理行 (0-24)
;   C  = X  論理列 (0-79)  ※表示開始列
;   HL = 文字列先頭アドレス
;
; 出力: なし
; 破壊: A, DE, HL
;         (BC は WRITE_CHAR_AT_XY が保存するため変化なし)
;==============================================================
STRING_OUT:
    LD   A, (HL)            ; 次の文字を読み出す
    OR   A                  ; ヌル終端 (00H) か?
    RET  Z                  ; 00H なら終了

    PUSH HL                 ; 文字列ポインタを退避
							; (WRITE_CHAR_AT_XY は HL を破壊するため)
    CALL WRITE_CHAR_AT_X_Y  ; B=Y, C=X, A=文字 → VRAM へ書き込む
    POP  HL                 ; 文字列ポインタを復元

    INC  HL                 ; 次の文字へ
    INC  C                  ; X を +1 (次の列へ)
    JR   STRING_OUT
;==============================================================
; for CRT control
;==============================================================
;==============================================================
; データ領域 (CONOUT が使用)
;==============================================================
CURSOR_X:
    DB  0                   ; 現在のカーソル X 座標 (0-79)
CURSOR_Y:
    DB  0                   ; 現在のカーソル Y 座標 (0-24)
CURRENT_CURSOR_LOCATE:
    DW  F800H              ; カーソルの VRAM アドレス (PRINT_CURSOR が参照)



	ORG	2B00H

;===============
;エントリ
;===============


; DREAD:	JP	read_disk	;ディスク読み込み
DWRITE:	JP	write_disk	;ディスク書き込み
disk_unit_number:	DS	1	;0～


;===============
;サブルーチン
;===============


;DREAD本体
;入力	HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
;	[disk_unit_number]参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
read_disk:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	DRDSB	;ディスクから読み込みます
	POP	HL
	POP	DE
	POP	BC
	RET


;ディスクから読み込みます
;入力	HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
;	[disk_unit_number]参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，HL，DE，BC，AF'
DRDSB:
	LD	(SPBUFF),SP	;リターン･スタック･ポインタ
	;レコード番号より、トラック番号とセクタ番号を得ます。例えば、レコード番号50Hは第5トラックのセクタ1になる。
	;D←トラック番号、E←セクタ番号、Acc'←レコード数
	CALL	get_track_number_and_sector_number_from_record_number
	CALL	get_ready_to_access_disk	;ディスクをアクセス可能にします
	PUSH AF ; レコード数を退避
	PUSH BC
	PUSH DE
	PUSH HL
	CALL	RESTORE	;ディスク･ドライブをリストアします
	POP	HL
	POP	DE
	POP	BC
	POP	AF ; レコード数を復帰

	PUSH AF ; レコード数をスタックに入れる
	PUSH DE ; Eレジスタに入っているセクタ番号を退避する
	LD A, D 	;目的のシリンダ(トラック)番号をAレジスタにセット
	LD E, A 	;Eレジスタに目的のシリンダ(トラック)番号をセット
	CALL SEEK	;目的のシリンダ(トラック)へシークします

	; LD	A,5	;リトライ･カウンタ
	; DMA Bank Select
	XOR A ; A=0
	OUT (DMA_BANK_SEL), A
	POP DE ; 読み込み開始セクタを復帰
	POP AF ; レコード数をAレジスタに取り出す

	LD B,A ; Aレジスタのレコード数を読み込むセクタ数として、Bレジスタに設定
	LD C,E ; 読込を開始するセクタ番号をCレジスタに設定 セクタ番号は1以上の数

	; HLに読み込み先アドレスが格納されているので、DMAコマンドチェーンにそれを反映させるコードを書いて下さい。
	; dma_read_out_address_H に転送先アドレスの上位バイトが格納されていると仮定します。
	; Hレジスタの値を、 dma_read_out_address_H にセットします。
	PUSH AF
	LD A, H
	LD (dma_read_out_address_H),A
	LD A, L
	LD (dma_read_out_address_L),A
	POP AF

READ_FIRST_LOOP:
	CALL GO_DMA_AND_READ0 ; DMA転送と読み込みを開始します
	INC C ; 次のセクタ番号へ
	LD A,(dma_read_out_address_H) ; DMAコマンドチェーンの中の転送アドレスが書かれているアドレスを指定する。
	INC A ; 256 byte incriment
	LD (dma_read_out_address_H),A
	DJNZ READ_FIRST_LOOP

	; エラーハンドリングは後で書く
	; ノー･エラー

	RET

;DWRITE本体
;入力	HL←書き込みアドレス、DE←レコード番号、Acc←レコード数
;	[disk_unit_number]参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
write_disk:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	do_write_disk	;ディスクへ書き込みます
	POP	HL
	POP	DE
	POP	BC
	RET


;ディスクへ書き込みます
;入力	HL←書き込みアドレス、DE←レコード番号、Acc←レコード数
;	[disk_unit_number]参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，HL，DE，BC，AF'
do_write_disk:
	LD	(SPBUFF),SP	;リターン･スタック･ポインタ
	CALL	get_track_number_and_sector_number_from_record_number	;レコード番号より、トラック番号とセクタ番号を得ます
	CALL	get_ready_to_access_disk	;ディスクをアクセス可能にします
	PUSH AF ; レコード数を退避
	PUSH BC
	PUSH DE
	PUSH HL
	CALL	RESTORE	;ディスク･ドライブをリストアします
	POP	HL
	POP	DE
	POP	BC
	POP	AF ; レコード数を復帰

	PUSH AF ; レコード数をスタックに入れる
	PUSH DE ; Eレジスタに入っているセクタ番号を退避する
	LD A, D 	;目的のシリンダ(トラック)番号をAレジスタにセット
	LD E, A 	;Eレジスタに目的のシリンダ(トラック)番号をセット
	CALL SEEK	;目的のシリンダ(トラック)へシークします

	; LD	A,5	;リトライ･カウンタ
	; DMA Bank Select
	XOR A ; A=0
	OUT (DMA_BANK_SEL), A
	POP AF ; レコード数をAレジスタに取り出す

	LD B,A ; Aレジスタのレコード数を読み込むセクタ数として、Bレジスタに設定
	LD C,E ; 読込を開始するセクタ番号をCレジスタに設定
;

	; HLに読み込み先アドレスが格納されているので、DMAコマンドチェーンにそれを反映させるコードを書いて下さい。
	; dma_write_in_address_H に転送先アドレスの上位バイトが格納されていると仮定します。
	; Hレジスタの値を、 dma_write_in_address_H にセットします。
	PUSH AF
	LD A, H
	LD (dma_write_in_address_H),A
	LD A, L
	LD (dma_write_in_address_L),A
	POP AF

WRITE_FIRST_LOOP:
	CALL GO_DMA_AND_WRITE0 ; DMA転送と読み込みを開始します
	INC C ; 次のセクタ番号へ
	; HLに転送先アドレスが格納されているので、DMAコマンドチェーンにそれを反映させるコードを書くこと。
	LD A,(dma_write_in_address_H) ; DMAコマンドチェーンの中の転送アドレスが書かれているアドレスを指定する。
	INC A ; 256 byte incriment
	LD (dma_write_in_address_H),A
	DJNZ WRITE_FIRST_LOOP

	; エラーハンドリングは後で書く
	; ノー･エラー
	RET

;レコード番号より、トラック番号とセクタ番号を得ます
;入力	DE←レコード番号、Acc←レコード数
;	[disk_unit_number]参照
;出力	D←トラック番号、E←セクタ番号、Acc'←レコード数
;破壊	AF，DE，AF'

get_track_number_and_sector_number_from_record_number:
	PUSH HL
	LD	L,A		;L←レコード数
	EX	AF,AF'	;AF'
	LD	H,4 	;H A'←04H
	LD	A,0FFH	;H A'←04FFH
	DEC	L		;L←レコード数－1
	SUB	L		;H A'←04FFH－（レコード数－1）
	LD	L,A		;HL←0500H－レコード数
	OR	A
	SBC	HL,DE	;（0500H－レコード数）－レコード番号
	POP	HL
	JP	C,bad_sector_error
	LD	A,E 	; E←レコード番号下位バイト
RLLOP:
	RLCA  ; A←A×2
	RL	D ; D←D×2
	RLCA  ; A←A×2
	RL	D ; D←D×2
	RLCA  ; A←A×2
	RL	D ; D←D×2
	RLCA  ; A←A×2
	RL	D ;D←トラック番号
	LD	A,E ; A←レコード番号下位バイト
	AND	0FH ; A←レコード番号下位バイトの下位4ビット
	INC	A   ; A←セクタ番号
	LD	E,A	;E←セクタ番号
	EX	AF,AF' ; AF'
	RET


;ディスクをアクセス可能にします
;入力	D←トラック番号
;出力	D←シリンダ番号、[disk_unit_number b4]←サイド、B←0FH
;破壊	AF，BC
get_ready_to_access_disk:
	; 未実装。必要性？
	RET


;目的のシリンダへシークします（V1，20ms） '0msに改
;入力	D←シリンダ番号、B←0FH
;出力	なし
;破壊	AF，C
; notSEEK:
; 	LD	C,0FBH	;BC←0FFBH 'データ･レジスタ
; 	OUT	(C),D	;FDCデータ･レジスタ←シリンダ番号
; 	PUSH HL
; 	CALL get_cylinder_buffer_address	;シリンダ･バッファのアドレスを得ます
; 	LD	A,(HL)
; 	LD	C,0F9H	;BC←0FF9H 'トラック･レジスタ
; 	OUT	(C),A	;FDCシリンダ･レジスタ←現在シリンダ番号
; 	LD	(HL),D	;シリンダ･バッファの更新
; 	POP	HL
; 	LD	C,0F8H	;BC←0FF8H
; ;	LD	A,00011110B	;シーク（V1，20ms）
; 	LD	A,00011100B	;シーク（V1， 0ms）
; 	OUT	(C),A


;FDCレディ待ち
;出力	なし
;破壊	AF，BC
wait_for_FDC_ready:
	RET


;FDCをチェックします
;出力	B←0FH
;破壊	AF，BC
; とりあえず、必ず正常とする
check_FDC:
	RET		;FDCが正常動作



;8μs単位で待ちます
;入力	Acc←カウンタ
;出力	32×Acc＋10ts待ちます
;破壊	AF
wait_8usec:
;	1ループ32ts
	DEC	A	; 4ts
	LD	HL,(1234H)	;16ts
	JR	NZ,wait_8usec	;12ts
	RET		;10ts


;シリンダ･バッファのアドレスを得ます
;入力	[disk_unit_number b3～b0]←ユニット番号（0～3）
;出力	HL←対応するシリンダ･バッファのアドレス
;破壊	AF，HL
get_cylinder_buffer_address:
	LD	HL,DSKTRK	;シリンダ･バッファ
	PUSH	DE
	LD	A,(disk_unit_number)
	AND	00001111B ; ユニット番号抽出
	LD	E,A
	LD	D,0
	ADD	HL,DE
	POP	DE
	RET


;FDCにセクタ番号をセットして、FDCコマンドを実行します
;入力	E←セクタ番号、Acc←FDCコマンド、B←0FH
;出力	C←F8H
;破壊	AF，C
set_sector_number_and_execute_FDC_coomand:
	; レジスタEのセクタ番号をレジスタCにコピー。
	PUSH DE
	PUSH BC
	LD C,E
	LD A,C
	OUT (FDC_SECTOR_REG),A
;	31μs（124ts）待ちます
	LD	A,7	;7ts
J3:	DEC	A	;---ts
	JR	NZ,J3	;107ts
	POP BC
	POP DE
	RET		;10ts


;モータをオフします。SORD M23ではオフにする必要はないので何もしない。
;出力	CY＝0
fdd_motor_off:
	EI
	OR	A
	RET


;リストアして、目的のシリンダへシークします
;出力	D←シリンダ番号、B←0FH
;破壊	BC
restore_and_seek:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	CALL get_cylinder_buffer_address	;シリンダ･バッファのアドレスを得ます
	CALL RESTORE	;リストアします
	LD A, D
	LD E, A
	CALL SEEK	;目的のシリンダへシークします
	POP	DE
	POP	HL
	POP	AF
	RET


;セクタ番号のカウント･アップ
;入力	E←セクタ番号、D←シリンダ番号、B←0FH
;出力	CY＝1ならシリンダの更新が必要
;破壊	AF，DE，C
count_up_sector:
	INC	E
	LD	A,16
	CP	E
	RET	NC	;セクタ番号2～16

;	トラックのカウント･アップ
	LD	E,1
	PUSH	HL
	LD	HL,disk_unit_number
	LD	A,(HL)
	XOR	00010000B
	LD	(HL),A
	AND	00010000B
	JR	NZ,BFIOST	;サイド0へ
	INC	D	;シリンダ番号のカウント･アップ
	SCF
BFIOST:
	LD	C,0FCH	;BC←0FFCH
	LD	A,(HL)
	OUT	(C),A	;サイドの更新
	POP	HL
	RET




;
; FDC COMMAND OUT subroutine
;
FDCOUT:
	OUT (FDC_COMMAND_REG),A
	LD A,30H
WLOOP: DEC A
	JR NZ,WLOOP
LOOP2:
	IN A,(FDC_STATUS_REG)
	BIT 0H,A ; BUSY IS CLEAR?
	JR NZ,LOOP2
	RET
;
; RESTORE subroutine
;
RESTORE:
RESTORE_LOOP:
	LD A,0BH ; restore command. 15ms, Head load, Verify OFF
	CALL FDCOUT
	BIT 7,A ; Not Ready?
	JR NZ,RESTORE_LOOP
	AND 98H
	JR NZ,RESTORE
	RET
;
; SEEK subroutine
; E is Track No.
;
SEEK:
	LD A,E ; E is Track No.
	OUT (FDC_DATA_REG),A
	LD A,1BH  ; seek command. 15ms, Head Load, Verify OFF
	CALL FDCOUT
	AND 98H
	JR NZ,SEEK ; retry
	RET
;
; DMA setting & Go
; HL is Address of DMA Command chain
;		but top value is No of DMA Command chain
DMA_ON:
	PUSH HL
	PUSH BC
	LD B,(HL)
	INC HL
	LD C,DMA_ADDRESS
	OTIR
	POP BC
	POP HL
	RET
;
; DMA setting & FDD read FOR SIDE 0
; C is Sector No.
;
GO_DMA_AND_READ0:
	LD A,C
	OUT (FDC_SECTOR_REG),A
READ0_RETRY:
	LD HL,DMA_COMMANDS
	CALL DMA_ON
	LD A,80H ; READ DATA COMMAND for Side 0
DO_FDC0:
	CALL FDCOUT

	PUSH AF
	LD A,83H ; DMA STOP
	OUT (DMA_ADDRESS),A
	POP AF

	AND 03CH
	JR Z, READ0_SUCCESS
	JR READ0_RETRY
READ0_SUCCESS:
	RET
;
; DMA setting & FDD write FOR SIDE 0
; C is Sector No.
;
GO_DMA_AND_WRITE0:
	LD A,C
	OUT (FDC_SECTOR_REG),A
	LD HL,DMA_WRITE_COMMANDS
	CALL DMA_ON
	LD A,0A0H ; WRITE DATA COMMAND for Side 0
DO_FDC_WR0:
	CALL FDCOUT
	AND 0FCH
	RET


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; FDC 初期化ルーチン
;
FDC_INIT:
	LD A,51H
	LD (FDC_CONTROL_REG),A
	RET


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; DMA COMMAND CHAIN
;

DMA_COMMANDS:
	DB 15H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
	DB 0BBH,01H,0BFH
	DB 6DH
	DB 0C3H,0FFH,00H,2CH,010H,8DH
dma_read_out_address_L:	DB BUFFER.@L; DMAで読み込む先のバッファのアドレスL
dma_read_out_address_H:	DB BUFFER.@H ; DMAで読み込む先のバッファのアドレスH。これが256byte毎にインクリメントされる。
	DB 8AH
	DB 0CFH,87H
DMA_WRITE_COMMANDS:
	DB 16H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
	DB 83H ; STOP DMA
	DB 79H ; B->A
dma_write_in_address_L:	DB BUFFER.@L
dma_write_in_address_H:	DB BUFFER.@H  ; this address is buffer address !!!
	DB 00H,0FFH ; 256yte transfer
	DB 14H,28H,8DH
	DB 0C3H,00H ; FDC data register
	DB 8AH
	DB 0CFH,05H
	DB 0CFH,87H

;=======================
;エラー･ジャンプ
;=======================


bad_sector_error:	LD	A,5	;Bad Record
	DB	01H	;「LD BC,」
device_offline_error:	LD	A,2	;Device Offline
	DB	01H	;「LD BC,」
write_protect_error:	LD	A,4	;Write Protected
	DB	01H	;「LD BC,」
device_io_error:	LD	A,1	;Device I/O Error
	CALL	fdd_motor_off	;モータをオフします
	LD	SP,(SPBUFF)	;リターン･スタック･ポインタ
	SCF
	RET


;===============
;内部ワーク
;===============


DSERJP:	DS	2	;未使用
SPBUFF:	DS	2	;リターン･スタック･ポインタ
DSKTRK:	DS	4	;各ユニットのシリンダ･バッファ



;=======
;フラグ
;=======


COMF:	DS	1	;＝1で、RAMディスクへメモリ3000H～4BFFHの待避が行われた
BDEV:	DS	1	;バッチ･ファイルのあるデバイス
BTRK:	DS	1	;バッチ･ファイルの現在クラスタ番号
BREC:	DS	2	;バッチ･ファイルの現在レコード番号
BCNT:	DS	1	;バッチ･ファイルの現在クラスタの残りレコード数＋1
; BTPNT:	DW	BATBF	;下位はバッチ･ファイルのバッファの前回のリード位置
BTPNT2:	DS	2	;バッチ変数の現在アドレス
BATFLG:	DS	1	;＝FFH（0以外）でバッチ･ファイル実行中
PARAF:	DS	1	;＝1（0以外）でバッチ変数アクセス中
;AUTNAM:	DB	'A:AUTOEXEC.BAT'	;自動実行ファイル名
;	DS	4
AUTNAM:	DB	'AUTOEXEC.BAT',00H	;自動実行ファイル名（カレント･ドライブより）
	DS	5


;=======================
;S-OSワーク･エリア
;=======================


	ORG	1F5BH
_MXLIN:	DB	25	;1F5BH 画面の行数。SORD M23版では25。
_WIDTH:	DB	80	;1F5CH 画面の桁数。SOR M23版では80。
_DSK:	DB	'A'	;1F5DH アクセスしようとするデバイス名
_FATPS:	DW	000EH	;1F5EH FATのあるレコード番号。デフォルトは000Eh (トラック0セクタ15)。
_DIRPS:	DW	0010H	;1F60H ディレクトリの始まるレコード番号。デフォルトは0010h(1Dではトラック1セクタ1)。
_FATBF:	DW	2E00H	;1F62H '2E00H～2EFFH FATリード用バッファ(256Byte)の先頭アドレス。デフォルトは2E00h。
; _DTBUF:	DW	2F00H	;1F64H '2F00H～2FFFH ディスクリード用バッファ(256Byte)の先頭アドレス。デフォルトは2F00h。
_DTBUF:	DW	2F00H	;1F64H '2F00H～2FFFH ディスクリード用バッファ(256Byte)の先頭アドレス。デフォルトは2F00h。
_MXTRK:	DB	80	;1F66H 80トラック
_DIRNO:	DS	1	;1F67H _FCBで使用するワーク。何番目のファイルか。
_WKSIZ:	DW	0	;1F68H 256バイト単位 特殊ワークのサイズ。P6版では2800hがデフォルト。
_MEMAX:	DS	2	;1F6AH メモリの上限 	ユーザエリアの上限 (最終アドレス+1)。P6版ではD000hがデフォルト。
_STKAD:	DW	0F900H	;1F6CH '通常のスタック スタックの初期値。P6版ではF900hがデフォルト。
_EXADR:	DS	2	;1F6EH ファイルの実行アドレス。
_DTADR:	DS	2	;1F70H ファイルの先頭アドレス。
_SIZE:	DS	2	;1F72H ファイルサイズ。
_IBFAD:	DW	fcb_buffer	;1F74H ファイルのインフォメーションブロックの先頭アドレス。同時にファイル属性のアドレスでもある。
_KBFAD:	DW	keyboard_buffer	;1F76H キー入力に使えるバッファのアドレス。LD DE,(#KBFAD) CALL #GETLなどとする。P6版では内部ワークに81バイトの領域を確保してある。
_XYADR:	DW	display_cursor_XY_not_use	;1F78H 'ダミー カーソル座標が格納してあるアドレス。
_PRCNT:	DW	number_of_character_after_CR	;1F7AH '未使用 改行後に表示した文字数を格納してあるアドレス。
_LPSW:	DB	0	;1F7CH 0以外なら、表示ルーチンを呼ぶとプリンタにも出力する。
_DVSW:	DB	0	;1F7CH 'S-OS 2400bps 'ダミー テープフォーマット。0:共通 1:各機種 3:QD。P6版では1がデフォルト。
_USR:	DW	_HOT;1F7EH '通常_HOTが入ります コールドスタート後にジャンプするアドレス。デフォルトは#HOT。
;NEXT	1F82H


;===============================
;S-OSジャンプ･テーブル
;===============================
	ORG	1F80H
_GETPC:			POP HL		;1F80H
_HL:			JP	(HL)	;1F81H

	DS	3	;1F82H 'MSXでは「MBIOS」
	DS	3	;1F85H
	DS	3	;1F88H
; BPRNT:			JP	BPRNT0	;1F8BH

	ORG	1F8EH
_MON:			JP	MON		;1F8EH
_peek_entity:	JP	peek_entity	;1F91H
_PEEK:			JP	PEEK	;1F94H
_poke_entity:	JP	poke_entity	;1F97H
_POKE:			JP	POKE	;1F9AH
_FPRNT:			JP	print_file_name	;1F9DH
_FSAME:			JP	FSAME	;1FA0H
_FILE:			JP	FILE	;1FA3H
_RDD:			JP	RDD		;1FA6H
_FCB:			JP	GETFCB	;1FA9H 'MACE #RDI
_WRD:			JP	WRD		;1FACH
_WOPEN:			JP	WOPEN	;1FAFH 'MACE #WRI
_HLHEX:			JP	convert_4_digit_data_to_hex_binary_ascii_code	;1FB2H
_2HEX:			JP	convert_2_digit_data_to_hex_binary_ascii_code	;1FB5H
_HEX:			JP	convert_data_to_hex_binary_ascii_code		;1FB8H
_ASC:			JP	convert_data_to_ascii_code		;1FBBH
_print_hex_4_digit:			JP	print_hex_4_digit	;1FBEH
_print_hex_2_digit:			JP	print_hex_2_digit	;1FC1H
_BELL:			JP	BELL	;1FC4H
_PAUSE:			JP	PAUSE	;1FC7H
_INKEY:			JP	INKEY	;1FCAH
_BRKEY:			JP	check_break_key	;1FCDH
_GETKY:			JP	GETKY	;1FD0H
_GETL:			JP	GETL	;1FD3H
_LPTOF:			JP	LPTOF	;1FD6H
_LPTON:			JP	LPTON	;1FD9H
_LPRNT:			JP	LPRNT	;1FDCH
_TAB:			JP	TAB		;1FDFH
_MPRNT:			JP	print_string_from_next_call_address	;1FE2H
_MSX:			JP	print_string_until_00H_from_DE_register		;1FE5H
_MSG:			JP	print_string_pointed_by_DE_register	;1FE8H
_NL:			JP	carriage_return_if_not_at_head_of_line		;1FEBH
_LTNL:			JP	carriage_return_and_line_feed	;1FEEH
_PRNTS:			JP	print_space_character	;1FF1H
_PRINT:			JP	PRINT	;1FF4H
_VER:			JP	VER		;1FF7H 
_HOT:			JP	sos_monitor	;1FFAH SOSのモニタ
_COLD:			JP	COLD	;1FFDH
;	SWORDで拡張された部分
_DRDSB:			JP	sequential_sector_read_disk	;2000H
_DWTSB:			JP	sequential_sector_write_disk	;2003H
_DIR:			JP	DIR		;2006H
_ROPEN:			JP	ROPEN	;2009H
_SET:			JP	SETP	;200CH
_RESET:			JP	RESET	;200FH
_NAME:			JP	NAME	;2012H
_KILL:			JP	KILL	;2015H
_CSR:			JP	CSR		;2018H
_SCRN:			JP	SCRN	;201BH
_LOC:			JP	LOC		;201EH
_FLGET:			JP	FLGET	;2021H
_RDVSW:			JP	RDVSW	;2024H
_SDVSW:			JP	SDVSW	;2027H
_INP:			JP	INP		;202AH
_OUT:			JP	OUTP	;202DH
_WIDCH:			JP	WIDCH	;2030H
_ERROR:			JP	RSERR	;2033H
; Oh! MZ 1986/2に載っているのはここまで

_BOOT:			JP	BOOT	;2036H
;NEXT	2039H
GTPRC:			JP	get_logical_column	;2039H
LINCH:			JP	LINCH0	;203CH
;NEXT	203FH

;	204BH～20FEHはバッチ変数バッファ

	ORG	20FFH

;
; DOSモジュールの始まり
;
	ORG	2100H

;〈セーブ動作〉
;　「_FILE」「_WOPEN」「_WRD」の順で呼び出します。

;〈ロード動作〉
;　「_FILE」「_ROPEN」「_RDD」の順で呼び出します。


;===============
;モニタ処理
;===============


sos_monitor:
	LD	SP,(_STKAD)
	; CALL	_LPTOF ; SORD M23版では不要
	LD	A,'#' ; プロンプト表示
	CALL	PRINT
	LD	DE,(_KBFAD) ; 1行入力バッファのアドレスをDEにセット
	CALL	GETL ; キー入力を1行受け取ります
	CALL	sos_monitor_command_routine ; コマンド･ライン･ルーチン
	CALL	C,_ERROR
	JR	sos_monitor


;コマンド･ライン･ルーチン
;出力	CY＝1でエラー
sos_monitor_command_routine:
	LD	A,(DE) ; コマンド･ラインの最初の文字を取得
	; CP	'#'
	; JR	Z,$+4
	; OR	A
	; RET
;	INC	DE
;	LD	A,(DE)
;	INC	DE
	; CALL	sos_monitor_command_routine1 ; 小文字で入力されたときに大文字に変換する処理
	OR	A
	RET	Z ; 空行の場合はリターン
	CP	'!'
	JP	Z,_BOOT	;ブート
	CP	'J'
	JP	Z,JUMP	;ジャンプ
	CP	'L'
	JP	Z,LOAD	;ロード
	CP	'K'
	JP	Z,MKILL	;デリート
	CP	'N'
	JP	Z,MNAME	;リネーム
	CP	'M'
	JP	Z,DOSMON	;モニタ
	CP	'W'
	JP	Z,MWIDTH	;表示桁
	CP	'S'
	JR	Z,CMDSB1	;プロテクト（ST），セーブ（S）
	CP	'D'
	JR	Z,CMDSB2	;デフォルト･デバイス（DV），ディレクトリ（D）
	LD	A,13	;Syntax Error
	SCF
	RET
	; JP	execute_expanded_command
	; DS	1


;モニタ Sxコマンド処理
CMDSB1:
	LD	A,(DE)
	; CALL	convert_lower_case_to_upper_case	;小文字→大文字変換
	INC	DE
	CP	'T'
	JP	Z,MSET	;モニタ STコマンド処理
	DEC	DE
	JP	SAVE	;モニタ Sコマンド処理


;モニタ Dxコマンド処理
CMDSB2:
	LD	A,(DE)
	; CALL	convert_lower_case_to_upper_case	;小文字→大文字変換
	INC	DE
	CP	'V'
	JP	Z,DEVST	;モニタ DVコマンド処理
	DEC	DE
	JP	MDIR	;モニタ Dコマンド処理 ディレクトリ表示


;モニタ Jコマンド処理
JUMP:
	INC DE
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	LD	A,13	;Syntax Error
	RET	C
;	6バイト
	; IF	0
	; EX	DE,HL
	; LD	HL,sos_monitor
	; EX	(SP),HL
	; EX	DE,HL
	; JP	(HL)
	; ENDIF
;	DE保存のための改定
	EX	(SP),HL	;スタック←ジャンプ先
	LD	HL,sos_monitor
	EX	(SP),HL	;スタック←sos_monitor，HL←ジャンプ先
	JP	(HL)
	DS	1


;モニタ Mコマンド処理
DOSMON:	JP	_MON


;モニタ Dコマンド処理
MDIR:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	CALL	GETDEV	;文字列からデバイス名を得ます
	LD	(_DSK),A
	CALL	DIR
	RET


;モニタ Sコマンド処理
SAVE:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	LD	A,1
	CALL	_FILE
	LD	A,(DE)
	CP	':'
	JR	NZ,SNERR
	INC	DE

	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	JR	C,SNERR
	LD	(_DTADR),HL	;先頭アドレス
	LD	(_EXADR),HL	;仮実行アドレス
	INC	DE	;「:」をスキップ

	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	JR	C,SNERR
	PUSH	DE
	LD	DE,(_DTADR)
	OR	A
	SBC	HL,DE
	POP	DE
	JR	C,SNERR
	INC	HL
	LD	(_SIZE),HL	;サイズ
	INC	DE	;「:」などをスキップ

;	実行アドレスが指定されているときだけ
	CALL	convert_4_digit_data_to_hex_binary_ascii_code
	JR	C,SAVE1
	LD	(_EXADR),HL	;実行アドレス

SAVE1:
	CALL	_WOPEN
	RET	C	;エラー
	CALL	_WRD
	RET	C
	CALL	carriage_return_if_not_at_head_of_line
	LD	DE,OK
	CALL	print_string_pointed_by_DE_register
	JP	carriage_return_if_not_at_head_of_line
SNERR:
	LD	A,13	;Syntax Error
	SCF
	RET


;モニタ Lコマンド処理
LOAD:
	LD A,1
	CALL FILE
	LD A,(DE)
	OR A
	LD (LDWORK+2),A	;ロード･アドレス存在フラグ
	; JR Z,LOAD1	;ロード･アドレスの指定なし
	JR Z,SNERR	;ロード･アドレスの指定なし
;	ロード･アドレスの指定あり
	INC	DE
	CALL convert_4_digit_data_to_hex_binary_ascii_code
	JR C,SNERR	;ロード･アドレスが不正
	LD (LDWORK),HL	;←ロード･アドレス

LOAD1:
	CALL ROPEN ;ディスクではファイルの存在のチェック。
	RET	C ;エラー
	; CALL NZ,SKPRT	;テープのスキップしているファイル名を表示します
	; JR NZ, LOAD1

	CALL print_string_from_next_call_address
	DB	'Loading ',00H
	CALL print_file_name
	CALL carriage_return_if_not_at_head_of_line

;	ロード･アドレスの設定
	LD	A,(LDWORK+2) ; ロードアドレスフラグをセット
	OR	A ; ロードアドレスフラグ=0ならロードアドレス無効
	JR	Z,LOAD3
	LD	HL,(LDWORK)
	LD	(_DTADR),HL ; 1F70H ファイルの先頭アドレスが格納される。

;	ロードします
LOAD3:	JP	RDD

LDWORK:	DS	2	;ロード･アドレス
	DS	1	;ロード･アドレス･フラグ（＝0でロード･アドレスが無効）


;テープのスキップしているファイル名を表示します
;破壊	DE
SKPRT:
	PUSH	AF
	CALL	print_string_from_next_call_address
	DB	'Found   ',00H
	CALL	print_file_name
	CALL	carriage_return_if_not_at_head_of_line
	POP	AF
	RET


;モニタ Kコマンド処理
MKILL:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	CALL	_FILE
	RET	C	;エラー
	CALL	_KILL
	RET


;モニタ STコマンド処理
MSET:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	CALL	_FILE
	INC	DE
;	CALL	skip_space_characters	;文字列の空白を読み飛ばします
;	LD	A,(DE)
	CALL	MSET1	;小文字受け付けのため
	NOP
	CP	'P'
	JP	Z,_SET
	CP	'R'
	JP	Z,_RESET
;	パラメータが「P」でも「R」でもない
	LD	A,13	;Syntax Error
	SCF
	RET


;モニタ DVコマンド処理
DEVST:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	LD	A,(DE)
	CALL	convert_lower_case_to_upper_case	;小文字→大文字変換
	CALL	_DVCHK	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	JR	NC,DEVST1
	LD	A,3	;Bad File Descripter
	RET
DEVST1:	LD	(_DSK),A
	JP	_SDVSW


;モニタ Nコマンド処理
MNAME:
	CALL skip_space_characters	;文字列の空白を読み飛ばします
	CALL _FILE
	LD A,(DE)
	INC	DE
	CP ':'
	JP Z,_NAME
	LD A,13	;Syntax Error
	SCF
	RET


;モニタ Wコマンド処理
;注：80桁モード以外なら40桁モードにしています。
MWIDTH:
	JP	_WIDCH


;文字列の空白を読み飛ばします
;入力	DE←文字列の先頭アドレス
;出力	DE←カウント･アップ
;破壊	AF，DE
	INC	DE
skip_space_characters:
	LD	A,(DE)
	CP	' '
	JR	Z,skip_space_characters-1 ; INC	DEに戻る
	RET


;=======================================
;拡張されたS-OSファンクション本体
;=======================================

;文字列からデバイス名を得ます
;入力	DE←文字列のアドレス
;出力	Acc←デバイス名、DE←カウント･アップ
;破壊	AF，DE
;注：
;　小文字は大文字に変換されます。
;　デバイス名が省略された場合、デフォルト･デバイスが採用されます。
GETDEV:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
;	INC	DE
;	LD	A,(DE)	;Acc←2文字目
;	DEC	DE
	CALL	GDVPAT	;GETDEVのバグ回避
	CP	':'
	JR	Z,$+5
	JP	RDVSW	;＝#RDVSW（2024H）

	LD	A,(DE)
	INC	DE
	INC	DE

	CALL 	convert_lower_case_to_upper_case	;小文字→大文字変換
	RET


;#WOPEN（1FAFH）の本体
;注：
;　仕様と違いAF'が破壊されます。
;　テープではインフォメーション･ファイルを書き込み、
; ディスクでは空きエリアをチェックします。
;　正常終了CY＝0（Acc←0）。
WOPEN:
	CALL	CLOSE	;[_OPNFG]←0
	LD	A,(_DSK)
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;エラー
	JP	Z,_WRI	;カセットにインフォメーション･ファイルをセーブします

;	テープ以外
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	JR	NC, WOPEN1
	RET		;エラー（テープ，ディスク以外）

WOPEN1:
	CALL	FATRED	;FATを読みます
	RET	C	;エラー
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	JR	NZ,WOPEN2

;	同じファイル名のファイルがあった
	LD	A,(HL)
	CALL	check_write_protect	;ファイルのライト･プロテクトのチェック
	RET	C	;エラー
	CALL	FMCHK	;属性をチェックします
	RET	C	;エラー
;
	PUSH	HL
	LD	BC,30
	ADD	HL,BC
	LD	A,(HL)	;Acc←ファイルの開始クラスタ
	POP	HL
	CALL	ERAFAT	;FATバッファから指定のクラスタ･チェインをカットします
	RET	C	;エラー
	JR	WOPEN3

;	同じファイル名のファイルがなかった
WOPEN2:
	CALL	FRESCH	;ディスクに空きエリアがあるかチェックします
	LD	A,9	;Bad Record
	RET	C	;エラー

WOPEN3:
	LD	(DEBUF),DE	;アクセスするレコード番号の一時保存場所
	LD	(HLBUF),HL	;参照FCBのアドレスの一時保存場所
	CALL	_PARCS	;S-OSのカセットのアドレス情報を、機種依存のワークに転送します
	CALL	OPEN	;[_OPNFG]←1
	XOR	A	;CY←0，Acc←0
	RET


;#ROPEN（2009H）の本体
;注：
;　仕様と違いAF'が破壊されます。
;　テープではインフォメーション･ファイルの読み込み、
;ディスクではファイルの存在のチェック。
;　正常終了CY＝0（Acc←0）。
ROPEN:
	CALL	CLOSE	;[_OPNFG]←0
	LD	A,(_DSK)
	; CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	; RET	C	;エラー
	; JP	Z,_TROPN	;テープのリード･オープン

;	テープ以外
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	JR	NC,ROPEN1
	RET		;エラー（テープ，ディスク以外）

;	ディスクの場合
ROPEN1:
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	RET	C	;エラー
	LD	A,8	;File not Found
	SCF
	RET	NZ	;エラー（ファイルが見つからなかった）

;	一致したFCBを、FCBバッファに転送します
	PUSH	HL
	LD	DE,(_IBFAD)
	LD	BC,32
	LDIR
	POP	HL

;	属性を比較します
	LD	A,(HL)
	CALL	FMCHK	;属性をチェックします
	RET	C	;エラー

;	アドレス情報の転送など
ROPEN2:
	CALL	_PARSC	;機種依存のカセットのアドレス情報を、S-OSのワークに転送します
	CALL	OPEN	;[_OPNFG]←1
	XOR	A	;CY←0，Acc←0
	RET


;#WRD（1FACH）の本体
;注：
;　仕様と違いAF'が破壊されます。
;　正常終了CY＝0（Acc←0）。
WRD:
	LD	A,(_DSK)
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;エラー
	JP	Z,_TWRD	;カセットにデータ･ファイルをセーブします

;	テープ以外
	LD	A,(_OPNFG)
	OR	A
	JR	NZ,WRD1
	SCF
	LD	A,12	;File not Open
	RET		;オープンされてなかった
WRD1:
	CALL	CLOSE	;[_OPNFG]←0
	LD	A,(_DSK)
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C	;エラー（テープ，ディスク以外）

;	ディスクの場合
	CALL	DSAVE	;ディスクにファイルを書き込みます
	RET


;#RDD（1FA6H）の本体
;注：
;　仕様と違いAF'が破壊されます。
;　正常終了CY＝0（Acc←0）。
;　[_DIRNO]、[RETPOI]をクリアします。
RDD:
	LD	A,(_DSK)
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;エラー
	JP	Z,_TRDD	;カセットのデータ･ファイルをロードします

;	テープ以外
	XOR	A
	LD	(_DIRNO),A	;クローズ処理
	LD	(RETPOI),A	;以前正しいFCBがロードされたかのフラグ
	LD	A,(_OPNFG)
	OR	A
	JR	NZ, RDD1
	SCF
	LD	A,12	;File not Open
	RET		;オープンされてなかった
RDD1:
	CALL	CLOSE	;[_OPNFG]←0
	LD	A,(_DSK)
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C	;エラー（テープ，ディスク以外）

;	ディスクの場合
	CALL	FATRED	;FATを読みます
	RET	C	;エラー
	CALL	DLOAD	;ディスクからファイルを読み込みます
	RET


;#FCB（1FA9H）の本体
;〈解説〉
;　ESCキーが押されていれば、CY＝1（Acc←8）で戻ります
;（[_DIRNO]はクリア）。
;　RETキーが押されていれば、[_DIRNO]をカウント･ダウン
;（以前正しくロードされたFCB）。
;注：
;　仕様と違いAF'が破壊されます。
;　ファイルのオープンと同等。
;　正常終了CY＝0（Acc←0）。
GETFCB:
	CALL	CLOSE	;[_OPNFG]←0
	LD	A,(_DSK)
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;エラー
	JR	NZ,GETFC1	;テープ以外

;	テープの場合
	CALL	TRDVSW	;#DVSWからテープのデバイス名を求めます
	LD	(_DSK),A
	JP	_RDI	;カセットのインフォメーション･ファイルをロードします

;	テープ以外
GETFC1:
	CALL	_GETKY
	CP	1BH	;ESC
	JP	Z,DEND	;[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン
	CP	0DH	;RET
	JR	NZ,GETFC2

;	RETキーが押された場合
	LD	A,(RETPOI)	;以前正しいFCBがロードされたかのフラグ
	OR	A
	JR	NZ,DECPOI	;[_DIRNO]をカウント･ダウンして、[RETPOI]をクリアしてエラーNo.8でリターン

;	[_DIRNO]に対応するレコードを読み込みます
GETFC2:
	LD	A,(_DIRNO)
	LD	C,A	;C←[_DIRNO]
	LD	B,3
SFR41:
	SRL	A	;Acc←[_DIRNO]÷8
	DJNZ	SFR41
	LD	HL,(_DIRPS)
	LD	D,0
	LD	E,A	;DE←[_DIRNO]÷8
	ADD	HL,DE
	EX	DE,HL	;DE←[_DIRNO]に対応するFCBが存在するディスクのレコード番号
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	JR	C,ERRRET	;[_DIRNO]と[RETPOI]をクリア（AF保存）

;	有効なFCBかチェック
	LD	A,C	;Acc←[_DIRNO]
	AND	00000111B
	LD	B,5
SFL51:
	ADD	A,A	;Acc←[_DIRNO]の下位3ビット×32
	DJNZ	SFL51
	LD	HL,(_DTBUF)
	ADD	A,L
	LD	L,A
	JR	NC,$+3
	INC	H	;HL←[_DTBUF]＋[_DIRNO]の下位3ビット×32
	LD	A,(HL)	;Acc←[_DIRNO]に対応するFCBの属性
	OR	A
	JR	Z,NEXT1	;未使用FCB
	CP	0FFH	;最後のFCBを通過したか
	JR	Z,DEND	;[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン

	LD	DE,(_IBFAD)
	LD	BC,32
	LDIR
	CALL	INCPOI	;[_DIRNO]をカウント･アップして、[RETPOI]に[_DIRNO]をコピーします
	JP	ROPEN2	;アドレス情報の転送など

;	未使用FCBだった
NEXT1:
	CALL	INCPOI	;[_DIRNO]をカウント･アップして、[RETPOI]に[_DIRNO]をコピーします
	JR	NC,GETFC1
	RET


;[_DIRNO]をカウント･アップして、[RETPOI]に[_DIRNO]をコピーします
;入力	なし
;出力	CY＝1なら、[_MXTRK]に達した、
;	[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン
;破壊	AF，HL
INCPOI:
	LD	HL,_DIRNO
	INC	(HL)
	LD	A,(HL)
	LD	HL,_MXTRK
	CP	(HL)
	JR	Z,DEND	;[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン
	LD	(RETPOI),A
	OR	A
	RET


;[_DIRNO]と[RETPOI]をクリア（AF保存）
;入力	なし
;出力	[_DIRNO]←0、[RETPOI]←0
;破壊	なし
ERRRET:
	PUSH	AF
	CALL	DEND	;[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン
	POP	AF
	RET


;[_DIRNO]をカウント･ダウンして、[RETPOI]をクリアしてエラーNo.8でリターン
;入力	なし
;出力	[_DIRNO]をカウント･ダウン、[RETPOI]←0
;破壊	AF，HL
DECPOI:
	LD	HL,_DIRNO
	LD	A,(HL)
	OR	A
	JR	Z,$+3
	DEC	(HL)
	XOR	A
	JR	DEND1


;[_DIRNO]と[RETPOI]をクリアしてエラーNo.8でリターン
;入力	なし
;出力	[_DIRNO]←0、[RETPOI]←0
;破壊	AF
DEND:
	XOR	A
	LD	(_DIRNO),A
DEND1:
	LD	(RETPOI),A
	LD	A,8	;File not Found
	SCF
	RET

;注：
;　00H以外で、以前に正しいFCBがロードされたことをあらわします。
;　#RDDを実行すると、クリアされます。
RETPOI:	DB	0	;以前正しいFCBがロードされたかのフラグ


;#DIR（2006H）の本体
; ディレクトリを表示します
;注：仕様と違いAF'が破壊されます。
DIR:
	LD	A,(_DSK)
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;正しくなかった
	JP	Z,_TDIR	;テープのディレクトリを表示します

;	テープ以外
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C	;エラー（テープ，ディスク以外）

;	ディスク
	CALL	FATRED	; FATを読みます FATBFに読み込みます
	RET	C	;エラー
	LD	A,'$'
	CALL	PRINT
	CALL	FRECLU	;空きクラスタ数を得ます
	CALL	print_hex_2_digit
	LD	DE,cluster_free_message	;「 Clusters Free」
	CALL	print_string_until_00H_from_DE_register
	LD	B,16
	LD	DE,(_DIRPS)

DIRL:
	LD	HL,(_DTBUF) ; ディスクリードバッファ
	LD	A,1
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	RET	C	;エラー
	CALL	DIRPRT	;ディレクトリを1セクタ分表示します
	RET	Z
	INC	DE
	DJNZ	DIRL

	XOR	A
	RET


;ディレクトリを1セクタ分表示します
;入力	HL←ディレクトリのアドレス（256バイト)
;出力	ZF＝1ならブレイクされた
;破壊	AF，HL
DIRPRT:
	PUSH BC
	PUSH DE
	LD B,8

DIRPL:
	LD A,(HL)
	OR A	;＝00Hで未使用
	JR Z,DIRN
	CP FFH	;＝FFHで未使用領域
	JR Z,DIRPE
	CALL print_file_information ;ファイル情報を表示します
	CALL carriage_return_and_line_feed
	CALL PAUSE
	DW	DIRPE
DIRN:
	LD	DE,20H
	ADD	HL,DE
	DJNZ DIRPL
	DB	3EH
DIRPE:
	XOR	A
	POP	DE
	POP	BC
	OR	A
	RET


;#KILL（2015H）の本体
;注：仕様と違いAF'が破壊されます。
KILL:
	LD	A,(_DSK)
	CALL	ALCHK	;デバイス名がFDかチェックします
	RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C

;	FATを読みます
	CALL	FATRED	;FATを読みます
	RET	C

;	ファイル名を検索
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	RET	C
	LD	A,8	;File not Found
	SCF
	RET	NZ	;ファイルが見つからない
	LD	A,(HL)
	CALL	check_write_protect	;ファイルのライト･プロテクトのチェック
	RET	C	;エラー

;	ディレクトリ･バッファとFATバッファを書き換えます
	LD	(HL),0	;未使用をあらわします
	PUSH	HL
	LD	BC,30
	ADD	HL,BC
	LD	A,(HL)	;Acc←ファイルの開始クラスタ
	POP	HL
	CALL	ERAFAT	;FATバッファから指定のクラスタ･チェインをカットします
	RET	C	;エラー

;	ディスクを書き換えます（先にディレクトリを）
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	CALL	NC,FATWRT	;FATを書き込みます
	RET


;#NAME（2012H）の本体
;注：仕様と違いAF'が破壊されます。
NAME:
	LD	A,(_DSK)
	CALL	ALCHK	;デバイス名がFDかチェックします
	RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C

;	変更前のファイル名を検索
	PUSH	DE
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	LD	(DEBUF),DE	;アクセスするレコード番号の一時保存場所
	LD	(HLBUF),HL	;参照FCBのアドレスの一時保存場所
	POP	DE
	RET	C	;エラー
	LD	A,8	;File not Found
	SCF
	RET	NZ	;ファイルが見つからない
	LD	A,(HL)
	CALL	check_write_protect	;ファイルのライト･プロテクトのチェック
	RET	C	;エラー

;	変更後のファイル名を検索
	LD	A,(_DSK)
	PUSH	AF
	CALL	_FILE
	POP	AF
	LD	(_DSK),A
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	RET	C	;エラー
	LD	A,10	;File Already Exists
	SCF
	RET	Z	;変更しようとしたファイル名が既に存在した

;	ディレクトリを再読み込み（変更後のファイル名検索で、バッファ破壊のため）
	LD	DE,(DEBUF)	;アクセスするレコード番号の一時保存場所
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	RET	C	;エラー

;	ディレクトリ･バッファのファイル名を変更します
	LD	HL,(_IBFAD)
	INC	HL
	LD	DE,(HLBUF)	;参照FCBのアドレスの一時保存場所
	INC	DE
	LD	BC,17
	LDIR

	LD	DE,(DEBUF)	;アクセスするレコード番号の一時保存場所
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	RET


;#SET（200CH）の本体
;注：仕様と違いAF'が破壊されます。
SETP:
	LD	A,(_DSK)
	CALL	ALCHK	;デバイス名がFDかチェックします
	RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C

;	ファイル名を検索
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	RET	C
	LD	A,8	;File not Found
	SCF
	RET	NZ	;ファイルが見つからない

;	ディレクトリ･バッファを書き換えます
	SET	6,(HL)	;属性b6←1

;	ディレクトリを書き換えます
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	RET


;#RESET（200FH）の本体
;注：仕様と違いAF'が破壊されます。
RESET:
	LD	A,(_DSK)
	CALL	ALCHK	;デバイス名がFDかチェックします
	RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C

;	ファイル名を検索
	CALL	FCBSCH	;ファイルを検索します（属性は無視）
	RET	C
	LD	A,8	;File not Found
	SCF
	RET	NZ	;ファイルが見つからない

;	ディレクトリ･バッファを書き換えます
	RES	6,(HL)	;属性b6←0

;	ディレクトリを書き換えます
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	RET


;#DRDSB（2000H）の本体
;入力	HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
;出力	CY＝0(Acc←0)なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
; 連続セクタリード
sequential_sector_read_disk:
	EX	AF,AF'	;AF'
	LD	A,(_DSK) ; デバイス名取得
	; CALL	ALCHK	;デバイス名がFDかチェックします
	; RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C ; エラー
	SUB	'A' ; ユニット番号計算
	LD	(disk_unit_number),A	;ディスクのユニット番号（0～）
	EX	AF,AF' ; AF'
	PUSH AF
	PUSH HL
	; HLのHを、dma_read_out_address_Hにセットして、Lを、dma_read_out_address_Lにセット
	LD	A,H
	LD	(dma_read_out_address_H),A
	LD	A,L
	LD	(dma_read_out_address_L),A
	POP HL
	POP AF
	CALL	read_disk	;ディスク読み込み
	RET


;#DWRSB（2003H）の本体
;入力	HL←書き込みアドレス、DE←レコード番号、Acc←レコード数
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
sequential_sector_write_disk:
	EX	AF,AF'	;AF'
	LD	A,(_DSK)
	CALL	ALCHK	;デバイス名がFDかチェックします
	RET	C
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET	C
	SUB	'A'
	LD	(disk_unit_number),A	;ディスクのユニット番号（0～）
	EX	AF,AF' ; AF'
	CALL	DWRITE	;ディスク書き込み
	RET


;[_OPNFG]←1
;入力	なし
;出力	[_OPNFG]←1
;破壊	なし
OPEN:
	PUSH	AF
	LD	A,1
	JR	CLOSE1


;[_OPNFG]←0
;入力	なし
;出力	[_OPNFG]←0
;破壊	なし
CLOSE:
	PUSH	AF
	XOR	A
CLOSE1:	LD	(_OPNFG),A
	POP	AF
	RET


;ファイルのライト･プロテクトのチェック
;入力	Acc←属性（b6）
;出力	CY＝1ならライト･プロテクト（Acc←4）
;破壊	F，（AF）
check_write_protect:
	OR	A	;CY←0
	BIT	6,A
	RET	Z
	LD	A,4	;Write Protected
	SCF
	RET


;属性をチェックします
;入力	Acc←属性（b7b2b1b0）
;	[_FTYPE]参照
;出力	CY＝1（Acc←6）なら一致しない
;破壊	AF
FMCHK:
	PUSH	HL
	AND	10000111B
	LD	HL,_FTYPE
	CP	(HL)
	POP	HL
	RET	Z
	LD	A,6	;Bad File Mode
	SCF
	RET


;デバイス名がFDかチェックします
;入力	Acc←デバイス名
;出力	CY＝1ならFDでない
;破壊	F（AF）
check_FD_device_name:
	CP	'A'
	JR	C,DSKCH1
;	CP	'D'+1
	CP	'E'+1	;RAMディスク対応のための改定
	CCF
	RET	NC
DSKCH1:
	LD	A,11	;Reserved Feature
	RET


;デバイス名がFDかチェックします
;入力	Acc←デバイス名
;出力	CY＝1ならFDでない
;破壊	F（AF）
;注：デバイス名が不正なら、Acc←エラー･コード。
ALCHK:
	CALL	check_device_name	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C
	CALL	check_tape_device_name	;デバイス名がテープ（QD）かチェックします
	JR	NZ,$+6
	LD	A,3	;Bad File Descripter
	SCF
	RET
	CALL	check_FD_device_name	;デバイス名がFDかチェックします
	RET


;#RDVSW（2024H）の本体
RDVSW:
	LD	A,(_DFDV)	;デフォルト･デバイス
	CALL	check_tape_device_name	;デバイス名がテープ（QD）かチェックします
	RET	NZ	;テープ以外ならそのままリターン


;#DVSWからテープのデバイス名を求めます
;入力	なし
;出力	Acc←テープのデバイス名
;破壊	AF
TRDVSW:
	LD	A,(_DVSW)
	OR	A
	JR	NZ,$+4
	LD	A,'T'	;テープ 
	CP	1
	JR	NZ,$+4
	LD	A,'S'	;システム依存
	CP	3
	JR	NZ,$+4
	LD	A,'Q'	;QD
	RET


;#SDVSW（25C9H）の本体
SDVSW:
	PUSH	AF
	LD	(_DFDV),A	;デフォルト･デバイス
	CP	'T'	;0
	JR	NZ,$+3
	XOR	A
	CP	'S'	;1
	JR	NZ,$+4
	LD	A,1
	CP	'Q'	;3
	JR	NZ,$+4
	LD	A,3
	LD	(_DVSW),A
	POP	AF
	RET


;ディスクからファイルを読み込みます
;入力	[_IBFAD]～,[_FATBF]～etc参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，HL，DE，BC，AF'
; ---------------------------------
; S-OSのFATは、ファイルが存在するトラックの情報が格納されている。FATの1バイトが1つのトラックを指している。
; よって、SORD M23は80トラックなので、FATは80バイトで構成される。先頭は、システムにかかわるファイルの情報が格納されている。
; 例えば、FATの最初の16バイトが以下のようであったとする。先頭の01 8fは、ブートローダーがトラック1とトラック2に存在し、トラック2のセクタ15までを占有していることを示している。
; 次の3バイト「03 04 8e」は、S-OS本体がトラック3からトラック5まで存在し、トラック5のセクタ14までを占有していることを示している。
; 01 8f 03 04 8e 06 8d 08 83 0a 8a 0c 0d 85 00 00
; この様に、FATには1つのファイルが占有しているトラックとセクタの情報が格納されている。注意すべき点は、FATにはファイル名のような個々のファイルを識別をする情報は含まれていないことである。
; それらの情報はFCB(File control block)に格納されている。FATは、ファイルの物理的な配置を示す役割を果たしている。
; FCBはディレクトリトラックに格納されている。
; 例えば、ディレクトリトラックのデフォルトである、トラック1セクタ1のダンプが以下のようであったとする。
; +000: 01 4c 20 20 20 20 20 20 20 20 20 20 20 20 4f 42
; +010: 4a 20 00 1e 00 30 00 30 26 13 21 21 22 00 05 00
; 先頭の1バイトは属性を示しており、次の16バイトはファイル名を示している。この場合、"L          OBJ"というファイル名である。
; その次の1バイトはパスワード(パスワードなしは20H)、その次の2バイトはファイルのサイズ、その次の2バイトは読み出しアドレス、
; その次の2バイトは実行開始アドレス、次の6バイトは日付、最後の2バイトが開始クラスタである。
; 開始クラスタの2バイトは、上記の例では、「05 00」となっていて、これは、ファイル「L.OBJ」が第5トラックのセクタ1から始まっていることを示している。
; ディスクからのロードで必要な情報は、開始クラスタ、サイズ、読み出しアドレスである。
; これらの情報を基に、FATを参照して、ファイルが存在するトラックとセクタを特定し、順次読み出しを行う。
; ---------------------------------
; 読み出し手順は、1.FATを読む、2.FCBを読む、これで読み出すべくトラックとセクタが判明する。
; 3.この情報を用いて、目標トラックと目標セクタをセットして、ディスクをリードすればよい。

; ファイルの終末部分のFATには、最上位ビットが1になっている。つまり常に80H以上の値が入っている。下位4ビットに読み込むべきセクタ数-1が書かれている。
; 例えば、FATのある値が「8e」なら、該当のトラック番号を14+1=15セクタ読めばよいということになる。
; 書くべきコードは、まず、(HL)のHにおける最上位ビットが1であるか否かを判定する。Hの最上位ビットが0の場合、DEの値が最初に読むべきトラック番号であることがわかり、
; かつ、読むべきセクタは全セクタ、SORD M23では16セクタであることがわかる。この情報があれば、あとは、ファイルの先頭アドレス_DTADRzをセットして、16セクタ分読み込めばよい。
; (HL)のHにおける最上位ビットが1の場合、読み込み対象となっているファイルは終端に達していることがわかる。(HL)の下位バイトLが読み込むべきセクタ数nを指しているので、
; 1~nセクタまでを読めばよい。 

DLOAD:
	LD	HL,(_IBFAD)
	LD	BC,30 ; FCBのオフセット
	ADD	HL,BC
	LD	A,(HL)	;Acc←ファイルの開始トラック番号
	LD	(NXCLST),A	;アクセスするクラスタの一時保存場所
	LD	BC,(_SIZE);1F72H ファイルサイズ。
	LD	HL,(_DTADR);1F70H ファイルの先頭アドレス。

;	ロード･ループ
DLOAD1:
	PUSH	HL
	LD	A,(NXCLST)	;アクセスするクラスタの一時保存場所
	LD	HL,(_FATBF);1F62H '2E00H～2EFFH FATリード用バッファ(256Byte)の先頭アドレス。デフォルトは2E00h。
	LD	E,A ; ファイルの開始トラック番号
	LD	D,0	;DE←アクセスするトラック番号
	ADD	HL,DE	;HL←FATバッファのアクセスするクラスタ(トラック番号)の位置
	LD	A,(HL)	;次のクラスタへのチェイン情報 次のクラスタ(トラック番号)がどこか書いてある。
	LD	(NXCLST),A	;次にアクセスするクラスタ(トラック番号)の一時保存場所
	EX	DE,HL ; トラック番号から、レコード番号へ変換
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	EX	DE,HL	;DE←アクセスするレコード位置（空きクラスタ番号×16）
	POP	HL	;HL←[_DTADR]
	OR	A
	JR	Z,DLOAD2	;FATが不正
	CP	80H
	JR	NC,DLOAD3	;最後のクラスタ
	LD	A,16	;4Kバイト読み込みます
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	RET	C	;エラー
	LD	DE,1000H ;1000Hバイト = 4kバイト
	ADD	HL,DE	;ディスクから読み込んだデータを書き込むアドレスを4kバイト分カウント･アップする。
	PUSH	HL
	LD	L,C
	LD	H,B
	OR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H	;4kバイト読んだので、その分読み込むべきサイズを引き算しておく。FATがあるのでこの処理はいらないのでは？
	POP	HL	;HL←次のメモリ
	JR	NC,DLOAD1

;	エラー
DLOAD2:
	LD	A,7	;Bad Allocation Tableのエラー･コード
	SCF
	RET

;	最後のクラスタ。ファイルの終端になり、余ったセクタを読み込む処理
DLOAD3:
	SUB	7FH	;Acc←読み込みセクタ数
	CP	16+1
	JR	NC, DLOAD2	;FATが不正
	DEC	A	;Acc←読み込みセクタ数－1（0～15）
	DEC	BC	;B←読み込む最後のセクタ－1（0～15）
	CP	B
	JR	NZ, DLOAD2	;FATが不正
	LD	B,0
	INC	BC	;BC←最後のセクタのバイト数
	OR	A
	JR	Z, DLOAD4	;最後のクラスタは、セクタを1つだけ使用

;	最後のセクタ以外を読み込みます
	PUSH	AF
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	JR	C, DLOAD5
	POP	AF	;Acc←読み込みセクタ数－1（0～15）

DLOAD4:
	PUSH	DE
	LD	E,0
	LD	D,A	;DE←次に読み込むアドレスの変移
	ADD	HL,DE	;メモリのカウント･アップ
	EX	(SP),HL	;HL←最後のクラスタの先頭レコード番号，スタック←最後に読み込むメモリのアドレス
	LD	E,A
	LD	D,0	;DE←次に読み込むレコードの変移
	ADD	HL,DE

;	最後のセクタ以外を読み込みます
	EX	DE,HL	;DE←最後に読み込むレコード番号
	LD	HL,(_DTBUF)
	LD	A,1
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
DLOAD5:
	POP	DE	;DE←最後に読み込むメモリのアドレス
	RET	C

;	[_DTBUF]～から最後のセクタの内容を正しいメモリに転送します
	LDIR
	XOR	A	;Acc←0
	RET


;ディスクにファイルを書き込みます
;入力	[DEBUF]、[HLBUF]、[_FATBF]～etc参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，HL，DE，BC，AF'
DSAVE:
	LD	DE,(DEBUF)	;アクセスするレコード番号の一時保存場所
	LD	HL,(HLBUF)	;参照FCBのアドレスの一時保存場所
	LD	BC,(_SIZE)
	PUSH	BC
	DEC	BC
	SRL	B
	SRL	B
	SRL	B
	SRL	B
	INC	B	;B←占有クラスタ数
	CALL	FRECLU	;空きクラスタ数を得ます
	CP	B
	POP	BC	;BC←[_SIZE]
	LD	A,9	;Device Full
	RET	C	;空き領域が足りない

;	タイム･スタンプとクラスタ値をクリア
	LD	HL,(_IBFAD)
	PUSH	HL
	PUSH	DE
	PUSH	BC
	LD	DE,24
	ADD	HL,DE
	LD	E,L
	LD	D,H
	INC	DE
	LD	(HL),0
	LD	BC,7
	LDIR
	POP	BC	;BC←[_SIZE]
	POP	DE	;DE←[DEBUF]
	POP	HL	;HL←[_IBFAD]

;	FCBのクラスタ値の設定
	LD	A,30
	ADD	A,L
	LD	L,A
	JR	NC,$+3
	INC	H	;HL←[_IBFAD]＋30
	CALL	FCGET	;空きクラスタを得ます
	LD	(HL),A	;FCBのクラスタ値←空きクラスタ番号
	LD	HL,(_DTADR)

;	セーブ･ループ
DSAVE1:	PUSH	HL
	LD	HL,(_FATBF)
	LD	E,A
	LD	D,0	;DE←空きクラスタ番号
	ADD	HL,DE	;HL←FATバッファの空きクラスタの位置
	EX	DE,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	EX	DE,HL	;DE←空きレコード位置（空きクラスタ番号×16）
	DEC	BC
	LD	A,B
	INC	BC
	CP	16
	JR	C,DSAVE3	;最後のクラスタ
	LD	(HL),80H	;FCGETルーチンでスキップさせるため
	CALL	FCGET	;空きクラスタを得ます
	LD	(HL),A	;次のクラスタへのチェイン情報
	POP	HL	;HL←[_DTADR]
	PUSH	AF
	LD	A,16	;4Kバイト書き込みます
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	JR	C,DSAVE2	;エラー
	LD	DE,1000H
	ADD	HL,DE	;メモリのカウント･アップ
	PUSH	HL
	LD	L,C
	LD	H,B
	OR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H	;サイズのカウント･ダウン
	POP	HL	;HL←次のメモリ
	POP	AF	;Acc←次のクラスタ
	JR	DSAVE1

;	エラー
DSAVE2:	POP	HL	;スタック位置調整のため
	RET

;	最後のクラスタ
DSAVE3:	INC	A	;Acc←書き込みセクタ数
	PUSH	AF
	ADD	A,7FH	;Acc←80H～8FH
	LD	(HL),A	;チェインの終わりを示す
	POP	AF	;Acc←書き込みセクタ数
	POP	HL	;HL←メモリのアドレス
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	RET	C	;エラー

;	FATの更新
	CALL	FATWRT	;FATを書き込みます
	RET	C	;エラー

;	ディレクトリの更新
	LD	HL,(_IBFAD)
	LD	DE,(HLBUF)	;参照FCBのアドレスの一時保存場所
;	INC	DE	;無意味？
	LD	BC,32
	LDIR
	LD	HL,(_DTBUF)
	LD	DE,(DEBUF)	;アクセスするレコード番号の一時保存場所
	LD	A,1
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	RET	C
	XOR	A	;Acc←0
	RET


;FATを読みます
;入力	[_FATPS]、[_FATBF]参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
FATRED:
	PUSH	DE
	PUSH	HL
	LD	DE,(_FATPS) ; FATの読み込み先レコード(トラック)番号
	LD	HL,(_FATBF) ; FATのバッファの先頭アドレス 2E00H
	LD	A,1 ; 読み込むレコード数
	; HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
	PUSH AF
	PUSH BC
	PUSH DE
	PUSH HL
	CALL 	RESTORE
	POP HL
	POP DE
	POP BC
	POP AF
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	POP	HL
	POP	DE
	RET


;FATを書き込みます
;入力	[_FATPS]、[_FATBF]～参照
;出力	CY＝0（Acc←0）なら成功、
;	CY＝1（Acc←エラー･コード）なら失敗
;破壊	AF，AF'
FATWRT:
	PUSH	DE
	PUSH	HL
	LD	DE,(_FATPS) ; 書き込み先レコード(トラック)番号
	LD	HL,(_FATBF) ; 書き込み先アドレス
	LD	A,1 ; 書き込むレコード数
	; HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
	CALL	sequential_sector_write_disk	;=#DWRSB（2003H）の本体
	POP	HL
	POP	DE
	RET


;空きクラスタ数を得ます
;入力	[_FATBF]～参照
;出力	Acc←空きクラスタ数
;破壊	AF
FRECLU:
	PUSH	BC
	PUSH	HL
	LD	B,80H ; FATエントリ数 128
	LD	C,0 ; 空きクラスタ数カウンタ初期化
	LD	HL,(_FATBF) ; FATバッファの先頭アドレス

FRECL1:
	LD	A,(HL) ; Acc←FATの内容
	OR	A	;00Hが未使用
	JR	NZ,FRECL2 ; 使用中
	INC	C ; 空きクラスタ数カウントアップ
FRECL2:
	INC	HL
	DJNZ	FRECL1

	LD	A,C ; Acc←空きクラスタ数
	POP	HL
	POP	BC
	RET


;空きクラスタを得ます
;入力	なし
;出力	Acc←空きクラスタ番号
;	CY＝1なら空きクラスタがない
;破壊	AF
FCGET:
	PUSH	BC
	PUSH	HL
	LD	B,80H ; FATエントリ数
	LD	HL,(_FATBF)

FCGET2:
	LD	A,(HL)
	OR	A	;00Hは未使用クラスタ
	JR	Z,FCGET3 ; 見つかった
	INC	HL
	DJNZ	FCGET2

	SCF ; CY←1 （空きクラスタがない）
	JR	FCGET4 ; リターン
FCGET3:
	LD	A,80H ; 空きクラスタ番号は80Hから始まる
	SUB	B	;Acc←空きクラスタ番号
	OR	A
FCGET4:
	POP	HL
	POP	BC
	RET


;FATバッファから指定のクラスタ･チェインをカットします
;入力	Acc←ファイルの開始クラスタ
;出力	CY＝0（Acc←0）なら正常終了、CY＝1（Acc←7）ならエラー
;破壊	AF，DE
ERAFAT:
	PUSH	DE
	PUSH	HL
	LD	DE,(_FATBF)

ERAFA1:	LD	L,A
	LD	H,0	;HL←ファイルの開始クラスタ
	ADD	HL,DE	;HL←対応するFATバッファのアドレス
	LD	A,(HL)	;Acc←チェインしているクラスタ番号
	LD	(HL),0
	CP	80H
	JR	C,ERAFA1	;チェインしていた

;	チェイン終了
	POP	HL
	POP	DE
	CP	90H
	JR	NC,ERAFA2	;90H～のデータがあった
;	正常終了
	XOR	A
	RET

;	存在するはずのない数値があった
ERAFA2:	LD	A,7	;Bad Allocation Table
	SCF
	RET


;ファイルを検索します（属性は無視）
;入力	[_IBFAD]参照
;出力	ZF＝1なら一致した
;	HL←一致したFCBのあるアドレス、DE←一致したFCBのあるレコード番号
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，AF'
FCBSCH:
	PUSH	BC
	LD	C,16
	LD	DE,(_DIRPS) ;ディレクトリの先頭レコード番号

FCBSC1:
	LD	HL,(_DTBUF) ;1F64H '2F00H～2FFFH ディスクリード用バッファ(256Byte)の先頭アドレス。デフォルトは2F00h。
	LD	A,1 ; 1レコード読む
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	JR	C,FCBSC6	;エラー
	LD	B,8

FCBSC2:
	LD	A,(HL)
	CP	0FFH
	JR	Z,FCBSC4
	OR	A
	JR	Z,FCBSC3
	PUSH	DE
	LD	DE,(_IBFAD)
;	CALL	FCOMP	;ファイル名を比較します
	CALL	compare_file_name	;ファイル名を比較します
	POP	DE
	JR	Z,FCBSC5	;一致した
FCBSC3:	PUSH	DE
	LD	DE,32
	ADD	HL,DE
	POP	DE
	DJNZ	FCBSC2

	INC	DE
	DEC	C
	JR	NZ,FCBSC1

FCBSC4:	DB	3EH	;「LD A,」
FCBSC5:	XOR	A
	OR	A
FCBSC6:	POP	BC
	RET


;ディスクに空きエリアがあるかチェックします
;入力	なし
;出力	HL←一空きFCBのあるアドレス、DE←空きFCBのあるレコード番号
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，AF'
FRESCH:
	PUSH	BC
	LD	C,16
	LD	DE,(_DIRPS)

FRESC1:
	LD	HL,(_DTBUF); _DTBUF=1F64H '2F00H～2FFFH ディスクリード用バッファ(256Byte)の先頭アドレス。デフォルトは2F00h。
	LD	A,1 
	CALL	sequential_sector_read_disk	;=#DRDSB（2000H）
	JR	C,FRESC3
	LD	B,8

FRESC2:
	LD	A,(HL)
	OR	A
	JR	Z,FRESC4
	CP	0FFH
	JR	Z,FRESC4
	PUSH	DE
	LD	DE,32
	ADD	HL,DE
	POP	DE
	DJNZ	FRESC2

	INC	DE
	DEC	C
	JR	NZ,FRESC1

FRESC3:	DB	3EH	;「LD A,」
FRESC4:	XOR	A
	POP	BC
	RET


; 	IF	0
; ;ファイル名を比較します
; ;入力	HL←比較されるFCBの先頭アドレス、
; ;	DE←比較するFCBの先頭アドレス
; ;出力	ZF＝1なら一致した
; ;破壊	AF
; FCOMP:
; 	PUSH	BC
; 	PUSH	DE
; 	PUSH	HL
; 	LD	B,16

; FCOMP1:	INC	DE
; 	INC	HL
; 	LD	A,(DE)
; 	CP	(HL)
; 	JR	NZ,FCOMP2	;不一致
; 	DJNZ	FCOMP1

; FCOMP2:	POP	HL
; 	POP	DE
; 	POP	BC
; 	RET
; 	ENDIF


;	compare_file_nameの一部
FCMPW2:
	LD	A,(DE);DE←比較するFCBの先頭アドレス+1
	CP	C	;CP ' '
	RET	Z
FCMPW1:
	LD	A,(DE) ;DE←比較するFCBの先頭アドレス+1
	CP	'?'	;ワイルド･カード
	RET	Z
	; CALL	convert_lower_case_to_upper_case	;小文字→大文字変換
	LD	C,A
	LD	A,(HL);HL←比較されるFCBの先頭アドレス+1
	; CALL	convert_lower_case_to_upper_case	;小文字→大文字変換
	CP	C	;ZF＝1なら一致
	RET


NXCLST:	DS	1	;アクセスするクラスタの一時保存場所（ロード･ルーチンで使用）
DEBUF:	DS	2	;アクセスするレコード番号の一時保存場所
HLBUF:	DS	2	;参照FCBのアドレスの一時保存場所


;P%FNAM（2912H）の本体
;ファイル情報を表示します
;入力	Acc←属性、HL←ファイル情報の先頭アドレス
;出力	なし
;破壊	AF
print_file_information:
	PUSH BC
	PUSH DE
	PUSH HL
	LD DE,(_IBFAD);1F74H ファイルのインフォメーションブロックの先頭アドレス。
					;同時にファイル属性のアドレスでもある。
	LD BC,0020H
	LDIR ;DEにファイル情報をコピーします
	CALL print_file_attribute ;属性情報を表示します。BINやBASなど
	LD	A,(_DSK)
	CALL PRINT
	LD	A,':'
	CALL PRINT
	CALL print_file_name
ADRPRT:
	CALL _PARSC		;Fileのアドレス情報を、S-OSのワークに転送します
	LD BC,(_SIZE)	;1F72H ファイルサイズ。
	LD HL,(_DTADR)	;1F70H ファイルの先頭アドレス。
	LD DE,(_EXADR)	;1F76H ファイルの実行アドレス。
	CALL PHEX		;まず、ファイルの先頭アドレスを表示します
	ADD	HL,BC
	DEC	HL
	CALL PHEX		;次に、ファイルサイズを表示します
	EX	DE,HL
	CALL PHEX		;次に、実行アドレスを表示します
	POP	HL
	POP	DE
	POP	BC
	RET

PHEX:	LD	A,':'
	CALL	PRINT
	CALL	print_hex_4_digit
	RET


;属性情報を表示します
;入力	Acc←属性
;出力	なし
;破壊	AF，HL，DE
print_file_attribute:
	PUSH	AF
	LD	DE,ATRMES
	BIT	7,A
	JR	Z,ATRP1
;	ディレクトリの場合
	LD	A,8
	DB	11H	;「LD DE,」
ATRP1:
	AND	07H	;Acc←0～8
	LD	L,A
	LD	H,0
	ADD	HL,HL
	ADD	HL,HL
	LD	DE,ATRMES
	ADD	HL,DE
	EX	DE,HL
	CALL	print_string_until_00H_from_DE_register
	POP	AF
	BIT	6,A
	LD	A,'*'
	JR	NZ,ATRP2
	LD	A,' '
ATRP2:
	CALL	PRINT
	CALL	print_space_character
	RET


;%check_device_name（2851H）の本体
;デバイス名が正しいか（A～L，S，T，Q）かチェックします
;入力	Acc←デバイス名（小文字不可）
;出力	ZF＝1ならテープ、CY＝1なら不正
;破壊	F（AF）
;注：デバイス名が不正なら、Acc←エラー･コード。
check_device_name:
	CALL	check_tape_device_name	;デバイス名がテープ（QD）かチェックします
	RET	Z
	CP	'A'
	JR	C, device_name_is_bad_file_descripter	;「A」未満
;	「A」～
	CP	'L'+1
	CCF
	JR	C,$+4
	OR	A
	RET
device_name_is_bad_file_descripter:
	LD	A,3	;error code for Bad File Descripter
	RET


;%check_tape_device_name（2918H）の本体
;デバイス名がテープ（QD）かチェックします。SORD M23はテープはサポートなし。
;入力	Acc←デバイス名（小文字不可）
;出力	ZF＝1ならテープ, 常にZeroフラグが0になる
;破壊	F
check_tape_device_name:
	PUSH AF
	LD A, 0
	OR A
	POP	AF
	RET


;#ERROR（2033H）の本体
ERROR:
	DEC	A
	CP	14
	JR	C,ERROR1
	INC	A
	LD	DE,ER15
	PUSH	AF
	CALL	print_string_pointed_by_DE_register
	LD	A,'$'	;16進数ヘッダ
	CALL	PRINT
	POP	AF
	CALL	print_hex_2_digit
	JR	ERROR2
ERROR1:	LD	HL,MESTBL
	ADD	A,A
	LD	E,A
	LD	D,0
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	CALL	print_string_pointed_by_DE_register
ERROR2:	CALL	BELL
	CALL	carriage_return_if_not_at_head_of_line
	RET


;	空きクラスタ表示用メッセージ
cluster_free_message:	DB	' Clusters Free',0DH,00H

;	属性メッセージ
ATRMES:
	DB	'Nul',00H	;000
	DB	'Bin',00H	;001
	DB	'Bas',00H	;010
	DB	'???',00H	;011
	DB	'Asc',00H	;100
	DB	'???',00H	;101
	DB	'???',00H	;110
	DB	'???',00H	;111
	DB	'Dir',00H	;1xxxxxxx


;GETDEVルーチンのバグ回避処理
;ファイル･ディスクリプタのセパレータの位置の文字を得ます
GDVPAT:
	LD	A,(DE)
	OR	A
	RET	Z	;文字列の最後に達していた
	INC	DE
	LD	A,(DE)
	DEC	DE
	RET


;モニタ･コマンドで小文字を受け付けるため
sos_monitor_command_routine1:
	INC	DE
	LD	A,(DE)
	INC	DE
	JP	convert_lower_case_to_upper_case	;小文字→大文字変換


;STコマンドで小文字を受け付けるため
MSET1:
	CALL	skip_space_characters	;文字列の空白を読み飛ばします
	LD	A,(DE)
	JP	convert_lower_case_to_upper_case	;小文字→大文字変換


;ファイル名を比較します（小文字、拡張子なしでも一致させるため）
;入力	HL←比較されるFCBの先頭アドレス、
;	DE←比較するFCBの先頭アドレス
;出力	ZF＝1なら一致した
;破壊	AF
compare_file_name:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	LD	B,13 ;拡張子なしのファイル名部分（8＋3＝11バイト）＋区切り文字2バイト。0Dh。

FCPWL1:
	INC	DE ;DE←比較するFCBの先頭アドレス+1
	INC	HL ;HL←比較されるFCBの先頭アドレス+1
	CALL	FCMPW1
	JR	NZ,FCMPWE
	DJNZ	FCPWL1

	LD	B,3

FCPWL2:
	INC	DE
	INC	HL
	LD	C,' '
	CALL	FCMPW2
	JR	NZ,FCMPWE
	DJNZ	FCPWL2

FCMPWE:	POP	HL
	POP	DE
	POP	BC
	RET


	ORG	2A00H
MESTBL:
	DW	ER1,ER2,ER3,ER4,ER5,ER6,ER7,ER8
	DW	ER9,ER10,ER11,ER12,ER13,ER14

ER1:	DB	'Device I/O Error',0DH
ER2:	DB	'Device Offline',0DH
ER3:	DB	'Bad File Descripter',0DH
ER4:	DB	'Write Protected',0DH
ER5:	DB	'Bad Record',0DH
ER6:	DB	'Bad File Mode',0DH
ER7:	DB	'Bad Allocation Table',0DH
ER8:	DB	'File not Found',0DH
ER9:	DB	'Device Full',0DH
ER10:	DB	'File Already Exists',0DH
ER11:	DB	'Reserved Feature',0DH
ER12:	DB	'File not Open',0DH
ER13:	DB	'Syntax '
ER15:	DB	'Error ',0DH
ER14:	DB	'Bad Data',0DH
OK:	DB	'Complete !',0DH


;=======================================
;内部ワーク＆内部ジャンプ･テーブル
;=======================================


	ORG	2900H
;%RDI（2900H）
;テープのインフォメーション･ファイルをロードします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
_RDI:	RET

DS 2

;%TROPN（2903H）
;テープのリード･オープン
;入力	[_DSK]←デバイス名
;出力	ZF＝1（Acc←0）ならファイルが見つかった
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
;注：
; ファイル名解析後呼び出すこと。
; ファイル名の先頭が20Hか0DHの場合は、常に一致とみなします。
_TROPN:	RET

DS 2

;%WRI（2906H）
;テープにインフォメーション･ファイルをセーブします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
_WRI:	RET

DS 2

;%TWRD（2909H）
;テープにデータ･ファイルをセーブします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
_TWRD:	RET

DS 2

;%TRDD（290CH）
;テープのデータ･ファイルをロードします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
_TRDD:	RET

DS 2

;%TDIR（290FH）
;テープのディレクトリを表示します
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
_TDIR:	RET

DS 2

;P%FNAM（2912H）
;ファイル情報を表示します
;入力	Acc←ファイル属性、HL←ファイル情報の先頭アドレス
;出力	なし
;破壊	AF
_PFNAM:	JP	print_file_information


;%DVCHK（2915H）
;デバイス名が正しいか（A～L，S，T，Q）かチェックします
;入力	Acc←デバイス名（小文字不可）
;出力	ZF＝1ならテープ
;	CY＝1なら不正（Acc←エラー･コード）
;破壊	AF
_DVCHK:	JP	check_device_name


;%check_tape_device_name（2918H）
;デバイス名がテープ（QD）かチェックします
;入力	Acc←デバイス名（小文字不可）
;出力	ZF＝1ならテープ
;破壊	F
_check_tape_device_name:	JP	check_tape_device_name


;	291BH～291DHは未使用
	DS	3


;%OPNFG（291EH）
;ファイルのオープンの状態（＝0でクローズ,＝1でオープン）
_OPNFG:	DB	0


;%FTYPE（291FH）
;ファイル属性（ファイル名の解析でセットされます）
_FTYPE:	DS	1


;%DFDV（2920H）
;デフォルト･デバイス（初期値「A」）
_DFDV:	DB	'A'


;	2921H～2929Hは未使用
	DS	9


;%PARSC（292AH）
;機種依存のテープのアドレス情報を、S-OSのワークに転送します
;入力	なし
;出力	なし
;破壊	全レジスタ保存
_PARSC:
	PUSH	HL
	LD	HL,(fcb_buffer+18)
	LD	(_SIZE),HL
	LD	HL,(fcb_buffer+20)
	LD	(_DTADR),HL
	LD	HL,(fcb_buffer+22)
	LD	(_EXADR),HL
	POP	HL
	RET


;%PARCS（293FH）
;S-OSのテープのアドレス情報を、機種依存のワークに転送します
;入力	なし
;出力	なし
;破壊	全レジスタ保存
_PARCS:
	; PUSH	HL
	; LD	HL,(_SIZE)
	; LD	(fcb_buffer+18),HL
	; LD	HL,(_DTADR)
	; LD	(fcb_buffer+20),HL
	; LD	HL,(_EXADR)
	; LD	(fcb_buffer+22),HL
	; POP	HL
	RET


;=======================================
;フィジカル･ディスクI／Oエントリ
;=======================================
;注：本体は、サイズが大きいため、メイン部後ろ移転しました。


;	2D00H～2DFFHはバッチ･ファイル読み込みバッファ



	ORG	2D00H

;=======================
;ブート･プログラム
;=======================


START:
	DI
	LD	SP,F900H	;仮スタック

;	vram_address_of_topの初期化
	LD	HL,F800H ; SORD M23のTXT VRAMの先頭アドレス
	LD	(vram_address_of_top),HL

;	デフォルト･ドライブの設定
	LD	A,(0FF87H)	;立ち上がったドライブ番号（下位ニブル）
	AND	1111B
	CP	4
	JR	NC,STADVS
	ADD	A,'A'	;Acc←立ち上がったドライブ名
	LD	(_DFDV),A	;デフォルト･ドライブ
STADVS:

;	[vram_size]の設定（VRAMのサイズ÷100H）
;〈VRAMのサイズ〉
;00C000Hバイト
	LD	HL,0020H	;002000H
	LD	(vram_size),HL


;	コールド･スタートします
	LD	HL,F900H	;仮スタック
	LD	(_STKAD),HL
	LD	HL, _COLD
	LD	(0001H),HL
	LD	(0067H),HL
	; JP	0000H
	JP COLD
	END
