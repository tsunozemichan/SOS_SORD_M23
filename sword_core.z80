

;
; CRTC ports
;
VRAM_TXT_TOP EQU 0F800H ; VRAM上で画面左上を指すアドレス
VRAM_TXT_END 		EQU FFD0H ; VRAMのテキストエリアの終端アドレス
VRAM_ATR_TOP EQU 0F000H ; アトリビュートの先頭アドレス
CRTC_ADDRESS_PORT 	EQU F0H ; CRTCアドレスポート
CRTC_VALUE_PORT 	EQU F1H ; CRTC値ポート
; CRTC_ADDRESS_PORT EQU 0F0H ; CRTCアドレス･ポート
; CRTC_VALUE_PORT EQU 0F1H ; CRTCデータ･ポート
; NUMBER_OF_CHARACTER_AT_LINE EQU 50H ; 80文字モードの1行のバイト数
; CURSOR_XY_ADDR EQU FF00H ; カーソルのX,Y座標を保存するアドレス

; Display Constants
NUMBER_OF_CHARACTER_AT_LINE	EQU 80 ; 80文字モードの1行の文字数


;
; FDC I/O ports
;
FDC_COMMAND_REG EQU 0C0H
FDC_STATUS_REG 	EQU FDC_COMMAND_REG
FDC_TRACK_REG 	EQU 0C1H
FDC_SECTOR_REG 	EQU 0C2H
FDC_DATA_REG 	EQU 0C3H
DMA_ADDRESS 	EQU 0C4H
FDC_CONTROL_REG EQU 0C5H
DMA_BANK_SEL 	EQU 0C6H



; Ascii code Constants
CR	EQU	0DH ; Carriage Return
LF	EQU	0AH ; Line Feed
BS	EQU	08H ; Back Space
DEL	EQU	7FH ; Delete
HT  EQU 09H ; Horizontal Tab
VT  EQU 0BH ; Vertical Tab
BEL EQU 07H ; Bell
NP  EQU 0CH ; Formfeed (also: New page NP)
ESC EQU 1BH ; Escape

;〈SLANGについて〉
; SLANGは、特殊ワークのサイズによっては動作しません。
;SLANGの3014H～3015H番地の内容が、
;特殊ワーク上の大局テーブルの先頭アドレスをさしているので、
;特殊ワークのサイズのために動かない場合は、
;若い番地へ移動して対応してください。

	ORG	0000H
	JP	START	;初期化
	ORG	0066H
	JP	START	;NMIでリスタート

	ORG	0100H


;=======================
;汎用バッファ
;=======================


;	0100H（256バイト）
BUFFER:	DS	256


;=======================
;文字列入力バッファ
;=======================


;	0100Hバイト
keyboard_buffer:	DS	256
;
;
; key input scan buffer
; 末尾1バイトのアドレスが00であることを期待している。
;
	; org KEYBOARD_SCAN_BUFFER

PORT_INDEX:
	DS 16


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; Keyboard map
;

KEY_MAP:
	DB 0H,'1234567890-=',5CH,08H,0H
	DB 0H,'QWERTYUIOP@',5BH,0DH,0DH,0H
	DB 0H,'ASDFGHJKL',3BH,3AH,5DH,0H,0H,0H
	DB 0H,'ZXCVB',20H,'NM',2CH,2EH,2FH,0H,0H,0H

;=======================
;キー入力バッファ
;=======================


;	0080H（128バイト）
input_key_buffer:	DS	127	;キー入力バッファ（127文字分）
pointer_for_write_key_buffer:	DS	1	;キーを書き込むポインタ（＝0でカラ、＝7FHでいっぱい）


;=======================================
;コントロール･コード･ジャンプ･テーブル
;=======================================


;	0040H（64バイト）
control_code_jump_tabel:
	DW	control_code_NULL	;^＠
	DW	CTL01				;^A 'カーソルを論理行頭へ（-^V）
	DW	control_code_NULL	;^B '前のワードの先頭へ（－^F） '非サポート
	DW	CTLCAN				;^C ^STOP（論理改行＆インサート解除）
	DW	control_code_DELETEL;^D '論理行のカーソル位置の文字の削除（DELキー）
	DW	CTL05				;^E '論理行のカーソル以降削除（－^U）
	DW	control_code_NULL	;^F '次のワードの先頭へ（－^B） '非サポート
	DW	BELL				;^G BELL
	DW	control_code_BS		;^H BS
	DW	control_code_TAB	;^I TAB
	DW	control_code_NULL	;^J LF
	DW	control_code_HOME	;^K HOME
	DW	control_code_CLS	;^L CLR
	DW	CTLCR				;^M CR＋LF
	DW	control_code_NULL	;^N '論理行分割（－^W） '非サポート
	DW	control_code_NULL	;^O '物理行注入（－^Y） '非サポート
	DW	control_code_NULL	;^P
	DW	control_code_NULL	;^Q
	DW	control_code_INS	;^R INS
	DW	control_code_ROLL_UP	;^S 'スクロール･アップ（－^S）
	DW	control_code_ROLL_DOWN	;^T 'スクロール･ダウン（－^T）
	DW	control_code_NULL	;^U '論理行のカーソルより前削除（－^E） '非サポート
	DW	control_code_NULL	;^V 'カーソルを論理行末へ（－^A、最後の文字の次のカーソル位置) '非サポート
	DW	control_code_NULL	;^W '次の行と連結（－^N、,論理行末と次の行の行頭をつなぐ) '非サポート
	DW	control_code_NULL	;^X SELECT
	DW	control_code_NULL	;^Y '物理行削除（－^O） '非サポート
	DW	control_code_NULL	;^Z
	DW	CTLCAN				;^［ ESC
	DW	control_code_Right	;^￥ →
	DW	control_code_Left	;^］ ←
	DW	control_code_Up		;^＾ ↑
	DW	control_code_Down	;^＿ ↓


;=======================================
;カーソル･オフセット計算用テーブル下位
;=======================================
;y座標に対応するカーソル･オフセットを得ます
;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]


;	0020H（32バイト）
cursor_offset_for_Y_table:	DS	32


;===============================
;システム･スタック･エリア
;===============================


;	00CCH（204バイト）
	DS	256-52
system_stack_area:


;*******	256バイト境界	********


;=======================================
;カーソル･オフセット計算用テーブル上位
;=======================================
; y座標に対応するカーソル･オフセットを得ます。
;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]


;	0020H（32バイト）
	DS	32


;=======================
;内部ワーク･エリア
;=======================


;	0050H（80バイト）
fcb_buffer:	DS	32	;S-OSのFCBバッファ（[_IBFAD]でポイント）

;	通常（42バイト）
total_number_of_character_display:	DS	2	;画面の表示文字数
cursor_offset_last_top_of_line:		DS	2	;最終行先頭のカーソル･オフセット
vram_address_of_top:				DS	2	;テキストVRAM先頭アドレス（未使用の場合あり）
vram_address_of_top_of_last_line:	DS	2	;最終行先頭のテキストVRAMアドレス（未使用の場合あり）
locate_of_cursor_overlap_character:	DS	1	;カーソルと重なった位置の文字の保存（未使用の場合あり）
screen_width:	DS	1	;＝00Hで40桁、＝FFHで80桁 -> M23では80桁固定なので、常にscreen_width=FFHとなる。
CSRADD:	DS	2	;（行数－1）×256＋桁数
CSRNXI:	DS	1	;256－桁数 '[CSRNX]の初期値 -> M23では桁数80固定なので、CSRNXI=CSRNXとなる。
CSRNYI:	DS	1	;256－行数 '[CSRNY]の初期値-> M23では行数25固定なので、CSRNYI=CSRNYとなる。
CSRNX:	DS	1	;x座標-[_WIDTH] _WIDTHは80
CSRNY:	DS	1	;y座標-[_MXLIN] _MXLINは25
display_cursor_XY_not_use:		DS	2	;カーソル座標（使用しません）
number_of_character_after_CR:	DS	1	;改行してからの文字数（未使用）
insert_mode_flag:	DS	1	;＝00Hで通常、＝FFHでインサート･モード
foreground_color:	DS	1	;前景色
background_color:	DS	1	;背景色
BDR_color:			DS	1	;周辺色
attribute_data:		DS	1	;画面のアトリビュートRAMへ書き込むデータ
real_time_key:		DS	1	;リアル･タイム･キー（未使用の場合あり）
GRAFLG:				DS	1	;＝FFHでグラフィック表示（未使用の場合あり）

vram_size:			DS	2	;VRAMのサイズ÷100H



	ORG	(($+0FFH) & 0FF00H)


;===============================
;ライン･ターミナル･テーブル
;===============================


; 先頭行の行連結情報はxx00Hのアドレスに格納されます。
;行連結情報←lineterminal_table＋y座標（0～）
; FFHで次の行と連結。
;	0020H（32バイト）
lineterminal_table:	DS	32


;-----------------------
;S-OSルーチン
;-----------------------

;=======================
;システム･ルーチン
;=======================


;#COLD（1FFDH）の本体
; コールド･スタートして、[_USR]のアドレスにジャンプします。
;[_USR]の内容は、「_HOT」に初期化します。
;注：
; プリンタ非出力モードにします。
; 「RET」命令で、「_HOT」にジャンプします。
; キー入力バッファをカラにして、そのアドレスをDEで渡す。
; 固有の初期化ルーチンの cold_start_entity（全レジスタ破壊）を呼び出します。
; 固有のメッセージ「title_message」を参照します。
COLD:
;	初期化
	LD	SP,(_STKAD)
	DI
	; IM	2
	CALL CRT_INIT			;CRTCの初期化
	CALL FDC_INIT			;FDCの初期化
	EI

;	スタックの設定など
	LD	HL,D000H
	LD	(_MEMAX),HL	;使用可能メモリの上限を設定
	LD	HL,system_stack_area
	LD	(_STKAD),HL


;	キー入力バッファのクリア
	CALL	clear_key_buffer ; インデックスポインタを0にしているだけ。

;	ディスクのパラメータの初期化
	LD	HL,000EH ;  FATは第0トラック、第15セクタにある。HuBASIC準拠。
	LD	(_FATPS),HL
	LD	HL,0010H ; ディレクトリ情報が記録されているトラック番号
	LD	(_DIRPS),HL
	LD	HL,2E00H ; FAT読み込みバッファ
	LD	(_FATBF),HL
	LD	HL,2F00H ; ディスクI／Oバッファ
	LD	(_DTBUF),HL
	LD	A,80 ; 最大トラック数
	LD	(_MXTRK),A

;	ディスクI／O初期化
	; CALL	SOSSI



;	タイトル表示
	LD	DE,title_message
	CALL 	print_string_until_00H_from_DE_register

;	メモリの情報を表示
	CALL print_string_from_next_call_address
	DB	'MAIN 3000H-',00H
	LD	HL,(_MEMAX) ; _MEMAX = 仕様メモリの上限
	DEC	HL ; -1して、最後の使用可能アドレスにする
	CALL print_hex_4_digit
	CALL print_string_from_next_call_address
	DB	'H',0DH,00H
	CALL print_string_from_next_call_address
	DB	'WORK 0000H-',00H
	LD	HL,(_WKSIZ)
	DEC	HL
	CALL print_hex_4_digit
	CALL print_string_from_next_call_address
	DB	'H',0DH,00H

;	文字列入力バッファの80バイトをクリア
	LD	HL,(_KBFAD)
	LD	E,L
	LD	D,H
	INC	DE	;DE←[_KBFAD]＋1
	LD	BC,79
	LD	(HL),B	;[_KBFAD]←0
	LDIR

;	ホット･スタートへ
	LD	HL,(_USR)
	EX	DE,HL		;DE←ジャンプ先
	LD	HL,_HOT
	PUSH HL			;戻りアドレス（_HOT）
	LD	(_USR),HL	;[_USR]の再設定
	EX	DE,HL		;HL←ジャンプ先
	LD	DE,(_KBFAD)	;DE←[_KBFAD]
	XOR	A

	JP	(HL)	;旧[_USR]の内容にジャンプ


;コールド･スタート時のメッセージ
title_message:
	DB	'<<<<< S-OS  SWORD >>>>>',CR
	DB	00H


;#BOOT（2036H）の本体
; S-OSを終えます。
;注：フィジカル･ルーチンboot_entity（全レジスタ破壊）を呼び出します。
BOOT:
	JP	boot_entity


;===============================
;バージョン･ナンバーの取り出し
;===============================

;#VER（1FF7H）の本体
; Hに機種別情報、LにS-OSのバージョンを返します。
;入力	なし
;出力	H←機種別情報、L←S-OSのバージョン
;破壊	HL
;〈機種別情報〉
;00H	MZ-80K／C／1200
;01H	MZ-700
;02H	MZ-1500
;10H	MZ-80B
;11H	MZ-2000／2200
;12H	MZ-2500
;20H	X1
;21H	X1turbo
;22H	X1（筑紫版）
;30H	PC-8801（ROM）
;31H	PC-8001
;32H	PC-8801（オールRAM）
;40H	FM-7／77
;50H	SMC-777
;60H	PASOPIA
;61H	PASOPIA7
;70H	PC-286
;80H	X68000
;90H	MSX／2／2＋／turboR（ANK専用版）
;91H	MSX／2／2＋／turboR（漢字対応版）
;95H	SORD M23
;〈S-OSのバージョン〉
; SWORDでは、「20H」。
VER:
	PUSH	AF
	PUSH	DE
	PUSH	BC
	LD	HL,9520H	;SORD M23，S-OS V2.0
	POP	BC
	POP	DE
	POP	AF
	RET


;===============
;表示ルーチン
;===============

;#PRNTS（1FF1H）の本体
; スペースを1つ表示します。
;入力	なし
;出力	なし
;破壊	F（実際なし）

print_space_character:
	PUSH AF
	LD	A,' '
	CALL CONOUT_PROCESS
	POP	AF
	RET


;#LTNL（1FFEH）の本体
; 改行します。
;入力	なし
;出力	なし
;破壊	なし

carriage_return_and_line_feed:
	PUSH AF
	LD	A, CR
	CALL CONOUT_PROCESS
	LD	A, LF
	CALL CONOUT_PROCESS
	POP	AF
	RET


;#NL（1FEBH）の本体
; 行頭でなければ、改行します。
;入力	なし
;出力	なし
;破壊	なし
;注：
; 行頭でなければ改行します。

carriage_return_if_not_at_head_of_line:
	PUSH DE
	PUSH BC
	LD A,(CURSOR_X)
	AND A
	JR	Z,NLRET ; 行頭ならリターン
	CALL carriage_return_and_line_feed ; 改行を実行
NLRET:
	POP	BC
	POP	DE
	RET


;
;#MSG（1FE8H）の本体
; DEレジスタの示すアドレスから0DHが出現するまでアスキーコードとみなし文字列表示する。
;入力	DE←文字列先頭アドレス
;出力	なし
;破壊	F（実際なし）
;注：0DHは表示しません。
; このサブルーチンを完成させてください。

print_string_pointed_by_DE_register:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
MSGLP:
	LD	A,(DE)	; 文字を取得
	CP	CR 		; 改行コードか？
	JR	Z,MSGSKP; 改行コードなら終了へ
	CALL CONOUT_PROCESS ; 文字を表示
	INC	DE		; アドレスを一つ進める
	JR	MSGLP
MSGSKP:	
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

;#MSX（1FE5H）の本体
; DEレジスタの示すアドレスから00Hが出現するまでアスキーコードとみなし文字列表示する。
;入力	DE←文字列先頭アドレス
;出力	なし
;破壊	F（実際なし）
;注：00Hは表示しません。

print_string_until_00H_from_DE_register:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
MSXLP:
	LD	A,(DE) ; 文字を取得
	CP	00H ; 終了コードか？
	JR	Z,MSXSKP	; 終了コードなら終了へ
	CALL CONOUT_PROCESS ; 文字を表示
	INC	DE	; アドレスを一つ進める
	JR	MSXLP
MSXSKP:	
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

;#MPRNT（1FE2H）本体
; このサブルーチンをコールした次のアドレスから00Hが出現するまでアスキーコードとみなし、文字列表示する。
;入力	「CALL ＃MPRNT」の次のアドレス～←文字列とみなす
;出力	なし
;破壊	AF，DE（実際AF）
;注：
; 00Hは表示しません。
; 「REDA」などがDE保存を期待しているので、DEを保存します。
; このサブルーチンを完成させてください。
print_string_from_next_call_address:
	EX (SP),HL	; CALLの次のアドレスをHLにロード
	PUSH DE
	PUSH BC
	EX DE,HL ; DEとHLを入れ替えて、DEに表示すべきデータの先頭アドレスが入る
	LD A,(DE) ; 最初の文字を取得
	CP 00H ; もし最初の文字が00Hなら終了
	JR Z,mprint_end ; もし最初の文字が00Hなら何も表示せずにリターン

	PUSH AF
	PUSH HL
	PUSH BC
mprint_loop:
	LD A,(DE) ; 文字を取得
	CP 00H ; 終了コードか？
	JR Z,mprint_terminate	; 終了コードなら終了へ
	CALL CONOUT_PROCESS ; 文字を表示
	INC	DE	; アドレスを一つ進める
	JR mprint_loop
mprint_terminate:
	INC DE ; 終了コードの次のアドレスへ
	POP	BC
	POP	HL
	POP	AF

mprint_end:
	EX	DE,HL ; DEは表示すべきデータの末尾の次のアドレスが入っている。つまりリターンアドレスが入っている
	; POP	BC ; SPを進めるためにPOPする必要はない
	POP	DE
	EX	(SP),HL	;HLをスタックに戻す（リターン先アドレス）
;	XOR	A
	RET

; TAB(1FDFH)の本体
; Bレジスタの値と、カーソルのX座標との差を計算して、その結果の数だけスペースを表示する。
TAB:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC

	LD A,(CURSOR_X) ; LにカーソルのX座標をロード
	LD L,A
	LD A,B
	SUB	L	; A = B - X座標
	JR C,TABERR	; 結果が負ならエラー
	LD L,A	; Lにスペース数をセット
	TABLP2:
	LD A,' '
	CALL CONOUT_PROCESS
	DEC	L
	JR NZ,TABLP2 ; スペース数分ループ
	XOR	A	; CY=0
	JR TABRET
TABERR:
	SCF	; CY=1
TABRET:
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

; #LPRINT(1FDCH)の本体
; 未実装
LPRINT:
	RET

;===============
;16進数
;===============

;#PRTHX print_hex_2_digit（1FC1H）の本体
; Aレジスタの値を16進2桁で画面に表示する
;入力	Acc←データ
;出力	なし
;破壊	AF

print_hex_2_digit:
	PUSH AF	;保存
	SRL	A	; 上位4ビットを取得
	SRL	A	; さらに1ビット右シフト
	SRL	A	; さらに1ビット右シフト
	SRL	A	; さらに1ビット右シフト
	CALL convert_data_to_ascii_code	; 上位4ビットを16進数アスキーコードに変換
	CALL CONOUT_PROCESS ; 2桁目文字表示
	POP	AF	; 復元
	AND	0FH	; 下位4ビットを取得
	CALL convert_data_to_ascii_code	; 下位4ビットを16進数アスキーコードに変換
	CALL CONOUT_PROCESS	; 1桁目文字表示
	; Aレジスタは破壊されたままリターンする。
	RET


;#print_hex_4_digit（1FBEH）の本体
; HLレジスタの値を16進4桁で表示する。
;入力	HL←データ
;出力	なし
;破壊	AF

print_hex_4_digit:
	LD	A,H ; HLの上位バイトをAにロード
	CALL print_hex_2_digit ; 2桁表示
	LD	A,L ; HLの下位バイトをAにロード
	CALL print_hex_2_digit ; 2桁表示
	RET


;#ASC（1FBBH）の本体
; Aレジスタの下位4ビットの値を16進数で表したときのアスキーコードに変換してAレジスタに格納する。
;入力	Acc下位4ビット←データ
;出力	Acc←16進数表示のアスキーコード
;破壊	AF

convert_data_to_ascii_code:
	AND	0FH	; 下位4ビットを取得
	CP	10 ; 10未満か？
	JR	C,data_is_number
	ADD	A,'A'-10	; 10以上なら'A'～'F'に変換
	JR	data_is_alphabetic
data_is_number:
	ADD	A,'0'	; 0～9なら'0'～'9'に変換
data_is_alphabetic:
	RET

;#HEX（1FB8H）の本体
; Aレジスタの内容を16進数で表したときのアスキーコードとしてバイナリに変換し、Aレジスタに格納する。
;入力	Acc←16進数文字(アスキーコードで表現)
;出力	Acc←データ（0～15）
;	CY＝1（Acc＝14）ならエラー
;破壊	AF
;注：
; 小文字に対応。
; 汎用ルーチンconvert_lower_case_to_upper_case（AF破壊）を呼び出します。
convert_data_to_hex_binary_ascii_code:
	; CALL	convert_lower_case_to_upper_case
	SUB	'0' 		; '0'のコードを引く
	JR	C,HEXERR 	; '0'未満はエラー
	CP	10 			; 10未満か？
	JR	C,HEXESC 	; 10未満なら正常終了
	CP	10+7		;7＝「A」－（「9」＋1）
	JR	C,HEXERR
	SUB	7 			; 10以上なら'A'～'F'を0～5に変換
	CP	16 			; 16以上はエラー
	JR	NC,HEXERR
HEXESC:	OR	A 		; CY←0
	RET

HEXERR:	LD	A,14	;Bad Data
	SCF ; CY←1
	RET

;#2HEX（1FB5H）の本体
; DEレジスタの示すアドレスから2バイトの内容を、2桁の16進数で表現するアスキーコードとしてバイナリに変換し、
;HLに格納する。エラーがあればキャリフラグがセットされる。
;入力	[DE～]←16進文字2桁
;出力	HL←データ
;	DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
;	CY＝1ならエラー
;破壊	AF，DE
;注：小文字に対応。

convert_2_digit_data_to_hex_binary_ascii_code:

	LD	A,(DE) ; 16進1桁目取得
	CALL	convert_data_to_hex_binary_ascii_code ; 1桁目変換
	JR	C,HEXERR ; エラーならリターン
	SLL A    ; Aレジスタを左にシフト
			 ; b7→CY, 0→b0
	SLL	A ; 4倍
	SLL	A ; 8倍
	SLL	A ; 16倍
	AND 0F0H ; 上位4ビットを残す

	LD	L,A ; Lに格納

	INC	DE ; DEカウントアップ
	LD	A,(DE) ; 16進2桁目取得
	CALL	convert_data_to_hex_binary_ascii_code ; 2桁目変換
	JR	C,HEXERR ; エラーならリターン
	; Aに格納した一桁の数値をLに加算するコードを書いて下さい。
	ADD	A,L ; Lに加算
	LD	L,A ; Lに格納
	INC	DE ; DEカウントアップ
	
	RET


;#HLHEX（1FB2H）の本体
; DEレジスタの示すアドレスから4バイトの内容を、4桁の16進数で表現するアスキーコードとしてバイナリに変換し、
;HLに格納する。エラーがあればキャリフラグがセットされる。
;入力	[DE～]←16進文字4桁
;出力	HL←データ
;	DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
;	CY＝1ならエラー
;破壊	AF，HL，DE
;注：小文字に対応。

convert_4_digit_data_to_hex_binary_ascii_code:
	CALL convert_2_digit_data_to_hex_binary_ascii_code ; 先頭2桁を変換
	JR	C,HEXERR ; エラーならリターン
	LD	H,L ; HLの上位に格納
	CALL convert_2_digit_data_to_hex_binary_ascii_code ; 次の2桁を変換
	JR	C,HEXERR ; エラーならリターン
	RET


;===============
;スクリーン制御
;===============


;#CSR（2018H）の本体
; カーソル座標を読み出します。
;入力	なし
;出力	L←x座標、H←y座標
;破壊	HL
;注：CALC_CURSOR_XYを呼び出します。
CSR:
	PUSH AF
	PUSH DE
	PUSH BC
	CALL GET_X_Y_FROM_VRAM_ADDRESS
	LD H,B ; BにY座標が入っているので、Hにロード
	LD L,C ; CにX座標が入っているので、Lにロード
	POP	BC
	POP	DE
	POP	AF
	RET


;#LOC（201EH）の本体
; HLレジスタの値(L=X座標、H=Y座標)で指定するXY座標へカーソルの位置をセットする。
;入力	L←x座標、H←y座標
;出力	なし
;破壊	AF（実際F）
;注：
; 「WALRUS」がAccの保存を期待しているので、Accは保存します。
; 「ELFES IV」「TANGERINE」などでCYクリアが必要。

LOC:
	PUSH AF
	LD A,H
	LD (CURSOR_Y),A ; Y座標を保存
	LD A,L
	LD (CURSOR_X),A ; X座標を保存
	POP	AF
	OR A	;CY←0
	RET


;#SCRN（201BH）の本体
; HレジスタにY座標、LレジスタにX座標を格納してコールすると、画面上におけるその座標の文字を読み込み、Aレジスタに格納する。
;入力	L←x座標、H←y座標
;出力	Acc←文字
;破壊	AF
;注：
; CYをクリアします。

SCRN:
	PUSH	HL
	PUSH	DE
	PUSH	BC
	LD	B,H ; Y座標をBにロード
	LD	C,L ; X座標をCにロード
	CALL GET_VRAM_ADDRESS_FROM_X_Y ; XY座標からVRAMアドレスをHLにロード
; VRAMにアクセスして、カーソル位置DEにある通常文字のアスキーコードを得る。
	OUT (0D2H),A ; access to RAM page 1
	LD A,(HL) ; get character
	POP	BC
	POP	DE
	POP	HL
	OR	A	;CY←0
	RET


;#WIDCH（2030H）の本体
; 表示桁数を変更します。SORD M23ではサポートしません。
;入力	Acc←桁数
;出力	なし
;破壊	AF，HL，DE，BC
; CY＝0でリターンします（ディスク･モジュールのため）。
WIDCH:
	OR A	;CY←0
	RET

RSERR:
	RET

;LINCH（203CH）の本体
; 表示行数を変更します。 SORD M23ではサポートしません。
;入力	Acc←行数
;	[_WIDTH]参照
;出力	なし
;破壊	AF，HL，DE，BC
LINCH0:
	RET

;=======================
;ビープ音を鳴らします
;=======================


;#BELL（1FC4H）の本体
; ビープ音を鳴らします。
;入力	なし
;出力	なし
;破壊	AF
BELL:
	RET


;=======================
;プリンタ･ルーチン
;=======================


;#LPRNT（1FDCH）本体
; プリンタ1文字出力。SORD M23ではサポートしません。
;入力	Acc←文字
;出力	CY＝1ならエラー（Acc＝1）
;破壊	AF
;注：
; 0DHは、0DH＋0AHに変換します。
; 00H、0AH、1AHは、無視します。
LPRNT:
	RET

;#LPTON（1FD9H）の本体
; 表示をプリンタ出力モードにします。SORD M23ではサポートしません。
;入力	なし
;出力	[_LPSW]←1
;破壊	なし
;注：
LPTON:
	RET

;#LPTOF（1FD6H）の本体
; 表示を非プリンタ出力モードにします。SORD M23ではサポートしません。
;入力	なし
;出力	[_LPSW]←0
;破壊	なし
LPTOF:
	RET


;===============
;入力ルーチン
;===============

;#GETKY（1FD0H）の本体
; キーボードからリアルタイムキー入力をする。入力したでデータはAレジスタに格納され、
; 何も押されていない時は、Aレジスタに0をセットして、リターンする。
; キー入力（入力待ちなし、エコー･バックなし）。
;入力	なし
;出力	Aレジスタに入力された文字のアスキーコードがセットされる。
;破壊	AF
GETKY:
	PUSH DE
	PUSH IX
	CALL KEY_ONECE_SCAN
	POP IX
	POP DE
	RET


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; キースキャン サブルーチン
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

KEY_ONECE_SCAN:
	PUSH HL
	PUSH BC
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
	CALL KEY_SCAN ; キースキャンを一回だけ実行する。
	POP BC
	POP HL
	RET



KEY_SCAN_WRAPPER:
	PUSH HL
	PUSH BC
KEY_SCAN_WRAPPER_LOOP:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
	CALL KEY_SCAN ; キースキャンを実行する。
	AND A ; 0でないか、つまり、空の値でないかチェック。
	JR Z,KEY_SCAN_WRAPPER_LOOP ; 空でない場合、つまり、何かが押されているならジャンプ
	POP BC
	POP HL
	RET

KEY_SCAN:
	INC C
	INI ; INIでキーボードポートE0~EFをスキャンする。
	JR NZ,KEY_SCAN ; Cをインクリメントしていくと、1->2->3...e->f->0となって、スキャン終了となる。
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	IN A,(C)
	AND (HL) ; INIでスキャンした結果と照合。
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを0にする。
	JR KEY_LOOP_1
SCAN_LOOP_RETURN:
	RET

KEY_LOOP_1:
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	AND A ; 0でないか、つまり、空の値でないかチェック。
	JR NZ, KEY_LOOP_2 ; 空でない場合、つまり、何かが押されているならジャンプ
	INC D ; インデックスをインクリメント
	INC HL ; ポインタをインクリメント
	LD A,D
	CP 0FH ; 16バイトチェックしたか？
	LD A,0H ; なにもキーが押されなかったときはAレジスタを0にする。
	JR Z,SCAN_LOOP_RETURN ; 終了
	JR KEY_LOOP_1 

;
; 何かが押されている時に実行される。
;

KEY_LOOP_2: 
	CP 04H ; キーボード1段目のキーが押された。(ESC,1,2,3,4,5,6,7,8,9,0,-,=,BS)
	JP Z, CODE_04

	CP 08H ; キーボード2段目のキーが押された。(TAB,q,w,e,r,t,y,u,i,o,p,CR)
	JP Z, CODE_08

	CP 10H ; キーボード3段目のキーが押された。(control,a,s,d,f,g,h,j,k,l)
	JP Z, CODE_10

	CP 20H ; キーボード4段目のキーが押された。(shift,z,x,c,v,b,n,m,shift)
	JP Z, CODE_20

	CP 40H
	JP Z, CODE_40


;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
;  CODE 04 キーボードの1段目
;  (esc,1,2,3,4,5,6,7,8,9,0,-,=,bs)
;;;;;;;;;;;;;;;;;;;;;;;;;;;

CODE_04:
	LD A, L
	AND 0FH

	CP 00H ; ESCキーか？
	JP Z, CODE_ESC ; ESCキー処理へ

	LD B,L
	LD IX, KEY_MAP
MAP_ADD_04:
	INC IX
	DJNZ MAP_ADD_04
	LD A,(IX+0)
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF
	JP SCAN_LOOP_RETURN

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
;  CODE 08 キーボードの2段目
;  (tab,q,w,e,r,t,y,u,i,o,p,cr)
;;;;;;;;;;;;;;;;;;;;;;;;;;;

CODE_08:
	LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
			; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
	AND 0FH

	CP 00H ; TABキーか？
	JP Z, CODE_TAB ; TABキー処理へ

	LD B,L
	LD IX, KEY_MAP
MAP_ADD_08:
	INC IX
	DJNZ MAP_ADD_08
	LD A,(IX+10H)
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF
	JP SCAN_LOOP_RETURN


;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
;  CODE 10 キーボードの3段目
;  (control,a,s,d,f,g,h,j,k,l)
;;;;;;;;;;;;;;;;;;;;;;;;;;;

CODE_10:
	LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
			; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
	AND 0FH

	CP 00H ; コントロールキーか？
	JP Z, CODE_CONTROL ; コントロールキー処理へ

	LD B,L
	LD IX, KEY_MAP
MAP_ADD_10:
	INC IX
	DJNZ MAP_ADD_10
	LD A,(IX+20H)
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF

	JP SCAN_LOOP_RETURN

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
;  CODE 20 キーボードの4段目
;  (shift,z,x,c,v,b,n,m,shift)
;;;;;;;;;;;;;;;;;;;;;;;;;;;

CODE_20:
	LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
			; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
	AND 0FH

	CP 00H
	JP Z, CODE_SHIFT ; シフトキー処理へ

	LD B,L
	LD IX, KEY_MAP
MAP_ADD_20:
	INC IX
	DJNZ MAP_ADD_20
	LD A,(IX+30H)
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF
	JP SCAN_LOOP_RETURN

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
;  CODE 40 キーボードの5段目
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;

CODE_40:
	JP KEY_LOOP_END

;
; 特殊キー(CONTROL,SHIFT, TAB)の処理
;

CODE_CONTROL:
	CALL CONTROL_KEY_NEXT_GET
	JP SCAN_LOOP_RETURN

CODE_SHIFT:
	CALL SHIFT_KEY_NEXT_GET
	JP SCAN_LOOP_RETURN

CODE_TAB:
	LD A,09H ; TABキーコード
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF
	JP SCAN_LOOP_RETURN

CODE_ESC:
	LD A,ESC ; ESCキーコード(1BH)
	PUSH AF
	CALL KEY_BREAK_WAIT
	POP AF
	JP SCAN_LOOP_RETURN

KEY_LOOP_END:
	LD A, ESC ; どれにも該当しないキーを押したときは、エスケープキー(1BH)を押したことにする。
	JP SCAN_LOOP_RETURN

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; キーの押下が解放されるまで待つサブルーチン
;

KEY_BREAK_WAIT:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
BREAK_SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	IN A,(C)
	AND (HL) ; INIでスキャンした結果と照合。
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ BREAK_SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを0にする。
	LD B,0FH
	LD E,0H

BREAK_KEY_LOOP:
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	ADD A, E 
	LD E, A ; Eにキースキャンの値を積算する。
	INC D ; インデックスをインクリメント
	INC HL ; ポインタをインクリメント
	DJNZ BREAK_KEY_LOOP
	LD A,E ; キースキャンの値の総和をAに戻す。
	AND A ; ゼロかどうか判定の為、自分自身でANDをとる。
	RET Z ; 全てのキーボードポートが0の時にリターンする。
	JR KEY_BREAK_WAIT

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; SHIFTキーと同時に押されたキーをゲットするサブルーチン
;

SHIFT_KEY_NEXT_GET:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
SHIFT_SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	IN A,(C)
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ SHIFT_SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを 1 にする。
	LD B,0FH ; B=FH=16
	LD E,0H

;
; SHIFTキーを離すか、他のキーが押されるまではループする。
;

SHIFT_NEXT_KEY_LOOP:
	LD A, (PORT_INDEX)
	AND A
	LD A,1BH
	RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
	INC HL
	INC D
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	AND A
	JR NZ, SHIFT_KEY_LOOP ; キーが押下されている時はジャンプする。
	LD A,D
	CP 0FH ; D=A=16バイトチェックしたか？
	JR Z, SHIFT_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
	JR SHIFT_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
	
SHIFT_KEY_LOOP:
	CP 04H
	JP Z, CODE_04_SHIFT
	CP 08H
	JP Z, CODE_08_SHIFT
	CP 10H
	JP Z, CODE_10_SHIFT
	CP 20H
	JP Z, CODE_20_SHIFT


CODE_04_SHIFT:
	LD A,L
	AND 0FH

	CP 01H
	JP Z, CODE_1_SHIFT
	CP 02H
	JP Z, CODE_2_SHIFT
	CP 03H
	JP Z, CODE_3_SHIFT
	CP 04H
	JP Z, CODE_4_SHIFT
	CP 05H
	JP Z, CODE_5_SHIFT
	CP 06H
	JP Z, CODE_6_SHIFT
	CP 07H
	JP Z, CODE_7_SHIFT
	CP 08H
	JP Z, CODE_8_SHIFT
	CP 09H
	JP Z, CODE_9_SHIFT

CODE_08_SHIFT:
	LD A,L
	AND 0FH

	CP 0BH
	JP Z, CODE_AT_MARK_SHIFT
	CP 0CH
	JP Z, CODE_L_SQ_PAR_SHIFT

CODE_10_SHIFT:
	LD A,L
	AND 0FH

	CP 0AH
	JP Z, CODE_SEMI_COLON_SHIFT
	CP 0BH
	JP Z, CODE_COLON_SHIFT
	CP 0CH
	JP Z, CODE_R_SQ_PAR_SHIFT

CODE_20_SHIFT:

	LD A,L
	AND 0FH

	CP 09H
	JP Z, CODE_COMMA_SHIFT
	CP 0AH
	JP Z, CODE_PERIOD_SHIFT
	CP 0BH
	JP Z, CODE_SLASH_SHIFT

	LD A,0H
	RET

CODE_1_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '!'
	RET
CODE_2_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, 22H
	RET
CODE_3_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '#'
	RET
CODE_4_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '$'
	RET
CODE_5_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '%'
	RET
CODE_6_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '&'
	RET
CODE_7_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, 27H ; 27Hは "'" 。シングルクォーテーション。
	RET
CODE_8_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '('
	RET
CODE_9_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, ')'
	RET

CODE_AT_MARK_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '`'
	RET
CODE_L_SQ_PAR_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '{'
	RET
CODE_SEMI_COLON_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '+'
	RET
CODE_COLON_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '*'
	RET
CODE_R_SQ_PAR_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '}'
	RET
CODE_COMMA_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '<'
	RET
CODE_PERIOD_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '>'
	RET
CODE_SLASH_SHIFT:
	CALL KEY_BREAK_WAIT
	LD A, '?'
	RET


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; Controlキーと同時に押されたキーをゲットするサブルーチン
;

CONTROL_KEY_NEXT_GET:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
CONTROL_SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	IN A,(C)
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ CONTROL_SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを 1 にする。
	LD B,0FH ; B=FH=16
	LD E,0H

;
; Controlキーを離すか、他のキーが押されるまではループする。
;

CONTROL_NEXT_KEY_LOOP:
	LD A, (PORT_INDEX)
	AND A
	LD A,1BH
	RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
	INC HL
	INC D
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	AND A
	JR NZ, CONTROL_KEY_LOOP ; キーが押下されている時はジャンプする。
	LD A,D
	CP 0FH ; D=A=16バイトチェックしたか？
	JR Z, CONTROL_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
	JR CONTROL_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
	
CONTROL_KEY_LOOP:
	CP 08H
	JP Z, CODE_08_CONTROL
	CP 10H
	JP Z, CODE_10_CONTROL
	CP 20H
	JP Z, CODE_20_CONTROL


CODE_08_CONTROL:
	LD A,L
	AND 0FH

	CP 03H
	JP Z, CODE_E_CONTROL
	CP 04H
	JP Z, CODE_R_CONTROL
	CP 07H
	JP Z, CODE_U_CONTROL
	CP 0AH
	JP Z, CODE_P_CONTROL

CODE_10_CONTROL:
	LD A,L
	AND 0FH

	CP 02H
	JP Z, CODE_S_CONTROL

CODE_20_CONTROL:
	LD A,L
	AND 0FH

	CP 01H
	JP Z, CODE_Z_CONTROL
	CP 02H
	JP Z, CODE_X_CONTROL
	CP 03H
	JP Z, CODE_C_CONTROL

	LD A,0H
	RET


CODE_E_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 05H
	RET
CODE_C_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 03H
	RET
CODE_P_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 10H
	RET
CODE_R_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 12H
	RET
CODE_S_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 13H
	RET
CODE_U_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 15H
	RET
CODE_X_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 18H
	RET
CODE_Z_CONTROL:
	CALL KEY_BREAK_WAIT
	LD A, 1AH
	RET



;#BRKEY（1FCDH）の本体
; ^Cチェックします（入力待ちなし、エコー･バックなし）。
;入力	なし
;出力	ZF＝1なら^Cが押されています
;破壊	AF
;注：
; 常にオート･リピートがかかっています。
; フィジカル･ルーチンreal_time_input_key_entity（AF，HL，DE，BC破壊）を呼び出します。
; ^C（03H）とESC（1BH）をブレイク･キーとみなします。
check_break_key:
	CALL	GETKY
	CP	03H	;^C
	JR	Z,BRKRET
	CP	1BH	;ESC
	JR	Z,BRKRET
	OR	0FFH	;ZF←0，CY←0
BRKRET:
	; POP	BC
	; POP	DE
	; POP	HL
	RET


;#PAUSE（1FC7H）の本体
; ポーズ処理。
; どのタイミングでも、
;^Cが入力されればインライン･パラのアドレスにジャンプします。
;何もキーが押されていなければ、そのままリターンします。
; スペースが押されれば一時停止し、他のキーが押されればリターンします。
;入力	「CALL ＃PAUSE」の次のアドレス←^C入力時の飛び先
;出力	なし
;破壊	AF
PAUSE:
	EX	(SP),HL	;スタック←HL，HL←インライン･パラのアドレス
	PUSH	DE
	PUSH	BC
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(PAURET),HL	;リターン･アドレス
	LD	(PAUREB),DE	;インライン･パラ
	CALL	check_break_key
	JR	Z,PAUBRK
	CALL	GETKY ;リアルタイムキー。何も押されていない時は、Aレジスタに0をセットして、リターンする。
	CP	' ' ;スペースか？
	JR	NZ,PAUESC

PAULP:
	CALL	check_break_key
	JR	Z,PAUBRK
	CALL	GETKY
	OR	A
	JR	Z,PAULP
	CP	' '
	JR	Z,PAULP

PAUESC:	POP	BC
	POP	DE
	POP	HL
	XOR	A
	DB	0C3H	;「JP」
PAURET:	DS	2

PAUBRK:	POP	BC
	POP	DE
	POP	HL
	XOR	A
	DB	0C3H	;「JP」
PAUREB:	DS	2


;#INKEY（1FCAH）の本体
; 何かキーを押すまでキー入力待ちをする。キー入力があるとリターンする。
; キー入力（入力待ちあり、エコー･バックなし）。
;入力	なし
;出力	Acc←文字
;破壊	AF
;注：
INKEY:
	PUSH DE
	PUSH IX
INKEY_WAIT_LOOP:
	CALL KEY_SCAN_WRAPPER
	; Accにキーコードが入っているか？
	CP	0
	JR	Z,INKEY_WAIT_LOOP ; 0なら、キー入力待ちループ
	POP IX
	POP DE
	RET


;#FLGET（2021H）の本体
; カーソル表示つき、キー入力（入力待ちあり、エコー･バックなし）。
;入力	なし
;出力	Acc←文字
;破壊	AF
FLGET:
	PUSH DE
	PUSH IX
	CALL KEY_SCAN_WRAPPER
	POP IX
	POP DE
	RET

;#GETL（1FD3H）の本体
; 文字列入力。
;入力	DE←キー入力バッファの先頭アドレス
;出力	[DE～]←文字列
;破壊	AF
;注：
; DEレジスタにキー入力バッファの先頭アドレスをセットしてコールすると、
; キーボードから1行入力して文字列をバッファに格納しリターンする。
; エンド･コードは00H。
; 入力がキャンセルされた場合、「1BH、00H」がバッファの先頭に格納されます。
; 入力待ちあり、エコー･バックあり。
GETL:
	PUSH	DE
GETL_LOOP:
	CALL INKEY ; キー入力待ち
	LD	(DE),A ; バッファに格納
	PUSH AF
	PUSH HL
	PUSH DE
	PUSH BC

	CALL CONOUT_PROCESS

	POP	BC
	POP	DE
	POP	HL
	POP	AF
	CP	CR ; キャリッジ･リターンか？
	JR	Z,GETL_END ; CRコードならエンドコード00Hを入れて終了
	CP BS ; バックスペースか？
	JR	Z,GETL_BS ; バックスペース処理へ
	INC	DE
	JR	GETL_LOOP
GETL_END:
	LD A, 0
	LD (DE),A ; エンドコード00H

	POP	DE
	RET

GETL_BS:
	; バッファの先頭なら何もしない。
	LD	A,(DE)
	OR	A
	JR	Z,GETL_LOOP
	DEC	DE ; バッファ･ポインタを1つ戻す
	JR	GETL_LOOP
;===============================
;ファイル操作（ファイル名処理）
;===============================


;#FPRNT（1F9DH）の本体
; S-OSのFCBバッファのファイル名を表示します（改行しません）。
; ポーズ機能あり。
;入力	S-OSのFCBバッファ（fcb_buffer～）参照
;出力	なし
;破壊	AF，HL，DE，BC
; FPRNT:
print_file_name:
	LD	DE,fcb_buffer+1

;	プライマリ名の表示
	LD	B,13
FPRLP1:
	LD	A,(DE)
	INC	DE
	CALL	PRINT
	DJNZ	FPRLP1

;	ピリオドの表示
	LD	A,'.'
	CALL	PRINT

;	拡張子の表示
	LD	B,3
FPRLP2:	LD	A,(DE)
	INC	DE
	CALL	PRINT
	DJNZ	FPRLP2

	CALL	PAUSE
	DW	$+2
	RET


;#FSAME（1FA0H）の本体
; ＃FILE（1FA3H）でセットされたファイル名、ファイル属性と、
;DE～にセットされた解析されてないないファイル名（エンド･コード00H）、
;ファイル属性（Acc）を比較します。
;入力	Acc←ファィル属性、DE←文字列（ファイル名）の先頭
;	S-OSのFCBバッファ（fcb_buffer～）参照
;出力	一致すればZF＝1（Acc←0）、不一致ならZF＝0（Acc←8）
;破壊	AF，HL，DE，BC
;注：
; 入力パラメータに、ファイル属性（Acc）が必要。
; CYは常にリセットされています。
FSAME:
;	ファイル属性の比較
	AND	10000111B	;マスク
	LD	B,A	;B←マスクされたファイル属性
	LD	A,(_FTYPE)	;Acc←セットされたFCBのファイル属性
	AND	10000111B	;マスク
	CP	B
	JP	NZ,FSMERR	;ファイル属性が一致しない

;	[BUFFER～]にデバイス名とファイル名を解析してセットします
	CALL	FNAME	;ファイル名を解析します
	RET	C	;デバイス名が異常（エラー3）

;	デバイス名の比較
	LD	A,(_DSK)
	LD	HL,BUFFER
	CP	(HL)
	JR	NZ,FSMERR

;	ファイル名（プライマリ，拡張子）の比較
	LD	DE,fcb_buffer+1	;比較されるファイル名
	LD	HL,BUFFER+1	;比較するファイル名
	LD	A,16
	CALL	CMPFNM	;ファイル名を比較します
	RET	Z

;	一致しませんでした
FSMERR:	LD	A,8	;File not Found
	OR	A	;ZF←0
	SCF
	RET


;#FILE（1FA3H）の本体
; ファイル名を解析して、各ワークにパラメータをセットします。
;入力	Acc←ファィル属性、DE←文字列（ファイル名）の先頭
;出力	[_DSK]←デバイス名、[_FTYPE]←ファイル属性、
;	S-OSのFCBバッファ←変換されたファイル名
;	DEは00Hか「:」のアドレスを示しています。
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
;注：
; CY＝0でリターンしています。
; ファイル名はコントロール･コードなどがカットされ、
;「*」は「?」に展開されます。
FILE:
	LD	(_FTYPE),A	;ファイル属性（ファイル名の解析でセットされます）
	LD	(fcb_buffer),A	;FCBのファイル属性部分（＋0）
	CALL	FNAME	;ファイル名を解析します
	RET	C	;デバイス名が異常（エラー3）
	PUSH	DE
	LD	A,(BUFFER)	;Acc←デバイス名
	LD	(_DSK),A
	LD	HL,BUFFER+1	;解析されたファイル名
	LD	DE,fcb_buffer+1	;FCBのファイル名フィールド
	LD	BC,16
	LDIR		;FCBのファイル名部分（＋1～＋16）
	LD	A,20H
	LD	(DE),A	;FCBのパスワード部分（＋17）
	POP	DE
	CALL	space_char_skip	;文字列の空白を読み飛ばします
	XOR	A	;CY←0
	RET


;===============================
;ファイル名処理補助ルーチン
;===============================


;ファイル名を比較します
;入力	DE←比較されるファイル名の先頭、HL←比較するファイル名の先頭、
;	Acc←カウンタ
;出力	ZF＝1なら一致
;破壊	AF，HL，DE，BC
;注：ワイルド･カードの「?」は常に一致とみなします。
CMPFNM:
	LD	B,A	;B←カウンタ
	EX	DE,HL

;	比較ループ
CPFLP:	LD	A,(DE)	;Acc←比較する文字
	CP	'?'
	JR	Z,CPFSKP	;常に一致させます
	CP	(HL)
	RET	NZ	;一致しませんでした
CPFSKP:	INC	DE
	INC	HL
	DJNZ	CPFLP

;	すべて一致
	XOR	A	;ZF←1
	RET


;ファイル名を解析します
;入力	DE←文字列（ファイル名）の先頭
;出力	[BUFFER]←デバイス名、[BUFFER＋1～]←変換されたファイル名
;	DEはカウント･アップされます（区切りでストップ）
;	CY＝1（Acc←エラー･コード）ならエラー
;破壊	AF，HL，DE，BC
FNAME:
;	デバイス名の転送
	CALL	MGETDV	;文字列からデバイス名を取り出します
	CALL	_DVCHK	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;Acc←3 'Bad File Descripter
	LD	HL,BUFFER
	LD	(HL),A	;[BUFFER]←デバイス名
	INC	HL	;HL←BUFFER＋1

;	ファイル名の転送
	CALL	CLRWFG
	LD	B,13	;プライマリ名
	INC DE; コマンド名を1文字読み飛ばす。
FNML11:
	CALL	GTFLTR
	LD	(HL),A
	INC	HL
	DJNZ	FNML11
	CALL	SKPPRD
	CALL	CLRWFG
	LD	B,3	;拡張子
FNML12:	CALL	GTFLTR
	LD	(HL),A
	INC	HL
	DJNZ	FNML12
	CALL	SKPPRD

	XOR	A	;CY←0
	RET


;文字列からデバイス名を取り出します
;入力	DE←文字列の先頭アドレス
;出力	Acc←デバイス名（省略時はデフォルト、小文字は大文字に変換）
;	CY＝1ならデバイス名が省略されていました
;	DEはカウント･アップされます
;破壊	AF，DE
MGETDV:
	CALL	space_char_skip	;文字列の空白を読み飛ばします
	LD	A,(DE)
	OR	A
	JR	Z,MGTDV1	;文字列の終わりに達していました
	INC	DE
	LD	A,(DE)
	DEC	DE
	CP	':'
	JR	NZ,MGTDV1	;デバイスが指定されていません

;	デバイスが指定されています
	LD	A,(DE)
	CALL	convert_lower_case_to_upper_case
	INC	DE
	INC	DE
	OR	A	;CY←0
	RET

;	デバイスが指定されていません
MGTDV1:
	CALL	_RDVSW
	SCF		;CY←1
	RET


;GTFLTRルーチンの「*」モードを初期化します
;入力	なし
;出力	[WASFLG]←0
;破壊	AF
CLRWFG:
	XOR	A
	LD	(WASFLG),A
	RET


;文字列からファイル名（プライマリ，拡張子）を1文字取り出します
;入力	DE←文字列のアドレス
;出力	Acc←変換された文字（区切りに達した場合はスペースに変換されます）
;	DEはカウント･アップされます（区切りでストップ）
;破壊	AF，DE
;注：
; 00H、0DH、「:」、「.」を区切りとみなします。
; コントロール･コードやスペースはスキップします。
; 「*」フェイズでは「?」を返します。
GFLLP:	INC	DE

GTFLTR:
;	「*」フェイズかチェックします
	LD	A,(WASFLG)
	OR	A
	JR	NZ,GFLWLD

	LD	A,(DE)	;Acc←1文字

;	区切りに達したか調べます
	OR	A	;NUL
	JR	Z,GFLESC
	CP	0DH	;RET
	JR	Z,GFLESC
	CP	':'
	JR	Z,GFLESC
	CP	'.'
	JR	Z,GFLESC

;	コントロール･コードとスペースをスキップします
	LD	A,(DE)
	CP	7FH	;DEL
	JR	Z,GFLLP
	CP	21H	;00H～20H
	JR	C,GFLLP

;	「*」かチェックします
	CP	'*'
	JR	Z,GFLAST

;	通常終了
	INC	DE	;DEのカウント･アップ
	; JP	convert_lower_case_to_upper_case
	RET

;	「*」を発見しました
GFLAST:	LD	A,0FFH
	LD	(WASFLG),A
	INC	DE

;	「*」フェイズ
GFLWLD:	LD	A,'?'
	RET

;	ピリオドかファイル名の最後に達しました
GFLESC:	LD	A,' '
	RET

;	ワイルド･カード関係
WASFLG:	DS	1	;＝FFHで「*」フェイズ中


;ファイル名のピリオド部（プライマリと拡張子の区切り）をスキップします
;入力	DE←文字列のアドレス
;出力	DEはカウント･アップされます（区切りでストップ）
;破壊	AF，DE
;注：
; 00H、0DH、「:」を区切りとみなします。
; コントロール･コードやスペースはスキップします。
SKPLP:	INC	DE

SKPPRD:
	LD	A,(DE)	;Acc←1文字

;	区切りに達したか調べます
	OR	A	;NUL
	RET	Z
	CP	0DH	;RET
	RET	Z
	CP	':'
	RET	Z

;	ピリオドに達したか調べます
	CP	'.'
	JR	NZ,SKPLP

;	ピリオドをスキップ
	INC	DE
	RET


