;〈注意〉
; テープはサポートしません。
; #PRCNT（1F7AH）はサポートしません。

; ;	ＤＯＳモジュール内部エントリ
; ERROR	EQU	286CH

;	バッチ処理バッファ
; BATBF	EQU	2D00H	;バッチ･ファイル用リード･バッファ（2D00H～2DFFH）
; BPRBF	EQU	204BH	;バッチ変数バッファ（204BH～20FEH）


;
; CRTC ports
;
VRAM_TXT_TOP EQU 0F800H ; VRAM上で画面左上を指すアドレス
VRAM_ATR_TOP EQU 0F000H ; アトリビュートの先頭アドレス
CRTC_ADD EQU 0F0H ; CRTCアドレス･ポート
CRTC_VAL EQU 0F1H ; CRTCデータ･ポート
WIDTH_SCREEN EQU 50H ; 80文字モードの1行のバイト数
CURSOR_XY_ADDR EQU FF00H ; カーソルのX,Y座標を保存するアドレス

; Ascii code Constants
CR	EQU	0DH ; Carriage Return
LF	EQU	0AH ; Line Feed
BS	EQU	08H ; Back Space
DEL	EQU	7FH ; Delete
HT  EQU 09H ; Horizontal Tab
VT  EQU 0BH ; Vertical Tab
BEL EQU 07H ; Bell
NP  EQU 0CH ; Formfeed (also: New page NP)
ESC EQU 1BH ; Escape

;〈SLANGについて〉
; SLANGは、特殊ワークのサイズによっては動作しません。
;SLANGの3014H～3015H番地の内容が、
;特殊ワーク上の大局テーブルの先頭アドレスをさしているので、
;特殊ワークのサイズのために動かない場合は、
;若い番地へ移動して対応してください。

	ORG	0000H
	JP	START	;初期化
	ORG	0066H
	JP	START	;NMIでリスタート

	ORG	0100H


;=======================
;汎用バッファ
;=======================


;	0100H（256バイト）
BUFFER:	DS	256


;=======================
;文字列入力バッファ
;=======================


;	0100Hバイト
keyboard_buffer:	DS	256


;=======================
;キー入力バッファ
;=======================


;	0080H（128バイト）
input_key_buffer:	DS	127	;キー入力バッファ（127文字分）
pointer_for_write_key_buffer:	DS	1	;キーを書き込むポインタ（＝0でカラ、＝7FHでいっぱい）

;=======================================
;コントロール･コード･ジャンプ･テーブル
;=======================================


;	0040H（64バイト）
control_code_jump_tabel:
	DW	control_code_NULL	;^＠
	DW	CTL01				;^A 'カーソルを論理行頭へ（-^V）
	DW	control_code_NULL	;^B '前のワードの先頭へ（－^F） '非サポート
	DW	CTLCAN				;^C ^STOP（論理改行＆インサート解除）
	DW	control_code_DELETEL;^D '論理行のカーソル位置の文字の削除（DELキー）
	DW	CTL05				;^E '論理行のカーソル以降削除（－^U）
	DW	control_code_NULL	;^F '次のワードの先頭へ（－^B） '非サポート
	DW	BELL				;^G BELL
	DW	control_code_BS		;^H BS
	DW	control_code_TAB	;^I TAB
	DW	control_code_NULL	;^J LF
	DW	control_code_HOME	;^K HOME
	DW	control_code_CLS	;^L CLR
	DW	CTLCR				;^M CR＋LF
	DW	control_code_NULL	;^N '論理行分割（－^W） '非サポート
	DW	control_code_NULL	;^O '物理行注入（－^Y） '非サポート
	DW	control_code_NULL	;^P
	DW	control_code_NULL	;^Q
	DW	control_code_INS	;^R INS
	DW	control_code_ROLL_UP	;^S 'スクロール･アップ（－^S）
	DW	control_code_ROLL_DOWN	;^T 'スクロール･ダウン（－^T）
	DW	control_code_NULL	;^U '論理行のカーソルより前削除（－^E） '非サポート
	DW	control_code_NULL	;^V 'カーソルを論理行末へ（－^A、最後の文字の次のカーソル位置) '非サポート
	DW	control_code_NULL	;^W '次の行と連結（－^N、,論理行末と次の行の行頭をつなぐ) '非サポート
	DW	control_code_NULL	;^X SELECT
	DW	control_code_NULL	;^Y '物理行削除（－^O） '非サポート
	DW	control_code_NULL	;^Z
	DW	CTLCAN				;^［ ESC
	DW	control_code_Right	;^￥ →
	DW	control_code_Left	;^］ ←
	DW	control_code_Up		;^＾ ↑
	DW	control_code_Down	;^＿ ↓


;=======================================
;カーソル･オフセット計算用テーブル下位
;=======================================
;y座標に対応するカーソル･オフセットを得ます
;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]


;	0020H（32バイト）
cursor_offset_for_Y_table:	DS	32


;===============================
;システム･スタック･エリア
;===============================


;	00CCH（204バイト）
	DS	256-52
system_stack_area:


;*******	256バイト境界	********


;=======================================
;カーソル･オフセット計算用テーブル上位
;=======================================
; y座標に対応するカーソル･オフセットを得ます。
;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]


;	0020H（32バイト）
	DS	32


;=======================
;内部ワーク･エリア
;=======================


;	0050H（80バイト）
fcb_buffer:	DS	32	;S-OSのFCBバッファ（[_IBFAD]でポイント）

;	通常（42バイト）
total_number_of_character_display:	DS	2	;画面の表示文字数
cursor_offset_last_top_of_line:	DS	2	;最終行先頭のカーソル･オフセット
vram_address_of_top:	DS	2	;テキストVRAM先頭アドレス（未使用の場合あり）
vram_address_of_top_of_last_line:	DS	2	;最終行先頭のテキストVRAMアドレス（未使用の場合あり）
locate_of_cursor_overlap_character:	DS	1	;カーソルと重なった位置の文字の保存（未使用の場合あり）
screen_width:	DS	1	;＝00Hで40桁、＝FFHで80桁 -> M23では80桁固定なので、常にscreen_width=FFHとなる。
CSRADD:	DS	2	;（行数－1）×256＋桁数
CSRNXI:	DS	1	;256－桁数 '[CSRNX]の初期値 -> M23では桁数80固定なので、CSRNXI=CSRNXとなる。
CSRNYI:	DS	1	;256－行数 '[CSRNY]の初期値-> M23では行数25固定なので、CSRNYI=CSRNYとなる。
CSRNX:	DS	1	;x座標-[_WIDTH] _WIDTHは80
CSRNY:	DS	1	;y座標-[_MXLIN] _MXLINは25
display_cursor_XY_not_use:	DS	2	;カーソル座標（使用しません）
number_of_character_after_CR:	DS	1	;改行してからの文字数（未使用）
insert_mode_flag:	DS	1	;＝00Hで通常、＝FFHでインサート･モード
foreground_color:	DS	1	;前景色
background_color:	DS	1	;背景色
BDR_color:	DS	1	;周辺色
attribute_data:	DS	1	;画面のアトリビュートRAMへ書き込むデータ
real_time_key:	DS	1	;リアル･タイム･キー（未使用の場合あり）
GRAFLG:	DS	1	;＝FFHでグラフィック表示（未使用の場合あり）

vram_size:	DS	2	;VRAMのサイズ÷100H
top_of_special_work_of_vram:	DS	2	;VRAM上の特殊ワークの先頭÷100H
size_of_special_work_of_vram:	DS	1	;VRAM上の特殊ワークのサイズ÷100H
top_of_ram_disk_of_vram:	DS	2	;VRAM上のRAMディスクの先頭÷100H
size_of_ram_disk_of_vram:	DS	2	;VRAM上のRAMディスクのサイズ÷100H
top_of_special_work_of_memory:	DS	1	;メモリ上の特殊ワークの先頭÷100H
size_of_special_work_of_memory:	DS	1	;メモリ上の特殊ワークのサイズ÷100H

;	機種独自（6バイト）
KEYDAT:	DS	2	;ファンクション、アスキー･コードの生データ
IO1FD0:	DS	1	;I／O 1FD0Hのバッファ


	ORG	(($+7FH) & 0FF80H)
;-----------------------
;割り込みルーチン
;-----------------------

;=======================
;キー･スキャン･ルーチン
;=======================

;キー入力割り込み処理
KEYINT:
; 	LD	(KYIRSP),SP
; 	LD	SP,INTSTK	;割り込み用スタック
; 	PUSH	AF
; 	PUSH	HL
; 	PUSH	DE
; 	PUSH	BC

; ;	キーが有効かチェックします
; 	LD	A,(KEYDAT)	;ファンクション
; 	BIT	6,A
; 	JR	NZ,KYIRET	;キーがはなされた
; 	AND	00100000B	;b5
; 	JR	NZ,KYISKP
; 	LD	A,(pointer_for_write_key_buffer)
; 	OR	A
; 	JR	NZ,KYIRET	;バッファにカラでないときは、リピート禁止
KYISKP:
;	キー入力バッファに書き込みます
	; LD	A,(real_time_key)	;Acc←入力文字
	; CALL	write_one_character_to_key_buffer
	; JR	C,KYIRET	;バッファがいっぱいだった

KYIRET:
	; POP	BC
	; POP	DE
	; POP	HL
	; POP	AF
	; DB	31H	;「LD SP,」
KYIRSP:	DS	2
	; EI
	RETI


;キー入力バッファに1文字書き込みます
;入力	Acc←文字
;出力	キー入力バッファ←文字
;	CY＝1でバッファがいっぱいだった
;破壊	AF，HL，DE，BC
;注：
; 割り込み禁止して実行してください。
; キー入力バッファは、00xxHから始まる127バイトで、
;＋127の部分がpointer_for_write_key_bufferにあたります。
write_one_character_to_key_buffer:
	; LD	HL,pointer_for_write_key_buffer
	; LD	E,(HL)
	; LD	D,H	;DE←書き込みポイント
	; LD	(DE),A	;キー入力バッファ←文字
	; INC	E
	; JP	M,PKYBRK
	; LD	(HL),E	;[pointer_for_write_key_buffer]のカウント･アップ
	; OR	A	;CY←0
	RET
PKYBRK:
	; LD	(HL),L	;[pointer_for_write_key_buffer]を元に戻します
	; SCF
	RET


	ORG	(($+0FFH) & 0FF00H)


;*******	256バイト境界	********


;===============================
;ライン･ターミナル･テーブル
;===============================


; 先頭行の行連結情報はxx00Hのアドレスに格納されます。
;行連結情報←LINTTB＋y座標（0～）
; FFHで次の行と連結。
;	0020H（32バイト）
LINTTB:	DS	32


;-----------------------
;S-OSルーチン
;-----------------------

;=======================
;システム･ルーチン
;=======================


;#COLD（1FFDH）の本体
; コールド･スタートして、[_USR]のアドレスにジャンプします。
;[_USR]の内容は、「_HOT」に初期化します。
;注：
; プリンタ非出力モードにします。
; 「RET」命令で、「_HOT」にジャンプします。
; キー入力バッファをカラにして、そのアドレスをDEで渡す。
; 固有の初期化ルーチンの cold_start_entity（全レジスタ破壊）を呼び出します。
; 固有のメッセージ「title_message」を参照します。
COLD:
;	初期化
	LD	SP,(_STKAD)
	DI
	; IM	2
	CALL CRT_INIT			;CRTCの初期化
	EI

;	スタックの設定など
	LD	HL,FFFFH
	LD	(_MEMAX),HL	;使用可能メモリの上限
	LD	HL,system_stack_area
	LD	(_STKAD),HL

;	特殊ワークのサイズの初期化
	LD	A,(size_of_special_work_of_vram)
	LD	L,0
	LD	H,A	;HL←特殊ワークのサイズ
	LD	(_WKSIZ),HL	;[_WKSIZ]の初期化


;	キー入力バッファのクリア
	CALL	clear_key_buffer ; インデックスポインタを0にしているだけ。

;	ディスクのパラメータの初期化
	; LD	HL,000EH ; 
	; LD	(_FATPS),HL
	; LD	HL,0010H ; ディレクトリ情報が記録されているトラック番号
	; LD	(_DIRPS),HL
	; LD	HL,2E00H
	; LD	(_FATBF),HL
	; LD	HL,2F00H ; ディスクI／Oバッファ
	; LD	(_DTBUF),HL
	; LD	A,80 ; 最大トラック数
	; LD	(_MXTRK),A

;	ディスクI／O初期化
	; CALL	SOSSI



;	タイトル表示
	LD	DE,title_message
	CALL _MSX

;	メモリの情報を表示
	CALL _MPRNT
	DB	'MAIN 3000H-',00H
	LD	HL,(_MEMAX)
	DEC	HL
	CALL _print_hex_4_digit
	CALL _MPRNT
	DB	'H',0DH,00H
	CALL _MPRNT
	DB	'WORK 0000H-',00H
	LD	HL,(_WKSIZ)
	DEC	HL
	CALL _print_hex_4_digit
	CALL _MPRNT
	DB	'H',0DH,00H

;	文字列入力バッファの80バイトをクリア
	LD	HL,(_KBFAD)
	LD	E,L
	LD	D,H
	INC	DE	;DE←[_KBFAD]＋1
	LD	BC,79
	LD	(HL),B	;[_KBFAD]←0
	LDIR

;	ホット･スタートへ
	LD	HL,(_USR)
	EX	DE,HL	;DE←ジャンプ先
	LD	HL,_HOT
	PUSH HL	;戻りアドレス（_HOT）
	LD	(_USR),HL	;[_USR]の再設定
	EX	DE,HL	;HL←ジャンプ先
	LD	DE,(_KBFAD)	;DE←[_KBFAD]
	XOR	A
	JP	(HL)	;旧[_USR]の内容にジャンプ

;#BOOT（2036H）の本体
; S-OSを終えます。
;注：フィジカル･ルーチンboot_entity（全レジスタ破壊）を呼び出します。

	DS	3

;コールド･スタート時のメッセージ
title_message:
	DB	'<<<<< S-OS  SWORD >>>>>',CR
	DB	00H


BOOT:
	JP	boot_entity


;===============================
;バージョン･ナンバーの取り出し
;===============================

;#VER（1FF7H）の本体
; Hに機種別情報、LにS-OSのバージョンを返します。
;入力	なし
;出力	H←機種別情報、L←S-OSのバージョン
;破壊	HL
;〈機種別情報〉
;00H	MZ-80K／C／1200
;01H	MZ-700
;02H	MZ-1500
;10H	MZ-80B
;11H	MZ-2000／2200
;12H	MZ-2500
;20H	X1
;21H	X1turbo
;22H	X1（筑紫版）
;30H	PC-8801（ROM）
;31H	PC-8001
;32H	PC-8801（オールRAM）
;40H	FM-7／77
;50H	SMC-777
;60H	PASOPIA
;61H	PASOPIA7
;70H	PC-286
;80H	X68000
;90H	MSX／2／2＋／turboR（ANK専用版）
;91H	MSX／2／2＋／turboR（漢字対応版）
;95H	SORD M23
;〈S-OSのバージョン〉
; SWORDでは、「20H」。
VER:
	PUSH	AF
	PUSH	DE
	PUSH	BC
	LD	HL,9520H	;SORD M23，S-OS V2.0
	POP	BC
	POP	DE
	POP	AF
	RET


;===============
;表示ルーチン
;===============



;#PRNTS（1FF1H）の本体
; スペースを1つ表示します。
;入力	なし
;出力	なし
;破壊	F（実際なし）
PRNTS:
	PUSH	AF
	LD	A,' '
	CALL _PRINT
	POP	AF
	RET


;#LTNL（1FFEH）の本体
; 改行します。
;入力	なし
;出力	なし
;破壊	なし
LTNL:
	PUSH	AF
	LD	A,0DH
	CALL _PRINT
	POP	AF
	RET


;#NL（1FEBH）の本体
; 行頭でなければ、改行します。
;入力	なし
;出力	なし
;破壊	なし
;注：
; 行頭でなければ改行します。
; このサブルーチンを書いて下さい。
NL:
	PUSH DE
	PUSH BC

	CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
	; cursor_XY_ADDRからX座標を取得
	LD	HL,(cursor_XY_ADDR+2)		; HLにX座標をロード (2バイト)
	; cursor_XY_ADDR+2からY座標を取得
	LD	DE,(cursor_XY_ADDR)		; DEにY座標をロード (2バイト)
	OR	A ; フラグをクリア
	CP	L ; X座標が0かチェック
	JR	Z,NLRET	; X座標が0ならリターン
	CALL LTNL ; 改行を実行
NLRET:
	POP	BC
	POP	DE
	RET


;
;#MSG（1FE8H）の本体
; DEレジスタの示すアドレスから0DHが出現するまでアスキーコードとみなし文字列表示する。
;入力	DE←文字列先頭アドレス
;出力	なし
;破壊	F（実際なし）
;注：0DHは表示しません。
; このサブルーチンを完成させてください。
MSG:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
MSGLP:
	LD	A,(DE) ; 文字を取得
	CP	0DH ; 改行コードか？
	JR	Z,MSGSKP	; 改行コードなら終了へ
	CALL _PRINT ; 文字を表示
	INC	DE	; アドレスを一つ進める
	JR	MSGLP
MSGSKP:	
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

;#MSX（1FE5H）の本体
; DEレジスタの示すアドレスから00Hが出現するまでアスキーコードとみなし文字列表示する。
;入力	DE←文字列先頭アドレス
;出力	なし
;破壊	F（実際なし）
;注：00Hは表示しません。
MSX:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
MSXLP:
	LD	A,(DE) ; 文字を取得
	CP	00H ; 終了コードか？
	JR	Z,MSXSKP	; 終了コードなら終了へ

	CALL PRINT ; 文字を表示
	INC	DE	; アドレスを一つ進める
	JR	MSXLP
MSXSKP:	
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

;#MPRNT（1FE2H）本体
; このサブルーチンをコールした次のアドレスから00Hが出現するまでアスキーコードとみなし、文字列表示する。
;入力	「CALL ＃MPRNT」の次のアドレス～←文字列とみなす
;出力	なし
;破壊	AF，DE（実際AF）
;注：
; 00Hは表示しません。
; 「REDA」などがDE保存を期待しているので、DEを保存します。
; このサブルーチンを完成させてください。
MPRNT:
	EX	(SP),HL	;HL←インライン･パラのアドレス，スタック←HL
	PUSH DE
	PUSH BC
	EX	DE,HL ; DE←インライン･パラのアドレス
	CALL MSX ; DEの指す文字列を表示
MPRRET:
	EX	DE,HL ; HL←インライン･パラのアドレス，DE←元の値
	POP	BC
	POP	DE
	EX	(SP),HL	;スタック←インライン･パラの次のアドレス，HL←元の値
;	XOR	A
	RET

; TAB(1FDFH)の本体
; Bレジスタの値と、カーソルのX座標との差を計算して、その結果の数だけスペースを表示する。
TAB:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
	CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
	; cursor_XY_ADDRからX座標を取得
	LD	HL,(cursor_XY_ADDR+2)		; HLにX座標をロード (2バイト)
	; Bレジスタの値とX座標との差を計算
	LD	A,B
	SUB	L	; A = B - X座標
	JR	C,TABERR	; 結果が負ならエラー
	LD	L,A	; Lにスペース数をセット
	TABLP2:
	LD	A,' '
	CALL	_PRINT
	DEC	L
	JR	NZ,TABLP2 ; スペース数分ループ
	XOR	A	; CY=0
	JR	TABRET
TABERR:
	SCF	; CY=1
TABRET:
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	RET

; #LPRINT(1FDCH)の本体
; 未実装
LPRINT:
	RET

;===============
;16進数
;===============

;#PRTHX print_hex_2_digit（1FC1H）の本体
; Aレジスタの値を16進2桁で画面に表示する
;入力	Acc←データ
;出力	なし
;破壊	AF
; このサブルーチンを完成させてください。
print_hex_2_digit:
	PUSH AF	;保存
	LD	B,A	;Bにデータを保存
	SRL	A	;上位4ビットを取得
	SRL	A	; さらに1ビット右シフト
	SRL	A	; さらに1ビット右シフト
	SRL	A	; さらに1ビット右シフト
	CALL	ASC	; 上位4ビットを16進数アスキーコードに変換
	CALL	_PRINT	; 文字表示
	LD	A,B	;Bから元のデータを取得
	AND	0FH	; 下位4ビットを取得
	CALL	ASC	; 下位4ビットを16進数アスキーコードに変換
	CALL	_PRINT	; 文字表示
	POP	AF	;復元
	RET


;#print_hex_4_digit（1FBEH）の本体
; HLレジスタの値を16進4桁で表示する。
;入力	HL←データ
;出力	なし
;破壊	AF
; このサブルーチンを完成させてください。
print_hex_4_digit:
	LD	A,H ; HLの上位バイトをAにロード
	CALL	_print_hex_2_digit ; 2桁表示
	LD	A,L ; HLの下位バイトをAにロード
	JP	_print_hex_2_digit ; 2桁表示


;#ASC（1FBBH）の本体
; Aレジスタの下位4ビットの値を16進数で表したときのアスキーコードに変換してAレジスタに格納する。
;入力	Acc下位4ビット←データ
;出力	Acc←16進数表示のアスキーコード
;破壊	AF
; このサブルーチンを書いてください。
ASC:
	AND	0FH	; 下位4ビットを取得
	CP	10
	JR	C,ASCNUM
	ADD	A,'A'-10	; 10以上なら'A'～'F'に変換
	JR	ASCRET ; リターン
ASCNUM:
	ADD	A,'0'	; 0～9なら'0'～'9'に変換
ASCRET:
	RET

;#HEX（1FB8H）の本体
; Aレジスタの内容を16進数で表したときのアスキーコードとしてバイナリに変換し、Aレジスタに格納する。
;入力	Acc←16進数文字(アスキーコードで表現)
;出力	Acc←データ（0～15）
;	CY＝1（Acc＝14）ならエラー
;破壊	AF
;注：
; 小文字に対応。
; 汎用ルーチンconvert_lower_case_to_upper_case（AF破壊）を呼び出します。
HEX:
	CALL	convert_lower_case_to_upper_case
	SUB	'0' ; '0'のコードを引く
	JR	C,HEXERR ; '0'未満はエラー
	CP	10 ; 10未満か？
	JR	C,HEXESC ; 10未満なら正常終了
	CP	10+7	;7＝「A」－（「9」＋1）
	JR	C,HEXERR
	SUB	7 ; 10以上なら'A'～'F'を0～5に変換
	CP	16 ; 16以上はエラー
	JR	NC,HEXERR
HEXESC:	OR	A ; CY←0
	RET

HEXERR:	LD	A,14	;Bad Data
	SCF ; CY←1
	RET

;#2HEX（1FB5H）の本体
; DEレジスタの示すアドレスから2バイトの内容を、2桁の16進数で表現するアスキーコードとして、バイナリに変換し、HLに格納する。エラーがあればキャリフラグがセットされる。
;入力	[DE～]←16進文字2桁
;出力	Acc←データ
;	DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
;	CY＝1ならエラー
;破壊	AF，DE
;注：小文字に対応。
; このサブルーチンを完成させてください。
AHEX:
	LD	A,(DE) ; 16進1桁目取得
	CALL	HEX ; 1桁目変換
	JR	C,HEXERR ; エラーならリターン
	INC	DE ; DEカウントアップ
	LD	H,A ; Hに格納
	LD	A,(DE) ; 16進2桁目取得
	CALL	HEX ; 2桁目変換
	JR	C,HEXERR ; エラーならリターン
	INC	DE ; DEカウントアップ
	LD	L,A ; Lに格納
	RET


;#HLHEX（1FB2H）の本体
; DEレジスタの示すアドレスから4バイトの内容を、4桁の16進数で表現するアスキーコードとして、バイナリに変換し、HLに格納する。エラーがあればキャリフラグがセットされる。
;入力	[DE～]←16進文字4桁
;出力	HL←データ
;	DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
;	CY＝1ならエラー
;破壊	AF，HL，DE
;注：小文字に対応。
; このサブルーチンを完成させてください。
HLHEX:
	CALL	_2HEX ; 先頭2桁を変換
	JR	C,HEXERR ; エラーならリターン
	LD	H,L ; HLの上位に格納
	CALL	_2HEX ; 次の2桁を変換
	JR	C,HEXERR ; エラーならリターン
	LD	L,A ; HLの下位に格納
	RET



;===============
;スクリーン制御
;===============


;#CSR（2018H）の本体
; カーソル座標を読み出します。
;入力	なし
;出力	L←x座標、H←y座標
;破壊	HL
;注：CALC_CURSOR_XYを呼び出します。
CSR:
	PUSH	AF
	PUSH	DE
	PUSH	BC
	CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
	LD	HL,(cursor_XY_ADDR)		; LにX座標をロード (2バイト)
	POP	BC
	POP	DE
	POP	AF
	RET


;#LOC（201EH）の本体
; HLレジスタの値(L=X座標、H=Y座標)で指定するXY座標へカーソルの位置をセットする。
;入力	L←x座標、H←y座標
;出力	なし
;破壊	AF（実際F）
;注：
; 「WALRUS」がAccの保存を期待しているので、Accは保存します。
; 「ELFES IV」「TANGERINE」などでCYクリアが必要。
; このサブルーチンを完成させてください。
LOC:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
	; 現在HLが移動したいカーソルの位置を指さしている。
	; PRINT_CURSORはDEに現在のカーソルの位置が入っていることを期待している。
	EX DE,HL	; DE←移動先カーソル位置
	CALL	PRINT_CURSOR ; カーソル位置を設定
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	OR A	;CY←0
	RET


;#SCRN（201BH）の本体
; HレジスタにY座標、LレジスタにX座標を格納してコールすると、画面上におけるその座標の文字を読み込み、Aレジスタに格納する。
;入力	L←x座標、H←y座標
;出力	Acc←文字
;破壊	AF
;注：
; CYをクリアします。
; このサブルーチンを完成させてください。
SCRN:
	PUSH	HL
	PUSH	DE
	PUSH	BC
; VRAMにアクセスして、カーソル位置DEにある通常文字のアスキーコードを得る。
	OUT (0D2H),A ; access to RAM page 1
	LD A,(DE) ; get character
	POP	BC
	POP	DE
	POP	HL
	OR	A	;CY←0
	RET


;#WIDCH（2030H）の本体
; 表示桁数を変更します。SORD M23ではサポートしません。
;入力	Acc←桁数
;出力	なし
;破壊	AF，HL，DE，BC
; CY＝0でリターンします（ディスク･モジュールのため）。
WIDCH:
	OR A	;CY←0
	RET

;LINCH（203CH）の本体
; 表示行数を変更します。 SORD M23ではサポートしません。
;入力	Acc←行数
;	[_WIDTH]参照
;出力	なし
;破壊	AF，HL，DE，BC
LINCH0:
	RET

;=======================
;ビープ音を鳴らします
;=======================


;#BELL（1FC4H）の本体
; ビープ音を鳴らします。
;入力	なし
;出力	なし
;破壊	AF
BELL:
	RET


;=======================
;プリンタ･ルーチン
;=======================


;#LPRNT（1FDCH）本体
; プリンタ1文字出力。SORD M23ではサポートしません。
;入力	Acc←文字
;出力	CY＝1ならエラー（Acc＝1）
;破壊	AF
;注：
; 0DHは、0DH＋0AHに変換します。
; 00H、0AH、1AHは、無視します。
LPRNT:
	RET

;#LPTON（1FD9H）の本体
; 表示をプリンタ出力モードにします。SORD M23ではサポートしません。
;入力	なし
;出力	[_LPSW]←1
;破壊	なし
;注：
LPTON:
	RET

;#LPTOF（1FD6H）の本体
; 表示を非プリンタ出力モードにします。SORD M23ではサポートしません。
;入力	なし
;出力	[_LPSW]←0
;破壊	なし
LPTOF:
	RET


;===============
;入力ルーチン
;===============

;#GETKY（1FD0H）の本体
; キー入力（入力待ちなし、エコー･バックなし）。
;入力	なし
;出力	Acc←文字
;破壊	AF
;注：
; 常にオート･リピートがかかっています。
; フィジカル･ルーチンreal_time_input_key_entity（AF，HL，DE，BC破壊）を呼び出します。
GETKY:
	RET

;#BRKEY（1FCDH）の本体
; ^Cチェックします（入力待ちなし、エコー･バックなし）。
;入力	なし
;出力	ZF＝1なら^Cが押されています
;破壊	AF
;注：
; 常にオート･リピートがかかっています。
; フィジカル･ルーチンreal_time_input_key_entity（AF，HL，DE，BC破壊）を呼び出します。
; ^C（03H）とESC（1BH）をブレイク･キーとみなします。
BRKEY:
	PUSH	HL
	PUSH	DE
	PUSH	BC
	CALL	real_time_input_key_entity
	CP	03H	;^C
	JR	Z,BRKRET
	CP	1BH	;ESC
	JR	Z,BRKRET
	OR	0FFH	;ZF←0，CY←0
BRKRET:
	POP	BC
	POP	DE
	POP	HL
	RET


;#PAUSE（1FC7H）の本体
; ポーズ処理。
; どのタイミングでも、
;^Cが入力されればインライン･パラのアドレスにジャンプします。
;何もキーが押されていなければ、そのままリターンします。
; スペースが押されれば一時停止し、他のキーが押されればリターンします。
;入力	「CALL ＃PAUSE」の次のアドレス←^C入力時の飛び先
;出力	なし
;破壊	AF
PAUSE:
	EX	(SP),HL	;スタック←HL，HL←インライン･パラのアドレス
	PUSH	DE
	PUSH	BC
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	(PAURET),HL	;リターン･アドレス
	LD	(PAUREB),DE	;インライン･パラ
	CALL	_BRKEY
	JR	Z,PAUBRK
	CALL	_GETKY
	CP	' '
	JR	NZ,PAUESC

PAULP:	CALL	_BRKEY
	JR	Z,PAUBRK
	CALL	_GETKY
	OR	A
	JR	Z,PAULP
	CP	' '
	JR	Z,PAULP

PAUESC:	POP	BC
	POP	DE
	POP	HL
	XOR	A
	DB	0C3H	;「JP」
PAURET:	DS	2

PAUBRK:	POP	BC
	POP	DE
	POP	HL
	XOR	A
	DB	0C3H	;「JP」
PAUREB:	DS	2


;#INKEY（1FCAH）の本体
; キー入力（入力待ちあり、エコー･バックなし）。
;入力	なし
;出力	Acc←文字
;破壊	AF
;注：
; フィジカル･ルーチンINKEY_entity（AF，HL，DE，BC破壊）を呼び出します。
INKEY:
	RET


;#FLGET（2021H）の本体
; カーソル表示つき、キー入力（入力待ちあり、エコー･バックなし）。
;入力	なし
;出力	Acc←文字
;破壊	AF
;注：フィジカル･ルーチンinput_one_character_entity（AF，HL，DE，BC破壊）を呼び出します。
FLGET:
	RET

;#GETL（1FD3H）の本体
; 文字列入力。
;入力	DE←キー入力バッファの先頭アドレス
;出力	[DE～]←文字列
;破壊	AF
;注：
; エンド･コードは00H。
; 入力がキャンセルされた場合、「1BH、00H」がバッファに格納されます。
; 入力待ちあり、エコー･バックあり。
; フィジカル･ルーチンinput_line_character_entity（AF，HL，DE，BC破壊)を呼び出します。
GETL:
	RET

;===============================
;ファイル操作（ファイル名処理）
;===============================


;#FPRNT（1F9DH）の本体
; S-OSのFCBバッファのファイル名を表示します（改行しません）。
; ポーズ機能あり。
;入力	S-OSのFCBバッファ（fcb_buffer～）参照
;出力	なし
;破壊	AF，HL，DE，BC
FPRNT:
	LD	DE,fcb_buffer+1

;	プライマリ名の表示
	LD	B,13
FPRLP1:	LD	A,(DE)
	INC	DE
	CALL	_PRINT
	DJNZ	FPRLP1

;	ピリオドの表示
	LD	A,'.'
	CALL	_PRINT

;	拡張子の表示
	LD	B,3
FPRLP2:	LD	A,(DE)
	INC	DE
	CALL	_PRINT
	DJNZ	FPRLP2

	CALL	_PAUSE
	DW	$+2
	RET


;#FSAME（1FA0H）の本体
; ＃FILE（1FA3H）でセットされたファイル名、ファイル属性と、
;DE～にセットされた解析されてないないファイル名（エンド･コード00H）、
;ファイル属性（Acc）を比較します。
;入力	Acc←ファィル属性、DE←文字列（ファイル名）の先頭
;	S-OSのFCBバッファ（fcb_buffer～）参照
;出力	一致すればZF＝1（Acc←0）、不一致ならZF＝0（Acc←8）
;破壊	AF，HL，DE，BC
;注：
; 入力パラメータに、ファイル属性（Acc）が必要。
; CYは常にリセットされています。
FSAME:
;	ファイル属性の比較
	AND	10000111B	;マスク
	LD	B,A	;B←マスクされたファイル属性
	LD	A,(_FTYPE)	;Acc←セットされたFCBのファイル属性
	AND	10000111B	;マスク
	CP	B
	JP	NZ,FSMERR	;ファイル属性が一致しない

;	[BUFFER～]にデバイス名とファイル名を解析してセットします
	CALL	FNAME	;ファイル名を解析します
	RET	C	;デバイス名が異常（エラー3）

;	デバイス名の比較
	LD	A,(_DSK)
	LD	HL,BUFFER
	CP	(HL)
	JR	NZ,FSMERR

;	ファイル名（プライマリ，拡張子）の比較
	LD	DE,fcb_buffer+1	;比較されるファイル名
	LD	HL,BUFFER+1	;比較するファイル名
	LD	A,16
	CALL	CMPFNM	;ファイル名を比較します
	RET	Z

;	一致しませんでした
FSMERR:	LD	A,8	;File not Found
	OR	A	;ZF←0
	SCF
	RET


;#FILE（1FA3H）の本体
; ファイル名を解析して、各ワークにパラメータをセットします。
;入力	Acc←ファィル属性、DE←文字列（ファイル名）の先頭
;出力	[_DSK]←デバイス名、[_FTYPE]←ファイル属性、
;	S-OSのFCBバッファ←変換されたファイル名
;	DEは00Hか「:」のアドレスを示しています。
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
;注：
; CY＝0でリターンしています。
; ファイル名はコントロール･コードなどがカットされ、
;「*」は「?」に展開されます。
FILE:
	LD	(_FTYPE),A	;ファイル属性（ファイル名の解析でセットされます）
	LD	(fcb_buffer),A	;FCBのファイル属性部分（＋0）
	CALL	FNAME	;ファイル名を解析します
	RET	C	;デバイス名が異常（エラー3）
	PUSH	DE
	LD	A,(BUFFER)	;Acc←デバイス名
	LD	(_DSK),A
	LD	HL,BUFFER+1	;解析されたファイル名
	LD	DE,fcb_buffer+1	;FCBのファイル名フィールド
	LD	BC,16
	LDIR		;FCBのファイル名部分（＋1～＋16）
	LD	A,20H
	LD	(DE),A	;FCBのパスワード部分（＋17）
	POP	DE
	CALL	SPSKIP	;文字列の空白を読み飛ばします
	XOR	A	;CY←0
	RET


;===============================
;ファイル名処理補助ルーチン
;===============================


;ファイル名を比較します
;入力	DE←比較されるファイル名の先頭、HL←比較するファイル名の先頭、
;	Acc←カウンタ
;出力	ZF＝1なら一致
;破壊	AF，HL，DE，BC
;注：ワイルド･カードの「?」は常に一致とみなします。
CMPFNM:
	LD	B,A	;B←カウンタ
	EX	DE,HL

;	比較ループ
CPFLP:	LD	A,(DE)	;Acc←比較する文字
	CP	'?'
	JR	Z,CPFSKP	;常に一致させます
	CP	(HL)
	RET	NZ	;一致しませんでした
CPFSKP:	INC	DE
	INC	HL
	DJNZ	CPFLP

;	すべて一致
	XOR	A	;ZF←1
	RET


;ファイル名を解析します
;入力	DE←文字列（ファイル名）の先頭
;出力	[BUFFER]←デバイス名、[BUFFER＋1～]←変換されたファイル名
;	DEはカウント･アップされます（区切りでストップ）
;	CY＝1（Acc←エラー･コード）ならエラー
;破壊	AF，HL，DE，BC
FNAME:
;	デバイス名の転送
	CALL	MGETDV	;文字列からデバイス名を取り出します
	CALL	_DVCHK	;デバイス名が正しいか（A～L，S，T，Q）かチェックします
	RET	C	;Acc←3 'Bad File Descripter
	LD	HL,BUFFER
	LD	(HL),A	;[BUFFER]←デバイス名
	INC	HL	;HL←BUFFER＋1

;	ファイル名の転送
	CALL	CLRWFG
	LD	B,13	;プライマリ名
FNML11:	CALL	GTFLTR
	LD	(HL),A
	INC	HL
	DJNZ	FNML11
	CALL	SKPPRD
	CALL	CLRWFG
	LD	B,3	;拡張子
FNML12:	CALL	GTFLTR
	LD	(HL),A
	INC	HL
	DJNZ	FNML12
	CALL	SKPPRD

	XOR	A	;CY←0
	RET


;文字列からデバイス名を取り出します
;入力	DE←文字列の先頭アドレス
;出力	Acc←デバイス名（省略時はデフォルト、小文字は大文字に変換）
;	CY＝1ならデバイス名が省略されていました
;	DEはカウント･アップされます
;破壊	AF，DE
MGETDV:
	CALL	SPSKIP	;文字列の空白を読み飛ばします
	LD	A,(DE)
	OR	A
	JR	Z,MGTDV1	;文字列の終わりに達していました
	INC	DE
	LD	A,(DE)
	DEC	DE
	CP	':'
	JR	NZ,MGTDV1	;デバイスが指定されていません

;	デバイスが指定されています
	LD	A,(DE)
	CALL	convert_lower_case_to_upper_case
	INC	DE
	INC	DE
	OR	A	;CY←0
	RET

;	デバイスが指定されていません
MGTDV1:	CALL	_RDVSW
	SCF		;CY←1
	RET


;GTFLTRルーチンの「*」モードを初期化します
;入力	なし
;出力	[WASFLG]←0
;破壊	AF
CLRWFG:
	XOR	A
	LD	(WASFLG),A
	RET


;文字列からファイル名（プライマリ，拡張子）を1文字取り出します
;入力	DE←文字列のアドレス
;出力	Acc←変換された文字（区切りに達した場合はスペースに変換されます）
;	DEはカウント･アップされます（区切りでストップ）
;破壊	AF，DE
;注：
; 00H、0DH、「:」、「.」を区切りとみなします。
; コントロール･コードやスペースはスキップします。
; 「*」フェイズでは「?」を返します。
GFLLP:	INC	DE

GTFLTR:
;	「*」フェイズかチェックします
	LD	A,(WASFLG)
	OR	A
	JR	NZ,GFLWLD

	LD	A,(DE)	;Acc←1文字

;	区切りに達したか調べます
	OR	A	;NUL
	JR	Z,GFLESC
	CP	0DH	;RET
	JR	Z,GFLESC
	CP	':'
	JR	Z,GFLESC
	CP	'.'
	JR	Z,GFLESC

;	コントロール･コードとスペースをスキップします
	LD	A,(DE)
	CP	7FH	;DEL
	JR	Z,GFLLP
	CP	21H	;00H～20H
	JR	C,GFLLP

;	「*」かチェックします
	CP	'*'
	JR	Z,GFLAST

;	通常終了
	INC	DE	;DEのカウント･アップ
	JP	convert_lower_case_to_upper_case

;	「*」を発見しました
GFLAST:	LD	A,0FFH
	LD	(WASFLG),A
	INC	DE

;	「*」フェイズ
GFLWLD:	LD	A,'?'
	RET

;	ピリオドかファイル名の最後に達しました
GFLESC:	LD	A,' '
	RET

;	ワイルド･カード関係
WASFLG:	DS	1	;＝FFHで「*」フェイズ中


;ファイル名のピリオド部（プライマリと拡張子の区切り）をスキップします
;入力	DE←文字列のアドレス
;出力	DEはカウント･アップされます（区切りでストップ）
;破壊	AF，DE
;注：
; 00H、0DH、「:」を区切りとみなします。
; コントロール･コードやスペースはスキップします。
SKPLP:	INC	DE

SKPPRD:
	LD	A,(DE)	;Acc←1文字

;	区切りに達したか調べます
	OR	A	;NUL
	RET	Z
	CP	0DH	;RET
	RET	Z
	CP	':'
	RET	Z

;	ピリオドに達したか調べます
	CP	'.'
	JR	NZ,SKPLP

;	ピリオドをスキップ
	INC	DE
	RET


;=======================
;ファイル操作（テープ）
;=======================
; サポートしません。


;%RDI（2900H）
;テープのインフォメーション･ファイルをロードします
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
RDI:
	LD	A,2
	SCF
	RET


;%TROPN（2903H）
;テープのリード･オープン
;入力	[_DSK]←デバイス名
;出力	ZF＝1（Acc←0）ならファイルが見つかりました
;	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
;注：
; ファイル名解析後呼び出すこと。
; ファイル名の先頭が20Hか0DHの場合は、常に一致とみなします。
TROPN:
	LD	A,2
	SCF
	RET


;%WRI（2906H）
;テープにインフォメーション･ファイルをセーブします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
WRI:
	LD	A,2
	SCF
	RET


;%TWRD（2909H）
;テープにデータ･ファイルをセーブします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
TWRD:
	LD	A,2
	SCF
	RET


;%TRDD（290CH）
;テープのデータ･ファイルをロードします
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
TRDD:
	LD	A,2
	SCF
	RET


;%TDIR（290FH）
;テープのディレクトリを表示します
;入力	なし
;出力	CY＝1ならエラー（Acc←エラー･コード）
;破壊	AF，HL，DE，BC
TDIR:
	LD	A,2
	SCF
	RET


;-----------------------
;フィジカル･ルーチン
;-----------------------


;===============================
;フィジカル･ルーチン表示関係
;===============================


;1文字入力ルーチン（入力待ちあり、エコー･バックあり、カーソル表示あり）
;入力	なし
;出力	Acc←文字
;破壊	AF，HL，DE，BC
input_one_character_entity:
	CALL	display_cursor
	CALL	_INKEY
	PUSH	AF
	CALL	erase_cursor
	POP	AF
	RET


;===============================
;フィジカル･ルーチン入力関係
;===============================


;文字列入力ルーチン（入力待ちあり、エコー･バックあり、カーソル表示あり）
;入力	DE←入力バッファの先頭アドレス
;出力	[DE～]←入力文字列
;破壊	AF，HL，DE，BC
;注：
; ブレイク･キーが押された場合、入力バッファの先頭に、1BH（，00H）が入ります。
; リターン･キー（0DH）は含まれません。
; 文字列の最後には00Hが入ります。
; バッファは256バイトまで使用します。
; ルーチンの最初と最後で、インサート･モードをクリアします。
; 画面出力時のインサート処理は、高速化のため、このルーチンで処理します。
input_line_character_entity:
	XOR	A
	LD	(insert_mode_flag),A	;[insert_mode_flag]のクリア
	PUSH	DE

GTLP:	CALL	_FLGET
	CP	0DH	;CR
	JR	Z,GTCR
	CP	03H	;^C
	JR	Z,GTBRK
	CP	1BH	;ESC
	JR	Z,GTBRK
	CP	09H	;TAB
	JR	Z,GTTAB
	CALL	GTINS
	CALL	_PRINT
	JR	GTLP

;	ブレイクしました
GTBRK:	CALL	_PRINT
	POP	DE
	LD	A,1BH
	LD	(DE),A
	INC	DE
	XOR	A
	LD	(DE),A
	RET

;	1行入力がありました
GTCR:	POP	DE
	CALL	INPUTL	;カーソル位置は論理行の最後の物理行へ
	XOR	A
	LD	(insert_mode_flag),A
	JP	_LTNL	;改行します

;	タブ処理
GTTAB:	LD	A,(_WIDTH)
	LD	C,A	;C←桁数
	LD	A,(CSRNX)
	ADD	A,C	;Acc←x座標
	LD	B,A	;B←x座標
	AND	11111000B
	ADD	A,8	;Acc←次のタブ位置（仮）
	CP	C
	JR	C,$+3
	LD	A,C	;Acc←次のタブ位置（実際）
	SUB	B	;Acc←次のタブ位置-x座標
	LD	B,A	;B←表示スペース数
	LD	A,' '

GTTLP:	PUSH	BC
	CALL	GTINS
	POP	BC
	DJNZ	GTTLP

	LD	A,09H	;TAB
	CALL	_PRINT
	JR	GTLP

;	インサート･モードなら、1文字インサートします
GTINS:	CP	20H
	RET	C	;コントロール･コードだった
	LD	C,A
	LD	A,(insert_mode_flag)
	OR	A
	LD	A,C
	RET	Z	;インサート･モードでなかった

;	インサート･モードだった
	PUSH	AF

;	初期設定
	LD	A,(_WIDTH)
	LD	L,A
	LD	H,0
	LD	(line_length),HL
	LD	A,(_MXLIN)
	LD	L,0
	LD	H,A
	LD	(final_plus_one_cursor_XY),HL
	CALL	get_offset_from_cursor_XY
	LD	(offset_plus_one_cursor_XY),HL
	CALL	get_Y_next_logical_line
	LD	(next_cursor_XY_top_of_next_logical_line),HL
	CALL	get_offset_from_cursor_XY
	LD	(next_cursor_offset_top_of_next_logical_line),HL
	CALL	_CSR
	LD	(now_cursor_XY),HL
	CALL	get_offset_from_cursor_XY
	LD	(now_cursor_offset),HL
	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	DEC	HL	;HL←行末のカーソル･オフセット
	CALL	read_character_offset_address
	LD	(line_end_character),A
	SUB	' '	;0，0以外
	ADD	A,0FFH	;CY＝0， CY＝1
	SBC	A,A	;00H，FFH
	LD	(cursor_line_end),A
	LD	DE,(now_cursor_offset)
	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	DEC	HL	;HL←行末のカーソル･オフセット
	OR	A
	SBC	HL,DE
	LD	A,H
	OR	L	;0以外，0
	ADD	A,0FFH	;CY＝1，CY＝0
	SBC	A,A	;FFH，00H
	CPL		;00H，FFH
	LD	HL,cursor_line_end
	OR	(HL)
	LD	(HL),A

;	転送します
	LD	DE,(now_cursor_offset)
	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	DEC	HL	;HL←行末のカーソル･オフセット
	OR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H	;BC←転送文字数
	LD	HL,(now_cursor_offset)	;HL←転送元カーソル･オフセット
	LD	E,L
	LD	D,H
	INC	DE	;DE←転送先カーソル･オフセット
	JR	Z,$+5
	; CALL	VBTRNS
	CALL	_CSR
	CALL	get_offset_from_cursor_XY
	LD	A,' '
	CALL	write_character_offset_address
	LD	A,(cursor_line_end)
	OR	A
	JR	NZ,$+4
	POP	AF
	RET

;	1物理行を注入する必要がある場合
	LD	A,(_MXLIN)
	LD	HL,next_cursor_XY_top_of_next_logical_line+1
	SUB	(HL)	;Acc←画面残り物理行数
	JR	Z,GTIRU	;論理的に綱がっている最終物理行が、画面最終物理最終行と等しい
	DEC	A
	JR	Z,write_new_line	;論理的に綱がっている最終物理行が、画面最終物理行の上の行
;	ライン･ターミナル･テーブルの転送
	LD	C,A
	LD	B,0	;BC←転送行数－1
	LD	HL,next_cursor_XY_top_of_next_logical_line+1
	ADD	A,(HL)
	LD	E,A
	LD	D,LINTTB/100H	;DE←転送先
	LD	L,E
	LD	H,D
	DEC	L	;HL←転送元
	LDDR
	EX	DE,HL
	LD	(HL),B	;新行と次の行の連結解除
;	画面の転送
	LD	DE,(next_cursor_offset_top_of_next_logical_line)
	LD	HL,(offset_plus_one_cursor_XY)
	OR	A
	SBC	HL,DE
	LD	DE,(line_length)
;	OR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H	;BC←転送バイト数
	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	EX	DE,HL	;HL←[line_length]，DE←[next_cursor_offset_top_of_next_logical_line]
	ADD	HL,DE
	EX	DE,HL	;HL←転送元，DE←転送先
	; CALL	VBTRNS

;	新行を書き込みます
write_new_line:	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	LD	BC,(line_length)
	LD	A,' '
	; CALL	FILVRM
write_new_line_1:	LD	HL,next_cursor_XY_top_of_next_logical_line+1
	LD	L,(HL)
	DEC	L
	LD	H,LINTTB/100H
	LD	(HL),0FFH	;新物理行と前の物理行を連結
	LD	HL,(next_cursor_offset_top_of_next_logical_line)
	LD	A,(line_end_character)
	CALL	write_character_offset_address
	POP	AF
	RET

;	論理的に綱がっている最終物理行が、画面最終物理最終行と等しい場合
GTIRU:	CALL	control_code_ROLL_UP
	LD	HL,(now_cursor_XY)
	DEC	H
	JP	M,$+6
	CALL	_LOC
	LD	HL,(next_cursor_XY_top_of_next_logical_line)
	DEC	H
	LD	(next_cursor_XY_top_of_next_logical_line),HL
	CALL	get_offset_from_cursor_XY
	LD	(next_cursor_offset_top_of_next_logical_line),HL
	JR	write_new_line_1

line_end_character:	DS	1	;行末の文字
cursor_line_end:	DS	1	;＝FFH（≠0）で行末の文字がスペースでないか、カーソルが行末にあります
line_length:	DS	2	;1行の桁数
now_cursor_XY:	DS	2	;現在カーソル座標
now_cursor_offset:	DS	2	;現在カーソル･オフセット
next_cursor_XY_top_of_next_logical_line:	DS	2	;次の論理行頭カーソル座標
next_cursor_offset_top_of_next_logical_line:	DS	2	;次の論理行頭のカーソル･オフセット
final_plus_one_cursor_XY:	DS	2	;最終＋1のカーソル座標
offset_plus_one_cursor_XY:	DS	2	;最終＋1のカーソル･オフセット


;=======================================
;フィジカル･ルーチン･プリンタ関係
;=======================================


;プリンタ出力モードをオンします
;入力	なし
;出力	[_LPSW]←1
;破壊	AF，HL，DE，BC
;注：旧X1版SWORDと同じく、[#LPSW]に1を書きます。
printer_output_mode_on_entity:
	LD	A,1
	LD	(_LPSW),A

;	#PRINT（1FF4H）のため'
	LD	HL,LPPR
	LD	(_PRINT+1),HL
	LD	HL,LPPR
	LD	(BPRNT+1),HL

	RET


;プリンタ出力モードをオフします
;入力	なし
;出力	[_LPSW]←0
;破壊	AF，HL，DE，BC
printer_output_mode_off_entity:
	XOR	A
	LD	(_LPSW),A

;	#PRINT（1FF4H）のため'
	; LD	HL,PRINT
	; LD	(_PRINT+1),HL
	; LD	HL,BPRNT0
	; LD	(BPRNT+1),HL

	RET


;1文字プリント前処理
LPREB:
	; PUSH	HL
	; LD	HL,PRINT
	; LD	(_PRINT+1),HL
	; LD	HL,BPRNT0
	; LD	(BPRNT+1),HL
	; POP	HL
;	JP	LPPR


;#LPSW（1F7CH）がオンなら、通常表示ルーチンと置き代わります
LPPR:
	CALL	PRINT
	PUSH	AF
	; CALL	_LPRNT
	POP	AF
	RET


;===============================
;フィジカル･ルーチン補助
;===============================


;1行入力します
;入力	DE←バッファのアドレス
;出力	[DE～]←入力文字列
;	カーソルを論理的に綱がっている最後の物理行へ
;破壊	AF，HL，DE，BC
;注：
; 文字列の最後には00Hが入ります。
; バッファは256バイトまで使用します。
INPUTL:
	PUSH	DE	;スタック←入力バッファ

;	一時バッファのクリア
	LD	HL,BUFFER
	LD	DE,BUFFER+1
	LD	BC,255
	LD	(HL),B
	LDIR

;	読み出しアドレスの設定
;出力	DE←現在行の行頭のカーソル･オフセット、BC←現在行の最大文字数
	CALL	get_Y_top_of_logical_line	;論理行頭の座標を得ます
	CALL	get_offset_from_cursor_XY
	EX	DE,HL	;DE←現在行の行頭のカーソル･オフセット
	CALL	get_Y_next_logical_line	;次の論理行の座標を得ます
	DEC	H
	CALL	_LOC	;カーソルを論理的に綱がっている最後の物理行へ
	INC	H
	CALL	get_offset_from_cursor_XY
	OR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H	;BC←現在行の最大文字数

;	一時バッファへ転送します
;入力	DE←現在行の行頭のカーソル･オフセット、BC←現在行の最大文字数
	LD	A,B
	OR	A
	JR	Z,$+5
	LD	BC,255
	LD	HL,BUFFER
	; CALL	INVRM

;	ターミネート処理
; 後ろの00H～20Hの文字は00Hに変換します。
	LD	HL,BUFFER+100H
	LD	BC,0	;B←ループ･カウンタ256，C←ターミネータ00H
INLLP1:	DEC	HL
	LD	A,(HL)
	CP	21H
	JR	NC,INL1ES	;21H～の文字を発見しました
	LD	(HL),C
	DJNZ	INLLP1
INL1ES:

;	入力バッファに転送します
	LD	HL,BUFFER
	POP	DE	;DE←入力バッファ
INLLP2:	LD	A,(HL)
	INC	HL
	LD	(DE),A
	INC	DE
	OR	A
	JR	NZ,INLLP2

	JP	SETPRN


;=======================
;1文字表示ルーチン
;=======================


;^R インサート･モードのオン／オフ
control_code_INS:
	RET


;^＠ 何もしません
control_code_NULL:
	RET


;^I TAB タブ処理
;〈レジスタ･マップ〉
;HL	CSRNX
;D	[_WIDTH]
;E	定数00000111B
;C	現在x負座標
control_code_TAB:
	RET

;	最終桁の場合
CTLTAE:


;^L CLR 画面クリア
;注：フィジカル･ルーチンCLS（AF，HL，DE，BC破壊）を呼び出します。
control_code_CLS:
;	行連結情報のクリア
;	画面のクリア
	CALL	CLS
;	JP	control_code_HOME


;^K HOME カーソル･ホーム位置
control_code_HOME:
	RET


;^￥ → カーソル右移動
control_code_Right:
	RET


;^］ ← カーソル左移動
control_code_Left:
	RET


;^＾ ↑ カーソル上移動
control_code_Up:
	RET


;^＿ ↓ カーソル下移動
control_code_Down:
	RET


;^S スクロール･アップします
control_code_ROLL_UP:
	RET

;^T スクロール･ダウンします
control_code_ROLL_DOWN:
	RET

;^C STOP カーソルを次の行の行頭へ（論理改行）
CTLCAN:
	RET

;^M CR カーソルを次の行の行頭へ（物理改行）
CTLCR:
	RET

;^H BS バック･スペース
control_code_BS:
	RET

;7EH DEL デリート･コード
control_code_DELETEL:
	RET

;^E カーソル位置から行末までクリア
CTL05:
	RET


;^A カーソルを論理行頭へ（－^V）
CTL01:
	RET

;---------------
;独自ルーチン
;---------------


;=======================
;表示ルーチン前処理
;=======================


;表示ルーチンを初期飛び先へジャンプするように設定します
;入力	なし
;出力	なし
;破壊	HL
SETPRN:
	RET


;=======================
;スクリーン制御補助
;=======================


;論理桁位置を得ます
;入力	x座標、桁数参照
;出力	HL←論理桁位置
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;E	桁数
;C	現在y座標
;BC	ライン･ターミナル･テーブルの先頭＋y座標
;HL	論理桁位置カウンタ
get_logical_column:
	;テキストVRAMのスタートアドレスがF800Hであり、一行の桁数は80dであるので、
	;論理桁位置は、(y座標×80d)+x座標で求められます。
	CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
	LD	HL,(cursor_XY_ADDR) ; 
	RET

;論理行頭の座標を得ます
;入力	なし
;出力	L←0、H←論理行頭のy座標
;破壊	AF，HL
get_Y_top_of_logical_line:
	CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
	LD	HL,(cursor_XY_ADDR+2) ;
	RET


;次の論理行の座標を得ます
;入力	なし
;出力	L←0、H←論理行頭のy座標
;破壊	AF，HL
get_Y_next_logical_line:
	RET


;カーソル座標からオフセット･アドレスを求めます
;入力	L←x座標、H←y座標
;出力	HL←オフセット
;破壊	AF，HL
;注：cursor_offset_for_Y_tableは、y座標→カーソル･オフセット対応表。
get_offset_from_cursor_XY:
	RET


;オフセット･アドレスからカーソル座標を求めます
;入力	HL←カーソル･オフセット
;出力	L←x座標,H←y座標
;破壊	AF，HL
get_cursor_XY_from_offset_address:
	RET


;カーソルのオフセット計算用テーブルを生成します
;入力	[_WIDTH]参照
;出力	[cursor_offset_for_Y_table～]←オフセット
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;DE	テーブル･アドレス
;BC	定数[_WIDTH]
;HL	カーソル･オフセット
;Acc	ループ･カウンタ
generate_cursor_offset_table:
	RET


;カーソル制御用ワークの初期化
;入力	[_WIDTH]、[_WIDTH]、[_MXLIN]、[vram_address_of_top]参照
;出力	[CSRADD]、[CSRNXI]、[CSRNYI]、[cursor_offset_last_top_of_line]、[total_number_of_character_display]、[vram_address_of_top_of_last_line]、
;	ライン･ターミナル･テーブル初期化
;破壊	AF，HL，DE，BC
initialize_cursor_control_work_area:
	RET


;-------------------------------
;S-OSルーチン（機種依存）
;-------------------------------


;===============
;I／O入出力
;===============


;#INP（202AH）の本体
; I／Oポートにデータを出力。
;入力	なし
;出力	Acc←データ
;破壊	AF
INP:
	PUSH BC
	LD	B,0
	IN	A,(C)
	POP	BC
	RET


;#OUT（202DH）の本体
; I／Oポートからデータを入力。
;入力	Acc←データ
;出力	なし
;破壊	なし
OUTP:
	PUSH BC
	LD	B,0
	OUT	(C),A
	POP	BC
	RET


;=======================
;特殊ワーク（機種依存）
;=======================


;#POKE（1F9AH）の本体
; 特殊ワーク･エリアに1バイト書き込みます。
;入力	HL←アドレス、Acc←データ
;出力	なし
;破壊	なし
;〈旧SWORDとの速度比較〉
;POKE	 97ts→ 83ts	1.169倍
;#POKE	107ts→ 93ts	1.151倍
;＋CALL	124ts→110ts	1.127倍
POKE:
	PUSH	BC	;11ts
	PUSH	AF	;11ts
	LD	C,L	; 4ts
	LD	A,40H	; 7ts '特殊ワーク先頭（4000H）
	ADD	A,H	; 4ts 'CY←0
	LD	B,A	; 4ts 'BC←実アドレス
	POP	AF	;10ts
	OUT	(C),A	;12ts '特殊ワークへの書き込み
	POP	BC	;10ts
	RET		;10ts


;#PEEK（1F94H）の本体
; 特殊ワーク･エリアから1バイト読み込みます。
;入力	HL←アドレス
;出力	Acc←データ
;破壊	AF
;〈旧SWORDとの速度比較〉
;POKE	109ts→ 62ts	1.758倍
;#POKE	119ts→ 72ts	1.653倍
;＋CALL	136ts→ 89ts	1.528倍
;注：CYをクリアします。
PEEK:
	PUSH	BC	;11ts
	LD	C,L	; 4ts
	LD	A,40H	; 7ts '特殊ワーク先頭（4000H）
	ADD	A,H	; 4ts 'CY←0
	LD	B,A	; 4ts 'BC←実アドレス
	IN	A,(C)	;12ts '特殊ワークからの読み込み
	POP	BC	;10ts
	RET		;10ts


;#poke_entity（1F97H）の本体
; 特殊ワーク･エリアにブロック書き込みします。
;入力	HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
;	BC←転送バイト数
;出力	なし
;破壊	AF，HL，DE，BC
;〈旧SWORDとの速度比較〉
;ループ	 57ts→ 40ts	1.425倍
;注：「WINER」などでCYクリアが必要。
poke_entity:
	LD	A,40H	;特殊ワーク先頭（4000H）
	ADD	A,D	;CY←0
	LD	D,A
	PUSH	DE

;	高速ループ･カウンタの設定（BC→AD版）
	XOR	A
	CP	C	;下位カウンタ＝0ならCY＝0
	ADC	A,B	;Acc←新上位ループ･カウンタ
	LD	D,C	;D←下位ループ･カウンタ

	POP	BC	;BC←実アドレス

POKE_LP:	INC	B	; 4ts '先行デクリメントのため
	OUTI		;16ts '特殊ワークへの書き込み
	INC	BC	; 6ts
	DEC	D	; 4ts
	JP	NZ,POKE_LP	;10ts
	DEC	A
	JR	NZ,POKE_LP

;	OR	A	;CY←0
	RET


;#peek_entity（1F91H）の本体
; 特殊ワーク･エリアからブロック読み込みします。
;入力	HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
;	BC←転送バイト数
;出力	なし
;破壊	AF，HL，DE，BC
;〈旧SWORDとの速度比較〉
;ループ	 57ts→ 40ts	1.425倍
;注：「WINER」などでCYクリアが必要。
peek_entity:
	LD	A,40H	;特殊ワーク先頭（4000H）
	ADD	A,D	;CY←0
	LD	D,A
	PUSH	DE

;	高速ループ･カウンタの設定（BC→AD版）
	XOR	A
	CP	C	;下位カウンタ＝0ならCY＝0
	ADC	A,B	;Acc←新上位ループ･カウンタ
	LD	D,C	;D←下位ループ･カウンタ

	POP	BC	;BC←実アドレス

PEEK_LP:	INC	B	; 4ts '先行デクリメントのため
	INI		;16ts '特殊ワークからの読み込み
	INC	BC	; 6ts
	DEC	D	; 4ts
	JP	NZ,peek_lp	;10ts
	DEC	A
	JR	NZ,peek_lp

;	OR	A	;CY←0
	RET


;---------------------------------------
;フィジカル･ルーチン（機種依存）
;---------------------------------------


;===============================
;システム･ルーチン（機種依存）
;===============================

;ブートします
;入力	なし
;出力	なし
;破壊	AF，HL，DE，BC
boot_entity:
	CALL	SOSSF		;仮想ディスク全クローズ

	LD	HL,00D3H	;「OUT (0),A」
	LD	(0FFFEH),HL
	LD	A,1DH
	JP	0FFFEH


;===============================================
;フィジカル･ルーチン･プリンタ関係（機種依存）
;===============================================


;プリンタへ1文字出力します
;入力	Acc←文字
;出力	エラーが起こればCY＝1
;破壊	AF
lprint_entity:
	PUSH	HL
	PUSH	BC
	LD	L,A	;L←文字（保存用）
	LD	H,A	;H←文字
	LD	BC,1A01H

;	プリンタREADYを待ちます
lplp_entity:	IN	A,(C)
	RRCA
	JR	NC,lpbrk_entity	;^C
	IN	A,(C)
	AND	00001000B
	JR	NZ,lplp_entity

	OR	A	;CY←0

;	文字を出力
;注：CYは保存します。
lp1_entity:	DEC	C	;BC←1A00H
	OUT	(C),H
;	受け取り指示
	LD	C,3	;BC←1A03H
	LD	A,00001110B	;b7リセット
	OUT	(C),A
	INC	A	;b7セット
	OUT	(C),A

;	終了
	LD	A,L	;Acc←文字
	POP	BC
	POP	HL
	RET

;	^C処理
lpbrk_entity:	LD	H,0DH	;RET
	SCF
	JR	lp1_entity


;=======================
;音声（機種依存）
;=======================


;ビープ音を鳴らします
;入力	なし
;出力	なし
;破壊	AF，HL，DE，BC
bell_entity:
	DI
	EI
	RET

;===============================
;スクリーン関係（機種依存）
;===============================


;カーソル座標を読み出します
;入力	なし
;出力	L←x座標、H←y座標
;破壊	AF，HL，DE，BC
get_cursor_XY_entity:
	LD	DE,(CSRADD) ; CSRADDの値をDEへ
	LD	HL,(CSRNX) ; CSRNXの値をHLへ
	ADD	HL,DE
	RET

;カーソルを指定座標へ移動します
;入力	L←x座標、H←y座標
;出力	なし
;破壊	AF，HL，DE，BC
move_cursor_XY_entity:
	LD	DE,(CSRNXI)	;256-桁数 '[CSRNX]の初期値
	ADD	HL,DE
	LD	(CSRNX),HL ;ｘ座標-[_WIDTH]
	JP	SETPRN

;指定座標の文字を読み込みます
;入力	L←x座標、H←y座標
;出力	Acc←文字
;破壊	AF，HL，DE，BC
get_character_XY_entity:
	CALL get_offset_from_cursor_XY
	JP read_character_offset_address

;画面のクリア
;入力	[screen_width]、[total_number_of_character_display]、[attribute_data]参照
;出力	なし
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;E	クリア･データ（定数）
;BC	現在アトリビュートVRAMアドレス
;AD	高速ループ･カウンタ
; 画面左上のアドレスはf800hです。
; そこから、ffd0hまでをスペースキャラクタ(アスキーコード20h)で埋めて、画面をクリアするコードを書いて下さい。

CLS:
	PUSH HL
	PUSH BC

	LD HL,0F000H
	LD BC,0800H

	LD B,050H
	LD DE,0FFFFH
	LD A,20H ; スペースキャラクタ
; CLEAR_ALL_LINE_CLS:
.LOOP
	OUT (0D2H),A ; VRAMへアクセスするためのポート
	LD (HL),A ; VRAMへ20Hデータを書き込む
	INC HL ; 書き込むべきアドレスをインクリメント
	SBC HL,DE ; HL - DE
	; JR NZ,CLEAR_ALL_LINE_CLS ; 全てのアドレスを書き込むまでループ
	JR NZ,.LOOP ; 全てのアドレスを書き込むまでループ

	LD DE, VRAM_TXT_TOP ; 最初の文字列表示位置(左上隅)
	LD (CURSOR_LOCATE),DE ; カーソル位置を左上隅に設定 F800H
	LD (TOP_VIEW),DE
	LD DE, 0FFD0H ; 画面最終文字位置
	LD (NEED_DO_SCROLL_POINT),DE ; スクロールポイントを設定

	RET


;===============================
;1文字表示ルーチン（機種依存）
;===============================


;コントロール･コード制御（PRINTルーチンの一部）
;入力	Acc←コントロール･コード（00H～1FH）
PRNCTL:
	PUSH	AF
	PUSH	HL
	PUSH	DE
	PUSH	BC
	LD	HL,control_code_jump_tabel
	ADD	A,A	;Acc←コントロール･コード×2
	ADD	A,L
	LD	L,A	;HL←control_code_jump_tabel＋コントロール･コード×2
	LD	A,(HL)
	INC	L
	LD	H,(HL)
	LD	L,A	;HL←[control_code_jump_tabel＋コントロール･コード×2]

	LD	DE,PRCRET
	PUSH	DE	;リータン･アドレスの設定
	JP	(HL)	;「CALL コントロール制御」相当
PRCRET:	CALL	SETPRN
	POP	BC
	POP	DE
	POP	HL
	POP	AF
	OR	A	;CY←0
	RET

;1文字プリント前処理
PREPR:	PUSH	HL
	POP	HL

;#PRINT（1FF4H）本体
; 1文字プリント･ルーチン。
;入力	Acc←文字
;出力	なし
;破壊	F
;注：
; [#LPSW]がオンならプリンタにも出力します。
; インサート･モードと論理改行は、1行入力ルーチンで制御します。
; CYフラグをクリアします。
;〈実行時間〉
;PRINT	149ts（37.250μs）
;#PRINT	159ts（39.750μs）
;＋CALL	176ts（44.000μs）
PRINT:
	PUSH AF
	PUSH HL
	PUSH DE
	PUSH BC

	CALL PUTCHAR

	POP	BC
	POP	DE
	POP	HL
	POP	AF

	; PUSH HL
	; PUSH BC
	; PUSH DE
	; LD	HL,CSRNX ;10t
	; INC (HL) ;4ts	
	; POP	BC
	; POP	DE
	; POP	HL
	RET


;===============================
;文字列表示ルーチン（機種依存）
;===============================

;文字のブロック表示（非コントロール･コードのみ表示します）
;入力	DE←文字列の先頭アドレス
;出力	DE←次の文字の位置
;破壊	AF，HL，DE，BC
;〈レジスタ･マップ〉
;SP	現在文字列のアドレス
;E	文字読み込み1
;D	文字読み込み2
;BC	現在テキストVRAMアドレス
;HL	現在文字変換テーブルのアドレス
;IXL	ループ･カウンタ
;IXH	定数桁数÷2（ループ用）
;Acc	定数20H－1（コントロール･コード･チェック用）
;注：
; プリンタには出力しません。
; インサート･モードと論理改行は、1行入力ルーチンで制御します。
; [number_of_character_after_CR]は無視します。
; 桁数は、必ず偶数であること。
;〈実行時間〉
;最内ループ53ts（13.250μs）
BPRNT0:
; 	PUSH	IX
; ;	共通の設定
; 	LD	A,(_WIDTH)
; 	SRL	A
; 	DB	0DDH
; 	LD	H,A	;「LD IXH,A」 'IXH←桁数÷2 '定数
; 	LD	BC,(TXTADR)	;BC←現在テキストVRAMアドレス
; 	LD	(BPRRSP),SP
; ;	最初の行の設定
; 	LD	A,(CSRNX)
; 	CPL
; 	ADD	A,2	;Acc←現在行の残り文字数＋1，CY←0
; 	RRA		;Acc←現在行の残り文字数÷2切り上げ，CY←端数の反転
; 	DB	0DDH
; 	LD	L,A	;「LD IXL,A」 'IXL←初期ループ･カウンタ
; 	EX	DE,HL
; 	DI
; 	LD	SP,HL	;SP←文字列の先頭
; 	LD	H,LSXTBL/100H	;HL←文字変換テーブルのアドレス
; 	LD	A,20H-1	;コントロール･コード･チェック用
; 	JR	C,BPRL12
; ;	端数処理
; 	DEC	SP
; 	POP	DE	;D←最初の文字
; 	JR	BPRL1J

; BPRL11:
; 	DB	0DDH
; 	LD	L,H	;「LD IXL,IXH」 'IXL←ループ･カウンタ（桁数÷2）
; 	LD	H,LSXTBL/100H	;HL←文字変換テーブルのアドレス
; 	LD	A,20H-1	;コントロール･コード･チェック用

; ;	1ループ106ts（53ts×2）
; BPRL12:
; 	POP	DE	;10ts
; 	CP	E	; 4ts
; 	JR	NC,BPRRE1	; 7ts 'コントロール･コードがきました
; 	LD	L,E	; 4ts
; 	LD	E,(HL)	; 7ts
; 	OUT	(C),E	;12ts
; 	INC	C	; 4ts
; BPRL1J:
; 	CP	D	; 4ts
; 	JR	NC,BPRRE2	; 7ts 'コントロール･コードがきました
; 	LD	L,D	; 4ts
; 	LD	D,(HL)	; 7ts
; 	OUT	(C),D	;12ts
; 	INC	BC	; 6ts
; 	DB	0DDH
; 	DEC	L	; 8ts
; 	JP	NZ,BPRL12	;10ts

; 	LD	HL,CSRNX
; 	LD	A,(CSRNXI)
; 	LD	(HL),A	;カーソルを行頭へ
; 	INC	L	;HL←CSRNY
; 	LD	A,(_MXLIN)
; 	ADD	A,(HL)	;Acc←y座標 '（y座標－行数）＋行数
; 	LD	L,A
; 	LD	H,LINTTB/100H	;HL←対応するターミナル･テーブルのアドレス
; 	LD	(HL),0FFH	;行を連結します
; 	LD	HL,CSRNY
; 	INC	(HL)	;[CSRNY]のカウント･アップ
; 	JR	NZ,BPRL11

; ;	最終行の場合
; 	LD	(HL),0FFH	;最終行
; 	LD	(BPRLSP),SP
; 	EI
; 	LD	SP,(BPRRSP)
; 	CALL	control_code_ROLL_UP
; 	LD	BC,(vram_address_of_top_of_last_line)	;BC←最終行先頭のVRAMアドレス
; 	DI
; 	DB	31H	;「LD SP,n」
; BPRLSP:
; 	DS	2
; 	JR	BPRL11

; ;	コントロール･コードがきた場合（偶数）
; BPRRE1:
; 	XOR	A
; 	DB	0DDH
; 	SUB	L	;「SUB IXL」
; 	DB	0DDH
; 	SUB	L	;「SUB IXL」 'Acc←x座標－桁数
; 	LD	HL,-2
; 	JR	BPRRET
; ;	コントロール･コードがきた場合（端数）
; BPRRE2:
; 	LD	A,1
; 	DB	0DDH
; 	SUB	L	;「SUB IXL」
; 	DB	0DDH
; 	SUB	L	;「SUB IXL」 'Acc←x座標－桁数
; 	LD	HL,-1
; BPRRET:
; 	LD	(TXTADR),BC	;[TXTADR]の更新
; 	LD	(CSRNX),A	;[CSRNX]を更新
