000AB2 0AB2                     line_end_character: DS  1   ;行末の文字
000AB3 0AB3                     cursor_line_end:    DS  1   ;＝FFH（≠0）で行末の文字がスペースでないか、カーソルが行末にあります
000AB4 0AB4                     line_length:    DS  2   ;1行の桁数
000AB6 0AB6                     now_cursor_XY:  DS  2   ;現在カーソル座標
000AB8 0AB8                     now_cursor_offset:  DS  2   ;現在カーソル･オフセット
000ABA 0ABA                     next_cursor_XY_top_of_next_logical_line:    DS  2   ;次の論理行頭カーソル座標
000ABC 0ABC                     next_cursor_offset_top_of_next_logical_line:    DS  2   ;次の論理行頭のカーソル･オフセット
000ABE 0ABE                     final_plus_one_cursor_XY:   DS  2   ;最終＋1のカーソル座標
