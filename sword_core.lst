001DFF 1DFF CD8A1D          17  BGETL0: CALL    BGET    ;バッチ･ファイルから1文字を得ます
001E02 1E02 3005            12      JR  NC,BGETL1   ;バッチ･ファイルから入力があった
001E04 1E04 E1              10      POP HL
001E05 1E05 D1              10      POP DE
                                ;   ここのジャンプ先は機種によって違います
                                ;   JP  1610H   ;本来の#GETL
001E06 1E06 C3D31F          10      JP  _GETL
                                
                                ;
