                                ;===============================
                                ;フィジカル･ルーチン入力関係
                                ;===============================
                                
                                
                                ;文字列入力ルーチン（入力待ちあり、エコー･バックあり、カーソル表示あり）
                                ;入力   DE←入力バッファの先頭アドレス
                                ;出力   [DE～]←入力文字列
                                ;破壊   AF，HL，DE，BC
                                ;注：
                                ; ブレイク･キーが押された場合、入力バッファの先頭に、1BH（，00H）が入ります。
                                ; リターン･キー（0DH）は含まれません。
                                ; 文字列の最後には00Hが入ります。
                                ; バッファは256バイトまで使用します。
                                ; ルーチンの最初と最後で、インサート･モードをクリアします。
                                ; 画面出力時のインサート処理は、高速化のため、このルーチンで処理します。
       0960                     input_line_character_entity:
000960 0960 AF               4      XOR A
000961 0961 32FF04          13      LD  (insert_mode_flag),A    ;[insert_mode_flag]のクリア
000964 0964 D5              11      PUSH    DE
                                
000965 0965 CD2120          17  GTLP:   CALL    _FLGET
000968 0968 FE0D             7      CP  0DH ;CR
00096A 096A 281F            12      JR  Z,GTCR
00096C 096C FE03             7      CP  03H ;^C
00096E 096E 2810            12      JR  Z,GTBRK
000970 0970 FE1B             7      CP  1BH ;ESC
000972 0972 280C            12      JR  Z,GTBRK
000974 0974 FE09             7      CP  09H ;TAB
000976 0976 281E            12      JR  Z,GTTAB
000978 0978 CDB909          17      CALL    GTINS
00097B 097B CDF41F          17      CALL    _PRINT
00097E 097E 18E5            12      JR  GTLP
                                
                                ;   ブレイクしました
000980 0980 CDF41F          17  GTBRK:  CALL    _PRINT
000983 0983 D1              10      POP DE
000984 0984 3E1B             7      LD  A,1BH
000986 0986 12               7      LD  (DE),A
000987 0987 13               6      INC DE
000988 0988 AF               4      XOR A
000989 0989 12               7      LD  (DE),A
00098A 098A C9              10      RET
                                
                                ;   1行入力がありました
00098B 098B D1              10  GTCR:   POP DE
00098C 098C CDDF0A          17      CALL    INPUTL  ;カーソル位置は論理行の最後の物理行へ
00098F 098F AF               4      XOR A
000990 0990 32FF04          13      LD  (insert_mode_flag),A
000993 0993 C3EE1F          10      JP  _LTNL   ;改行します
                                
                                ;   タブ処理
000996 0996 3A5C1F          13  GTTAB:  LD  A,(_WIDTH)
000999 0999 4F               4      LD  C,A ;C←桁数
00099A 099A 3AFA04          13      LD  A,(CSRNX)
00099D 099D 81               4      ADD A,C ;Acc←x座標
00099E 099E 47               4      LD  B,A ;B←x座標
00099F 099F E6F8             7      AND 11111000B
0009A1 09A1 C608             7      ADD A,8 ;Acc←次のタブ位置（仮）
0009A3 09A3 B9               4      CP  C
0009A4 09A4 3801            12      JR  C,$+3
0009A6 09A6 79               4      LD  A,C ;Acc←次のタブ位置（実際）
0009A7 09A7 90               4      SUB B   ;Acc←次のタブ位置-x座標
0009A8 09A8 47               4      LD  B,A ;B←表示スペース数
0009A9 09A9 3E20             7      LD  A,' '
                                
0009AB 09AB C5              11  GTTLP:  PUSH    BC
0009AC 09AC CDB909          17      CALL    GTINS
0009AF 09AF C1              10      POP BC
0009B0 09B0 10F9            13      DJNZ    GTTLP
                                
0009B2 09B2 3E09             7      LD  A,09H   ;TAB
0009B4 09B4 CDF41F          17      CALL    _PRINT
0009B7 09B7 18AC            12      JR  GTLP
                                
                                ;   インサート･モードなら、1文字インサートします
0009B9 09B9 FE20             7  GTINS:  CP  20H
0009BB 09BB D8              11      RET C   ;コントロール･コードだった
0009BC 09BC 4F               4      LD  C,A
0009BD 09BD 3AFF04          13      LD  A,(insert_mode_flag)
0009C0 09C0 B7               4      OR  A
0009C1 09C1 79               4      LD  A,C
0009C2 09C2 C8              11      RET Z   ;インサート･モードでなかった
                                
                                ;   インサート･モードだった
0009C3 09C3 F5              11      PUSH    AF
                                
                                ;   初期設定
0009C4 09C4 3A5C1F          13      LD  A,(_WIDTH)
0009C7 09C7 6F               4      LD  L,A
0009C8 09C8 2600             7      LD  H,0
0009CA 09CA 22B40A          16      LD  (line_length),HL
0009CD 09CD 3A5B1F          13      LD  A,(_MXLIN)
0009D0 09D0 2E00             7      LD  L,0
0009D2 09D2 67               4      LD  H,A
0009D3 09D3 22BE0A          16      LD  (final_plus_one_cursor_XY),HL
0009D6 09D6 CD4D0B          17      CALL    get_offset_from_cursor_XY
0009D9 09D9 22C00A          16      LD  (offset_plus_one_cursor_XY),HL
0009DC 09DC CD4C0B          17      CALL    get_Y_next_logical_line
0009DF 09DF 22BA0A          16      LD  (next_cursor_XY_top_of_next_logical_line),HL
0009E2 09E2 CD4D0B          17      CALL    get_offset_from_cursor_XY
0009E5 09E5 22BC0A          16      LD  (next_cursor_offset_top_of_next_logical_line),HL
0009E8 09E8 CD1820          17      CALL    _CSR
0009EB 09EB 22B60A          16      LD  (now_cursor_XY),HL
0009EE 09EE CD4D0B          17      CALL    get_offset_from_cursor_XY
0009F1 09F1 22B80A          16      LD  (now_cursor_offset),HL
0009F4 09F4 2ABC0A          16      LD  HL,(next_cursor_offset_top_of_next_logical_line)
0009F7 09F7 2B               6      DEC HL  ;HL←行末のカーソル･オフセット
0009F8 09F8 CD8E0C          17      CALL    read_character_offset_address
0009FB 09FB 32B20A          13      LD  (line_end_character),A
0009FE 09FE D620             7      SUB ' ' ;0，0以外
000A00 0A00 C6FF             7      ADD A,0FFH  ;CY＝0， CY＝1
000A02 0A02 9F               4      SBC A,A ;00H，FFH
000A03 0A03 32B30A          13      LD  (cursor_line_end),A
000A06 0A06 ED5BB80A        20      LD  DE,(now_cursor_offset)
000A0A 0A0A 2ABC0A          16      LD  HL,(next_cursor_offset_top_of_next_logical_line)
000A0D 0A0D 2B               6      DEC HL  ;HL←行末のカーソル･オフセット
000A0E 0A0E B7               4      OR  A
000A0F 0A0F ED52            15      SBC HL,DE
000A11 0A11 7C               4      LD  A,H
000A12 0A12 B5               4      OR  L   ;0以外，0
000A13 0A13 C6FF             7      ADD A,0FFH  ;CY＝1，CY＝0
000A15 0A15 9F               4      SBC A,A ;FFH，00H
000A16 0A16 2F               4      CPL     ;00H，FFH
000A17 0A17 21B30A          10      LD  HL,cursor_line_end
000A1A 0A1A B6               7      OR  (HL)
000A1B 0A1B 77               7      LD  (HL),A
                                
                                ;   転送します
000A1C 0A1C ED5BB80A        20      LD  DE,(now_cursor_offset)
000A20 0A20 2ABC0A          16      LD  HL,(next_cursor_offset_top_of_next_logical_line)
000A23 0A23 2B               6      DEC HL  ;HL←行末のカーソル･オフセット
000A24 0A24 B7               4      OR  A
000A25 0A25 ED52            15      SBC HL,DE
000A27 0A27 4D               4      LD  C,L
000A28 0A28 44               4      LD  B,H ;BC←転送文字数
000A29 0A29 2AB80A          16      LD  HL,(now_cursor_offset)  ;HL←転送元カーソル･オフセット
000A2C 0A2C 5D               4      LD  E,L
000A2D 0A2D 54               4      LD  D,H
000A2E 0A2E 13               6      INC DE  ;DE←転送先カーソル･オフセット
000A2F 0A2F 2803            12      JR  Z,$+5
                                    ; CALL  VBTRNS
000A31 0A31 CD1820          17      CALL    _CSR
000A34 0A34 CD4D0B          17      CALL    get_offset_from_cursor_XY
000A37 0A37 3E20             7      LD  A,' '
000A39 0A39 CD8D0C          17      CALL    write_character_offset_address
000A3C 0A3C 3AB30A          13      LD  A,(cursor_line_end)
000A3F 0A3F B7               4      OR  A
000A40 0A40 2002            12      JR  NZ,$+4
000A42 0A42 F1              10      POP AF
000A43 0A43 C9              10      RET
                                
                                ;   1物理行を注入する必要がある場合
000A44 0A44 3A5B1F          13      LD  A,(_MXLIN)
000A47 0A47 21BB0A          10      LD  HL,next_cursor_XY_top_of_next_logical_line+1
000A4A 0A4A 96               7      SUB (HL)    ;Acc←画面残り物理行数
000A4B 0A4B 2849            12      JR  Z,GTIRU ;論理的に綱がっている最終物理行が、画面最終物理最終行と等しい
000A4D 0A4D 3D               4      DEC A
000A4E 0A4E 2829            12      JR  Z,write_new_line    ;論理的に綱がっている最終物理行が、画面最終物理行の上の行
                                ;   ライン･ターミナル･テーブルの転送
000A50 0A50 4F               4      LD  C,A
000A51 0A51 0600             7      LD  B,0 ;BC←転送行数－1
000A53 0A53 21BB0A          10      LD  HL,next_cursor_XY_top_of_next_logical_line+1
000A56 0A56 86               7      ADD A,(HL)
000A57 0A57 5F               4      LD  E,A
000A58 0A58 1606             7      LD  D,LINTTB/100H   ;DE←転送先
000A5A 0A5A 6B               4      LD  L,E
000A5B 0A5B 62               4      LD  H,D
000A5C 0A5C 2D               4      DEC L   ;HL←転送元
000A5D 0A5D EDB8                    LDDR
000A5F 0A5F EB               4      EX  DE,HL
000A60 0A60 70               7      LD  (HL),B  ;新行と次の行の連結解除
                                ;   画面の転送
