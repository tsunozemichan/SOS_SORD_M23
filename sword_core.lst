                                ;#FSAME（1FA0H）の本体
                                ; ＃FILE（1FA3H）でセットされたファイル名、ファイル属性と、
                                ;DE～にセットされた解析されてないないファイル名（エンド･コード00H）、
                                ;ファイル属性（Acc）を比較します。
                                ;入力   Acc←ファィル属性、DE←文字列（ファイル名）の先頭
                                ;   S-OSのFCBバッファ（fcb_buffer～）参照
                                ;出力   一致すればZF＝1（Acc←0）、不一致ならZF＝0（Acc←8）
                                ;破壊   AF，HL，DE，BC
                                ;注：
                                ; 入力パラメータに、ファイル属性（Acc）が必要。
                                ; CYは常にリセットされています。
       084D                     FSAME:
                                ;   ファイル属性の比較
00084D 084D E687             7      AND 10000111B   ;マスク
00084F 084F 47               4      LD  B,A ;B←マスクされたファイル属性
000850 0850 3A1F29          13      LD  A,(_FTYPE)  ;Acc←セットされたFCBのファイル属性
000853 0853 E687             7      AND 10000111B   ;マスク
000855 0855 B8               4      CP  B
000856 0856 C27208          10      JP  NZ,FSMERR   ;ファイル属性が一致しない
                                
                                ;   [BUFFER～]にデバイス名とファイル名を解析してセットします
000859 0859 CDAB08          17      CALL    FNAME   ;ファイル名を解析します
00085C 085C D8              11      RET C   ;デバイス名が異常（エラー3）
                                
                                ;   デバイス名の比較
00085D 085D 3A5D1F          13      LD  A,(_DSK)
000860 0860 210001          10      LD  HL,BUFFER
000863 0863 BE               7      CP  (HL)
000864 0864 200C            12      JR  NZ,FSMERR
                                
                                ;   ファイル名（プライマリ，拡張子）の比較
000866 0866 11CD04          10      LD  DE,fcb_buffer+1 ;比較されるファイル名
000869 0869 210101          10      LD  HL,BUFFER+1 ;比較するファイル名
00086C 086C 3E10             7      LD  A,16
00086E 086E CD9C08          17      CALL    CMPFNM  ;ファイル名を比較します
000871 0871 C8              11      RET Z
                                
                                ;   一致しませんでした
000872 0872 3E08             7  FSMERR: LD  A,8 ;File not Found
000874 0874 B7               4      OR  A   ;ZF←0
000875 0875 37               4      SCF
000876 0876 C9              10      RET
                                
                                
                                ;#FILE（1FA3H）の本体
                                ; ファイル名を解析して、各ワークにパラメータをセットします。
                                ;入力   Acc←ファィル属性、DE←文字列（ファイル名）の先頭
                                ;出力   [_DSK]←デバイス名、[_FTYPE]←ファイル属性、
                                ;   S-OSのFCBバッファ←変換されたファイル名
                                ;   DEは00Hか「:」のアドレスを示しています。
                                ;   CY＝1ならエラー（Acc←エラー･コード）
                                ;破壊   AF，HL，DE，BC
                                ;注：
                                ; CY＝0でリターンしています。
                                ; ファイル名はコントロール･コードなどがカットされ、
                                ;「*」は「?」に展開されます。
       0877                     FILE:
000877 0877 321F29          13      LD  (_FTYPE),A  ;ファイル属性（ファイル名の解析でセットされます）
00087A 087A 32CC04          13      LD  (fcb_buffer),A  ;FCBのファイル属性部分（＋0）
00087D 087D CDAB08          17      CALL    FNAME   ;ファイル名を解析します
000880 0880 D8              11      RET C   ;デバイス名が異常（エラー3）
000881 0881 D5              11      PUSH    DE
000882 0882 3A0001          13      LD  A,(BUFFER)  ;Acc←デバイス名
000885 0885 325D1F          13      LD  (_DSK),A
000888 0888 210101          10      LD  HL,BUFFER+1 ;解析されたファイル名
00088B 088B 11CD04          10      LD  DE,fcb_buffer+1 ;FCBのファイル名フィールド
00088E 088E 011000          10      LD  BC,16
000891 0891 EDB0                    LDIR        ;FCBのファイル名部分（＋1～＋16）
000893 0893 3E20             7      LD  A,20H
000895 0895 12               7      LD  (DE),A  ;FCBのパスワード部分（＋17）
000896 0896 D1              10      POP DE
000897 0897 CD180D          17      CALL    SPSKIP  ;文字列の空白を読み飛ばします
00089A 089A AF               4      XOR A   ;CY←0
00089B 089B C9              10      RET
                                
                                
                                ;===============================
                                ;ファイル名処理補助ルーチン
                                ;===============================
                                
                                
                                ;ファイル名を比較します
                                ;入力   DE←比較されるファイル名の先頭、HL←比較するファイル名の先頭、
                                ;   Acc←カウンタ
                                ;出力   ZF＝1なら一致
                                ;破壊   AF，HL，DE，BC
                                ;注：ワイルド･カードの「?」は常に一致とみなします。
       089C                     CMPFNM:
00089C 089C 47               4      LD  B,A ;B←カウンタ
00089D 089D EB               4      EX  DE,HL
                                
                                ;   比較ループ
00089E 089E 1A               7  CPFLP:  LD  A,(DE)  ;Acc←比較する文字
00089F 089F FE3F             7      CP  '?'
0008A1 08A1 2802            12      JR  Z,CPFSKP    ;常に一致させます
0008A3 08A3 BE               7      CP  (HL)
0008A4 08A4 C0              11      RET NZ  ;一致しませんでした
0008A5 08A5 13               6  CPFSKP: INC DE
0008A6 08A6 23               6      INC HL
0008A7 08A7 10F5            13      DJNZ    CPFLP
                                
                                ;   すべて一致
0008A9 08A9 AF               4      XOR A   ;ZF←1
0008AA 08AA C9              10      RET
                                
                                
                                ;ファイル名を解析します
                                ;入力   DE←文字列（ファイル名）の先頭
                                ;出力   [BUFFER]←デバイス名、[BUFFER＋1～]←変換されたファイル名
                                ;   DEはカウント･アップされます（区切りでストップ）
                                ;   CY＝1（Acc←エラー･コード）ならエラー
                                ;破壊   AF，HL，DE，BC
       08AB                     FNAME:
                                ;   デバイス名の転送
0008AB 08AB CDD708          17      CALL    MGETDV  ;文字列からデバイス名を取り出します
0008AE 08AE CD1529          17      CALL    _DVCHK  ;デバイス名が正しいか（A～L，S，T，Q）かチェックします
0008B1 08B1 D8              11      RET C   ;Acc←3 'Bad File Descripter
0008B2 08B2 210001          10      LD  HL,BUFFER
0008B5 08B5 77               7      LD  (HL),A  ;[BUFFER]←デバイス名
0008B6 08B6 23               6      INC HL  ;HL←BUFFER＋1
                                
                                ;   ファイル名の転送
0008B7 08B7 CDF208          17      CALL    CLRWFG
0008BA 08BA 060D             7      LD  B,13    ;プライマリ名
0008BC 08BC CDF808          17  FNML11: CALL    GTFLTR
0008BF 08BF 77               7      LD  (HL),A
0008C0 08C0 23               6      INC HL
0008C1 08C1 10F9            13      DJNZ    FNML11
0008C3 08C3 CD2D09          17      CALL    SKPPRD
0008C6 08C6 CDF208          17      CALL    CLRWFG
0008C9 08C9 0603             7      LD  B,3 ;拡張子
0008CB 08CB CDF808          17  FNML12: CALL    GTFLTR
0008CE 08CE 77               7      LD  (HL),A
0008CF 08CF 23               6      INC HL
0008D0 08D0 10F9            13      DJNZ    FNML12
0008D2 08D2 CD2D09          17      CALL    SKPPRD
                                
0008D5 08D5 AF               4      XOR A   ;CY←0
0008D6 08D6 C9              10      RET
                                
                                
                                ;文字列からデバイス名を取り出します
                                ;入力   DE←文字列の先頭アドレス
                                ;出力   Acc←デバイス名（省略時はデフォルト、小文字は大文字に変換）
                                ;   CY＝1ならデバイス名が省略されていました
                                ;   DEはカウント･アップされます
                                ;破壊   AF，DE
       08D7                     MGETDV:
0008D7 08D7 CD180D          17      CALL    SPSKIP  ;文字列の空白を読み飛ばします
0008DA 08DA 1A               7      LD  A,(DE)
0008DB 08DB B7               4      OR  A
0008DC 08DC 280F            12      JR  Z,MGTDV1    ;文字列の終わりに達していました
0008DE 08DE 13               6      INC DE
0008DF 08DF 1A               7      LD  A,(DE)
0008E0 08E0 1B               6      DEC DE
0008E1 08E1 FE3A             7      CP  ':'
0008E3 08E3 2008            12      JR  NZ,MGTDV1   ;デバイスが指定されていません
                                
                                ;   デバイスが指定されています
0008E5 08E5 1A               7      LD  A,(DE)
0008E6 08E6 CD220D          17      CALL    convert_lower_case_to_upper_case
0008E9 08E9 13               6      INC DE
0008EA 08EA 13               6      INC DE
0008EB 08EB B7               4      OR  A   ;CY←0
0008EC 08EC C9              10      RET
                                
                                ;   デバイスが指定されていません
0008ED 08ED CD2420          17  MGTDV1: CALL    _RDVSW
0008F0 08F0 37               4      SCF     ;CY←1
0008F1 08F1 C9              10      RET
                                
                                
                                ;GTFLTRルーチンの「*」モードを初期化します
                                ;入力   なし
                                ;出力   [WASFLG]←0
                                ;破壊   AF
       08F2                     CLRWFG:
0008F2 08F2 AF               4      XOR A
0008F3 08F3 322B09          13      LD  (WASFLG),A
0008F6 08F6 C9              10      RET
                                
                                
                                ;文字列からファイル名（プライマリ，拡張子）を1文字取り出します
                                ;入力   DE←文字列のアドレス
                                ;出力   Acc←変換された文字（区切りに達した場合はスペースに変換されます）
                                ;   DEはカウント･アップされます（区切りでストップ）
                                ;破壊   AF，DE
                                ;注：
                                ; 00H、0DH、「:」、「.」を区切りとみなします。
                                ; コントロール･コードやスペースはスキップします。
                                ; 「*」フェイズでは「?」を返します。
0008F7 08F7 13               6  GFLLP:  INC DE
                                
       08F8                     GTFLTR:
                                ;   「*」フェイズかチェックします
0008F8 08F8 3A2B09          13      LD  A,(WASFLG)
0008FB 08FB B7               4      OR  A
0008FC 08FC 2027            12      JR  NZ,GFLWLD
                                
0008FE 08FE 1A               7      LD  A,(DE)  ;Acc←1文字
                                
                                ;   区切りに達したか調べます
0008FF 08FF B7               4      OR  A   ;NUL
000900 0900 2826            12      JR  Z,GFLESC
000902 0902 FE0D             7      CP  0DH ;RET
000904 0904 2822            12      JR  Z,GFLESC
000906 0906 FE3A             7      CP  ':'
000908 0908 281E            12      JR  Z,GFLESC
00090A 090A FE2E             7      CP  '.'
00090C 090C 281A            12      JR  Z,GFLESC
                                
                                ;   コントロール･コードとスペースをスキップします
00090E 090E 1A               7      LD  A,(DE)
00090F 090F FE7F             7      CP  7FH ;DEL
000911 0911 28E4            12      JR  Z,GFLLP
000913 0913 FE21             7      CP  21H ;00H～20H
000915 0915 38E0            12      JR  C,GFLLP
                                
                                ;   「*」かチェックします
000917 0917 FE2A             7      CP  '*'
000919 0919 2804            12      JR  Z,GFLAST
                                
                                ;   通常終了
00091B 091B 13               6      INC DE  ;DEのカウント･アップ
00091C 091C C3220D          10      JP  convert_lower_case_to_upper_case
                                
                                ;   「*」を発見しました
00091F 091F 3EFF             7  GFLAST: LD  A,0FFH
000921 0921 322B09          13      LD  (WASFLG),A
000924 0924 13               6      INC DE
                                
                                ;   「*」フェイズ
000925 0925 3E3F             7  GFLWLD: LD  A,'?'
000927 0927 C9              10      RET
                                
                                ;   ピリオドかファイル名の最後に達しました
000928 0928 3E20             7  GFLESC: LD  A,' '
00092A 092A C9              10      RET
                                
                                ;   ワイルド･カード関係
00092B 092B                     WASFLG: DS  1   ;＝FFHで「*」フェイズ中
                                
                                
                                ;ファイル名のピリオド部（プライマリと拡張子の区切り）をスキップします
                                ;入力   DE←文字列のアドレス
                                ;出力   DEはカウント･アップされます（区切りでストップ）
                                ;破壊   AF，DE
                                ;注：
                                ; 00H、0DH、「:」を区切りとみなします。
                                ; コントロール･コードやスペースはスキップします。
00092C 092C 13               6  SKPLP:  INC DE
                                
       092D                     SKPPRD:
00092D 092D 1A               7      LD  A,(DE)  ;Acc←1文字
                                
                                ;   区切りに達したか調べます
00092E 092E B7               4      OR  A   ;NUL
00092F 092F C8              11      RET Z
000930 0930 FE0D             7      CP  0DH ;RET
000932 0932 C8              11      RET Z
000933 0933 FE3A             7      CP  ':'
000935 0935 C8              11      RET Z
                                
                                ;   ピリオドに達したか調べます
000936 0936 FE2E             7      CP  '.'
000938 0938 20F2            12      JR  NZ,SKPLP
                                
                                ;   ピリオドをスキップ
00093A 093A 13               6      INC DE
00093B 093B C9              10      RET
                                
                                
