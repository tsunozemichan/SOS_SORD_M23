                                ;^I TAB タブ処理
                                ;〈レジスタ･マップ〉
                                ;HL CSRNX
                                ;D  [_WIDTH]
                                ;E  定数00000111B
                                ;C  現在x負座標
       0B2C                     control_code_TAB:
000B2C 0B2C C9              10      RET
                                
                                ;   最終桁の場合
       0B2D                     CTLTAE:
                                
                                
                                ;^L CLR 画面クリア
                                ;注：フィジカル･ルーチンCLS（AF，HL，DE，BC破壊）を呼び出します。
       0B2D                     control_code_CLS:
