002172 2172 CD9422          17  JUMP:   CALL    SPCUT   ;文字列の空白を読み飛ばします
002175 2175 CDB21F          17      CALL    _HLHEX
002178 2178 3E0D             7      LD  A,13    ;Syntax Error
00217A 217A D8              11      RET C
