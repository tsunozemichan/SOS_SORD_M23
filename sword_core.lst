       0B37                     CTLCAN:
000B37 0B37 C9              10      RET
                                
                                ;^M CR カーソルを次の行の行頭へ（物理改行）
       0B38                     CTLCR:
000B38 0B38 C9              10      RET
                                
                                ;^H BS バック･スペース
       0B39                     control_code_BS:
000B39 0B39 C9              10      RET
                                
                                ;7EH DEL デリート･コード
       0B3A                     control_code_DELETEL:
000B3A 0B3A C9              10      RET
                                
                                ;^E カーソル位置から行末までクリア
       0B3B                     CTL05:
000B3B 0B3B C9              10      RET
                                
                                
                                ;^A カーソルを論理行頭へ（－^V）
       0B3C                     CTL01:
000B3C 0B3C C9              10      RET
                                
                                ;---------------
                                ;独自ルーチン
                                ;---------------
                                
                                
                                ;=======================
                                ;表示ルーチン前処理
                                ;=======================
                                
                                
                                ;表示ルーチンを初期飛び先へジャンプするように設定します
                                ;入力   なし
                                ;出力   なし
                                ;破壊   HL
       0B3D                     SETPRN:
000B3D 0B3D C9              10      RET
                                
                                
                                ;=======================
                                ;スクリーン制御補助
                                ;=======================
                                
                                
                                ;論理桁位置を得ます
                                ;入力   x座標、桁数参照
                                ;出力   HL←論理桁位置
                                ;破壊   AF，HL，DE，BC
                                ;〈レジスタ･マップ〉
                                ;E  桁数
                                ;C  現在y座標
                                ;BC ライン･ターミナル･テーブルの先頭＋y座標
                                ;HL 論理桁位置カウンタ
       0B3E                     get_logical_column:
                                    ;テキストVRAMのスタートアドレスがF800Hであり、一行の桁数は80dであるので、
                                    ;論理桁位置は、(y座標×80d)+x座標で求められます。
000B3E 0B3E CDF710          17      CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
000B41 0B41 2A00FF          16      LD  HL,(cursor_XY_ADDR) ; 
000B44 0B44 C9              10      RET
                                
                                ;論理行頭の座標を得ます
                                ;入力   なし
                                ;出力   L←0、H←論理行頭のy座標
                                ;破壊   AF，HL
       0B45                     get_Y_top_of_logical_line:
000B45 0B45 CDF710          17      CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
000B48 0B48 2A02FF          16      LD  HL,(cursor_XY_ADDR+2) ;
000B4B 0B4B C9              10      RET
                                
                                
                                ;次の論理行の座標を得ます
                                ;入力   なし
                                ;出力   L←0、H←論理行頭のy座標
                                ;破壊   AF，HL
       0B4C                     get_Y_next_logical_line:
000B4C 0B4C C9              10      RET
                                
                                
                                ;カーソル座標からオフセット･アドレスを求めます
                                ;入力   L←x座標、H←y座標
                                ;出力   HL←オフセット
                                ;破壊   AF，HL
                                ;注：cursor_offset_for_Y_tableは、y座標→カーソル･オフセット対応表。
       0B4D                     get_offset_from_cursor_XY:
000B4D 0B4D C9              10      RET
                                
                                
                                ;オフセット･アドレスからカーソル座標を求めます
                                ;入力   HL←カーソル･オフセット
                                ;出力   L←x座標,H←y座標
                                ;破壊   AF，HL
       0B4E                     get_cursor_XY_from_offset_address:
000B4E 0B4E C9              10      RET
                                
                                
                                ;カーソルのオフセット計算用テーブルを生成します
                                ;入力   [_WIDTH]参照
                                ;出力   [cursor_offset_for_Y_table～]←オフセット
                                ;破壊   AF，HL，DE，BC
                                ;〈レジスタ･マップ〉
                                ;DE テーブル･アドレス
                                ;BC 定数[_WIDTH]
                                ;HL カーソル･オフセット
                                ;Acc    ループ･カウンタ
       0B4F                     generate_cursor_offset_table:
000B4F 0B4F C9              10      RET
                                
                                
                                ;カーソル制御用ワークの初期化
                                ;入力   [_WIDTH]、[_WIDTH]、[_MXLIN]、[vram_address_of_top]参照
                                ;出力   [CSRADD]、[CSRNXI]、[CSRNYI]、[cursor_offset_last_top_of_line]、[total_number_of_character_display]、[vram_address_of_top_of_last_line]、
                                ;   ライン･ターミナル･テーブル初期化
                                ;破壊   AF，HL，DE，BC
       0B50                     initialize_cursor_control_work_area:
000B50 0B50 C9              10      RET
                                
                                
                                ;-------------------------------
                                ;S-OSルーチン（機種依存）
                                ;-------------------------------
                                
                                
                                ;===============
                                ;I／O入出力
                                ;===============
                                
                                
                                ;#INP（202AH）の本体
                                ; I／Oポートにデータを出力。
                                ;入力   なし
                                ;出力   Acc←データ
                                ;破壊   AF
       0B51                     INP:
000B51 0B51 C5              11      PUSH BC
000B52 0B52 0600             7      LD  B,0
000B54 0B54 ED78            12      IN  A,(C)
000B56 0B56 C1              10      POP BC
000B57 0B57 C9              10      RET
                                
                                
                                ;#OUT（202DH）の本体
                                ; I／Oポートからデータを入力。
                                ;入力   Acc←データ
                                ;出力   なし
                                ;破壊   なし
       0B58                     OUTP:
000B58 0B58 C5              11      PUSH BC
000B59 0B59 0600             7      LD  B,0
000B5B 0B5B ED79            12      OUT (C),A
000B5D 0B5D C1              10      POP BC
000B5E 0B5E C9              10      RET
                                
                                
                                ;=======================
                                ;特殊ワーク（機種依存）
                                ;=======================
                                
                                
                                ;#POKE（1F9AH）の本体
                                ; 特殊ワーク･エリアに1バイト書き込みます。
                                ;入力   HL←アドレス、Acc←データ
                                ;出力   なし
                                ;破壊   なし
                                ;〈旧SWORDとの速度比較〉
                                ;POKE    97ts→ 83ts    1.169倍
                                ;#POKE  107ts→ 93ts    1.151倍
                                ;＋CALL 124ts→110ts    1.127倍
       0B5F                     POKE:
000B5F 0B5F C5              11      PUSH    BC  ;11ts
000B60 0B60 F5              11      PUSH    AF  ;11ts
000B61 0B61 4D               4      LD  C,L ; 4ts
000B62 0B62 3E40             7      LD  A,40H   ; 7ts '特殊ワーク先頭（4000H）
000B64 0B64 84               4      ADD A,H ; 4ts 'CY←0
000B65 0B65 47               4      LD  B,A ; 4ts 'BC←実アドレス
000B66 0B66 F1              10      POP AF  ;10ts
000B67 0B67 ED79            12      OUT (C),A   ;12ts '特殊ワークへの書き込み
000B69 0B69 C1              10      POP BC  ;10ts
000B6A 0B6A C9              10      RET     ;10ts
                                
                                
                                ;#PEEK（1F94H）の本体
                                ; 特殊ワーク･エリアから1バイト読み込みます。
                                ;入力   HL←アドレス
                                ;出力   Acc←データ
                                ;破壊   AF
                                ;〈旧SWORDとの速度比較〉
                                ;POKE   109ts→ 62ts    1.758倍
                                ;#POKE  119ts→ 72ts    1.653倍
                                ;＋CALL 136ts→ 89ts    1.528倍
                                ;注：CYをクリアします。
       0B6B                     PEEK:
000B6B 0B6B C5              11      PUSH    BC  ;11ts
000B6C 0B6C 4D               4      LD  C,L ; 4ts
000B6D 0B6D 3E40             7      LD  A,40H   ; 7ts '特殊ワーク先頭（4000H）
000B6F 0B6F 84               4      ADD A,H ; 4ts 'CY←0
000B70 0B70 47               4      LD  B,A ; 4ts 'BC←実アドレス
000B71 0B71 ED78            12      IN  A,(C)   ;12ts '特殊ワークからの読み込み
000B73 0B73 C1              10      POP BC  ;10ts
000B74 0B74 C9              10      RET     ;10ts
                                
                                
                                ;#poke_entity（1F97H）の本体
                                ; 特殊ワーク･エリアにブロック書き込みします。
                                ;入力   HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
                                ;   BC←転送バイト数
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
                                ;〈旧SWORDとの速度比較〉
                                ;ループ  57ts→ 40ts    1.425倍
                                ;注：「WINER」などでCYクリアが必要。
       0B75                     poke_entity:
000B75 0B75 3E40             7      LD  A,40H   ;特殊ワーク先頭（4000H）
000B77 0B77 82               4      ADD A,D ;CY←0
000B78 0B78 57               4      LD  D,A
000B79 0B79 D5              11      PUSH    DE
                                
                                ;   高速ループ･カウンタの設定（BC→AD版）
000B7A 0B7A AF               4      XOR A
000B7B 0B7B B9               4      CP  C   ;下位カウンタ＝0ならCY＝0
000B7C 0B7C 88               4      ADC A,B ;Acc←新上位ループ･カウンタ
000B7D 0B7D 51               4      LD  D,C ;D←下位ループ･カウンタ
                                
000B7E 0B7E C1              10      POP BC  ;BC←実アドレス
                                
000B7F 0B7F 04               4  POKE_LP:    INC B   ; 4ts '先行デクリメントのため
000B80 0B80 EDA3            16      OUTI        ;16ts '特殊ワークへの書き込み
000B82 0B82 03               6      INC BC  ; 6ts
000B83 0B83 15               4      DEC D   ; 4ts
000B84 0B84 C27F0B          10      JP  NZ,POKE_LP  ;10ts
000B87 0B87 3D               4      DEC A
000B88 0B88 20F5            12      JR  NZ,POKE_LP
                                
                                ;   OR  A   ;CY←0
000B8A 0B8A C9              10      RET
                                
                                
                                ;#peek_entity（1F91H）の本体
                                ; 特殊ワーク･エリアからブロック読み込みします。
                                ;入力   HL←メモリ先頭アドレス、DE←特殊ワーク先頭アドレス、
                                ;   BC←転送バイト数
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
                                ;〈旧SWORDとの速度比較〉
                                ;ループ  57ts→ 40ts    1.425倍
                                ;注：「WINER」などでCYクリアが必要。
       0B8B                     peek_entity:
000B8B 0B8B 3E40             7      LD  A,40H   ;特殊ワーク先頭（4000H）
000B8D 0B8D 82               4      ADD A,D ;CY←0
000B8E 0B8E 57               4      LD  D,A
000B8F 0B8F D5              11      PUSH    DE
                                
                                ;   高速ループ･カウンタの設定（BC→AD版）
000B90 0B90 AF               4      XOR A
000B91 0B91 B9               4      CP  C   ;下位カウンタ＝0ならCY＝0
000B92 0B92 88               4      ADC A,B ;Acc←新上位ループ･カウンタ
000B93 0B93 51               4      LD  D,C ;D←下位ループ･カウンタ
                                
000B94 0B94 C1              10      POP BC  ;BC←実アドレス
                                
000B95 0B95 04               4  PEEK_LP:    INC B   ; 4ts '先行デクリメントのため
000B96 0B96 EDA2            16      INI     ;16ts '特殊ワークからの読み込み
000B98 0B98 03               6      INC BC  ; 6ts
000B99 0B99 15               4      DEC D   ; 4ts
000B9A 0B9A C2950B          10      JP  NZ,peek_lp  ;10ts
000B9D 0B9D 3D               4      DEC A
000B9E 0B9E 20F5            12      JR  NZ,peek_lp
                                
                                ;   OR  A   ;CY←0
000BA0 0BA0 C9              10      RET
                                
                                
                                ;---------------------------------------
                                ;フィジカル･ルーチン（機種依存）
                                ;---------------------------------------
                                
                                
                                ;===============================
                                ;システム･ルーチン（機種依存）
                                ;===============================
                                
                                ;ブートします
                                ;入力   なし
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       0BA1                     boot_entity:
000BA1 0BA1 CD4C10          17      CALL    SOSSF       ;仮想ディスク全クローズ
                                
000BA4 0BA4 21D300          10      LD  HL,00D3H    ;「OUT (0),A」
000BA7 0BA7 22FEFF          16      LD  (0FFFEH),HL
000BAA 0BAA 3E1D             7      LD  A,1DH
000BAC 0BAC C3FEFF          10      JP  0FFFEH
                                
                                
                                ;===============================================
                                ;フィジカル･ルーチン･プリンタ関係（機種依存）
                                ;===============================================
                                
                                
                                ;プリンタへ1文字出力します
                                ;入力   Acc←文字
                                ;出力   エラーが起こればCY＝1
                                ;破壊   AF
       0BAF                     lprint_entity:
000BAF 0BAF E5              11      PUSH    HL
000BB0 0BB0 C5              11      PUSH    BC
000BB1 0BB1 6F               4      LD  L,A ;L←文字（保存用）
000BB2 0BB2 67               4      LD  H,A ;H←文字
000BB3 0BB3 01011A          10      LD  BC,1A01H
                                
                                ;   プリンタREADYを待ちます
000BB6 0BB6 ED78            12  lplp_entity:    IN  A,(C)
000BB8 0BB8 0F               4      RRCA
000BB9 0BB9 3017            12      JR  NC,lpbrk_entity ;^C
000BBB 0BBB ED78            12      IN  A,(C)
000BBD 0BBD E608             7      AND 00001000B
000BBF 0BBF 20F5            12      JR  NZ,lplp_entity
                                
000BC1 0BC1 B7               4      OR  A   ;CY←0
                                
                                ;   文字を出力
                                ;注：CYは保存します。
000BC2 0BC2 0D               4  lp1_entity: DEC C   ;BC←1A00H
000BC3 0BC3 ED61            12      OUT (C),H
                                ;   受け取り指示
000BC5 0BC5 0E03             7      LD  C,3 ;BC←1A03H
000BC7 0BC7 3E0E             7      LD  A,00001110B ;b7リセット
000BC9 0BC9 ED79            12      OUT (C),A
000BCB 0BCB 3C               4      INC A   ;b7セット
000BCC 0BCC ED79            12      OUT (C),A
                                
                                ;   終了
000BCE 0BCE 7D               4      LD  A,L ;Acc←文字
000BCF 0BCF C1              10      POP BC
000BD0 0BD0 E1              10      POP HL
000BD1 0BD1 C9              10      RET
                                
                                ;   ^C処理
000BD2 0BD2 260D             7  lpbrk_entity:   LD  H,0DH   ;RET
000BD4 0BD4 37               4      SCF
000BD5 0BD5 18EB            12      JR  lp1_entity
                                
                                
                                ;=======================
                                ;音声（機種依存）
                                ;=======================
                                
                                
                                ;ビープ音を鳴らします
                                ;入力   なし
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       0BD7                     bell_entity:
000BD7 0BD7 F3               4      DI
000BD8 0BD8 FB               4      EI
000BD9 0BD9 C9              10      RET
                                
                                ;===============================
                                ;スクリーン関係（機種依存）
                                ;===============================
                                
                                
                                ;カーソル座標を読み出します
                                ;入力   なし
                                ;出力   L←x座標、H←y座標
                                ;破壊   AF，HL，DE，BC
       0BDA                     get_cursor_XY_entity:
000BDA 0BDA ED5BF604        20      LD  DE,(CSRADD) ; CSRADDの値をDEへ
000BDE 0BDE 2AFA04          16      LD  HL,(CSRNX) ; CSRNXの値をHLへ
000BE1 0BE1 19              11      ADD HL,DE
000BE2 0BE2 C9              10      RET
                                
                                ;カーソルを指定座標へ移動します
                                ;入力   L←x座標、H←y座標
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       0BE3                     move_cursor_XY_entity:
000BE3 0BE3 ED5BF804        20      LD  DE,(CSRNXI) ;256-桁数 '[CSRNX]の初期値
000BE7 0BE7 19              11      ADD HL,DE
000BE8 0BE8 22FA04          16      LD  (CSRNX),HL ;ｘ座標-[_WIDTH]
000BEB 0BEB C33D0B          10      JP  SETPRN
                                
                                ;指定座標の文字を読み込みます
                                ;入力   L←x座標、H←y座標
                                ;出力   Acc←文字
                                ;破壊   AF，HL，DE，BC
       0BEE                     get_character_XY_entity:
000BEE 0BEE CD4D0B          17      CALL get_offset_from_cursor_XY
000BF1 0BF1 C38E0C          10      JP read_character_offset_address
                                
                                ;画面のクリア
                                ;入力   [screen_width]、[total_number_of_character_display]、[attribute_data]参照
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
                                ;〈レジスタ･マップ〉
                                ;E  クリア･データ（定数）
                                ;BC 現在アトリビュートVRAMアドレス
                                ;AD 高速ループ･カウンタ
                                ; 画面左上のアドレスはf800hです。
                                ; そこから、ffd0hまでをスペースキャラクタ(アスキーコード20h)で埋めて、画面をクリアするコードを書いて下さい。
                                
       0BF4                     CLS:
000BF4 0BF4 E5              11      PUSH HL
000BF5 0BF5 C5              11      PUSH BC
                                
000BF6 0BF6 2100F0          10      LD HL,0F000H
000BF9 0BF9 010008          10      LD BC,0800H
                                
000BFC 0BFC 0650             7      LD B,050H
000BFE 0BFE 11FFFF          10      LD DE,0FFFFH
000C01 0C01 3E20             7      LD A,20H ; スペースキャラクタ
                                ; CLEAR_ALL_LINE_CLS:
       0C03                     .LOOP
000C03 0C03 D3D2            11      OUT (0D2H),A ; VRAMへアクセスするためのポート
000C05 0C05 77               7      LD (HL),A ; VRAMへ20Hデータを書き込む
000C06 0C06 23               6      INC HL ; 書き込むべきアドレスをインクリメント
000C07 0C07 ED52            15      SBC HL,DE ; HL - DE
                                    ; JR NZ,CLEAR_ALL_LINE_CLS ; 全てのアドレスを書き込むまでループ
000C09 0C09 20F8            12      JR NZ,.LOOP ; 全てのアドレスを書き込むまでループ
                                
000C0B 0C0B 1100F8          10      LD DE, VRAM_TXT_TOP ; 最初の文字列表示位置(左上隅)
000C0E 0C0E ED538E12        20      LD (CURSOR_LOCATE),DE ; カーソル位置を左上隅に設定 F800H
000C12 0C12 ED539012        20      LD (TOP_VIEW),DE
000C16 0C16 11D0FF          10      LD DE, 0FFD0H ; 画面最終文字位置
000C19 0C19 ED539212        20      LD (NEED_DO_SCROLL_POINT),DE ; スクロールポイントを設定
                                
000C1D 0C1D C9              10      RET
                                
                                
                                ;===============================
                                ;1文字表示ルーチン（機種依存）
                                ;===============================
                                
                                
                                ;コントロール･コード制御（PRINTルーチンの一部）
                                ;入力   Acc←コントロール･コード（00H～1FH）
       0C1E                     PRNCTL:
000C1E 0C1E F5              11      PUSH    AF
000C1F 0C1F E5              11      PUSH    HL
000C20 0C20 D5              11      PUSH    DE
000C21 0C21 C5              11      PUSH    BC
000C22 0C22 218003          10      LD  HL,control_code_jump_tabel
000C25 0C25 87               4      ADD A,A ;Acc←コントロール･コード×2
000C26 0C26 85               4      ADD A,L
000C27 0C27 6F               4      LD  L,A ;HL←control_code_jump_tabel＋コントロール･コード×2
000C28 0C28 7E               7      LD  A,(HL)
000C29 0C29 2C               4      INC L
000C2A 0C2A 66               7      LD  H,(HL)
000C2B 0C2B 6F               4      LD  L,A ;HL←[control_code_jump_tabel＋コントロール･コード×2]
                                
000C2C 0C2C 11310C          10      LD  DE,PRCRET
000C2F 0C2F D5              11      PUSH    DE  ;リータン･アドレスの設定
000C30 0C30 E9               4      JP  (HL)    ;「CALL コントロール制御」相当
000C31 0C31 CD3D0B          17  PRCRET: CALL    SETPRN
000C34 0C34 C1              10      POP BC
000C35 0C35 D1              10      POP DE
000C36 0C36 E1              10      POP HL
000C37 0C37 F1              10      POP AF
000C38 0C38 B7               4      OR  A   ;CY←0
000C39 0C39 C9              10      RET
                                
                                ;1文字プリント前処理
000C3A 0C3A E5              11  PREPR:  PUSH    HL
000C3B 0C3B E1              10      POP HL
                                
                                ;#PRINT（1FF4H）本体
                                ; 1文字プリント･ルーチン。
                                ;入力   Acc←文字
                                ;出力   なし
                                ;破壊   F
                                ;注：
                                ; [#LPSW]がオンならプリンタにも出力します。
                                ; インサート･モードと論理改行は、1行入力ルーチンで制御します。
                                ; CYフラグをクリアします。
                                ;〈実行時間〉
                                ;PRINT  149ts（37.250μs）
                                ;#PRINT 159ts（39.750μs）
                                ;＋CALL 176ts（44.000μs）
       0C3C                     PRINT:
000C3C 0C3C F5              11      PUSH AF
000C3D 0C3D E5              11      PUSH HL
000C3E 0C3E D5              11      PUSH DE
000C3F 0C3F C5              11      PUSH BC
                                
000C40 0C40 CD9A10          17      CALL PUTCHAR
                                
                                    ; Aレジスタに格納された値がCR（0DH）かどうかをチェック
000C43 0C43 FE0D             7      CP  CR
000C45 0C45 2805            12      JR  Z,ADD_LF; CRならLFの処理もする。SOSはCRをCR+LFとして扱うため。
                                
       0C47                     PRINT_END:
                                
000C47 0C47 C1              10      POP BC
000C48 0C48 D1              10      POP DE
000C49 0C49 E1              10      POP HL
000C4A 0C4A F1              10      POP AF
                                
                                    ; PUSH HL
                                    ; PUSH BC
                                    ; PUSH DE
                                    ; LD    HL,CSRNX ;10t
                                    ; INC (HL) ;4ts 
                                    ; POP   BC
                                    ; POP   DE
                                    ; POP   HL
                                
000C4B 0C4B C9              10      RET ; 
                                
       0C4C                     ADD_LF:
000C4C 0C4C F5              11      PUSH AF
000C4D 0C4D E5              11      PUSH HL
000C4E 0C4E D5              11      PUSH DE
000C4F 0C4F C5              11      PUSH BC
000C50 0C50 3E0A             7      LD A, LF; LFのASCIIコード
000C52 0C52 CD9A10          17      CALL PUTCHAR
000C55 0C55 C1              10      POP BC
000C56 0C56 D1              10      POP DE
000C57 0C57 E1              10      POP HL
000C58 0C58 F1              10      POP AF
000C59 0C59 18EC            12      JR  PRINT_END
                                
                                ;===============================
                                ;文字列表示ルーチン（機種依存）
                                ;===============================
                                
                                ;文字のブロック表示（非コントロール･コードのみ表示します）
                                ;入力   DE←文字列の先頭アドレス
                                ;出力   DE←次の文字の位置
                                ;破壊   AF，HL，DE，BC
                                ;〈レジスタ･マップ〉
                                ;SP 現在文字列のアドレス
                                ;E  文字読み込み1
                                ;D  文字読み込み2
                                ;BC 現在テキストVRAMアドレス
                                ;HL 現在文字変換テーブルのアドレス
                                ;IXL    ループ･カウンタ
                                ;IXH    定数桁数÷2（ループ用）
                                ;Acc    定数20H－1（コントロール･コード･チェック用）
                                ;注：
                                ; プリンタには出力しません。
                                ; インサート･モードと論理改行は、1行入力ルーチンで制御します。
                                ; [number_of_character_after_CR]は無視します。
                                ; 桁数は、必ず偶数であること。
                                ;〈実行時間〉
                                ;最内ループ53ts（13.250μs）
       0C5B                     BPRNT0:
                                ;   PUSH    IX
                                ; ; 共通の設定
                                ;   LD  A,(_WIDTH)
                                ;   SRL A
                                ;   DB  0DDH
                                ;   LD  H,A ;「LD IXH,A」 'IXH←桁数÷2 '定数
                                ;   LD  BC,(TXTADR) ;BC←現在テキストVRAMアドレス
                                ;   LD  (BPRRSP),SP
                                ; ; 最初の行の設定
                                ;   LD  A,(CSRNX)
                                ;   CPL
                                ;   ADD A,2 ;Acc←現在行の残り文字数＋1，CY←0
                                ;   RRA     ;Acc←現在行の残り文字数÷2切り上げ，CY←端数の反転
                                ;   DB  0DDH
                                ;   LD  L,A ;「LD IXL,A」 'IXL←初期ループ･カウンタ
                                ;   EX  DE,HL
                                ;   DI
                                ;   LD  SP,HL   ;SP←文字列の先頭
                                ;   LD  H,LSXTBL/100H   ;HL←文字変換テーブルのアドレス
                                ;   LD  A,20H-1 ;コントロール･コード･チェック用
                                ;   JR  C,BPRL12
                                ; ; 端数処理
                                ;   DEC SP
                                ;   POP DE  ;D←最初の文字
                                ;   JR  BPRL1J
                                
                                ; BPRL11:
                                ;   DB  0DDH
                                ;   LD  L,H ;「LD IXL,IXH」 'IXL←ループ･カウンタ（桁数÷2）
                                ;   LD  H,LSXTBL/100H   ;HL←文字変換テーブルのアドレス
                                ;   LD  A,20H-1 ;コントロール･コード･チェック用
                                
                                ; ; 1ループ106ts（53ts×2）
                                ; BPRL12:
                                ;   POP DE  ;10ts
                                ;   CP  E   ; 4ts
                                ;   JR  NC,BPRRE1   ; 7ts 'コントロール･コードがきました
                                ;   LD  L,E ; 4ts
                                ;   LD  E,(HL)  ; 7ts
                                ;   OUT (C),E   ;12ts
                                ;   INC C   ; 4ts
                                ; BPRL1J:
                                ;   CP  D   ; 4ts
                                ;   JR  NC,BPRRE2   ; 7ts 'コントロール･コードがきました
                                ;   LD  L,D ; 4ts
                                ;   LD  D,(HL)  ; 7ts
                                ;   OUT (C),D   ;12ts
                                ;   INC BC  ; 6ts
                                ;   DB  0DDH
                                ;   DEC L   ; 8ts
                                ;   JP  NZ,BPRL12   ;10ts
                                
                                ;   LD  HL,CSRNX
                                ;   LD  A,(CSRNXI)
                                ;   LD  (HL),A  ;カーソルを行頭へ
                                ;   INC L   ;HL←CSRNY
                                ;   LD  A,(_MXLIN)
                                ;   ADD A,(HL)  ;Acc←y座標 '（y座標－行数）＋行数
                                ;   LD  L,A
                                ;   LD  H,LINTTB/100H   ;HL←対応するターミナル･テーブルのアドレス
                                ;   LD  (HL),0FFH   ;行を連結します
                                ;   LD  HL,CSRNY
                                ;   INC (HL)    ;[CSRNY]のカウント･アップ
                                ;   JR  NZ,BPRL11
                                
                                ; ; 最終行の場合
                                ;   LD  (HL),0FFH   ;最終行
                                ;   LD  (BPRLSP),SP
                                ;   EI
                                ;   LD  SP,(BPRRSP)
                                ;   CALL    control_code_ROLL_UP
                                ;   LD  BC,(vram_address_of_top_of_last_line)   ;BC←最終行先頭のVRAMアドレス
                                ;   DI
                                ;   DB  31H ;「LD SP,n」
                                ; BPRLSP:
                                ;   DS  2
                                ;   JR  BPRL11
                                
                                ; ; コントロール･コードがきた場合（偶数）
                                ; BPRRE1:
                                ;   XOR A
                                ;   DB  0DDH
                                ;   SUB L   ;「SUB IXL」
                                ;   DB  0DDH
                                ;   SUB L   ;「SUB IXL」 'Acc←x座標－桁数
                                ;   LD  HL,-2
                                ;   JR  BPRRET
                                ; ; コントロール･コードがきた場合（端数）
                                ; BPRRE2:
                                ;   LD  A,1
                                ;   DB  0DDH
                                ;   SUB L   ;「SUB IXL」
                                ;   DB  0DDH
                                ;   SUB L   ;「SUB IXL」 'Acc←x座標－桁数
                                ;   LD  HL,-1
                                ; BPRRET:
                                ;   LD  (TXTADR),BC ;[TXTADR]の更新
                                ;   LD  (CSRNX),A   ;[CSRNX]を更新
                                ;   ADD HL,SP
                                ;   OR  A   ;CY←0
                                ;   EX  DE,HL   ;DE←コントロール･コードのアドレス
                                ;   EI
                                ;   DB  31H ;「LD SP,」
                                ; BPRRSP:
                                ;   DS  2
                                ;   POP IX
000C5B 0C5B C9              10      RET
                                
                                
                                ;===============================
                                ;キー入力関係（機種依存）
                                ;===============================
                                
                                
                                ;1文字入力ルーチン（入力待ちあり、エコー･バックなし、カーソル表示なし）
                                ;入力   なし
                                ;出力   Acc←アスキー･コード
                                ;破壊   AF，HL，DE，BC
                                ;注：DEL（7FH）コードは、^D（04H）に変換します。
       0C5C                     INKEY_entity:
                                
                                ;   キー入力バッファに文字が溜るまで待ちます
       0C5C                     INKLP_entity:
000C5C 0C5C FB               4      EI
                                    ; CALL  INJOY
000C5D 0C5D B7               4      OR  A
000C5E 0C5E C0              11      RET NZ
000C5F 0C5F FB               4      EI      ;念のため
000C60 0C60 3A7F03          13      LD  A,(pointer_for_write_key_buffer)
000C63 0C63 B7               4      OR  A
000C64 0C64 28F6            12      JR  Z,INKLP_entity
                                
                                ;   文字入力バッファから1文字取り出します
000C66 0C66 217F03          10      LD  HL,pointer_for_write_key_buffer
000C69 0C69 F3               4      DI
000C6A 0C6A 7E               7      LD  A,(HL)
000C6B 0C6B B7               4      OR  A   ;念のためもう1度チェック
000C6C 0C6C 28EE            12      JR  Z,INKLP_entity
000C6E 0C6E 35              11      DEC (HL)    ;[pointer_for_write_key_buffer]をデクリメントします
000C6F 0C6F 4E               7      LD  C,(HL)
000C70 0C70 0600             7      LD  B,0 ;BC←バッファに溜った文字数－1（0～254）
000C72 0C72 58               4      LD  E,B
000C73 0C73 54               4      LD  D,H ;DE←input_key_buffer
000C74 0C74 2E01             7      LD  L,1 ;HL←input_key_buffer+1
000C76 0C76 1A               7      LD  A,(DE)  ;Acc←入力文字
000C77 0C77 2802            12      JR  Z,INKRT
000C79 0C79 EDB0                    LDIR
       0C7B                     INKRT:
000C7B 0C7B FB               4      EI
000C7C 0C7C C9              10      RET
                                
                                
                                ;リアル･タイム･キー入力（入力待ちなし、エコー･バックなし、カーソル表示なし）
                                ;入力   なし
                                ;出力   Acc←アスキー･コード
                                ;破壊   AF，HL，DE，BC
                                ;注：ジョイスティック対応。
       0C7D                     real_time_input_key_entity:
000C7D 0C7D B7               4      OR  A
000C7E 0C7E C0              11      RET NZ
                                
000C7F 0C7F F3               4      DI
000C80 0C80 CD880C          17      CALL    clear_key_buffer
000C83 0C83 FB               4      EI
000C84 0C84 3A0405          13      LD  A,(real_time_key)
000C87 0C87 C9              10      RET
                                
                                
                                ;キー入力バッファをクリアします
                                ;入力   なし
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
                                ;注：割り込み禁止して実行してください。
       0C88                     clear_key_buffer:
000C88 0C88 AF               4      XOR A
000C89 0C89 327F03          13      LD  (pointer_for_write_key_buffer),A    ;キー入力バッファをクリアします
000C8C 0C8C C9              10      RET
                                
                                
                                
                                ;===============================
                                ;スクリーン制御補助（機種依存）
                                ;===============================
                                
                                
                                ;指定オフセット･アドレスに文字を書き込みます
                                ;入力   HL←オフセット･アドレス、Acc←文字
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       0C8D                     write_character_offset_address:
000C8D 0C8D C9              10      RET
                                
                                
                                ;指定カーソル･オフセットの文字を読み込みます
                                ;入力   HL←カーソル･オフセット
                                ;出力   Acc←文字
                                ;破壊   AF，HL，DE，BC
       0C8E                     read_character_offset_address:
000C8E 0C8E C9              10      RET
                                
                                
                                ;カーソルを表示します
                                ;入力   [insert_mode_flag]参照
                                ;出力   [locate_of_cursor_overlap_character]←カーソル位置の文字
                                ;破壊   AF，HL，DE，BC
       0C8F                     display_cursor:
000C8F 0C8F CDDA0B          17      CALL    get_cursor_XY_entity
000C92 0C92 CD4D0B          17      CALL    get_offset_from_cursor_XY
000C95 0C95 4D               4      LD  C,L
000C96 0C96 3E20             7      LD  A,20H   ;アトリビュートVRAM先頭（2000H）
000C98 0C98 84               4      ADD A,H
000C99 0C99 47               4      LD  B,A ;BC←アトリビュートVRAMアドレス
000C9A 0C9A ED78            12      IN  A,(C)
000C9C 0C9C EE08             7      XOR 00001000B   ;b3を反転
000C9E 0C9E 6F               4      LD  L,A
000C9F 0C9F 3AFF04          13      LD  A,(insert_mode_flag)
000CA2 0CA2 E610             7      AND 00010000B   ;b4
000CA4 0CA4 AD               4      XOR L   ;[insert_mode_flag]＝FFHなら、ブリンク
000CA5 0CA5 ED79            12      OUT (C),A
000CA7 0CA7 C9              10      RET
                                
                                
                                ;カーソルを消去します
                                ;入力   [locate_of_cursor_overlap_character]、[insert_mode_flag]参照
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       0CA8                     erase_cursor:
000CA8 0CA8 CDDA0B          17      CALL    get_cursor_XY_entity
000CAB 0CAB CD4D0B          17      CALL    get_offset_from_cursor_XY
000CAE 0CAE 4D               4      LD  C,L
000CAF 0CAF 3E20             7      LD  A,20H   ;アトリビュートVRAM先頭（2000H）
000CB1 0CB1 84               4      ADD A,H
000CB2 0CB2 47               4      LD  B,A ;BC←アトリビュートVRAMアドレス
000CB3 0CB3 ED78            12      IN  A,(C)
000CB5 0CB5 EE08             7      XOR 00001000B   ;b3を反転
000CB7 0CB7 E6EF             7      AND 11101111B   ;b4をクリア
000CB9 0CB9 ED79            12      OUT (C),A
000CBB 0CBB C9              10      RET
                                
                                
                                ;表示色を変更します
                                ;入力   [foreground_color]、[background_color]、[BDR_color]参照
                                ;出力   [attribute_data]←アトリビュート･データ
                                ;破壊   AF，HL，DE，BC
       0CBC                     change_color:
000CBC 0CBC 3A0005          13      LD  A,(foreground_color)
000CBF 0CBF CDDE0C          17      CALL    CCLSUB
000CC2 0CC2 6F               4      LD  L,A ;L←前景色
000CC3 0CC3 3A0105          13      LD  A,(background_color)
000CC6 0CC6 CDDE0C          17      CALL    CCLSUB
000CC9 0CC9 67               4      LD  H,A ;H←後景色
000CCA 0CCA B7               4      OR  A
000CCB 0CCB 2805            12      JR  Z,CCLBK0    ;背景色が0の場合
000CCD 0CCD 7C               4      LD  A,H
000CCE 0CCE FE07             7      CP  7
000CD0 0CD0 2805            12      JR  Z,CCLBK7    ;反転色指定
                                
                                ;   後景色が0の場合
000CD2 0CD2 7D               4  CCLBK0: LD  A,L
000CD3 0CD3 320305          13  CCLRET: LD  (attribute_data),A
000CD6 0CD6 C9              10      RET
                                
                                ;   反転で、色を指定します
000CD7 0CD7 7D               4  CCLBK7: LD  A,L
000CD8 0CD8 EE07             7      XOR 111B
000CDA 0CDA F608             7      OR  1000B   ;色反転
000CDC 0CDC 18F5            12      JR  CCLRET
                                
                                ;色コードを0～7に圧縮します
                                ;入力   Acc←色コード
                                ;出力   Acc←色コード（0～7）
                                ;破壊   AF
000CDE 0CDE FE08             7  CCLSUB: CP  8
000CE0 0CE0 D8              11      RET C
000CE1 0CE1 3E07             7      LD  A,7
000CE3 0CE3 C9              10      RET
                                
                                
                                ;===============================
                                ;スクリーン制御転送（機種依存）
                                ;===============================
                                
                                
                                
                                
                                ;===============================
                                ;特殊ルーチン（機種依存）
                                ;===============================
                                
                                
                                ;60分の1秒単位で時間待ちします
                                ;入力   Acc←カウンタ
                                ;出力   なし
                                ;破壊   AF
                                ;注：割り込み禁止して実行してください。
       0CE4                     WAIT60:
000CE4 0CE4 C5              11      PUSH    BC
000CE5 0CE5 47               4      LD  B,A
                                
       0CE6                     W60LP:
000CE6 0CE6 CDED0C          17      CALL    VBLANK
000CE9 0CE9 10FB            13      DJNZ    W60LP
                                
000CEB 0CEB C1              10      POP BC
000CEC 0CEC C9              10      RET
                                
                                
                                ;垂直帰線信号の立ち下がりを待ちます
                                ;入力   なし
                                ;出力   なし
                                ;破壊   AF
                                ;注：割り込み禁止して実行してください。
       0CED                     VBLANK:
                                ; 垂直帰線信号が無効になる場合があるので、CPU実行速度依存に書き直します。
                                ; 1／60秒、66,667ステートの15／16、62,500ステート待ちます。
000CED 0CED C5              11      PUSH    BC  ;11ts
000CEE 0CEE 016209          10      LD  BC,2402 ;10ts
                                
                                ;   1ループ26ts
000CF1 0CF1 0B               6  VBLLP:  DEC BC  ; 6ts
000CF2 0CF2 79               4      LD  A,C ; 4ts
000CF3 0CF3 B0               4      OR  B   ; 4ts
000CF4 0CF4 20FB            12      JR  NZ,VBLLP    ;12ts
                                
000CF6 0CF6 C1              10      POP BC  ;10ts
000CF7 0CF7 C9              10      RET     ;10ts
                                
                                
                                ;-----------------------
                                ;機種固有ルーチン
                                ;-----------------------
                                
                                
                                ;===============================
                                ;スクリーン制御補助（機種固有）
                                ;===============================
                                
                                
                                ;カーソルのテキストVRAMアドレスを求めます
                                ;入力   L←x座標、H←y座標
                                ;出力   BC←テキストVRAMアドレス
                                ;破壊   AF，HL，BC
       0CF8                     get_vram_address_from_cursor_XY:
000CF8 0CF8 CD4D0B          17      CALL    get_offset_from_cursor_XY
000CFB 0CFB 4D               4      LD  C,L
