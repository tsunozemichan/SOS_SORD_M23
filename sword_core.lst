000D0C 0D0C C9              10      RET
                                
                                
                                
                                ;---------------
                                ;汎用ルーチン
                                ;---------------
                                
                                
                                ;文字列から文字を取り出します（スペースはスキップ）
                                ;入力   DE←文字列の先頭アドレス
                                ;出力   Acc←文字
                                ;   DEはカウント･アップ
                                ;破壊   AF，DE
                                ;注：小文字を大文字に変換します。
       0D0D                     get_character_from_line:
000D0D 0D0D CD180D          17      CALL    SPSKIP
000D10 0D10 1A               7      LD  A,(DE)
000D11 0D11 B7               4      OR  A
000D12 0D12 C8              11      RET Z   ;文字列の終わりの達した
000D13 0D13 13               6      INC DE
000D14 0D14 C3220D          10      JP  convert_lower_case_to_upper_case
                                
                                
                                ;文字列のスペース･キャラをスキップします
                                ;入力   DE←文字列の先頭アドレス
                                ;出力   DE←カウント･アップ
                                ;破壊   AF，DE
       0D17                     SPSLP:
000D17 0D17 13               6      INC DE
                                
       0D18                     SPSKIP:
000D18 0D18 1A               7      LD  A,(DE)
000D19 0D19 FE20             7      CP  ' '
000D1B 0D1B 28FA            12      JR  Z,SPSLP
000D1D 0D1D FE09             7      CP  09H ;TAB
000D1F 0D1F 28F6            12      JR  Z,SPSLP
                                
000D21 0D21 C9              10      RET
                                
                                
                                ;小文字を大文字に変換します
                                ;入力   Acc←アスキー･コード
                                ;出力   Acc←変換したアスキー･コード
                                ;破壊   AF
       0D22                     convert_lower_case_to_upper_case:
000D22 0D22 FE61             7      CP  'a'
000D24 0D24 D8              11      RET C
000D25 0D25 FE7B             7      CP  'z'+1
000D27 0D27 D0              11      RET NC
000D28 0D28 D620             7      SUB 20H
000D2A 0D2A C9              10      RET
                                
                                
                                ;convert_decimal_character_to_number V1.00  Copyright (C) T.Chikushi  1994-06-18
                                ;10進文字を数値に変換します
                                ;入力   Acc←文字
                                ;出力   AL←数値、CY←変換状態
                                ;CF=0   AL←数値（0～9）
                                ;CF=1   10進文字ではなかった（ALは、呼び出し前の値）
                                ;破壊   AF
       0D2B                     convert_decimal_character_to_number:
000D2B 0D2B FE30             7      CP  '0'
000D2D 0D2D D8              11      RET C
000D2E 0D2E FE3A             7      CP  '9'+1
000D30 0D30 3F               4      CCF
000D31 0D31 D8              11      RET C
                                ;   「0」～「9」
000D32 0D32 D630             7      SUB '0' ;Acc←0～9，CY←0
000D34 0D34 C9              10      RET
                                
                                
                                ;Copyright (C) T.Chikushi  1991-01-04
                                ;HL÷Acc→商HL...余りAcc
                                ;入力   HL←被除数、Acc←除数
                                ;出力   HL←商、Acc←余り
                                ;破壊   AF，HL，DE，BC
       0D35                     DIV68:
000D35 0D35 C5              11      PUSH    BC
000D36 0D36 4F               4      LD  C,A ;C←除数
000D37 0D37 AF               4      XOR A
000D38 0D38 0610             7      LD  B,16
                                
000D3A 0D3A 29              11  DIV68L: ADD HL,HL
000D3B 0D3B 17               4      RLA
000D3C 0D3C B9               4      CP  C
000D3D 0D3D 3802            12      JR  C,DIV681
000D3F 0D3F 91               4      SUB C
000D40 0D40 2C               4      INC L
000D41 0D41 10F7            13  DIV681: DJNZ    DIV68L
                                
000D43 0D43 C1              10      POP BC
000D44 0D44 C9              10      RET
                                
                                
                                ;Copyright (C) T.Chikushi  1990
                                ;DEHL÷BC→商DEHL...余りBC
                                ;入力   DEHL←被除数、BC←除数
                                ;出力   DEHL←商、BC←余り
                                ;破壊   インデックス･レジスタ以外
                                ;   min 3,452ts max 3,600ts s1
       0D45                     DIV26:
000D45 0D45 C5              11      PUSH    BC
000D46 0D46 D9               4      EXX
000D47 0D47 C1              10      POP BC  ;BC'←除数
000D48 0D48 210000          10      LD  HL,0    ;HL'←0
000D4B 0D4B D9               4      EXX
000D4C 0D4C 0620             7      LD  B,32
000D4E 0D4E 29              11  DIV26L: ADD HL,HL
000D4F 0D4F EB               4      EX  DE,HL
000D50 0D50 ED6A            15      ADC HL,HL
000D52 0D52 EB               4      EX  DE,HL
000D53 0D53 D9               4      EXX
000D54 0D54 ED6A            15      ADC HL,HL   ;HL'DEHLを左シフト
000D56 0D56 380D            12      JR  C,DIV262    ;必ず引けます
000D58 0D58 ED42            15      SBC HL,BC   ;HL←HL－BC
000D5A 0D5A 300C            12      JR  NC,DIV263   ;引けた
000D5C 0D5C 09              11      ADD HL,BC   ;引けない場合はHL'を元に戻します
000D5D 0D5D D9               4      EXX
000D5E 0D5E 10EE            13      DJNZ    DIV26L
000D60 0D60 D9               4  DIV261: EXX
000D61 0D61 E5              11      PUSH    HL
000D62 0D62 D9               4      EXX
000D63 0D63 C1              10      POP BC
000D64 0D64 C9              10      RET
                                ;   必ず引ける場合
000D65 0D65 B7               4  DIV262: OR  A
000D66 0D66 ED42            15      SBC HL,BC
                                ;   引けた場合
000D68 0D68 D9               4  DIV263: EXX
000D69 0D69 2C               4      INC L   ;INC HL'DEHL
000D6A 0D6A 10E2            13      DJNZ    DIV26L
000D6C 0D6C 18F2            12      JR  DIV261
                                
                                
                                ;-----------------------
                                ;割り込みルーチン
                                ;-----------------------
                                
                                
                                ; 省メモリのため、テーブル･エリアに移動しました。
                                
                                
                                ;-----------------------
                                ;オリジナル･モニタ
                                ;-----------------------
                                
                                
                                ;#MON（1F8EH）の本体
                                ;CY＝0でリターンします（ディスク･モジュールのため）
       0D6E                     MON:
000D6E 0D6E ED734810        20      LD  (monitor_reserve_stack_pointer),SP
000D72 0D72 2A6A1F          16      LD  HL,(_MEMAX)
000D75 0D75 110030          10      LD  DE,3000H
000D78 0D78 B7               4      OR  A
000D79 0D79 ED52            15      SBC HL,DE
000D7B 0D7B 224A10          16      LD  (monitor_size_of_user_area),HL  ;ユーザー･エリアのサイズ
                                
                                ;   コマンド待ちループ
       0D7E                     monitor_command_waiting_loop:
000D7E 0D7E 310001          10      LD  SP,0100H    ;オリジナル･モニタのスタック･トップ
000D81 0D81 3E2A             7      LD  A,'*'
000D83 0D83 CDF41F          17      CALL    _PRINT
000D86 0D86 ED5B761F        20      LD  DE,(_KBFAD)
000D8A 0D8A CDD31F          17      CALL    _GETL
000D8D 0D8D CD0D0D          17      CALL    get_character_from_line
                                
                                ; コマンドを解析して、それぞれの処理ルーチンへ。
                                ;出力   DE←次の文字のアドレス
       0D90                     MON2:
000D90 0D90 FE3A             7      CP  ':'
000D92 0D92 CA670F          10      JP  Z,monitor_memory_edit   ;メモリ･エディト
000D95 0D95 FE2A             7      CP  '*'
000D97 0D97 CC0D0D          17      CALL Z,get_character_from_line
000D9A 0D9A FE52             7      CP  'R'
000D9C 0D9C CAC20D          10      JP  Z,terminate_monitor ;モニタを終えます
000D9F 0D9F FE23             7      CP  '#'
000DA1 0DA1 CA6F0E          10      JP  Z,monitor_dump_memory   ;ダンプ
000DA4 0DA4 FE46             7      CP  'F'
000DA6 0DA6 CADB0D          10      JP  Z,monitor_search_data   ;サーチ
000DA9 0DA9 FE41             7      CP  'A'
000DAB 0DAB CAC80D          10      JP  Z,monitor_go_command        ;ジャンプ
000DAE 0DAE FE49             7      CP  'I'
000DB0 0DB0 CABD0F          10      JP  Z,monitor_initialize_disk   ;ディスク初期化
000DB3 0DB3 FE4D             7      CP  'M'
000DB5 0DB5 CA380F          10      JP  Z,monitor_set_data_to_memory    ;メモリ･セット
000DB8 0DB8                         DS  4,00H   ;ダミー
000DBC 0DBC CDC41F          17      CALL _BELL
000DBF 0DBF C37E0D          10      JP  monitor_command_waiting_loop
                                
                                ;オリジナル･モニタを終えます
       0DC2                     terminate_monitor:
000DC2 0DC2 AF               4      XOR A   ;CY←0（Acc←0）
000DC3 0DC3 ED7B4810        20      LD  SP,(monitor_reserve_stack_pointer)
000DC7 0DC7 C9              10      RET
                                
                                
                                ;オリジナル･モニタ サブルーチン･コール
       0DC8                     monitor_go_command:
000DC8 0DC8 CD180D          17      CALL SPSKIP
000DCB 0DCB CDB21F          17      CALL _HLHEX
000DCE 0DCE 3805            12      JR  C,monitor_go_commandE
000DD0 0DD0 017E0D          10      LD  BC,monitor_command_waiting_loop
000DD3 0DD3 C5              11      PUSH    BC  ;スタック←monitor_command_waiting_loop
000DD4 0DD4 E9               4      JP  (HL)
                                
       0DD5                     monitor_go_commandE:
000DD5 0DD5 CDC41F          17      CALL _BELL
000DD8 0DD8 C37E0D          10      JP  monitor_command_waiting_loop
                                
                                
                                ;オリジナル･モニタ サーチ･ルーチン
                                ;〈使用法〉
                                ;「F 先頭アドレス 最終アドレス データ…」
                                ;〈サーチするデータ列〉
                                ;keyboard_buffer～
       0DDB                     monitor_search_data:
                                ;   アドレス情報を取り出します
000DDB 0DDB CD180D          17      CALL SPSKIP
000DDE 0DDE CDB21F          17      CALL _HLHEX
000DE1 0DE1 385C            12      JR  C,MONFIE
000DE3 0DE3 22680E          16      LD  (MONFTP),HL ;先頭アドレス
000DE6 0DE6 CD180D          17      CALL SPSKIP
000DE9 0DE9 CDB21F          17      CALL _HLHEX
000DEC 0DEC 3851            12      JR  C,MONFIE
000DEE 0DEE 23               6      INC HL
000DEF 0DEF 226A0E          16      LD  (MONFEN),HL ;最終アドレス＋1
                                
                                ;   データの取り出します
000DF2 0DF2 210002          10      LD  HL,keyboard_buffer  ;データ列の先頭
                                
       0DF5                     MONFL1:
000DF5 0DF5 CD180D          17      CALL SPSKIP
000DF8 0DF8 CDB51F          17      CALL _2HEX
000DFB 0DFB 3804            12      JR  C,MNFL1E
000DFD 0DFD 77               7      LD  (HL),A  ;←データ
000DFE 0DFE 2C               4      INC L   ;現在アドレス＆現在データ数
000DFF 0DFF 18F4            12      JR  MONFL1
                                
000E01 0E01 7D               4  MNFL1E: LD  A,L
000E02 0E02 B7               4      OR  A
000E03 0E03 283A            12      JR  Z,MONFIE    ;データがなかった
000E05 0E05 326E0E          13      LD  (MONFCT),A  ;データ数（1～）
000E08 0E08 2A6A0E          16      LD  HL,(MONFEN)
000E0B 0E0B ED5B680E        20      LD  DE,(MONFTP)
                                ;   OR  A
000E0F 0E0F ED52            15      SBC HL,DE
000E11 0E11 2B               6      DEC HL  ;HL←サイズ－1 '0～65,535
000E12 0E12 5F               4      LD  E,A
000E13 0E13 1600             7      LD  D,0
000E15 0E15 1B               6      DEC DE  ;DE←データ数－1 '0～
000E16 0E16 B7               4      OR  A
000E17 0E17 ED52            15      SBC HL,DE   ;HL←サイズ－データ数
000E19 0E19 3824            12      JR  C,MONFIE
000E1B 0E1B 23               6      INC HL
000E1C 0E1C 226C0E          16      LD  (MONFSZ),HL ;検索カウンタ（1～）
                                
                                ;   検索します
000E1F 0E1F 2A680E          16      LD  HL,(MONFTP) ;先頭アドレス
000E22 0E22 ED4B6C0E        20      LD  BC,(MONFSZ) ;検索カウンタ
000E26 0E26 3A0002          13      LD  A,(keyboard_buffer) ;最初の検索バイト
                                
000E29 0E29 EDB1                MONFL2: CPIR
000E2B 0E2B F5              11      PUSH    AF
000E2C 0E2C E5              11      PUSH    HL
000E2D 0E2D C5              11      PUSH    BC
000E2E 0E2E CC440E          17      CALL    Z,MONFSB    ;最初のバイトが一致しました
000E31 0E31 C1              10      POP BC
000E32 0E32 E1              10      POP HL
000E33 0E33 F1              10      POP AF
000E34 0E34 EA290E          10      JP  PE,MONFL2
                                
       0E37                     MONFES:
000E37 0E37 3E0D             7      LD  A,0DH
000E39 0E39 CDF41F          17      CALL    _PRINT
       0E3C                     MONFRT:
000E3C 0E3C C37E0D          10      JP  monitor_command_waiting_loop
                                
       0E3F                     MONFIE:
000E3F 0E3F CDC41F          17      CALL    _BELL
000E42 0E42 18F8            12      JR  MONFRT
                                
                                
                                ;最初のバイト以降を比較し、一致すれば、そのアドレスを表示します
                                ;入力   HL←最初のバイトが一致した次のアドレス
                                ;出力   なし
                                ;破壊   全レジスタ
       0E44                     MONFSB:
000E44 0E44 E5              11      PUSH    HL  ;スタック←比較されるアドレス＋1
000E45 0E45 110102          10      LD  DE,keyboard_buffer+1    ;データ列先頭＋1
000E48 0E48 3A6E0E          13      LD  A,(MONFCT)
000E4B 0E4B 47               4      LD  B,A
000E4C 0E4C 05               4      DEC B   ;B←チェックする残りのバイト数
000E4D 0E4D 2808            12      JR  Z,MNFSBR    ;比較は1バイトのみで、一致しました
                                
       0E4F                     MNFSBL:
000E4F 0E4F 1A               7      LD  A,(DE)
000E50 0E50 1C               4      INC E
000E51 0E51 BE               7      CP  (HL)
000E52 0E52 23               6      INC HL
000E53 0E53 2011            12      JR  NZ,MNFSBB
000E55 0E55 10F8            13      DJNZ    MNFSBL
                                
       0E57                     MNFSBR:
000E57 0E57 CDC71F          17      CALL    _PAUSE
000E5A 0E5A 370E                    DW  MONFES
000E5C 0E5C 3E20             7      LD  A,' '
000E5E 0E5E CDF41F          17      CALL    _PRINT
000E61 0E61 E1              10      POP HL  ;HL←比較されるアドレス＋1
000E62 0E62 2B               6      DEC HL
000E63 0E63 C36307          10      JP  print_hex_4_digit
                                
       0E66                     MNFSBB:
000E66 0E66 E1              10      POP HL
000E67 0E67 C9              10      RET
                                
                                
                                ;   サーチ･コマンド用ワーク
000E68 0E68                     MONFTP: DS  2   ;検索先頭アドレス
000E6A 0E6A                     MONFEN: DS  2   ;検索最終アドレス＋1
000E6C 0E6C                     MONFSZ: DS  2   ;検索バイト数（[MONFEN]－[MONFTP]－[MONFCT]＋1）
000E6E 0E6E                     MONFCT: DS  1   ;データ数
                                
                                
                                ;オリジナル･モニタ ダンプ（可変行、可変桁対応）
                                ;〈ダンプの桁数〉
                                ; ダンプの桁数は、「横バイト数×4＋7」文字。
                                ;72桁以上、71文字
                                ;「:AAAA=HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH /CCCCCCCCCCCCCCCC」
                                ;40桁以上、39文字
                                ;「:AAAA=HH HH HH HH HH HH HH HH /CCCCCCCC」
                                ;24桁以上、23文字
                                ;「:AAAA=HH HH HH HH /CCCC」
                                ;〈レジスタ･マップ〉
                                ;HL メモリのアドレス
                                ;B  汎用カウンタ
                                ;C  横バイト数
                                ;DE 縦表示数
                                ;注：DIV26（インデックス･レジスタ以外破壊）を呼び出します。
       0E6F                     monitor_dump_memory:
000E6F 0E6F CD180D          17      CALL    SPSKIP
000E72 0E72 CDB21F          17      CALL    _HLHEX
000E75 0E75 3803            12      JR  C,$+5
000E77 0E77 224610          16      LD  (monitor_operation_address),HL
000E7A 0E7A CD180D          17      CALL    SPSKIP
000E7D 0E7D CDB21F          17      CALL    _HLHEX
000E80 0E80 22330F          16      LD  (MONDE),HL
000E83 0E83 3F               4      CCF
000E84 0E84 9F               4      SBC A,A ;最終アドレスが指定されていたらAcc＝FFH
000E85 0E85 32350F          13      LD  (MONDF),A
000E88 0E88 CDFF0E          17      CALL    MNDINI  ;初期化
000E8B 0E8B DA7E0D          10      JP  C,monitor_command_waiting_loop  ;初期化失敗
000E8E 0E8E CDDB0E          17      CALL    MNDILC  ;表示ライン数の設定
000E91 0E91 EB               4      EX  DE,HL   ;DE←縦ライン数
000E92 0E92 3A360F          13      LD  A,(MONDX)
000E95 0E95 4F               4      LD  C,A ;C←横バイト数
                                
                                ;入力   C←横バイト数、DE←縦ライン数
                                ;   [monitor_operation_address]参照
                                ;出力   [monitor_operation_address]更新
                                ;破壊   AF，HL，DE，B
                                ;〈レジスタ･マップ〉
                                ;HL 現在メモリのアドレス
                                ;B  横ループ･カウンタ
                                ;DE 縦ループ･カウンタ
       0E96                     MDPLP1:
000E96 0E96 3E3A             7      LD  A,':'
000E98 0E98 CDF41F          17      CALL    _PRINT
000E9B 0E9B 2A4610          16      LD  HL,(monitor_operation_address)
000E9E 0E9E E5              11      PUSH    HL  ;スタック←アドレス（行頭）
000E9F 0E9F CDBE1F          17      CALL    _print_hex_4_digit
000EA2 0EA2 3E3D             7      LD  A,'='
000EA4 0EA4 CDF41F          17      CALL    _PRINT
000EA7 0EA7 41               4      LD  B,C ;B←横バイト数
                                
                                ;入力   HL←メモリのアドレス、B←横バイト数
                                ;出力   HLはカウント･アップされます
                                ;破壊   AF，HL，B
                                ;〈レジスタ･マップ〉
                                ;HL 現在メモリのアドレス
                                ;B  ループ･カウンタ
       0EA8                     MDPL21:
000EA8 0EA8 7E               7      LD  A,(HL)  ;Acc←メモリのデータ
000EA9 0EA9 23               6      INC HL
000EAA 0EAA CDC11F          17      CALL    _print_hex_2_digit
000EAD 0EAD 3E20             7      LD  A,' '
000EAF 0EAF CDF41F          17      CALL    _PRINT
000EB2 0EB2 10F4            13      DJNZ    MDPL21
                                
000EB4 0EB4 3E2F             7      LD  A,'/'
000EB6 0EB6 CDF41F          17      CALL    _PRINT
000EB9 0EB9 E1              10      POP HL  ;HL←アドレス（行頭）
000EBA 0EBA 41               4      LD  B,C ;B←横バイト数
                                
                                ;入力   HL←メモリのアドレス、B←横バイト数
                                ;出力   HLはカウント･アップされます
                                ;破壊   AF，HL，B
                                ;〈レジスタ･マップ〉
                                ;HL 現在メモリのアドレス
                                ;B  ループ･カウンタ
       0EBB                     MDPL22:
000EBB 0EBB 7E               7      LD  A,(HL)  ;Acc←メモリのデータ
000EBC 0EBC 23               6      INC HL
                                ;   CP  7FH
                                ;   JR  Z,$+6   ;DELコードだった
000EBD 0EBD FE20             7      CP  20H
000EBF 0EBF 3002            12      JR  NC,$+4  ;コントロール･コードだった
000EC1 0EC1 3E20             7      LD  A,' '   ;Acc←「 」
000EC3 0EC3 CDF41F          17      CALL    _PRINT
000EC6 0EC6 10F3            13      DJNZ    MDPL22
                                
000EC8 0EC8 224610          16      LD  (monitor_operation_address),HL
000ECB 0ECB CDEE1F          17      CALL    _LTNL
000ECE 0ECE CDC71F          17      CALL    _PAUSE
000ED1 0ED1 7E0D                    DW  monitor_command_waiting_loop
000ED3 0ED3 1B               6      DEC DE
000ED4 0ED4 7B               4      LD  A,E
000ED5 0ED5 B2               4      OR  D
000ED6 0ED6 20BE            12      JR  NZ,MDPLP1
                                
000ED8 0ED8 C37E0D          10      JP  monitor_command_waiting_loop
                                
                                
                                ;表示ライン数を得ます
                                ;入力   [MONDE]←最終アドレス、[MONDF]←[MONDE]有効のフラグ
                                ;出力   HL←ライン数
                                ;破壊   全レジスタ
       0EDB                     MNDILC:
000EDB 0EDB 3A350F          13      LD  A,(MONDF)
000EDE 0EDE B7               4      OR  A
000EDF 0EDF 2007            12      JR  NZ,MNDLC1
                                
                                ;   最終アドレスが設定されていない場合
000EE1 0EE1 3A370F          13      LD  A,(MONDY)
000EE4 0EE4 6F               4      LD  L,A
000EE5 0EE5 2600             7      LD  H,0 ;HL←縦ライン数（1画面分）
000EE7 0EE7 C9              10      RET
                                
                                ;   最終アドレスが設定されている場合
       0EE8                     MNDLC1:
000EE8 0EE8 3A360F          13      LD  A,(MONDX)
000EEB 0EEB 4F               4      LD  C,A
000EEC 0EEC 0600             7      LD  B,0 ;BC←横バイト数（2～）
000EEE 0EEE 2A330F          16      LD  HL,(MONDE)
000EF1 0EF1 ED5B4610        20      LD  DE,(monitor_operation_address)
000EF5 0EF5 AF               4      XOR A
000EF6 0EF6 ED52            15      SBC HL,DE   ;HL←ダンプするバイト数－1
000EF8 0EF8 09              11      ADD HL,BC
000EF9 0EF9 17               4      RLA     ;Acc←CY
000EFA 0EFA 5F               4      LD  E,A
000EFB 0EFB 50               4      LD  D,B ;DEHL←ダンプするバイト数＋横バイト数－1
000EFC 0EFC C3450D          10      JP  DIV26
                                
                                
                                ;ダンプ･コマンドの初期化処理
                                ;入力   [_MXLIN]、[_WIDTH]参照
                                ;出力   [MONDX]、[MONDY]設定
                                ;   CY＝1なら初期化に失敗しました
                                ;破壊   全レジスタ
       0EFF                     MNDINI:
                                ;   [MONDXの設定]
000EFF 0EFF 3A5C1F          13      LD  A,(_WIDTH)
000F02 0F02 D608             7      SUB 8   ;アドレスなどの8文字を除きます
000F04 0F04 D8              11      RET C
000F05 0F05 FE08             7      CP  4*2
000F07 0F07 D8              11      RET C   ;2バイト分の表示にも足りない
000F08 0F08 E6FC             7      AND 11111100B
000F0A 0F0A 0F               4      RRCA
000F0B 0F0B 0F               4      RRCA        ;Acc←表示可能横バイト数
000F0C 0F0C CD230F          17      CALL    MNDN2
000F0F 0F0F 32360F          13      LD  (MONDX),A   ;[MONDY]←横バイト数（2～）
                                
                                ;   [MONDYの設定]
000F12 0F12 3A5B1F          13      LD  A,(_MXLIN)
000F15 0F15 D601             7      SUB 1   ;1行のアキを作るため
000F17 0F17 D8              11      RET C
000F18 0F18 FE02             7      CP  2
000F1A 0F1A D8              11      RET C   ;2行分の表示にも足りない
000F1B 0F1B CD230F          17      CALL    MNDN2
000F1E 0F1E 32370F          13      LD  (MONDY),A   ;[MONDY]←縦ライン数（2～）
                                
000F21 0F21 AF               4      XOR A
000F22 0F22 C9              10      RET
                                
                                
                                ;データをn^2化します
                                ;入力   Acc←処理するデータ（0～255）
                                ;出力   Acc←n^2化されたデータ（8、16など）
                                ;破壊   全レジスタ
       0F23                     MNDN2:
000F23 0F23 010008          10      LD  BC,8*100H   ;B←8，C←0
                                
       0F26                     MNDN21:
000F26 0F26 07               4      RLCA
000F27 0F27 0C               4      INC C   ;カウント･アップ
000F28 0F28 3802            12      JR  C,$+4
000F2A 0F2A 10FA            13      DJNZ    MNDN21
                                
000F2C 0F2C 3E00             7      LD  A,0 ;CYA←1_00000000B
000F2E 0F2E 41               4      LD  B,C
                                
       0F2F                     MNDN22:
000F2F 0F2F 1F               4      RRA
000F30 0F30 10FD            13      DJNZ    MNDN22
                                
000F32 0F32 C9              10      RET
                                
                                
                                ;   ダンプ･コマンド用ワーク
000F33 0F33                     MONDE:  DS  2   ;ユーザーが指定したダンプの最終アドレス
000F35 0F35                     MONDF:  DS  1   ;＝FFHで、[MONDE]が有効
000F36 0F36                     MONDX:  DS  1   ;ダンプする横バイト数（2～）
000F37 0F37                     MONDY:  DS  1   ;ダンプする縦バイト数（2～）
                                
                                
                                ;オリジナル･モニタ メモリ･セット
       0F38                     monitor_set_data_to_memory:
000F38 0F38 CD180D          17      CALL    SPSKIP
000F3B 0F3B CDB21F          17      CALL    _HLHEX
000F3E 0F3E 3803            12      JR  C,$+5
000F40 0F40 224610          16      LD  (monitor_operation_address),HL
                                
000F43 0F43 3E3A             7  MMSLP:  LD  A,':'
000F45 0F45 CDF41F          17      CALL    _PRINT
000F48 0F48 2A4610          16      LD  HL,(monitor_operation_address)
000F4B 0F4B CDBE1F          17      CALL    _print_hex_4_digit
000F4E 0F4E 3E3D             7      LD  A,'='
000F50 0F50 CDF41F          17      CALL    _PRINT
000F53 0F53 7E               7      LD  A,(HL)
000F54 0F54 CDC11F          17      CALL    _print_hex_2_digit
000F57 0F57 3E1D             7      LD  A,1DH   ;Acc←「←」
000F59 0F59 CDF41F          17      CALL    _PRINT
000F5C 0F5C CDF41F          17      CALL    _PRINT
000F5F 0F5F CD750F          17      CALL    MEMEDT
000F62 0F62 DA900D          10      JP  C,MON2
000F65 0F65 18DC            12      JR  MMSLP
                                
                                
                                ;オリジナル･モニタ メモリ･エディト
       0F67                     monitor_memory_edit:
000F67 0F67 CD7F0F          17      CALL    MEMED1
000F6A 0F6A DA7E0D          10      JP  C,monitor_command_waiting_loop
                                
000F6D 0F6D CD750F          17  MONELP: CALL    MEMEDT
000F70 0F70 DA900D          10      JP  C,MON2
000F73 0F73 18F8            12      JR  MONELP
                                
                                
                                ;1行メモリ･エディト･ルーチン
                                ;入力   [monitor_operation_address]参照
                                ;出力   CY＝1ならエディトを終了しました
                                ;破壊   AF，HL，DE
       0F75                     MEMEDT:
000F75 0F75 ED5B761F        20      LD  DE,(_KBFAD)
000F79 0F79 CDD31F          17      CALL    _GETL
000F7C 0F7C CD0D0D          17      CALL    get_character_from_line
                                
                                ;   既に先頭1文字を取り出した時のエントリ
       0F7F                     MEMED1:
000F7F 0F7F FE3A             7      CP  ':' ;メモリ･エディト用ヘッダ
000F81 0F81 37               4      SCF
000F82 0F82 C0              11      RET NZ  ;ヘッダが不正
000F83 0F83 CD180D          17      CALL    SPSKIP
000F86 0F86 CDB21F          17      CALL    _HLHEX
000F89 0F89 D8              11      RET C   ;アドレスが不正
000F8A 0F8A CD0D0D          17      CALL    get_character_from_line
000F8D 0F8D FE3D             7      CP  '='
000F8F 0F8F 37               4      SCF
000F90 0F90 C0              11      RET NZ  ;セパレータが不正
                                
000F91 0F91 CD180D          17  MEMELP: CALL    SPSKIP
000F94 0F94 1A               7      LD  A,(DE)
000F95 0F95 FE2E             7      CP  '.'
000F97 0F97 37               4      SCF
000F98 0F98 C8              11      RET Z   ;エディト終了
000F99 0F99 CDB51F          17      CALL    _2HEX
000F9C 0F9C 3F               4      CCF
000F9D 0F9D D0              11      RET NC  ;入力終了
000F9E 0F9E 77               7      LD  (HL),A
000F9F 0F9F 23               6      INC HL
000FA0 0FA0 224610          16      LD  (monitor_operation_address),HL
000FA3 0FA3 18EC            12      JR  MEMELP
                                
                                
                                ;===============================================
                                ;オリジナル･モニタ Ok、Errorメッセージ
                                ;===============================================
                                
                                
                                ;処理が正常終了しました
       0FA5                     monitor_normal_end:
000FA5 0FA5 CDE21F          17      CALL    _MPRNT
000FA8 0FA8 4F6B0D00                DB  'Ok',0DH,00H
       0FAC                     MNOKRT:
000FAC 0FAC C37E0D          10      JP  monitor_command_waiting_loop
                                
                                
                                ;処理が異常終了しました
       0FAF                     monitor_error_termination:
000FAF 0FAF CDE21F          17      CALL    _MPRNT
000FB2 0FB2 4572726F7220210D        DB  'Error !',0DH,00H
            00                  
000FBB 0FBB 18EF            12      JR  MNOKRT
                                
                                
                                ;=======================================
                                ;オリジナル･モニタ･ディスク初期化処理
                                ;=======================================
                                
                                
                                ;S-OSディスク･イメージの初期化
       0FBD                     monitor_initialize_disk:
000FBD 0FBD CD180D          17      CALL    SPSKIP
000FC0 0FC0 CD3210          17      CALL    MONDEV
000FC3 0FC3 B7               4      OR  A
000FC4 0FC4 2009            12      JR  NZ,MONIDI
                                
                                ;   S-OSディスク･イメージのクローズ
000FC6 0FC6 CD4C10          17      CALL SOSSF
000FC9 0FC9 DAAF0F          10      JP  C,monitor_error_termination
000FCC 0FCC C3A50F          10      JP  monitor_normal_end
                                
                                ;   論理フォーマット
000FCF 0FCF 3D               4  MONIDI: DEC A   ;Acc←ユニット番号
000FD0 0FD0 32062B          13      LD  (disk_unit_number),A
000FD3 0FD3 C641             7      ADD A,'A'
000FD5 0FD5 4F               4      LD  C,A ;C←デバイス名
000FD6 0FD6 CDE21F          17      CALL    _MPRNT
000FD9 0FD9 C3DECADEB2BD2000        DB  'ﾃﾞﾊﾞｲｽ ',00H
000FE1 0FE1 79               4      LD  A,C
000FE2 0FE2 CDF41F          17      CALL    _PRINT
000FE5 0FE5 CDE21F          17      CALL    _MPRNT
000FE8 0FE8 3A20A620BCAEB7B6        DB  ': ｦ ｼｮｷｶ ｼﾃ ﾖﾛｼｲ ﾃﾞｽｶ(Y/N)?',00H
            20BCC320D6DBBCB2    
            20C3DEBDB628592F    
            4E293F00            
001004 1004 CD2120          17      CALL    _FLGET
001007 1007 CD220D          17      CALL    convert_lower_case_to_upper_case
00100A 100A FE59             7      CP  'Y'
00100C 100C 280D            12      JR  Z,MONIDY
                                
                                ;   初期化しません
00100E 100E 3E4E             7      LD  A,'N'
001010 1010 CDF41F          17      CALL    _PRINT
001013 1013 3E0D             7      LD  A,0DH
001015 1015 CDF41F          17      CALL    _PRINT
001018 1018 C37E0D          10      JP  monitor_command_waiting_loop
                                
                                ;   初期化します
       101B                     MONIDY:
00101B 101B CDF41F          17      CALL    _PRINT
00101E 101E 3E0D             7      LD  A,0DH
001020 1020 CDF41F          17      CALL    _PRINT
                                
001023 1023 CD4E10          17      CALL    SOSDI
001026 1026 D2A50F          10      JP  NC,monitor_normal_end
                                
                                ;   物理的フォーマット（論理フォーマットに失敗しました）
001029 1029 CD4E10          17      CALL    SOSDF
00102C 102C D2A50F          10      JP  NC,monitor_normal_end
                                
                                ;   物理的フォーマットにも失敗しました
00102F 102F C3AF0F          10      JP  monitor_error_termination
                                
                                
                                ;=======================================
                                ;オリジナル･モニタ･ディスク･ルーチン
                                ;=======================================
                                
                                
                                ;ファイル名からデバイスを抜き出します
                                ;入力   DE←ファイル名の先頭アドレス
                                ;出力   Acc←デバイス（0，1～）、DE←カウント･アップ
                                ;破壊   AF，DE
                                ;注：デフォルト･デバイスは0、ドライブAは1に対応します。
       1032                     MONDEV:
001032 1032 1A               7      LD  A,(DE)
001033 1033 B7               4      OR  A
001034 1034 C8              11      RET Z   ;文字列の終わりに達していました
                                
001035 1035 13               6      INC DE
001036 1036 1A               7      LD  A,(DE)
001037 1037 1B               6      DEC DE
001038 1038 FE3A             7      CP  ':'
00103A 103A 3E00             7      LD  A,0 ;Acc←デフォルト･デバイス
00103C 103C C0              11      RET NZ  ;デバイスが指定されています
                                
                                ;   デバイスが指定されています
00103D 103D 1A               7      LD  A,(DE)
00103E 103E CD220D          17      CALL    convert_lower_case_to_upper_case
001041 1041 D640             7      SUB 'A'-1   ;Acc←1～
001043 1043 13               6      INC DE
001044 1044 13               6      INC DE
001045 1045 C9              10      RET
                                
                                
                                
                                ;-------------------------------
                                ;オリジナル･モニタ ワーク
                                ;-------------------------------
                                
                                
001046 1046 0000                monitor_operation_address:  DW  0   ;操作アドレス
001048 1048 0000                monitor_reserve_stack_pointer:  DW  0   ;SPの保存
00104A 104A 0000                monitor_size_of_user_area:  DW  0   ;ユーザー･エリアの大きさ
                                
                                
                                ;---------------------------------------
                                ;SWXCDIOを使わないための処理
                                ;---------------------------------------
                                
                                
       104C                     SOSSI:
       104C                     SOSSF:
00104C 104C B7               4      OR  A
00104D 104D C9              10      RET
       104E                     SOSDI:
       104E                     SOSDF:
00104E 104E 37               4      SCF
00104F 104F C9              10      RET
       1050                     DIOETP:
001050 1050                         DS  2
                                
                                
       1052                     CRT_INIT:
001052 1052 2100F0          10      LD HL,0F000H ; VRAMの左上のアトリビュートアドレス
001055 1055 010008          10      LD BC,0800H
                                ; カーソル座標を00Hに設定する。
                                ; 注：画面左上がカーソル座標では0000Hになる。VRAMにおけるテキスト画面左上(F800H)ではないことに注意。
001058 1058 3E0E             7      LD A,0EH ; R14 (cursor H)
00105A 105A D3F0            11      OUT (CRTC_ADD),A
00105C 105C 3E00             7      LD A,0H
00105E 105E D3F1            11      OUT (CRTC_VAL),A
001060 1060 3E0F             7      LD A,0FH ; R15 (cursor L)
001062 1062 D3F0            11      OUT (CRTC_ADD),A
001064 1064 3E00             7      LD A,00H
001066 1066 D3F1            11      OUT (CRTC_VAL),A
                                
                                ; カーソルの形状と点滅の設定
001068 1068 3E0A             7      LD A,0AH ; R10 (cursor start address)
00106A 106A D3F0            11      OUT (CRTC_ADD),A
                                ;   LD A,C0H ; 点滅、豆腐カーソル
00106C 106C 3EC7             7      LD A,C7H ; 点滅、アンスコカーソル
                                ;   LD A,0H ; 表示せず。
00106E 106E D3F1            11      OUT (CRTC_VAL),A
001070 1070 3E0B             7      LD A,0BH ; R11 (cursor end address)
001072 1072 D3F0            11      OUT (CRTC_ADD),A
001074 1074 3E0A             7      LD A,0AH
                                ;   LD A,0H ; 表示せず。
001076 1076 D3F1            11      OUT (CRTC_VAL),A
                                
                                ;
                                ;   一度画面全てを消す(スペースで埋める)。
                                ;
001078 1078 0650             7      LD B,050H
00107A 107A 11FFFF          10      LD DE,0FFFFH
00107D 107D 3E20             7      LD A,20H ; 20Hはアスキーコードでスペース
       107F                     .CLEAR_LOOP
                                ; CLEAR_ALL_LINE:
00107F 107F D3D2            11      OUT (0D2H),A ; D2Hポートになにか書くと次の命令は別のページ(この場合はVRAMのページ)に行う。
001081 1081 77               7      LD (HL),A ; F000H～FFFFHまで20Hで埋めている。アトリビュートに20H書いても問題ないみたい。
001082 1082 23               6      INC HL
001083 1083 ED52            15      SBC HL,DE
                                    ; JR NZ,CLEAR_ALL_LINE
001085 1085 20F8            12      JR NZ,.CLEAR_LOOP
                                
001087 1087 1100F8          10      LD DE, VRAM_TXT_TOP ; 最初の文字列表示位置(左上隅)
00108A 108A ED538E12        20      LD (CURSOR_LOCATE),DE
00108E 108E ED539012        20      LD (TOP_VIEW),DE
001092 1092 11D0FF          10      LD DE, 0FFD0H
001095 1095 ED539212        20      LD (NEED_DO_SCROLL_POINT),DE
                                
001099 1099 C9              10      RET ; 初期化処理終了
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; CRTCコントロールサブルーチン群
                                ;
                                
                                ;
                                ; VRAM_TXT_TOP : VRAMテキストエリアの先頭(F800H)
                                ; CURSOR_LOCATE : 現在のカーソル位置
                                ; CR_NOW_CURSOR_LOCATE : CRコードが入った時のカーソル位置
                                ; TOP_VIEW : 画面左上端のアドレス(スクロールによって動的に変化する)
                                ; CR_BASE_ADDRESS : CR後のカーソル位置
                                ; CR_NEW_ORIGIN : FFFFHの境界を越え、更に画面右端を超えた時にCRアドレス計算の原点になるアドレス
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; １文字表示サブルーチン
                                ; A regに表示するアスキーコードが入っている。
                                ;
                                
       109A                     PUTCHAR:
00109A 109A E5              11      PUSH HL
00109B 109B F5              11      PUSH AF
00109C 109C D5              11      PUSH DE
                                
00109D 109D A7               4      AND A
00109E 109E 283D            12      JR Z, PUTCHAR_RET ; NULL文字なら何もしないで戻る
0010A0 10A0 ED5B8E12        20      LD DE,(CURSOR_LOCATE) ; 現在のカーソル位置をDEにロード
0010A4 10A4 FE0D             7      CP CR ; キャリッジリターンか？
0010A6 10A6 CA1D11          10      JP Z, DO_CR ; CRの処理
0010A9 10A9 FE0A             7      CP LF ; ラインフィードか？
0010AB 10AB CAC211          10      JP Z, DO_LF ; LFの処理
0010AE 10AE FE08             7      CP BS ; バックスペースか？
0010B0 10B0 CAE611          10      JP Z, DO_BS ; BSの処理
0010B3 10B3 FE09             7      CP HT ; タブか？
0010B5 10B5 CAEF11          10      JP Z, DO_HT ; HTの処理
0010B8 10B8 FE1B             7      CP ESC ; エスケープか？
0010BA 10BA CA0412          10      JP Z, DO_ESC ; ESCの処理
                                
                                ; 通常文字の表示処理
       10BD                     DO_NORMAL:
0010BD 10BD D3D2            11      OUT (0D2H),A ; access to RAM page 1
0010BF 10BF 12               7      LD (DE),A ; put character
                                ;
                                ; 越境判定。FFFFHの次はF800Hになる
                                ;
0010C0 10C0 F5              11      PUSH AF
0010C1 10C1 7A               4      LD A,D ; DEの上位バイト
0010C2 10C2 FEFF             7      CP 0FFH
0010C4 10C4 2008            12      JR NZ,CURSOR_BOUNDARY_END ; オーバーフローしていなければジャンプ
0010C6 10C6 7B               4      LD A,E ; DEの下位バイト
0010C7 10C7 FEFF             7      CP 0FFH
0010C9 10C9 2003            12      JR NZ,CURSOR_BOUNDARY_END ; オーバーフローしていなければジャンプ
0010CB 10CB 11FFF7          10      LD DE, VRAM_TXT_TOP-1     ; 現在のカーソル位置 = F800H - 1 
       10CE                     CURSOR_BOUNDARY_END:
0010CE 10CE F1              10      POP AF
0010CF 10CF 13               6      INC DE ; カーソル位置を1つ進める
       10D0                     DO_CR_LF_BS_RETURN: ; CR,LF,BSの処理で戻ってくる
0010D0 10D0 CD0612          17      CALL DO_SCROLL ; 1行スクロール処理
0010D3 10D3 ED538E12        20      LD (CURSOR_LOCATE),DE ; 現在のカーソル位置を更新。
0010D7 10D7 CDE110          17      CALL PRINT_CURSOR ; カーソル表示
0010DA 10DA CDF710          17      CALL CALC_CURSOR_XY ; カーソルのX,Y座標計算
       10DD                     PUTCHAR_RET:
0010DD 10DD D1              10      POP DE
0010DE 10DE F1              10      POP AF
0010DF 10DF E1              10      POP HL
0010E0 10E0 C9              10      RET
                                
                                ;
                                ; カーソルをCURSOR_LOCATE=DEの位置に表示する(HD46505Sの機能)
                                ;
       10E1                     PRINT_CURSOR:
0010E1 10E1 F5              11      PUSH AF
0010E2 10E2 D5              11      PUSH DE
0010E3 10E3 E5              11      PUSH HL
0010E4 10E4 EB               4      EX DE,HL ; HL=CURSOR_LOCATE
0010E5 10E5 3E0E             7      LD A,0EH ; R14 (cursor H)
0010E7 10E7 D3F0            11      OUT (CRTC_ADD),A
0010E9 10E9 7C               4      LD A,H
0010EA 10EA D3F1            11      OUT (CRTC_VAL),A ; カーソルの上位アドレス設定
0010EC 10EC 3E0F             7      LD A,0FH ; R15 (cursor L)
0010EE 10EE D3F0            11      OUT (CRTC_ADD),A
0010F0 10F0 7D               4      LD A,L
0010F1 10F1 D3F1            11      OUT (CRTC_VAL),A ; カーソルの下位アドレス設定
0010F3 10F3 E1              10      POP HL
0010F4 10F4 D1              10      POP DE
0010F5 10F5 F1              10      POP AF
0010F6 10F6 C9              10      RET
                                
                                ;
                                ; CURSOR_LOCATE=DEから、カーソルのX,Y座標を計算して、特定のメモリ領域に保存する。
                                ;
       10F7                     CALC_CURSOR_XY:
0010F7 10F7 F5              11      PUSH AF
0010F8 10F8 C5              11      PUSH BC
0010F9 10F9 D5              11      PUSH DE
0010FA 10FA E5              11      PUSH HL
0010FB 10FB 2100F8          10      LD HL,VRAM_TXT_TOP ; 画面左上端アドレスをHLにロード
0010FE 10FE EB               4      EX DE,HL ; DEとHLを交換。HL=CURSOR_LOCATE, DE=VRAM_TXT_TOP
0010FF 10FF ED52            15      SBC HL,DE ; HL = CURSOR_LOCATE - VRAM_TXT_TOP
001101 1101 B7               4      OR A ; フラグをクリア
001102 1102 010000          10      LD BC,0 ; B=Y座標カウンタ初期化
       1105                     Y_CALC_LOOP:
001105 1105 115000          10      LD DE,WIDTH_SCREEN ; 50H = 画面の桁数(80d)
001108 1108 ED52            15      SBC HL,DE ; HL - 50H
00110A 110A 3803            12      JR C,Y_CALC_END ; HLが負ならループ終了
00110C 110C 04               4      INC B ; Y座標カウンタをインクリメント
00110D 110D 18F6            12      JR Y_CALC_LOOP
       110F                     Y_CALC_END:
00110F 110F 19              11      ADD HL,DE ; 余り復元（これがX座標）
001110 1110 78               4      LD A,B
001111 1111 3200FF          13      LD (cursor_XY_ADDR),A   ; Y座標保存
001114 1114 7D               4      LD A,L
001115 1115 3202FF          13      LD (cursor_XY_ADDR+2),A   ; X座標保存
001118 1118 E1              10      POP HL
001119 1119 D1              10      POP DE
00111A 111A C1              10      POP BC
00111B 111B F1              10      POP AF
00111C 111C C9              10      RET
                                
                                ;
                                ; 
                                ;
                                
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; CR処理ルーチン(スクロール処理対応版)
                                ;
                                
       111D                     DO_CR:
00111D 111D E5              11      PUSH HL
00111E 111E C5              11      PUSH BC
00111F 111F AF               4      XOR A ; A=0にする
001120 1120 ED539812        20      LD (CR_NOW_CURSOR_LOCATE),DE ; 現在のカーソル位置保存
001124 1124 2A9012          16      LD HL,(TOP_VIEW) ; 左上端をロード
001127 1127 EB               4      EX DE,HL
001128 1128 ED52            15      SBC HL,DE ; 左上端アドレス - 現在のカーソル位置
00112A 112A 3062            12      JR NC,CONTINUE_CR ; オーバーフローしていないなら単純処理
                                ;
                                ;   TOP_VIEWがCR_NOW_CURSOR_LOCATEよりも大きいとき。
                                ;   この状況は、スクロールされた時に発生する。
                                ;   つまり、殆どの場合、この処理が実行される。
                                ;
00112C 112C 2A9012          16      LD HL,(TOP_VIEW)
00112F 112F ED5B9812        20      LD DE,(CR_NOW_CURSOR_LOCATE) ; CRコードが入った時のカーソル位置
001133 1133 015000          10      LD BC,WIDTH_SCREEN ;  50H =  画面の桁数(80d)
001136 1136 229412          16      LD (CR_BASE_ADDRESS),HL ; 初期値は左上端アドレス
       1139                     CR_SCAN_0:
001139 1139 2A9412          16      LD HL,(CR_BASE_ADDRESS)
00113C 113C 229612          16      LD (CR_BASE_ADDRESS_PRE),HL
00113F 113F 09              11      ADD HL,BC ; 50H(80d)づつ足していく
001140 1140 229412          16      LD (CR_BASE_ADDRESS),HL
001143 1143 D23911          10      JP NC,CR_SCAN_0     ; 越境をチェックしている。
                                                        ; オーバーフローまでループする。
001146 1146 2A9612          16      LD HL,(CR_BASE_ADDRESS_PRE) ; ループを抜けたときHLはオーバーフロー後の値になっている。
                                                                ; 足し算前の値に戻す
                                    ; FFFFHを超えた値がいくつかを調べる。
                                    ; FFFFHまでの値と合わせて、それが1行の桁数50H(80d)を
                                    ; 超えたなら、CR後の現在カーソル位置は
                                    ; その新しい行の先頭アドレスにならなくてはならない。
                                    ; 
001149 1149 11FFFF          10      LD DE,0FFFFH ; 境界値
00114C 114C EB               4      EX DE,HL
00114D 114D ED52            15      SBC HL,DE ; FFFFH - CR_BASE_ADDRESS_PRE = A
                                              ; オーバーフローする一つ前の値でFFFFHを引く
00114F 114F 115000          10      LD DE,WIDTH_SCREEN ; 50H(80d)
001152 1152 EB               4      EX DE,HL
001153 1153 ED52            15      SBC HL,DE ; 50H(80d) - A = X ; Xは境界を越えた数
001155 1155 1100F8          10      LD DE,VRAM_TXT_TOP ; VRAM_TXT_TOP = F800H
001158 1158 19              11      ADD HL,DE ; F800H + X ; この値が境界を含む行の右端のアドレス
001159 1159 2B               6      DEC HL  ; -1する
00115A 115A 2B               6      DEC HL  ; この引き算二回の処理がないと正しい左端のアドレスが出ない。
                                            ; これはCP/Mでは常にプロンプト(a>)の2文字が出ているため。
00115B 115B 229A12          16      LD (CR_NEW_ORIGIN),HL ; 新しいCR評価位置になる
00115E 115E 229412          16      LD (CR_BASE_ADDRESS),HL ; CR_BASE_ADDRESSに新しい値を入れる
001161 1161 ED5B9812        20      LD DE,(CR_NOW_CURSOR_LOCATE) ; CR命令を受けた時のカーソル位置
                                
                                    ;
                                    ; 例えば現在カーソル位置がF819Hで新しいCR評価位置がF820Hのときに、
                                    ; CR_2_NEW_SCAN_0のループを通ると+50Hされてしまうので、バイパスする処理。
001165 1165 ED52            15      SBC HL,DE ; (CR_NEW_ORIGIN) > CR_NOW_CURSOR_LOCATE ?
001167 1167 F2BC11          10      JP P,CR_BOUNDARY_RETURN ; 正であれば、ジャンプ
                                    ;
                                    ;
00116A 116A 2A9A12          16      LD HL,(CR_NEW_ORIGIN) ; 負であれば、そのまま処理を進める。
00116D 116D 015000          10      LD BC,WIDTH_SCREEN ;  50H(80d)
       1170                     CR_NEW_SCAN_0:
001170 1170 2A9412          16      LD HL,(CR_BASE_ADDRESS)
001173 1173 229612          16      LD (CR_BASE_ADDRESS_PRE),HL ; HL=CR_NEW_ORIGIN
001176 1176 09              11      ADD HL,BC ; CR_NEW_ORIGIN + 50H +...
001177 1177 229412          16      LD (CR_BASE_ADDRESS),HL
00117A 117A ED52            15      SBC HL,DE ; (CR_NEW_ORIGIN + 50H +...) > CR_NOW_CURSOR_LOCATE ?
00117C 117C FA7011          10      JP M, CR_NEW_SCAN_0 ; DEの方が大きければループ
00117F 117F CA7011          10      JP Z, CR_NEW_SCAN_0 ; 完全に一致したときも1回ループを回す
001182 1182 2A9612          16      LD HL,(CR_BASE_ADDRESS_PRE) ; HL>DE。50Hを足す一つ前の値をHLに入れる。
001185 1185 229412          16      LD (CR_BASE_ADDRESS),HL
001188 1188 ED5B9412        20      LD DE,(CR_BASE_ADDRESS) ; CR後のアドレスをDEに入れる。
00118C 118C 1829            12      JR CR_END
                                ;
                                ;   TOP_VIEWがCR_NOW_CURSOR_LOCATEよりも小さいとき
                                ;
       118E                     CONTINUE_CR:
00118E 118E 2A9012          16      LD HL,(TOP_VIEW)
001191 1191 ED5B9812        20      LD DE,(CR_NOW_CURSOR_LOCATE)
001195 1195 015000          10      LD BC,WIDTH_SCREEN ; 50H(80d) 
001198 1198 229412          16      LD (CR_BASE_ADDRESS),HL
       119B                     CR_SCAN_1:
00119B 119B 2A9412          16      LD HL,(CR_BASE_ADDRESS)
00119E 119E 229612          16      LD (CR_BASE_ADDRESS_PRE),HL
0011A1 11A1 09              11      ADD HL,BC ; 50H(80d)づつ足していく
0011A2 11A2 229412          16      LD (CR_BASE_ADDRESS),HL
0011A5 11A5 ED52            15      SBC HL,DE   ; HLが現在のカーソル位置を超えるかチェック
0011A7 11A7 FA9B11          10      JP M,CR_SCAN_1 ; 超えていなければループ
0011AA 11AA CA9B11          10      JP Z,CR_SCAN_1 ; 完全に一致したときも1回ループを回す。
0011AD 11AD 2A9612          16      LD HL,(CR_BASE_ADDRESS_PRE) ; HLが現在のカーソル位置を超えたので、1つ前の値に戻す
0011B0 11B0 229412          16      LD (CR_BASE_ADDRESS),HL
0011B3 11B3 ED5B9412        20      LD DE,(CR_BASE_ADDRESS)
       11B7                     CR_END:
0011B7 11B7 C1              10      POP BC
0011B8 11B8 E1              10      POP HL
0011B9 11B9 C3D010          10      JP DO_CR_LF_BS_RETURN; CR,LF,BSの処理の終了
                                
       11BC                     CR_BOUNDARY_RETURN:
0011BC 11BC ED5B9612        20      LD DE,(CR_BASE_ADDRESS_PRE) ; DEに現在のカーソル位置を超える前の値(CR_BASE_ADDRESS_PRE)を戻す
0011C0 11C0 18F5            12      JR CR_END
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; LINE_FEED 処理(スクロール処理対応版)
                                ;
                                
       11C2                     DO_LF:
0011C2 11C2 E5              11      PUSH HL
0011C3 11C3 C5              11      PUSH BC
0011C4 11C4 EB               4      EX DE,HL ; HL <-> DE DE=現在のカーソル位置
0011C5 11C5 015000          10      LD BC,WIDTH_SCREEN ; 50H(80d)
0011C8 11C8 09              11      ADD HL,BC ; HL = DE + 50H
0011C9 11C9 3015            12      JR NC,CONTINUE_LF ; オーバーフローしていなければジャンプ
                                ;
                                ;   BEYOND FFFFH BOUNDARY
                                ;
0011CB 11CB 2A8E12          16      LD HL,(CURSOR_LOCATE)
0011CE 11CE 11FFFF          10      LD DE,0FFFFH
0011D1 11D1 EB               4      EX DE,HL ; HL - CURSOR_LOCATE
0011D2 11D2 ED52            15      SBC HL,DE ; FFFFH - CURSOR_LOCATE = A
0011D4 11D4 115000          10      LD DE,50H ; 50H(80d)
0011D7 11D7 EB               4      EX DE,HL ; DE - A
0011D8 11D8 ED52            15      SBC HL,DE ; 50H - A = X
                                ;
0011DA 11DA 2B               6      DEC HL ; この引き算二回の処理がないと正しい左端のアドレスが出ない。
0011DB 11DB 2B               6      DEC HL ; これはCP/Mでは常にプロンプト(a>)の2文字が出ているため。
                                ;
0011DC 11DC 1100F8          10      LD DE,VRAM_TXT_TOP
0011DF 11DF 19              11      ADD HL,DE
       11E0                     CONTINUE_LF:
0011E0 11E0 EB               4      EX DE,HL ; DE <-> HL
0011E1 11E1 C1              10      POP BC
0011E2 11E2 E1              10      POP HL
0011E3 11E3 C3D010          10      JP DO_CR_LF_BS_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; BACK SPACE 処理
                                ;
       11E6                     DO_BS:
0011E6 11E6 3E20             7      LD A, 20H ; 20H -> Space ASCII CODE
0011E8 11E8 1B               6      DEC DE ; カーソル位置を1つ戻す
0011E9 11E9 D3D2            11      OUT (0D2H),A ; access to RAM page 1
0011EB 11EB 12               7      LD (DE),A ; 20H(スペース)を表示させる。
0011EC 11EC C3D010          10      JP DO_CR_LF_BS_RETURN ; BSの為の復帰点に戻る。
                                
                                ;
                                ; Horizontal Tab
                                ;
       11EF                     DO_HT:
0011EF 11EF F5              11      PUSH AF
0011F0 11F0 E5              11      PUSH HL
0011F1 11F1 C5              11      PUSH BC
                                
                                    ; PUTCHARルーチンを4回呼び出してスペースを表示させる。
0011F2 11F2 3E20             7      LD A,20H ; 20H is Space CODE
0011F4 11F4 0604             7      LD B,04H    ; 4回ループ
       11F6                     HT_LOOP:
0011F6 11F6 F5              11          PUSH AF
0011F7 11F7 CD9A10          17          CALL PUTCHAR
0011FA 11FA F1              10          POP AF
0011FB 11FB 05               4          DEC B
0011FC 11FC 20F8            12          JR NZ, HT_LOOP
0011FE 11FE C1              10      POP BC
0011FF 11FF E1              10      POP HL
001200 1200 F1              10      POP AF
001201 1201 C9              10      RET
                                
       1202                     DO_VT:
001202 1202 C9              10      RET
                                
       1203                     DO_NP:
001203 1203 C9              10      RET
                                
       1204                     DO_ESC:
001204 1204 C9              10      RET
                                
       1205                     DO_BEL:
001205 1205 C9              10      RET
                                
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; スクロール処理
                                ; SORD M23のCRTCであるHD4650SPはスクロール機能がある。
                                ; 具体的には表示したい画面左上端のアドレスを、R12、R13に上位、下位アドレスとして入れることで実行される。
                                ; SORD M23のVRAMのテキストエリアはF800H～FFFFHであるが、画面に表示される文字は80桁×25行の2000(7D0H)文字である。
                                ; よって、余りが生じるため、スクロール処理は殆どがこの余りの処理に費やされる。
                                ;
                                
       1206                     DO_SCROLL:
001206 1206 ED538E12        20      LD (CURSOR_LOCATE),DE ; 現在のカーソル位置を更新
00120A 120A 2A9012          16      LD HL,(TOP_VIEW) ; 左上端アドレス
00120D 120D 11D007          10      LD DE,7D0H ; 全画面文字数
001210 1210 19              11      ADD HL,DE ; TOP_VIEW + 7D0H ; 
001211 1211 3802            12      JR C,SCROLL_POINT_BEYOND_FFFF ; 境界値をまたいでいる、オーバーフローしたらジャンプ
001213 1213 1813            12      JR SCROLL_POINT ; スクロールすべきカーソル位置の更新へ
       1215                     SCROLL_POINT_BEYOND_FFFF:
001215 1215 2A9012          16      LD HL,(TOP_VIEW)
001218 1218 11FFFF          10      LD DE,0FFFFH
00121B 121B EB               4      EX DE,HL ; HL - TOP_VIEW
00121C 121C ED52            15      SBC HL,DE ; FFFFH - TOP_VIEW = A
00121E 121E 11CE07          10      LD DE,7CEH ; 7D0H - 2H = 7CEH
001221 1221 EB               4      EX DE,HL ; DE - A
001222 1222 ED52            15      SBC HL,DE ; 7CEH - A = X
001224 1224 1100F8          10      LD DE,VRAM_TXT_TOP
001227 1227 19              11      ADD HL,DE ; X + F800H = 新しいTOP_VIEW
                                    ;
       1228                     SCROLL_POINT:
                                    ; update need_do_scroll_point
001228 1228 229212          16      LD (NEED_DO_SCROLL_POINT),HL ; need_do_scroll_point = 新しいTOP_VIEW
00122B 122B ED5B8E12        20      LD DE,(CURSOR_LOCATE) ; 現在のカーソル位置
00122F 122F 7A               4      LD A,D ; need_do_scroll_point == CURSOR_LOCATE?
001230 1230 BC               4      CP H
001231 1231 C0              11      RET NZ
001232 1232 7B               4      LD A,E ; need_do_scroll_point == CURSOR_LOCATE?
001233 1233 BD               4      CP L
001234 1234 C0              11      RET NZ ; スクロール不要なら終了
                                ;
                                ; TOP_VIEWの更新
                                ;
                                
                                ; スクロールから外れた行をスペースで埋める。
001235 1235 2A9012          16      LD HL,(TOP_VIEW) ; スクロール直前の左上端アドレス
001238 1238 C5              11      PUSH BC
001239 1239 D5              11      PUSH DE
00123A 123A F5              11      PUSH AF
00123B 123B 064F             7      LD B,04FH ; 4FH=79d
00123D 123D 11FFFF          10      LD DE,0FFFFH ; 境界値
001240 1240 3E20             7      LD A,20H ; 20H is Space CODE
       1242                     CLEAR_1_LINE:
001242 1242 D3D2            11      OUT (0D2H),A
001244 1244 77               7      LD (HL),A ; スペースで埋める
001245 1245 E5              11      PUSH HL ; HL < FFFFHのとき、下の引き算はオーバーフローするが、
                                            ; HL=F800Hの時に実行すると、HL=F801となり、
                                            ; その後INC HLでF802Hになるため、スペースによる穴埋めがF801Hのみ実行されないことになる。
                                            ; なので、一度、HLを退避して、引き算してFFFFHでないか判定したのち、POPして戻している。
                                            ; このコードは遅いが、現状、これを採用する。20221229
001246 1246 ED52            15      SBC HL,DE ; HL - FFFFH = HL
001248 1248 E1              10      POP HL
001249 1249 2805            12      JR Z, CLEAR_BEYOND_BOUNDARY ; HL = FFFFHのときは境界を越えた
00124B 124B 23               6      INC HL
00124C 124C 10F4            13      DJNZ CLEAR_1_LINE
00124E 124E 1809            12      JR CLEAR_1_LINE_END
                                    ; 越境時の処理
       1250                     CLEAR_BEYOND_BOUNDARY:
001250 1250 2100F8          10      LD HL,VRAM_TXT_TOP ; HLをVRAMの先頭(F800H)にセット
       1253                     CLEAR_1_LINE_BOUNDARY: ; B回ループする
001253 1253 D3D2            11      OUT (0D2H),A
001255 1255 77               7      LD (HL),A
001256 1256 23               6      INC HL
001257 1257 10FA            13      DJNZ CLEAR_1_LINE_BOUNDARY
       1259                     CLEAR_1_LINE_END:
001259 1259 F1              10      POP AF
00125A 125A D1              10      POP DE
00125B 125B C1              10      POP BC
                                ;
                                ;
00125C 125C 2A9012          16      LD HL,(TOP_VIEW) ; TOP_VIEWの更新
00125F 125F 115000          10      LD DE,50H ; 50H=80d
001262 1262 19              11      ADD HL,DE ; TOP_VIEW + 50H
001263 1263 3015            12      JR NC,UPDATE_TOP_VIEW
                                ;
                                ;   BEYOND FFFFH BOUNDARY
                                ;
001265 1265 11FFFF          10      LD DE,0FFFFH ; 境界値
001268 1268 2A9012          16      LD HL,(TOP_VIEW) ; TOP_VIEW
00126B 126B EB               4      EX DE,HL
00126C 126C ED52            15      SBC HL,DE ; FFFFH - TOP_VIEW = A
00126E 126E 115000          10      LD DE,50H ; 50H(80d)
001271 1271 EB               4      EX DE,HL ; DE - A
001272 1272 ED52            15      SBC HL,DE ; 50H - A = X
001274 1274 1100F8          10      LD DE,VRAM_TXT_TOP ; VRAM_TXT_TOP
001277 1277 19              11      ADD HL,DE ; F800H + X = TOP_VIEW
                                ;
001278 1278 2B               6      DEC HL ; この引き算二回の処理がないと正しい左端のアドレスが出ない。
001279 1279 2B               6      DEC HL ; これはCP/Mでは常にプロンプト(a>)の2文字が出ているため。
                                ;
       127A                     UPDATE_TOP_VIEW:
00127A 127A 229012          16      LD (TOP_VIEW),HL
                                    ;
                                    ; 1行スクロール
                                    ;
00127D 127D F5              11      PUSH AF
00127E 127E 3E0C             7      LD A,0CH ; START ADDRESS HIGH
001280 1280 D3F0            11      OUT (CRTC_ADD),A
001282 1282 7C               4      LD A,H ; スクロールしたときに左隅になるVRAMの上位アドレス
001283 1283 D3F1            11      OUT (CRTC_VAL),A
001285 1285 3E0D             7      LD A,0DH ; START ADDRESS LOW
001287 1287 D3F0            11      OUT (CRTC_ADD),A
001289 1289 7D               4      LD A,L ; スクロールしたときに左隅になるVRAMの下位アドレス
00128A 128A D3F1            11      OUT (CRTC_VAL),A
00128C 128C F1              10      POP AF
       128D                     SCROLL_END:
00128D 128D C9              10      RET
                                
                                
                                
                                ;
                                ; for CRT control
                                ;
                                
       128E                     CURSOR_LOCATE: ; カーソル位置を保存する変数
00128E 128E                         DS 02H
                                
       1290                     TOP_VIEW: ; 画面左上端のアドレスを保存する変数
001290 1290                         DS 02H
                                
       1292                     NEED_DO_SCROLL_POINT: ; スクロールすべきポイントアドレスを保存する変数
001292 1292                         DS 02H
                                
       1294                     CR_BASE_ADDRESS: ; CRTコントローラのベースアドレス保存変数
001294 1294                         DS 02H
                                
       1296                     CR_BASE_ADDRESS_PRE: ; CRTコントローラのベースアドレス保存変数（前回値）
001296 1296                         DS 02H
                                
       1298                     CR_NOW_CURSOR_LOCATE: ; 現在のカーソル位置保存変数
001298 1298                         DS 02H
                                
       129A                     CR_NEW_ORIGIN: ; 新しい表示開始アドレス保存変数
00129A 129A                         DS 02H
                                
                                
002B00 2B00                         ORG 2B00H
                                
                                ;===============
                                ;エントリ
                                ;===============
                                
                                
002B00 2B00 C3072B          10  DREAD:  JP  read_disk_entity    ;ディスク読み込み
002B03 2B03 C35E2B          10  DWRITE: JP  write_disk_entity   ;ディスク書き込み
002B06 2B06                     disk_unit_number:   DS  1   ;0～
                                
                                
                                ;===============
                                ;サブルーチン
                                ;===============
                                
                                
                                ;DREAD本体
                                ;入力   HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
                                ;   [disk_unit_number]参照
                                ;出力   CY＝0（Acc←0）なら成功、
                                ;   CY＝1（Acc←エラー･コード）なら失敗
                                ;破壊   AF，AF'
       2B07                     read_disk_entity:
002B07 2B07 C5              11      PUSH    BC
002B08 2B08 D5              11      PUSH    DE
002B09 2B09 E5              11      PUSH    HL
002B0A 2B0A CD112B          17      CALL    DRDSB   ;ディスクから読み込みます
002B0D 2B0D E1              10      POP HL
002B0E 2B0E D1              10      POP DE
002B0F 2B0F C1              10      POP BC
002B10 2B10 C9              10      RET
                                
                                
                                ;ディスクから読み込みます
                                ;入力   HL←読み込みアドレス、DE←レコード番号、Acc←レコード数
                                ;   [disk_unit_number]参照
                                ;出力   CY＝0（Acc←0）なら成功、
                                ;   CY＝1（Acc←エラー･コード）なら失敗
                                ;破壊   AF，HL，DE，BC，AF'
       2B11                     DRDSB:
002B11 2B11 ED73D72C        20      LD  (SPBUFF),SP ;リターン･スタック･ポインタ
002B15 2B15 CDB82B          17      CALL    get_track_number_and_sector_number_from_record_number   ;レコード番号より、トラック番号とセクタ番号を得ます
002B18 2B18 CDDC2B          17      CALL    get_ready_to_access_disk    ;ディスクをアクセス可能にします
       2B1B                     AGNRDY:
002B1B 2B1B CD0F2C          17      CALL    SEEK    ;目的のシリンダへシークします（V1，20ms） '0msに改
       2B1E                     REDAGN:
002B1E 2B1E 3E05             7      LD  A,5 ;リトライ･カウンタ
       2B20                     REDRTY:
002B20 2B20 F5              11      PUSH    AF
002B21 2B21 E5              11      PUSH    HL
002B22 2B22 3E80             7      LD  A,10000000B ;リード･データ（サイド比較なし）
002B24 2B24 CD692C          17      CALL    set_sector_number_and_execute_FDC_coomand   ;FDCにセクタ番号をセットして、FDCコマンドを実行します
002B27 2B27 D5              11      PUSH    DE
002B28 2B28 11FBF8          10      LD  DE,0F8FBH
002B2B 2B2B 4B               4      LD  C,E ;BC←0FFBH 'データ･レジスタ
002B2C 2B2C ED78            12      IN  A,(C)
002B2E 2B2E 4A               4      LD  C,D ;BC←0FF8H
                                
002B2F 2B2F ED78            12  MPNYMI: IN  A,(C)
002B31 2B31 0F               4      RRCA        ;BUSY
002B32 2B32 300B            12      JR  NC,ENDRED
002B34 2B34 0F               4      RRCA        ;DATA REQUEST
002B35 2B35 30F8            12      JR  NC,MPNYMI
002B37 2B37 4B               4      LD  C,E ;BC←0FFBH 'データ･レジスタ
002B38 2B38 ED78            12      IN  A,(C)   ;FDより1バイト読みます
002B3A 2B3A 77               7      LD  (HL),A  ;メモリに書き込みます
002B3B 2B3B 23               6      INC HL
002B3C 2B3C 4A               4      LD  C,D ;BC←0FF8H
002B3D 2B3D 18F0            12      JR  MPNYMI
                                
                                ;   NOT READY，RECORD NOT FOUND，CRC ERROR，LOST DATA
002B3F 2B3F E64E             7  ENDRED: AND 01001110B   ;10011100B
002B41 2B41 D1              10      POP DE
002B42 2B42 280B            12      JR  Z,CNTRED
                                ;   エラー
002B44 2B44 E1              10      POP HL  ;HL←読み込み先頭アドレス
002B45 2B45 F1              10      POP AF  ;Acc←リトライ･カウンタ
002B46 2B46 3D               4      DEC A
002B47 2B47 CACA2C          10      JP  Z,device_io_error   ;リトライでも回復不能
002B4A 2B4A CD882C          17      CALL    restore_and_seek    ;リストアして、目的のシリンダへシークします
002B4D 2B4D 18D1            12      JR  REDRTY  ;リトライします
                                
                                ;   ノー･エラー
002B4F 2B4F F1              10  CNTRED: POP AF  ;読み込み先頭アドレスを捨てます
002B50 2B50 F1              10      POP AF  ;リトライ･カウンタを捨てます
002B51 2B51 08               4      EX  AF,AF'  ;Acc←レコード数
002B52 2B52 3D               4      DEC A
002B53 2B53 CA792C          10      JP  Z,fdd_motor_off ;モータをオフします
002B56 2B56 08               4      EX  AF,AF'
002B57 2B57 CDA52C          17      CALL    count_up_sector ;セクタ番号のカウント･アップ
002B5A 2B5A 30C2            12      JR  NC,REDAGN
002B5C 2B5C 18BD            12      JR  AGNRDY
                                
                                
                                ;DWRITE本体
                                ;入力   HL←書き込みアドレス、DE←レコード番号、Acc←レコード数
                                ;   [disk_unit_number]参照
                                ;出力   CY＝0（Acc←0）なら成功、
                                ;   CY＝1（Acc←エラー･コード）なら失敗
                                ;破壊   AF，AF'
       2B5E                     write_disk_entity:
002B5E 2B5E C5              11      PUSH    BC
002B5F 2B5F D5              11      PUSH    DE
002B60 2B60 E5              11      PUSH    HL
002B61 2B61 CD682B          17      CALL    DWTSB   ;ディスクへ書き込みます
002B64 2B64 E1              10      POP HL
002B65 2B65 D1              10      POP DE
002B66 2B66 C1              10      POP BC
002B67 2B67 C9              10      RET
                                
                                
                                ;ディスクへ書き込みます
                                ;入力   HL←書き込みアドレス、DE←レコード番号、Acc←レコード数
                                ;   [disk_unit_number]参照
                                ;出力   CY＝0（Acc←0）なら成功、
                                ;   CY＝1（Acc←エラー･コード）なら失敗
                                ;破壊   AF，HL，DE，BC，AF'
       2B68                     DWTSB:
002B68 2B68 ED73D72C        20      LD  (SPBUFF),SP ;リターン･スタック･ポインタ
002B6C 2B6C CDB82B          17      CALL    get_track_number_and_sector_number_from_record_number   ;レコード番号より、トラック番号とセクタ番号を得ます
002B6F 2B6F CDDC2B          17      CALL    get_ready_to_access_disk    ;ディスクをアクセス可能にします
       2B72                     AGNWRT:
002B72 2B72 CD0F2C          17      CALL    SEEK    ;目的のシリンダへシークします（V1，20ms） '0msに改
       2B75                     WRTAGN:
002B75 2B75 3E05             7      LD  A,5 ;リトライ･カウンタ
       2B77                     WRTRTY:
002B77 2B77 F5              11      PUSH    AF
002B78 2B78 E5              11      PUSH    HL
002B79 2B79 3EA0             7      LD  A,10100000B ;ライト･データ（サイド比較なし）
002B7B 2B7B CD692C          17      CALL    set_sector_number_and_execute_FDC_coomand   ;FDCにセクタ番号をセットして、FDCコマンドを実行します
002B7E 2B7E D5              11      PUSH    DE
002B7F 2B7F 11FBF8          10      LD  DE,0F8FBH
                                
002B82 2B82 ED78            12  MPNWRT: IN  A,(C)
002B84 2B84 0F               4      RRCA        ;BUSY
002B85 2B85 300B            12      JR  NC,ENDWRT
002B87 2B87 0F               4      RRCA        ;DATA REQUEST
002B88 2B88 30F8            12      JR  NC,MPNWRT
002B8A 2B8A 7E               7      LD  A,(HL)  ;メモリから読みます
002B8B 2B8B 4B               4      LD  C,E ;BC←0FFBH 'データ･レジスタ
002B8C 2B8C ED79            12      OUT (C),A   ;FDに1バイト書き込みます
002B8E 2B8E 23               6      INC HL
002B8F 2B8F 4A               4      LD  C,D ;BC←0FF8H
002B90 2B90 18F0            12      JR  MPNWRT
                                
       2B92                     ENDWRT:
002B92 2B92 CB6F             8      BIT 5,A ;b6 WRITE PROTECT
002B94 2B94 C2C72C          10      JP  NZ,write_protect_error  ;エラー
                                ;   NOT READY，WRITE PROTECT，WRITE FAULT，RECORD NOT FOUND，CRC ERROR，LOST DATA
002B97 2B97 E67E             7      AND 01111110B   ;11111100B
002B99 2B99 D1              10      POP DE
002B9A 2B9A 280D            12      JR  Z,CNTWRT
                                ;   エラー
002B9C 2B9C E1              10      POP HL  ;HL←読み込み先頭アドレス
002B9D 2B9D F1              10      POP AF  ;Acc←リトライ･カウンタ
002B9E 2B9E 3D               4      DEC A
002B9F 2B9F 2003            12      JR  NZ,WTRTYL
002BA1 2BA1 C3CA2C          10      JP  device_io_error ;リトライでも回復不能
       2BA4                     WTRTYL:
002BA4 2BA4 CD882C          17      CALL restore_and_seek   ;リストアして、目的のシリンダへシークします
002BA7 2BA7 18CE            12      JR  WRTRTY  ;リトライします
                                
                                ;   ノー･エラー
       2BA9                     CNTWRT:
002BA9 2BA9 F1              10      POP AF  ;読み込み先頭アドレスを捨てます
002BAA 2BAA F1              10      POP AF  ;リトライ･カウンタを捨てます
002BAB 2BAB 08               4      EX  AF,AF'  ;Acc←レコード数
002BAC 2BAC 3D               4      DEC A
002BAD 2BAD CA792C          10      JP  Z,fdd_motor_off ;モータをオフします
002BB0 2BB0 08               4      EX  AF,AF'
002BB1 2BB1 CDA52C          17      CALL    count_up_sector ;セクタ番号のカウント･アップ
002BB4 2BB4 30BF            12      JR  NC,WRTAGN
002BB6 2BB6 18BA            12      JR  AGNWRT
                                
                                
                                ;レコード番号より、トラック番号とセクタ番号を得ます
                                ;入力   DE←レコード番号、Acc←レコード数
                                ;   [disk_unit_number]参照
                                ;出力   D←トラック番号、E←セクタ番号、Acc'←レコード数
                                ;破壊   AF，DE，AF'
       2BB8                     get_track_number_and_sector_number_from_record_number:
002BB8 2BB8 E5              11      PUSH HL
002BB9 2BB9 6F               4      LD  L,A ;L←レコード数
002BBA 2BBA 08               4      EX  AF,AF'  ;AF'
002BBB 2BBB 2604             7      LD  H,4
002BBD 2BBD 3EFF             7      LD  A,0FFH  ;H A'←04FFH
002BBF 2BBF 2D               4      DEC L   ;L←レコード数－1
002BC0 2BC0 95               4      SUB L   ;H A'←04FFH－（レコード数－1）
002BC1 2BC1 6F               4      LD  L,A ;HL←0500H－レコード数
002BC2 2BC2 B7               4      OR  A
002BC3 2BC3 ED52            15      SBC HL,DE   ;（0500H－レコード数）－レコード番号
002BC5 2BC5 E1              10      POP HL
002BC6 2BC6 DAC12C          10      JP  C,bad_sector_error
002BC9 2BC9 7B               4      LD  A,E
       2BCA                     RLLOP:
002BCA 2BCA 07               4      RLCA
002BCB 2BCB CB12             8      RL  D
002BCD 2BCD 07               4      RLCA
002BCE 2BCE CB12             8      RL  D
002BD0 2BD0 07               4      RLCA
002BD1 2BD1 CB12             8      RL  D
002BD3 2BD3 07               4      RLCA
002BD4 2BD4 CB12             8      RL  D   ;D←トラック番号
002BD6 2BD6 7B               4      LD  A,E
002BD7 2BD7 E60F             7      AND 0FH
002BD9 2BD9 3C               4      INC A
002BDA 2BDA 5F               4      LD  E,A ;E←セクタ番号
002BDB 2BDB C9              10      RET
                                
                                
                                ;ディスクをアクセス可能にします
                                ;入力   D←トラック番号
                                ;出力   D←シリンダ番号、[disk_unit_number b4]←サイド、B←0FH
                                ;破壊   AF，BC
       2BDC                     get_ready_to_access_disk:
002BDC 2BDC E5              11      PUSH    HL
002BDD 2BDD F3               4      DI
002BDE 2BDE CD352C          17      CALL check_FDC  ;FDCをチェックします
002BE1 2BE1 3A062B          13      LD  A,(disk_unit_number)
002BE4 2BE4 E603             7      AND 00000011B
002BE6 2BE6 CB3A             8      SRL D   ;D←シリンダ番号
002BE8 2BE8 3002            12      JR  NC,J1
002BEA 2BEA F610             7      OR  00010000B
002BEC 2BEC F680             7  J1: OR  10000000B
002BEE 2BEE 32062B          13      LD  (disk_unit_number),A    ;[disk_unit_number]←I／O 0FFCHに書き込む値
002BF1 2BF1 0EFC             7      LD  C,0FCH  ;BC←0FFCH
002BF3 2BF3 ED79            12      OUT (C),A   ;モータ･オン
002BF5 2BF5 D5              11      PUSH    DE
002BF6 2BF6 1E03             7  DBSY:   LD  E,3
002BF8 2BF8 210000          10      LD  HL,0
002BFB 2BFB 01F80F          10      LD  BC,0FF8H
                                
                                ;   ディスクが正常回転するまで、196,608ループまで待ちます
       2BFE                     RDYWT1:
002BFE 2BFE ED78            12      IN  A,(C)
002C00 2C00 E681             7      AND 10000001B
002C02 2C02 282E            12      JR  Z,RTRDYS    ;POPリターン
002C04 2C04 2B               6      DEC HL
002C05 2C05 7C               4      LD  A,H
002C06 2C06 B5               4      OR  L
002C07 2C07 20F5            12      JR  NZ,RDYWT1
002C09 2C09 1D               4      DEC E
002C0A 2C0A 20F2            12      JR  NZ,RDYWT1
002C0C 2C0C C3C42C          10      JP  device_offline_error
                                
                                
                                ;目的のシリンダへシークします（V1，20ms） '0msに改
                                ;入力   D←シリンダ番号、B←0FH
                                ;出力   なし
                                ;破壊   AF，C
       2C0F                     SEEK:
002C0F 2C0F 0EFB             7      LD  C,0FBH  ;BC←0FFBH 'データ･レジスタ
002C11 2C11 ED51            12      OUT (C),D   ;FDCデータ･レジスタ←シリンダ番号
002C13 2C13 E5              11      PUSH HL
002C14 2C14 CD5A2C          17      CALL get_cylinder_buffer_address    ;シリンダ･バッファのアドレスを得ます
002C17 2C17 7E               7      LD  A,(HL)
002C18 2C18 0EF9             7      LD  C,0F9H  ;BC←0FF9H 'トラック･レジスタ
002C1A 2C1A ED79            12      OUT (C),A   ;FDCシリンダ･レジスタ←現在シリンダ番号
002C1C 2C1C 72               7      LD  (HL),D  ;シリンダ･バッファの更新
002C1D 2C1D E1              10      POP HL
002C1E 2C1E 0EF8             7      LD  C,0F8H  ;BC←0FF8H
                                ;   LD  A,00011110B ;シーク（V1，20ms）
002C20 2C20 3E1C             7      LD  A,00011100B ;シーク（V1， 0ms）
002C22 2C22 ED79            12      OUT (C),A
                                
                                
                                ;FDCレディ待ち
                                ;出力   なし
                                ;破壊   AF，BC
       2C24                     wait_for_FDC_ready:
                                ;   115.5μs（462ts）待ちます
002C24 2C24 E5              11      PUSH    HL  ;11ts
002C25 2C25 D5              11      PUSH    DE  ;11ts
002C26 2C26 0620             7      LD  B,32    ; 7ts
       2C28                     SELF:
002C28 2C28 10FE            13      DJNZ    SELF    ;411ts
002C2A 2C2A 01F80F          10      LD  BC,0FF8H    ;10ts
                                
       2C2D                     BSYLP1:
002C2D 2C2D ED78            12      IN  A,(C)   ;12ts
002C2F 2C2F 0F               4      RRCA        ;BUSY
002C30 2C30 38FB            12      JR  C,BSYLP1
                                
       2C32                     RTRDYS:
002C32 2C32 D1              10      POP DE
002C33 2C33 E1              10      POP HL
002C34 2C34 C9              10      RET
                                
                                
                                ;FDCをチェックします
                                ;出力   B←0FH
                                ;破壊   AF，BC
       2C35                     check_FDC:
002C35 2C35 D5              11      PUSH    DE
002C36 2C36 16FF             7      LD  D,255
                                
002C38 2C38 01FB0F          10  check_FDCL: LD  BC,0FFBH    ;データ･レジスタ
002C3B 2C3B 3EA5             7      LD  A,0A5H
002C3D 2C3D ED79            12      OUT (C),A
                                ;   139.5μs待ちます
002C3F 2C3F 3E10             7      LD  A,16
002C41 2C41 CD532C          17      CALL wait_8usec ;8μs単位で待ちます
002C44 2C44 ED78            12      IN  A,(C)
002C46 2C46 FEA5             7      CP  0A5H
002C48 2C48 2002            12      JR  NZ,J2
002C4A 2C4A D1              10      POP DE
002C4B 2C4B C9              10      RET     ;FDCが正常動作
002C4C 2C4C 15               4  J2: DEC D
002C4D 2C4D 20E9            12      JR  NZ,check_FDCL
                                
                                ;   FDCが正常でない
002C4F 2C4F D1              10      POP DE
002C50 2C50 C3C42C          10      JP  device_offline_error
                                
                                
                                ;8μs単位で待ちます
                                ;入力   Acc←カウンタ
                                ;出力   32×Acc＋10ts待ちます
                                ;破壊   AF
       2C53                     wait_8usec:
                                ;   1ループ32ts
002C53 2C53 3D               4      DEC A   ; 4ts
002C54 2C54 2A3412          16      LD  HL,(1234H)  ;16ts
002C57 2C57 20FA            12      JR  NZ,wait_8usec   ;12ts
002C59 2C59 C9              10      RET     ;10ts
                                
                                
                                ;シリンダ･バッファのアドレスを得ます
                                ;入力   [disk_unit_number b3～b0]←ユニット番号（0～3）
                                ;出力   HL←対応するシリンダ･バッファのアドレス
                                ;破壊   AF，HL
       2C5A                     get_cylinder_buffer_address:
002C5A 2C5A 21D92C          10      LD  HL,DSKTRK   ;シリンダ･バッファ
002C5D 2C5D D5              11      PUSH    DE
002C5E 2C5E 3A062B          13      LD  A,(disk_unit_number)
002C61 2C61 E60F             7      AND 00001111B
002C63 2C63 5F               4      LD  E,A
002C64 2C64 1600             7      LD  D,0
002C66 2C66 19              11      ADD HL,DE
002C67 2C67 D1              10      POP DE
002C68 2C68 C9              10      RET
                                
                                
                                ;FDCにセクタ番号をセットして、FDCコマンドを実行します
                                ;入力   E←セクタ番号、Acc←FDCコマンド、B←0FH
                                ;出力   C←F8H
                                ;破壊   AF，C
       2C69                     set_sector_number_and_execute_FDC_coomand:
002C69 2C69 FB               4      EI
002C6A 2C6A 0EFA             7      LD  C,0FAH  ;BC←0FFAH 'セクタ･レジスタ
002C6C 2C6C F3               4      DI
002C6D 2C6D ED59            12      OUT (C),E   ;FDCセクタ･レジスタ←セクタ番号
002C6F 2C6F 0EF8             7      LD  C,0F8H  ;BC←0FF8H
002C71 2C71 ED79            12      OUT (C),A
                                ;   31μs（124ts）待ちます
002C73 2C73 3E07             7      LD  A,7 ;7ts
002C75 2C75 3D               4  J3: DEC A   ;---ts
002C76 2C76 20FD            12      JR  NZ,J3   ;107ts
002C78 2C78 C9              10      RET     ;10ts
                                
                                
                                ;モータをオフします
                                ;出力   CY＝0
       2C79                     fdd_motor_off:
002C79 2C79 F5              11      PUSH    AF
002C7A 2C7A 01FC0F          10      LD  BC,0FFCH
002C7D 2C7D 3A062B          13      LD  A,(disk_unit_number)
002C80 2C80 E603             7      AND 00000011B
002C82 2C82 ED79            12      OUT (C),A
002C84 2C84 F1              10      POP AF
002C85 2C85 FB               4      EI
002C86 2C86 B7               4      OR  A
002C87 2C87 C9              10      RET
                                
                                
                                ;リストアして、目的のシリンダへシークします
                                ;出力   D←シリンダ番号、B←0FH
                                ;破壊   BC
       2C88                     restore_and_seek:
002C88 2C88 F5              11      PUSH    AF
002C89 2C89 E5              11      PUSH    HL
002C8A 2C8A D5              11      PUSH    DE
002C8B 2C8B CD5A2C          17      CALL    get_cylinder_buffer_address ;シリンダ･バッファのアドレスを得ます
002C8E 2C8E 3600            10      LD  (HL),0
002C90 2C90 AF               4      XOR A
002C91 2C91 01F90F          10      LD  BC,0FF9H    ;トラック･レジスタ
002C94 2C94 ED79            12      OUT (C),A   ;FDCシリンダ･レジスタ←0
002C96 2C96 0D               4      DEC C   ;BC←0FF8H
                                ;   LD  A,00000010B ;リストア（V0，20ms）
002C97 2C97 3E00             7      LD  A,00000000B ;リストア（V0， 0ms）
002C99 2C99 ED79            12      OUT (C),A
002C9B 2C9B CD242C          17      CALL    wait_for_FDC_ready  ;FDCレディ待ち
002C9E 2C9E D1              10      POP DE
002C9F 2C9F CD0F2C          17      CALL    SEEK    ;目的のシリンダへシークします（V1，20ms） '0msに改
002CA2 2CA2 E1              10      POP HL
002CA3 2CA3 F1              10      POP AF
002CA4 2CA4 C9              10      RET
                                
                                
                                ;セクタ番号のカウント･アップ
                                ;入力   E←セクタ番号、D←シリンダ番号、B←0FH
                                ;出力   CY＝1ならシリンダの更新が必要
                                ;破壊   AF，DE，C
       2CA5                     count_up_sector:
002CA5 2CA5 1C               4      INC E
002CA6 2CA6 3E10             7      LD  A,16
002CA8 2CA8 BB               4      CP  E
002CA9 2CA9 D0              11      RET NC  ;セクタ番号2～16
                                
                                ;   トラックのカウント･アップ
002CAA 2CAA 1E01             7      LD  E,1
002CAC 2CAC E5              11      PUSH    HL
002CAD 2CAD 21062B          10      LD  HL,disk_unit_number
002CB0 2CB0 7E               7      LD  A,(HL)
002CB1 2CB1 EE10             7      XOR 00010000B
002CB3 2CB3 77               7      LD  (HL),A
002CB4 2CB4 E610             7      AND 00010000B
002CB6 2CB6 2002            12      JR  NZ,BFIOST   ;サイド0へ
002CB8 2CB8 14               4      INC D   ;シリンダ番号のカウント･アップ
002CB9 2CB9 37               4      SCF
       2CBA                     BFIOST:
002CBA 2CBA 0EFC             7      LD  C,0FCH  ;BC←0FFCH
002CBC 2CBC 7E               7      LD  A,(HL)
002CBD 2CBD ED79            12      OUT (C),A   ;サイドの更新
002CBF 2CBF E1              10      POP HL
002CC0 2CC0 C9              10      RET
                                
                                
                                ;=======================
                                ;エラー･ジャンプ
                                ;=======================
                                
                                
002CC1 2CC1 3E05             7  bad_sector_error:   LD  A,5 ;Bad Record
002CC3 2CC3 01                      DB  01H ;「LD BC,」
002CC4 2CC4 3E02             7  device_offline_error:   LD  A,2 ;Device Offline
002CC6 2CC6 01                      DB  01H ;「LD BC,」
002CC7 2CC7 3E04             7  write_protect_error:    LD  A,4 ;Write Protected
002CC9 2CC9 01                      DB  01H ;「LD BC,」
002CCA 2CCA 3E01             7  device_io_error:    LD  A,1 ;Device I/O Error
002CCC 2CCC CD792C          17      CALL    fdd_motor_off   ;モータをオフします
002CCF 2CCF ED7BD72C        20      LD  SP,(SPBUFF) ;リターン･スタック･ポインタ
002CD3 2CD3 37               4      SCF
002CD4 2CD4 C9              10      RET
                                
                                
                                ;===============
                                ;内部ワーク
                                ;===============
                                
                                
002CD5 2CD5                     DSERJP: DS  2   ;未使用
002CD7 2CD7                     SPBUFF: DS  2   ;リターン･スタック･ポインタ
002CD9 2CD9                     DSKTRK: DS  4   ;各ユニットのシリンダ･バッファ
                                
                                
                                ;   RUN＆SUBMITルーチン組み込み
                                
                                ;　ファイルの先頭が3000Hで、サイズが7Kバイト（1C00H）
                                ;以内のファイルは、RAMディスク（デバイスE:）に、
                                ;メモリの3000H～4BFFHの内容が待避されます。
                                ;その場合は、RAMディスクのレコード0～13、18～31が使用されます。
                                ;よって、RAMディスクのディレクトリ領域は2レコードしか使えません。
                                ;このことは、RAMディスク（デバイスE:）を64Kバイト以内とみなしています。
                                
001CC0 1CC0                         ORG 1CC0H ; RUN&SUBMITルーチン･エリア
                                
                                
                                ;DOSモジュール、2152H番地よりジャンプしてきます（コマンドの拡張）
       1CC0                     execute_expanded_command:
001CC0 1CC0 FE3B             7      CP  ';' ;REMコマンド
001CC2 1CC2 C8              11      RET Z
001CC3 1CC3 FE50             7      CP  'P' ;ポーズ･コマンド
001CC5 1CC5 2808            12      JR  Z,RSPAU
001CC7 1CC7 FE20             7      CP  ' ' ;RUNコマンド
001CC9 1CC9 2820            12      JR  Z,RUN
001CCB 1CCB 3E0D             7      LD  A,13    ;Syntax Error
001CCD 1CCD 37               4      SCF
001CCE 1CCE C9              10      RET
                                
                                
                                ;モニタ 「;」コマンド処理
       1CCF                     RSPAU:
001CCF 1CCF CDE21F          17      CALL    _MPRNT
001CD2 1CD2 484954204B45590D        DB  'HIT KEY',0DH,00H
            00                  
                                
                                ;   キーがはなされるまで待ちます
001CDB 1CDB CDD01F          17  PAU0:   CALL    _GETKY
001CDE 1CDE B7               4      OR  A
001CDF 1CDF 20FA            12      JR  NZ,PAU0
                                
                                ;   CALL    _INKEY
001CE1 1CE1 CD651E          17      CALL    PAU1    ;バッチ･ファイルなどからキー入力させないため
001CE4 1CE4 FE1B             7      CP  1BH ;ESC
001CE6 1CE6 CADD1D          10      JP  Z,BOFF  ;[BATFLG]をクリアします
001CE9 1CE9 B7               4      OR  A
001CEA 1CEA C9              10      RET
                                
                                
                                ;モニタ Rコマンド処理
                                ;注：DEは、コマンドまたはバッチ変数の次のアドレスを示しています。
       1CEB                     RUN:
001CEB 1CEB 3E01             7      LD  A,1
001CED 1CED CDA31F          17      CALL    _FILE
001CF0 1CF0 1A               7      LD  A,(DE)
001CF1 1CF1 B7               4      OR  A
001CF2 1CF2 2801            12      JR  Z,RUN0
001CF4 1CF4 13               6      INC DE  ;パラメータの区切りをとばします
001CF5 1CF5 D5              11  RUN0:   PUSH    DE
001CF6 1CF6 CD0920          17      CALL    _ROPEN
001CF9 1CF9 DA791D          10      JP  C,BATCH ;ファイル属性が違った（バッチ･ファイル）かも知れない
                                ;   CALL    CMNDQ   ;コマンド･ファイルならRAMディスクにメモリを待避します
001CFC 1CFC                         DS  3,00H
001CFF 1CFF CDA61F          17      CALL    _RDD
001D02 1D02 D1              10      POP DE
001D03 1D03 3806            12      JR  C,RUN1
001D05 1D05 2A6E1F          16      LD  HL,(_EXADR)
001D08 1D08 CD811F          17      CALL    _HL
001D0B 1D0B F5              11  RUN1:   PUSH    AF
001D0C 1D0C 3A331E          13      LD  A,(COMF)    ;メモリ待避フラグ
001D0F 1D0F B7               4      OR  A
001D10 1D10 C4441D          17      CALL    NZ,CWRT ;待避したメモリを元に戻します
001D13 1D13 F1              10      POP AF
001D14 1D14 C9              10      RET
                                
                                
                                ;コマンド･ファイル（先頭3000Hで、サイズ7Kバイト以下）ならRAMディスクにメモリを待避します
                                ;入力   [_DTADR]、[_SIZE]参照
                                ;出力   なし
                                ;破壊   AF，HL，DE，AF'
       1D15                     CMNDQ:
001D15 1D15 AF               4      XOR A
001D16 1D16 32331E          13      LD  (COMF),A    ;メモリ待避フラグ
001D19 1D19 2A701F          16      LD  HL,(_DTADR)
001D1C 1D1C 110030          10      LD  DE,3000H
001D1F 1D1F ED52            15      SBC HL,DE
001D21 1D21 C0              11      RET NZ  ;先頭アドレスが3000H以外だった
                                
                                ;   先頭アドレスが3000H
001D22 1D22 2A721F          16      LD  HL,(_SIZE)
                                ;   LD  DE,-1C00H
001D25 1D25 11FFE3          10      LD  DE,-1C01H   ;深谷崇さんより
001D28 1D28 19              11      ADD HL,DE
001D29 1D29 D8              11      RET C   ;サイズが1C00Hより大きい
                                
                                ;   サイズが7Kバイト（1C00H）以下
                                ;   メモリを待避します
001D2A 1D2A 3A5D1F          13      LD  A,(_DSK)
001D2D 1D2D F5              11      PUSH    AF
001D2E 1D2E CD501D          17      CALL    SET1    ;アクセスするデバイスをRAMディスクにして、メモリ待避用のパラメータ（前半）を得ます
001D31 1D31 CD0320          17      CALL    _DWTSB
001D34 1D34 CD5E1D          17      CALL    SET2    ;メモリ待避用のパラメータ（後半）を得ます
001D37 1D37 CD0320          17      CALL    _DWTSB
001D3A 1D3A F1              10      POP AF
001D3B 1D3B 325D1F          13      LD  (_DSK),A
001D3E 1D3E 3E01             7      LD  A,1
001D40 1D40 32331E          13      LD  (COMF),A    ;メモリ待避フラグ
001D43 1D43 C9              10      RET
                                
                                
                                ;待避したメモリを元に戻します
                                ;入力   なし
                                ;出力   [_DSK]←「E」、HL←3000H、DE←0、Acc←14
                                ;破壊   AF，HL，DE，AF'
       1D44                     CWRT:
001D44 1D44 CD501D          17      CALL    SET1    ;アクセスするデバイスをRAMディスクにして、メモリ待避用のパラメータ（前半）を得ます
001D47 1D47 CD0020          17      CALL    _DRDSB
001D4A 1D4A CD5E1D          17      CALL    SET2    ;メモリ待避用のパラメータ（後半）を得ます
001D4D 1D4D C30020          10      JP  _DRDSB
                                
                                
                                ;アクセスするデバイスをRAMディスクにして、メモリ待避用のパラメータ（前半）を得ます
                                ;入力   なし
                                ;出力   [_DSK]←「E」、HL←3000H、DE←0、Acc←14
                                ;破壊   A，HL，DE
       1D50                     SET1:
001D50 1D50 3E45             7      LD  A,'E'
001D52 1D52 325D1F          13      LD  (_DSK),A
001D55 1D55 210030          10      LD  HL,3000H
001D58 1D58 110000          10      LD  DE,0
001D5B 1D5B 3E0E             7      LD  A,14
001D5D 1D5D C9              10      RET
                                
                                
                                ;メモリ待避用のパラメータ（後半）を得ます
                                ;入力   なし
                                ;出力   HL←3E00H、DE←18、Acc←14
                                ;破壊   A，HL，DE
       1D5E                     SET2:
001D5E 1D5E 21003E          10      LD  HL,3E00H
001D61 1D61 111200          10      LD  DE,18
001D64 1D64 3E0E             7      LD  A,14
001D66 1D66 C9              10      RET
                                
                                
                                ;=======================
                                ;#HOT（1F7EH）のっとり
                                ;=======================
                                
                                
                                ;AUTOEXEC.BATの自動実行
       1D67                     run_auto_execute_batch:
001D67 1D67 21FA1F          10      LD  HL,_HOT
001D6A 1D6A 227E1F          16      LD  (_USR),HL
001D6D 1D6D 113D1E          10      LD  DE,AUTNAM
001D70 1D70 CDCD1F          17      CALL    _BRKEY
001D73 1D73 C4EB1C          17      CALL    NZ,RUN
001D76 1D76 C3FA1F          10      JP  _HOT
                                
                                
                                ;モニタ Rコマンド処理の続き（バッチ･ファイル）
                                ;入力   スタック←ファイル名のあとにあるパラメータのアドレス
                                ;注：
                                ;　バッチ変数があれば、バッチ変数バッファに格納します。
                                ;　DEは、コマンドまたはバッチ変数の次のアドレスを示しています。
       1D79                     BATCH:
                                ;   POP DE  ;DE←パラメータのアドレス
                                ;   CALL    BOFF    ;[BATFLG]をクリアします
                                ;   CP  6   ;ファイル属性の不一致
                                ;   SCF
                                ;   RET NZ
                                
                                ; ; 01H以外のファイル属性のファイル
                                ;   LD  HL,(_IBFAD)
                                ;   LD  A,(HL)  ;Acc←ファイル属性
                                ; ;注：
                                ; ;　ここはソースとコメントのリセットするビットが違います。
                                ; ;ソースはb6（書き込み禁止属性）、コメントはb5（ベリファイON属性）。
                                ;   AND 0BFH    ;「1101 1111」←オリジナルのコメント（多分間違い）
                                ;   CP  4
                                ;   LD  A,6 ;Bad File Mode
                                ;   SCF
                                ;   RET NZ  ;アスキー･ファイルでなかった
                                
                                ; ; アスキー･ファイルだった
                                ;   LD  BC,1EH
                                ;   ADD HL,BC   ;HL←FCBバッファのクラスタ番号の部分
                                ;   CALL    STTRK   ;[BTRK]と[BREC]を設定します
                                ;   CALL    STPARA  ;バッチ変数をバッチ変数バッファを読み込みます
                                ;   LD  A,(_DSK)
                                ;   LD  (BDEV),A    ;バッチ･ファイルのあるデバイス
                                ;   LD  A,16+1
                                ;   LD  (BCNT),A    ;バッチ･ファイルの現在クラスタの残りレコード数＋1
                                ;   XOR A
                                ;   DEC A   ;Acc←FFH
                                ;   LD  (BTPNT),A   ;バッチ･ファイルのバッファの前回のリード位置
                                ;   LD  (BATFLG),A  ;＝FFH（0以外）でバッチ･ファイル実行中
001D79 1D79 C9              10      RET
                                
                                
                                ;[BTRK]と[BREC]を設定します
                                ;入力   [HL]←クラスタ番号
                                ;出力   [BTRK]←クラスタ番号、[BREC]←レコード番号
                                ;破壊   AF，HL
       1D7A                     STTRK:
001D7A 1D7A 7E               7      LD  A,(HL)  ;Acc←クラスタ番号
001D7B 1D7B 32351E          13      LD  (BTRK),A    ;バッチ･ファイルの現在クラスタ番号
001D7E 1D7E 6F               4      LD  L,A
001D7F 1D7F 2600             7      LD  H,0 ;HL←クラスタ番号
001D81 1D81 29              11      ADD HL,HL
001D82 1D82 29              11      ADD HL,HL
001D83 1D83 29              11      ADD HL,HL
001D84 1D84 29              11      ADD HL,HL   ;HL←クラスタ番号×16
001D85 1D85 22361E          16      LD  (BREC),HL   ;バッチ･ファイルのあるレコード番号
001D88 1D88 C9              10      RET
                                
                                
                                ;バッチ変数をバッチ変数バッファを読み込みます
                                ;入力   DE←パラメータのアドレス
                                ;出力   [BPRBF～]←バッチ変数
                                ;破壊   AF，HL，DE，BC
       1D89                     STPARA:
                                ;   バッチ変数バッファをクリアします
                                ;   LD  HL,BPRBF    ;バッチ変数バッファ
                                ;   LD  (HL),0
                                ;   PUSH    DE
                                ;   PUSH    HL
                                ;   LD  D,H
                                ;   LD  E,L
                                ;   INC DE  ;DE←BPRBF＋1
                                ;   LD  BC,179
                                ;   LDIR        ;[BPRBF～BPRBF＋179]をクリア
                                ;   POP HL  ;HL←BPRBF
                                ;   POP DE  ;DE←パラメータのアドレス
                                
                                ;   LD  A,(DE)  ;Acc←パラメータの先頭
                                ;   CP  ':'
                                ;   JR  NZ,STP0
                                ;   INC DE  ;「:」をスキップ
                                ; STP0: LD  C,9 ;バッチ変数は￥1～￥9の9個
                                
                                ; STPAR0:   LD  B,19    ;バッチ変数1個につき20バイト
                                
                                ; ; バッチ変数をバッチ変数バッファに転送します
                                ; STPAR1:   LD  A,(DE)
                                ;   OR  A
                                ;   RET Z
                                ;   CP  ' ' ;バッチ変数の区切り
                                ;   JR  Z,STPAR3    ;区切りに達した
                                ;   LD  (HL),A
                                ;   INC HL
                                ;   INC DE
                                ;   DJNZ    STPAR1
                                
                                ; STPAR2:   INC HL
                                ;   DEC C
                                ;   JR  NZ,STPAR0
                                
001D89 1D89 C9              10      RET
                                
                                ;   アドレスをスキップします
                                ; STPAR3:   INC DE
                                ; STPAR4:   INC HL
                                ;   DJNZ    STPAR4
                                ;   JR  STPAR2
                                
                                
                                ;バッチ･ファイルから1文字を得ます
                                ;入力   なし
                                ;出力   CY＝0ならバッチ･ファイル実行中でAcc←キャラ
                                ;   CY＝1ならバッチ･ファイル実行中でないか、バッチ変数￥0が来た
                                ;破壊   AF，AF'
       1D8A                     BGET:
001D8A 1D8A 3A3B1E          13      LD  A,(BATFLG)  ;＝FFH（0以外）でバッチ･ファイル実行中
001D8D 1D8D B7               4      OR  A
001D8E 1D8E 37               4      SCF
001D8F 1D8F C8              11      RET Z
                                
                                ;   バッチ･ファイル実行中
001D90 1D90 C5              11      PUSH    BC
001D91 1D91 E5              11      PUSH    HL
001D92 1D92 3A3C1E          13      LD  A,(PARAF)   ;＝1（0以外）でバッチ変数アクセス中
001D95 1D95 B7               4      OR  A
001D96 1D96 280A            12      JR  Z,BGET0 ;バッチ変数アクセス中でない
                                
                                ;   バッチ変数アクセス中
001D98 1D98 2A391E          16  BPARA:  LD  HL,(BTPNT2) ;バッチ変数の現在アドレス
001D9B 1D9B 7E               7      LD  A,(HL)
001D9C 1D9C B7               4      OR  A
001D9D 1D9D 2016            12      JR  NZ,BPARA0   ;バッチ変数の終わりに達していない
                                
                                ;   バッチ変数の終わりに達した（[PARAF]のクリア）
001D9F 1D9F 323C1E          13      LD  (PARAF),A   ;＝1（0以外）でバッチ変数アクセス中
                                
                                ;   バッチ･ファイルから1バイト取り出します
001DA2 1DA2 CDC21D          17  BGET0:  CALL    get_one_byte_fro_batch_file ;バッチ･ファイルから1バイト取り出します
001DA5 1DA5 B7               4      OR  A
001DA6 1DA6 2813            12      JR  Z,BEND  ;バッチ･ファイルからリード終了
001DA8 1DA8 FE5C             7      CP  '\\'    ;バッチ変数
001DAA 1DAA 2005            12      JR  NZ,BGET1
                                
                                ;   バッチ変数
001DAC 1DAC CDDC1D          17      CALL    PARAQ   ;バッチ変数のアクセスを設定
001DAF 1DAF 30E7            12      JR  NC,BPARA    ;バッチ変数だった
                                
                                ;   リターンします（Acc←キャラ）
001DB1 1DB1 B7               4  BGET1:  OR  A   ;CY←0
001DB2 1DB2 E1              10      POP HL
001DB3 1DB3 C1              10      POP BC
001DB4 1DB4 C9              10      RET
                                
                                ;   バッチ変数バッファより1バイト取り出してリターンします
001DB5 1DB5 23               6  BPARA0: INC HL
001DB6 1DB6 22391E          16      LD  (BTPNT2),HL ;バッチ変数の現在アドレス
001DB9 1DB9 18F6            12      JR  BGET1
                                
                                ;   バッチ･ファイルを終わります
                                ;出力   CY←1、Acc←0
001DBB 1DBB CDDD1D          17  BEND:   CALL    BOFF    ;[BATFLG]をクリアします
001DBE 1DBE 37               4      SCF
001DBF 1DBF E1              10      POP HL
001DC0 1DC0 C1              10      POP BC
001DC1 1DC1 C9              10      RET
                                
                                
                                ;バッチ･ファイルから1バイト取り出します
                                ;入力   なし
                                ;出力   Acc←キャラ
                                ;   Acc＝0なら、バッチ･ファイルから読み込めなかった
                                ;破壊   AF，HL，AF'
       1DC2                     get_one_byte_fro_batch_file:
                                ;   CALL    _BRKEY
                                ;   LD  A,0
                                ;   RET Z   ;ブレイク･キーを押されていた
                                
                                ;   LD  HL,BTPNT    ;バッチ･ファイルのバッファの前回のリード位置
                                ;   INC (HL)
                                ;   JR  NZ,read_one_byte_from_buffer_of_batch_file  ;バッチ･ファイルのバッファから読み込み可能
                                
                                ; ; バッチ･ファイルのリード･バッファが空
                                ;   LD  HL,BCNT ;バッチ･ファイルの現在クラスタの残りレコード数＋1
                                ;   DEC (HL)
                                ;   JR  NZ,read_next_record_from_batch_file ;次のレコードを読みます
                                
                                ; ; 次のクラスタを読みます
                                ;   LD  (HL),16 ;[BCNT]←16
                                ;   PUSH    DE
                                ;   LD  DE,(_FATPS)
                                ;   LD  HL,BATBF    ;バッチ･ファイル用リード･バッファ（2D00H～2DFFH）
                                ;   CALL    RSREAD  ;バッチ･ファイルを読みます
                                ;   JR  C,error_read_from_buffer_of_batch_file  ;リード･エラー
                                ;   LD  A,(BTRK)    ;バッチ･ファイルの現在クラスタ番号
                                ;   LD  E,A
                                ;   LD  D,0 ;DE←バッチ･ファイルの現在クラスタ番号
                                ;   ADD HL,DE   ;HL←バッチ･ファイルのバッファの次のクラスタ番号の部分
                                ;   CALL    STTRK   ;[BTRK]と[BREC]を設定します
                                ;   POP DE
                                
                                ; ; 次のレコードを読みます
                                ; read_next_record_from_batch_file:
                                ;   PUSH    DE
                                ;   LD  DE,(BREC)   ;バッチ･ファイルの現在レコード番号
                                ;   LD  HL,BATBF    ;バッチ･ファイル用リード･バッファ（2D00H～2DFFH）
                                ;   CALL    RSREAD  ;バッチ･ファイルを読みます
                                ;   JR  C,error_read_from_buffer_of_batch_file  ;リード･エラー
                                ;   INC DE
                                ;   LD  (BREC),DE   ;バッチ･ファイルの現在レコード番号
                                ;   POP DE
                                
                                ; ; バッチ･ファイルのバッファより、1バイト取り出します
                                ; read_one_byte_from_buffer_of_batch_file:
                                ;   LD  HL,(BTPNT)  ;バッチ･ファイルのバッファの前回のリード位置
                                ;   LD  A,(HL)
001DC2 1DC2 C9              10      RET
                                
                                ;   バッチ･ファイルから読み込めなかった
       1DC3                     error_read_from_buffer_of_batch_file:
001DC3 1DC3 D1              10      POP DE
001DC4 1DC4 AF               4      XOR A   ;Acc←0
001DC5 1DC5 C9              10      RET
                                
                                
                                ;バッチ･ファイルを読みます
                                ;入力   HL←読み込みアドレス、DE←レコード番号
                                ;出力   CY＝1（Acc←エラー･コード）ならエラー
                                ;破壊   AF，AF'
       1DC6                     RSREAD:
001DC6 1DC6 3A5D1F          13      LD  A,(_DSK)
001DC9 1DC9 F5              11      PUSH    AF  ;スタック←もとのデバイス
001DCA 1DCA 3A341E          13      LD  A,(BDEV)    ;バッチ･ファイルのあるデバイス
001DCD 1DCD 325D1F          13      LD  (_DSK),A    ;一時的にバッチ･ファイルのデバイスに
001DD0 1DD0 3E01             7      LD  A,1 ;1レコード
001DD2 1DD2 CD0020          17      CALL    _DRDSB
001DD5 1DD5 08               4      EX  AF,AF'
001DD6 1DD6 F1              10      POP AF  ;Acc←もとのデバイス
001DD7 1DD7 325D1F          13      LD  (_DSK),A    ;デバイスをもとに戻します
001DDA 1DDA 08               4      EX  AF,AF'
001DDB 1DDB C9              10      RET
                                
                                
                                ;バッチ変数のアクセスを設定
                                ;入力   なし
                                ;出力   CY＝1ならバッチ変数でなかった（Acc←キャラ）
                                ;破壊   AF，HL，BC，AF'
       1DDC                     PARAQ:
                                ;   CALL    get_one_byte_fro_batch_file ;バッチ･ファイルから1バイト取り出します
                                ;   CP  '0'
                                ;   RET C
                                ;   CP  '9'+1
                                ;   CCF
                                ;   RET C
                                
                                ; ; バッチ変数￥0～￥9
                                ;   SUB '0'
                                ;   JR  Z,PAR00 ;「\0」だった
                                
                                ; ; バッチ変数￥1～￥9
                                ;   LD  L,A
                                ;   LD  H,0 ;HL←1～9
                                ;   ADD HL,HL
                                ;   ADD HL,HL   ;HL←(1～9)×4
                                ;   LD  B,H
                                ;   LD  C,L ;BC←(1～9)×4
                                ;   ADD HL,HL
                                ;   ADD HL,HL   ;HL←(1～9)×16
                                ;   ADD HL,BC   ;HL←(1～9)×20
                                ;   LD  BC,BPRBF-20 ;バッチ変数バッファ
                                ;   ADD HL,BC   ;HL←バッチ変数に対応するバッファのアドレス
                                ;   LD  (BTPNT2),HL ;バッチ変数の現在アドレス
                                ;   XOR A   ;CY←0
                                ;   INC A   ;Acc←1
                                ;   LD  (PARAF),A   ;＝1（0以外）でバッチ変数アクセス中
                                ;   RET
                                
                                ; ; バッチ変数￥0（BGETルーチンを呼び出したルーチンにCY＝1で戻ります）
                                ; PAR00:    CALL    get_one_byte_fro_batch_file ;バッチ･ファイルから1バイト取り出します
                                ;   OR  A
                                ;   JR  Z,PAR01
                                ;   CP  0DH ;RET
                                ;   JR  NZ,PAR00    ;CRコードのスキップ
                                ; PAR01:    POP HL  ;戻り番地のキャンセル
                                
                                ; ; BGETルーチンのスタックに保存したレジスタをもとに戻します
                                ;   POP HL
                                ;   POP BC
                                
                                ;   CALL    _BELL
                                ;   SCF
001DDC 1DDC C9              10      RET
                                
                                
                                ;[BATFLG]をクリアします
                                ;破壊   なし
       1DDD                     BOFF:
001DDD 1DDD F5              11      PUSH    AF
001DDE 1DDE AF               4      XOR A
001DDF 1DDF 323B1E          13      LD  (BATFLG),A  ;＝FFH（0以外）でバッチ･ファイル実行中
001DE2 1DE2 F1              10      POP AF
001DE3 1DE3 C9              10      RET
                                
                                
                                ;===============================
