                                ;=======================================
                                ;フィジカル･ルーチン･プリンタ関係
                                ;=======================================
                                
                                
                                ;プリンタ出力モードをオンします
                                ;入力   なし
                                ;出力   [_LPSW]←1
                                ;破壊   AF，HL，DE，BC
                                ;注：旧X1版SWORDと同じく、[#LPSW]に1を書きます。
       0AC2                     printer_output_mode_on_entity:
000AC2 0AC2 3E01             7      LD  A,1
000AC4 0AC4 327C1F          13      LD  (_LPSW),A
                                
                                ;   #PRINT（1FF4H）のため'
000AC7 0AC7 21D90A          10      LD  HL,LPPR
000ACA 0ACA 22F51F          16      LD  (_PRINT+1),HL
000ACD 0ACD 21D90A          10      LD  HL,LPPR
000AD0 0AD0 228C1F          16      LD  (BPRNT+1),HL
                                
000AD3 0AD3 C9              10      RET
                                
                                
                                ;プリンタ出力モードをオフします
                                ;入力   なし
                                ;出力   [_LPSW]←0
                                ;破壊   AF，HL，DE，BC
       0AD4                     printer_output_mode_off_entity:
000AD4 0AD4 AF               4      XOR A
000AD5 0AD5 327C1F          13      LD  (_LPSW),A
                                
                                ;   #PRINT（1FF4H）のため'
                                    ; LD    HL,PRINT
                                    ; LD    (_PRINT+1),HL
                                    ; LD    HL,BPRNT0
                                    ; LD    (BPRNT+1),HL
                                
000AD8 0AD8 C9              10      RET
                                
                                
                                ;1文字プリント前処理
       0AD9                     LPREB:
                                    ; PUSH  HL
                                    ; LD    HL,PRINT
                                    ; LD    (_PRINT+1),HL
                                    ; LD    HL,BPRNT0
                                    ; LD    (BPRNT+1),HL
                                    ; POP   HL
                                ;   JP  LPPR
                                
                                
                                ;#LPSW（1F7CH）がオンなら、通常表示ルーチンと置き代わります
       0AD9                     LPPR:
000AD9 0AD9 CD3C0C          17      CALL    PRINT
000ADC 0ADC F5              11      PUSH    AF
                                    ; CALL  _LPRNT
000ADD 0ADD F1              10      POP AF
000ADE 0ADE C9              10      RET
                                
                                
                                ;===============================
                                ;フィジカル･ルーチン補助
                                ;===============================
                                
                                
                                ;1行入力します
                                ;入力   DE←バッファのアドレス
                                ;出力   [DE～]←入力文字列
                                ;   カーソルを論理的に綱がっている最後の物理行へ
                                ;破壊   AF，HL，DE，BC
                                ;注：
                                ; 文字列の最後には00Hが入ります。
                                ; バッファは256バイトまで使用します。
       0ADF                     INPUTL:
000ADF 0ADF D5              11      PUSH    DE  ;スタック←入力バッファ
                                
                                ;   一時バッファのクリア
000AE0 0AE0 210001          10      LD  HL,BUFFER
000AE3 0AE3 110101          10      LD  DE,BUFFER+1
000AE6 0AE6 01FF00          10      LD  BC,255
000AE9 0AE9 70               7      LD  (HL),B
000AEA 0AEA EDB0                    LDIR
                                
                                ;   読み出しアドレスの設定
                                ;出力   DE←現在行の行頭のカーソル･オフセット、BC←現在行の最大文字数
000AEC 0AEC CD450B          17      CALL    get_Y_top_of_logical_line   ;論理行頭の座標を得ます
000AEF 0AEF CD4D0B          17      CALL    get_offset_from_cursor_XY
000AF2 0AF2 EB               4      EX  DE,HL   ;DE←現在行の行頭のカーソル･オフセット
000AF3 0AF3 CD4C0B          17      CALL    get_Y_next_logical_line ;次の論理行の座標を得ます
000AF6 0AF6 25               4      DEC H
000AF7 0AF7 CD1E20          17      CALL    _LOC    ;カーソルを論理的に綱がっている最後の物理行へ
000AFA 0AFA 24               4      INC H
000AFB 0AFB CD4D0B          17      CALL    get_offset_from_cursor_XY
000AFE 0AFE B7               4      OR  A
000AFF 0AFF ED52            15      SBC HL,DE
000B01 0B01 4D               4      LD  C,L
000B02 0B02 44               4      LD  B,H ;BC←現在行の最大文字数
                                
                                ;   一時バッファへ転送します
                                ;入力   DE←現在行の行頭のカーソル･オフセット、BC←現在行の最大文字数
000B03 0B03 78               4      LD  A,B
000B04 0B04 B7               4      OR  A
000B05 0B05 2803            12      JR  Z,$+5
000B07 0B07 01FF00          10      LD  BC,255
000B0A 0B0A 210001          10      LD  HL,BUFFER
                                    ; CALL  INVRM
                                
                                ;   ターミネート処理
                                ; 後ろの00H～20Hの文字は00Hに変換します。
000B0D 0B0D 210002          10      LD  HL,BUFFER+100H
000B10 0B10 010000          10      LD  BC,0    ;B←ループ･カウンタ256，C←ターミネータ00H
000B13 0B13 2B               6  INLLP1: DEC HL
000B14 0B14 7E               7      LD  A,(HL)
000B15 0B15 FE21             7      CP  21H
000B17 0B17 3003            12      JR  NC,INL1ES   ;21H～の文字を発見しました
000B19 0B19 71               7      LD  (HL),C
000B1A 0B1A 10F7            13      DJNZ    INLLP1
       0B1C                     INL1ES:
                                
                                ;   入力バッファに転送します
000B1C 0B1C 210001          10      LD  HL,BUFFER
000B1F 0B1F D1              10      POP DE  ;DE←入力バッファ
000B20 0B20 7E               7  INLLP2: LD  A,(HL)
000B21 0B21 23               6      INC HL
000B22 0B22 12               7      LD  (DE),A
000B23 0B23 13               6      INC DE
000B24 0B24 B7               4      OR  A
000B25 0B25 20F9            12      JR  NZ,INLLP2
                                
000B27 0B27 C33D0B          10      JP  SETPRN
                                
                                
                                ;=======================
                                ;1文字表示ルーチン
                                ;=======================
                                
                                
                                ;^R インサート･モードのオン／オフ
       0B2A                     control_code_INS:
000B2A 0B2A C9              10      RET
                                
                                
                                ;^＠ 何もしません
       0B2B                     control_code_NULL:
