002195 2195 3E01             7      LD  A,1
002197 2197 CDA31F          17      CALL    _FILE
00219A 219A 1A               7      LD  A,(DE)
00219B 219B FE3A             7      CP  ':'
00219D 219D 203E            12      JR  NZ,SNERR
00219F 219F 13               6      INC DE
                                
0021A0 21A0 CDB21F          17      CALL    _HLHEX
0021A3 21A3 3838            12      JR  C,SNERR
0021A5 21A5 22701F          16      LD  (_DTADR),HL ;先頭アドレス
