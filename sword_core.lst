000A72 0A72 44               4      LD  B,H ;BC←転送バイト数
000A73 0A73 2ABC0A          16      LD  HL,(next_cursor_offset_top_of_next_logical_line)
000A76 0A76 EB               4      EX  DE,HL   ;HL←[line_length]，DE←[next_cursor_offset_top_of_next_logical_line]
000A77 0A77 19              11      ADD HL,DE
000A78 0A78 EB               4      EX  DE,HL   ;HL←転送元，DE←転送先
                                    ; CALL  VBTRNS
                                
                                ;   新行を書き込みます
000A79 0A79 2ABC0A          16  write_new_line: LD  HL,(next_cursor_offset_top_of_next_logical_line)
