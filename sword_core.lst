000CFE 0CFE 84               4      ADD A,H
000CFF 0CFF 47               4      LD  B,A ;BC←テキストVRAMアドレス
000D00 0D00 C9              10      RET
                                
                                
                                ;=======================
                                ;CRTC（機種固有）
                                ;=======================
                                
                                
                                ;CRTCのレジスタにデータを書き込みます
