                                ;モニタ処理
                                ;===============
                                
                                
       2100                     sos_monitor:
002100 2100 ED7B6C1F        20      LD  SP,(_STKAD)
002104 2104 CDD61F          17      CALL    _LPTOF
002107 2107 3E23             7      LD  A,'#'
002109 2109 CDF41F          17      CALL    _PRINT
00210C 210C ED5B761F        20      LD  DE,(_KBFAD)
