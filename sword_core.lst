00215A 215A 13               6      INC DE
00215B 215B FE54             7      CP  'T'
00215D 215D CA4322          10      JP  Z,MSET  ;モニタ STコマンド処理
002160 2160 1B               6      DEC DE
002161 2161 C39221          10      JP  SAVE    ;モニタ Sコマンド処理
                                
                                
                                ;モニタ Dxコマンド処理
       2164                     CMDSB2:
