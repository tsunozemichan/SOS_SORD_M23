                                ;-----------------------
                                ;フィジカル･ルーチン
                                ;-----------------------
                                
                                
                                ;===============================
                                ;フィジカル･ルーチン表示関係
                                ;===============================
                                
                                
                                ;1文字入力ルーチン（入力待ちあり、エコー･バックあり、カーソル表示あり）
                                ;入力   なし
                                ;出力   Acc←文字
                                ;破壊   AF，HL，DE，BC
       0954                     input_one_character_entity:
000954 0954 CD8F0C          17      CALL    display_cursor
000957 0957 CDCA1F          17      CALL    _INKEY
00095A 095A F5              11      PUSH    AF
