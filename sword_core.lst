                                ;出力   CY＝1でエラー
       211B                     sos_monitor_command_routine:
00211B 211B 1A               7      LD  A,(DE)
00211C 211C FE23             7      CP  '#'
00211E 211E 2802            12      JR  Z,$+4
002120 2120 B7               4      OR  A
002121 2121 C9              10      RET
