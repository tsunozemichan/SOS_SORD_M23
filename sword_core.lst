                                ;=======================================
                                ;フィジカル･ディスクI／Oエントリ
                                ;=======================================
                                ;注：本体は、サイズが大きいため、メイン部後ろ移転しました。
                                
                                
                                ;   2D00H～2DFFHはバッチ･ファイル読み込みバッファ
                                
                                
002D00 2D00                         ORG 2D00H
                                ;=======================
                                ;ブート･プログラム
                                ;=======================
                                
                                
       2D00                     START:
002D00 2D00 F3               4      DI
002D01 2D01 3100F9          10      LD  SP,F900H    ;仮スタック
                                
                                ;   vram_address_of_topの初期化
002D04 2D04 2100F8          10      LD  HL,F800H ; SORD M23のTXT VRAMの先頭アドレス
002D07 2D07 22F004          16      LD  (vram_address_of_top),HL
                                
                                ;   デフォルト･ドライブの設定
                                    ; LD    A,(0FF87H)  ;立ち上がったドライブ番号（下位ニブル）
                                    ; AND   1111B
                                    ; CP    4
                                    ; JR    NC,STADVS
                                    ; ADD   A,'A'   ;Acc←立ち上がったドライブ名
                                    ; LD    (_DFDV),A   ;デフォルト･ドライブ
       2D0A                     STADVS:
                                
                                ;   [vram_size]の設定（VRAMのサイズ÷100H）
                                ;〈VRAMのサイズ〉
                                ;00C000Hバイト
002D0A 2D0A 212000          10      LD  HL,0020H    ;002000H
002D0D 2D0D 220605          16      LD  (vram_size),HL
                                
                                ;   [top_of_special_work_of_vram]の設定（VRAM上の特殊ワークの先頭÷100H）
                                ;〈VRAM特殊ワークの先頭アドレス〉
                                ;004000H番地
002D10 2D10 210000          10      LD  HL,0000H    ;004000H
002D13 2D13 220805          16      LD  (top_of_special_work_of_vram),HL
                                
                                ;   [size_of_special_work_of_vram]の設定（VRAM上の特殊ワークのサイズ÷100H）
                                ;〈VRAM特殊ワークのサイズ〉
                                ;4000Hバイト
002D16 2D16 3E00             7      LD  A,00H   ;4000H
002D18 2D18 320A05          13      LD  (size_of_special_work_of_vram),A
                                
                                ;   [top_of_ram_disk_of_vram]の設定（VRAM上のRAMディスクの先頭÷100H）
                                ;〈VRAM上のRAMディスクの先頭〉
                                ;008000H番地
                                    ; LD    HL,0000H    ;008000H
                                    ; LD    (top_of_ram_disk_of_vram),HL
                                
                                ;   [size_of_ram_disk_of_vram]の設定（VRAM上のRAMディスクのサイズ÷100H）
                                ;〈VRAM上のRAMディスクのサイズ〉
                                ;008000Hバイト
                                    ; LD    HL,0000H    ;008000H
                                    ; LD    (size_of_ram_disk_of_vram),HL
                                
                                ;   [top_of_special_work_of_memory]、[size_of_special_work_of_memory]の設定
                                ;〈メモリ特殊ワークの先頭とサイズ〉
                                ;使用しません
002D1B 2D1B 3E00             7      LD  A,00H   ;0000H
002D1D 2D1D 320F05          13      LD  (top_of_special_work_of_memory),A
002D20 2D20 3E00             7      LD  A,00H   ;0000H
002D22 2D22 321005          13      LD  (size_of_special_work_of_memory),A
                                
                                ;   コールド･スタートします
002D25 2D25 2100F9          10      LD  HL,F900H    ;仮スタック
002D28 2D28 226C1F          16      LD  (_STKAD),HL
002D2B 2D2B 21FD1F          10      LD  HL,_COLD
002D2E 2D2E 220100          16      LD  (0001H),HL
002D31 2D31 226700          16      LD  (0067H),HL
                                    ; JP    0000H
002D34 2D34 C32006          10      JP COLD
