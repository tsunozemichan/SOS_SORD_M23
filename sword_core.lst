0021AB 21AB 13               6      INC DE  ;「:」をスキップ
                                
0021AC 21AC CDB21F          17      CALL    _HLHEX
0021AF 21AF 382C            12      JR  C,SNERR
0021B1 21B1 D5              11      PUSH    DE
0021B2 21B2 ED5B701F        20      LD  DE,(_DTADR)
0021B6 21B6 B7               4      OR  A
