000A65 0A65 2AC00A          16      LD  HL,(offset_plus_one_cursor_XY)
000A68 0A68 B7               4      OR  A
000A69 0A69 ED52            15      SBC HL,DE
000A6B 0A6B ED5BB40A        20      LD  DE,(line_length)
                                ;   OR  A
000A6F 0A6F ED52            15      SBC HL,DE
