002168 2168 13               6      INC DE
002169 2169 FE56             7      CP  'V'
00216B 216B CA5C22          10      JP  Z,DEVST ;モニタ DVコマンド処理
00216E 216E 1B               6      DEC DE
00216F 216F C38521          10      JP  MDIR    ;モニタ Dコマンド処理
                                
                                
