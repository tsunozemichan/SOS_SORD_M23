002133 2133 CAE121          10      JP  Z,LOAD  ;ロード
002136 2136 FE4B             7      CP  'K'
002138 2138 CA3822          10      JP  Z,MKILL ;デリート
00213B 213B FE4E             7      CP  'N'
00213D 213D CA7122          10      JP  Z,MNAME ;リネーム
002140 2140 FE4D             7      CP  'M'
002142 2142 CA8221          10      JP  Z,DOSMON    ;モニタ
002145 2145 FE57             7      CP  'W'
002147 2147 CA8222          10      JP  Z,MWIDTH    ;表示桁
00214A 214A FE53             7      CP  'S'
