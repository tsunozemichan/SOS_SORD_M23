                                ;*** AILZ80ASM *** Z-80 Assembler, version 1.0.27.0, LST:Full:4
                                ;〈注意〉
                                ; テープはサポートしません。
                                ; #PRCNT（1F7AH）はサポートしません。
                                
                                ; ; ＤＯＳモジュール内部エントリ
                                ; ERROR EQU 286CH
                                
                                ;   バッチ処理バッファ
                                ; BATBF EQU 2D00H   ;バッチ･ファイル用リード･バッファ（2D00H～2DFFH）
                                ; BPRBF EQU 204BH   ;バッチ変数バッファ（204BH～20FEH）
                                
                                
                                ;
                                ; CRTC ports
                                ;
       F800                     VRAM_TXT_TOP EQU 0F800H ; VRAM上で画面左上を指すアドレス
       F000                     VRAM_ATR_TOP EQU 0F000H ; アトリビュートの先頭アドレス
       00F0                     CRTC_ADD EQU 0F0H ; CRTCアドレス･ポート
       00F1                     CRTC_VAL EQU 0F1H ; CRTCデータ･ポート
       0050                     WIDTH_SCREEN EQU 50H ; 80文字モードの1行のバイト数
       FF00                     CURSOR_XY_ADDR EQU FF00H ; カーソルのX,Y座標を保存するアドレス
                                
                                ; Ascii code Constants
       000D                     CR  EQU 0DH ; Carriage Return
       000A                     LF  EQU 0AH ; Line Feed
       0008                     BS  EQU 08H ; Back Space
       007F                     DEL EQU 7FH ; Delete
       0009                     HT  EQU 09H ; Horizontal Tab
       000B                     VT  EQU 0BH ; Vertical Tab
       0007                     BEL EQU 07H ; Bell
       000C                     NP  EQU 0CH ; Formfeed (also: New page NP)
       001B                     ESC EQU 1BH ; Escape
                                
                                ;〈SLANGについて〉
                                ; SLANGは、特殊ワークのサイズによっては動作しません。
                                ;SLANGの3014H～3015H番地の内容が、
                                ;特殊ワーク上の大局テーブルの先頭アドレスをさしているので、
                                ;特殊ワークのサイズのために動かない場合は、
                                ;若い番地へ移動して対応してください。
                                
000000 0000                         ORG 0000H
000000 0000 C3002D          10      JP  START   ;初期化
000066 0066                         ORG 0066H
000066 0066 C3002D          10      JP  START   ;NMIでリスタート
                                
000100 0100                         ORG 0100H
                                
                                
                                ;=======================
                                ;汎用バッファ
                                ;=======================
                                
                                
                                ;   0100H（256バイト）
000100 0100                     BUFFER: DS  256
                                
                                
                                ;=======================
                                ;文字列入力バッファ
                                ;=======================
                                
                                
                                ;   0100Hバイト
000200 0200                     keyboard_buffer:    DS  256
                                
                                
                                ;=======================
                                ;キー入力バッファ
                                ;=======================
                                
                                
                                ;   0080H（128バイト）
000300 0300                     input_key_buffer:   DS  127 ;キー入力バッファ（127文字分）
00037F 037F                     pointer_for_write_key_buffer:   DS  1   ;キーを書き込むポインタ（＝0でカラ、＝7FHでいっぱい）
                                
                                ;=======================================
                                ;コントロール･コード･ジャンプ･テーブル
                                ;=======================================
                                
                                
                                ;   0040H（64バイト）
       0380                     control_code_jump_tabel:
000380 0380 2B0B                    DW  control_code_NULL   ;^＠
000382 0382 3C0B                    DW  CTL01               ;^A 'カーソルを論理行頭へ（-^V）
000384 0384 2B0B                    DW  control_code_NULL   ;^B '前のワードの先頭へ（－^F） '非サポート
000386 0386 370B                    DW  CTLCAN              ;^C ^STOP（論理改行＆インサート解除）
000388 0388 3A0B                    DW  control_code_DELETEL;^D '論理行のカーソル位置の文字の削除（DELキー）
00038A 038A 3B0B                    DW  CTL05               ;^E '論理行のカーソル以降削除（－^U）
00038C 038C 2B0B                    DW  control_code_NULL   ;^F '次のワードの先頭へ（－^B） '非サポート
00038E 038E DA07                    DW  BELL                ;^G BELL
000390 0390 390B                    DW  control_code_BS     ;^H BS
000392 0392 2C0B                    DW  control_code_TAB    ;^I TAB
000394 0394 2B0B                    DW  control_code_NULL   ;^J LF
000396 0396 300B                    DW  control_code_HOME   ;^K HOME
000398 0398 2D0B                    DW  control_code_CLS    ;^L CLR
00039A 039A 380B                    DW  CTLCR               ;^M CR＋LF
00039C 039C 2B0B                    DW  control_code_NULL   ;^N '論理行分割（－^W） '非サポート
00039E 039E 2B0B                    DW  control_code_NULL   ;^O '物理行注入（－^Y） '非サポート
0003A0 03A0 2B0B                    DW  control_code_NULL   ;^P
0003A2 03A2 2B0B                    DW  control_code_NULL   ;^Q
0003A4 03A4 2A0B                    DW  control_code_INS    ;^R INS
0003A6 03A6 350B                    DW  control_code_ROLL_UP    ;^S 'スクロール･アップ（－^S）
0003A8 03A8 360B                    DW  control_code_ROLL_DOWN  ;^T 'スクロール･ダウン（－^T）
0003AA 03AA 2B0B                    DW  control_code_NULL   ;^U '論理行のカーソルより前削除（－^E） '非サポート
0003AC 03AC 2B0B                    DW  control_code_NULL   ;^V 'カーソルを論理行末へ（－^A、最後の文字の次のカーソル位置) '非サポート
0003AE 03AE 2B0B                    DW  control_code_NULL   ;^W '次の行と連結（－^N、,論理行末と次の行の行頭をつなぐ) '非サポート
0003B0 03B0 2B0B                    DW  control_code_NULL   ;^X SELECT
0003B2 03B2 2B0B                    DW  control_code_NULL   ;^Y '物理行削除（－^O） '非サポート
0003B4 03B4 2B0B                    DW  control_code_NULL   ;^Z
0003B6 03B6 370B                    DW  CTLCAN              ;^［ ESC
0003B8 03B8 310B                    DW  control_code_Right  ;^￥ →
0003BA 03BA 320B                    DW  control_code_Left   ;^］ ←
0003BC 03BC 330B                    DW  control_code_Up     ;^＾ ↑
0003BE 03BE 340B                    DW  control_code_Down   ;^＿ ↓
                                
                                
                                ;=======================================
                                ;カーソル･オフセット計算用テーブル下位
                                ;=======================================
                                ;y座標に対応するカーソル･オフセットを得ます
                                ;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]
                                
                                
                                ;   0020H（32バイト）
0003C0 03C0                     cursor_offset_for_Y_table:  DS  32
                                
                                
                                ;===============================
                                ;システム･スタック･エリア
                                ;===============================
                                
                                
                                ;   00CCH（204バイト）
0003E0 03E0                         DS  256-52
       04AC                     system_stack_area:
                                
                                
                                ;*******    256バイト境界   ********
                                
                                
                                ;=======================================
                                ;カーソル･オフセット計算用テーブル上位
                                ;=======================================
                                ; y座標に対応するカーソル･オフセットを得ます。
                                ;カーソル･オフセット←[cursor_offset_for_Y_table＋256＋y座標]×256＋[cursor_offset_for_Y_table＋y座標]
                                
                                
                                ;   0020H（32バイト）
0004AC 04AC                         DS  32
                                
                                
                                ;=======================
                                ;内部ワーク･エリア
                                ;=======================
                                
                                
                                ;   0050H（80バイト）
0004CC 04CC                     fcb_buffer: DS  32  ;S-OSのFCBバッファ（[_IBFAD]でポイント）
                                
                                ;   通常（42バイト）
0004EC 04EC                     total_number_of_character_display:  DS  2   ;画面の表示文字数
0004EE 04EE                     cursor_offset_last_top_of_line: DS  2   ;最終行先頭のカーソル･オフセット
0004F0 04F0                     vram_address_of_top:    DS  2   ;テキストVRAM先頭アドレス（未使用の場合あり）
0004F2 04F2                     vram_address_of_top_of_last_line:   DS  2   ;最終行先頭のテキストVRAMアドレス（未使用の場合あり）
0004F4 04F4                     locate_of_cursor_overlap_character: DS  1   ;カーソルと重なった位置の文字の保存（未使用の場合あり）
0004F5 04F5                     screen_width:   DS  1   ;＝00Hで40桁、＝FFHで80桁 -> M23では80桁固定なので、常にscreen_width=FFHとなる。
0004F6 04F6                     CSRADD: DS  2   ;（行数－1）×256＋桁数
0004F8 04F8                     CSRNXI: DS  1   ;256－桁数 '[CSRNX]の初期値 -> M23では桁数80固定なので、CSRNXI=CSRNXとなる。
0004F9 04F9                     CSRNYI: DS  1   ;256－行数 '[CSRNY]の初期値-> M23では行数25固定なので、CSRNYI=CSRNYとなる。
0004FA 04FA                     CSRNX:  DS  1   ;x座標-[_WIDTH] _WIDTHは80
0004FB 04FB                     CSRNY:  DS  1   ;y座標-[_MXLIN] _MXLINは25
0004FC 04FC                     display_cursor_XY_not_use:  DS  2   ;カーソル座標（使用しません）
0004FE 04FE                     number_of_character_after_CR:   DS  1   ;改行してからの文字数（未使用）
0004FF 04FF                     insert_mode_flag:   DS  1   ;＝00Hで通常、＝FFHでインサート･モード
000500 0500                     foreground_color:   DS  1   ;前景色
000501 0501                     background_color:   DS  1   ;背景色
000502 0502                     BDR_color:  DS  1   ;周辺色
000503 0503                     attribute_data: DS  1   ;画面のアトリビュートRAMへ書き込むデータ
000504 0504                     real_time_key:  DS  1   ;リアル･タイム･キー（未使用の場合あり）
000505 0505                     GRAFLG: DS  1   ;＝FFHでグラフィック表示（未使用の場合あり）
                                
000506 0506                     vram_size:  DS  2   ;VRAMのサイズ÷100H
000508 0508                     top_of_special_work_of_vram:    DS  2   ;VRAM上の特殊ワークの先頭÷100H
00050A 050A                     size_of_special_work_of_vram:   DS  1   ;VRAM上の特殊ワークのサイズ÷100H
00050B 050B                     top_of_ram_disk_of_vram:    DS  2   ;VRAM上のRAMディスクの先頭÷100H
00050D 050D                     size_of_ram_disk_of_vram:   DS  2   ;VRAM上のRAMディスクのサイズ÷100H
00050F 050F                     top_of_special_work_of_memory:  DS  1   ;メモリ上の特殊ワークの先頭÷100H
000510 0510                     size_of_special_work_of_memory: DS  1   ;メモリ上の特殊ワークのサイズ÷100H
                                
                                ;   機種独自（6バイト）
000511 0511                     KEYDAT: DS  2   ;ファンクション、アスキー･コードの生データ
000513 0513                     IO1FD0: DS  1   ;I／O 1FD0Hのバッファ
                                
                                
000580 0580                         ORG (($+7FH) & 0FF80H)
                                ;-----------------------
                                ;割り込みルーチン
                                ;-----------------------
                                
                                ;=======================
                                ;キー･スキャン･ルーチン
                                ;=======================
                                
                                ;キー入力割り込み処理
       0580                     KEYINT:
                                ;   LD  (KYIRSP),SP
                                ;   LD  SP,INTSTK   ;割り込み用スタック
                                ;   PUSH    AF
                                ;   PUSH    HL
                                ;   PUSH    DE
                                ;   PUSH    BC
                                
                                ; ; キーが有効かチェックします
                                ;   LD  A,(KEYDAT)  ;ファンクション
                                ;   BIT 6,A
                                ;   JR  NZ,KYIRET   ;キーがはなされた
                                ;   AND 00100000B   ;b5
                                ;   JR  NZ,KYISKP
                                ;   LD  A,(pointer_for_write_key_buffer)
                                ;   OR  A
                                ;   JR  NZ,KYIRET   ;バッファにカラでないときは、リピート禁止
       0580                     KYISKP:
                                ;   キー入力バッファに書き込みます
                                    ; LD    A,(real_time_key)   ;Acc←入力文字
                                    ; CALL  write_one_character_to_key_buffer
                                    ; JR    C,KYIRET    ;バッファがいっぱいだった
                                
       0580                     KYIRET:
                                    ; POP   BC
                                    ; POP   DE
                                    ; POP   HL
                                    ; POP   AF
                                    ; DB    31H ;「LD SP,」
000580 0580                     KYIRSP: DS  2
                                    ; EI
000582 0582 ED4D            15      RETI
                                
                                
                                ;キー入力バッファに1文字書き込みます
                                ;入力   Acc←文字
                                ;出力   キー入力バッファ←文字
                                ;   CY＝1でバッファがいっぱいだった
                                ;破壊   AF，HL，DE，BC
                                ;注：
                                ; 割り込み禁止して実行してください。
                                ; キー入力バッファは、00xxHから始まる127バイトで、
                                ;＋127の部分がpointer_for_write_key_bufferにあたります。
       0584                     write_one_character_to_key_buffer:
                                    ; LD    HL,pointer_for_write_key_buffer
                                    ; LD    E,(HL)
                                    ; LD    D,H ;DE←書き込みポイント
                                    ; LD    (DE),A  ;キー入力バッファ←文字
                                    ; INC   E
                                    ; JP    M,PKYBRK
                                    ; LD    (HL),E  ;[pointer_for_write_key_buffer]のカウント･アップ
                                    ; OR    A   ;CY←0
000584 0584 C9              10      RET
       0585                     PKYBRK:
                                    ; LD    (HL),L  ;[pointer_for_write_key_buffer]を元に戻します
                                    ; SCF
000585 0585 C9              10      RET
                                
                                
000600 0600                         ORG (($+0FFH) & 0FF00H)
                                
                                
                                ;*******    256バイト境界   ********
                                
                                
                                ;===============================
                                ;ライン･ターミナル･テーブル
                                ;===============================
                                
                                
                                ; 先頭行の行連結情報はxx00Hのアドレスに格納されます。
                                ;行連結情報←LINTTB＋y座標（0～）
                                ; FFHで次の行と連結。
                                ;   0020H（32バイト）
000600 0600                     LINTTB: DS  32
                                
                                
                                ;-----------------------
                                ;S-OSルーチン
                                ;-----------------------
                                
                                ;=======================
                                ;システム･ルーチン
                                ;=======================
                                
                                
                                ;#COLD（1FFDH）の本体
                                ; コールド･スタートして、[_USR]のアドレスにジャンプします。
                                ;[_USR]の内容は、「_HOT」に初期化します。
                                ;注：
                                ; プリンタ非出力モードにします。
                                ; 「RET」命令で、「_HOT」にジャンプします。
                                ; キー入力バッファをカラにして、そのアドレスをDEで渡す。
                                ; 固有の初期化ルーチンの cold_start_entity（全レジスタ破壊）を呼び出します。
                                ; 固有のメッセージ「title_message」を参照します。
       0620                     COLD:
                                ;   初期化
000620 0620 ED7B6C1F        20      LD  SP,(_STKAD)
000624 0624 F3               4      DI
                                    ; IM    2
000625 0625 CD5210          17      CALL CRT_INIT           ;CRTCの初期化
000628 0628 FB               4      EI
                                
                                ;   スタックの設定など
000629 0629 21FFFF          10      LD  HL,FFFFH
00062C 062C 226A1F          16      LD  (_MEMAX),HL ;使用可能メモリの上限
00062F 062F 21AC04          10      LD  HL,system_stack_area
000632 0632 226C1F          16      LD  (_STKAD),HL
                                
                                ;   特殊ワークのサイズの初期化
000635 0635 3A0A05          13      LD  A,(size_of_special_work_of_vram)
000638 0638 2E00             7      LD  L,0
00063A 063A 67               4      LD  H,A ;HL←特殊ワークのサイズ
00063B 063B 22681F          16      LD  (_WKSIZ),HL ;[_WKSIZ]の初期化
                                
                                
                                ;   キー入力バッファのクリア
00063E 063E CD880C          17      CALL    clear_key_buffer ; インデックスポインタを0にしているだけ。
                                
                                ;   ディスクのパラメータの初期化
                                    ; LD    HL,000EH ; 
                                    ; LD    (_FATPS),HL
                                    ; LD    HL,0010H ; ディレクトリ情報が記録されているトラック番号
                                    ; LD    (_DIRPS),HL
                                    ; LD    HL,2E00H
                                    ; LD    (_FATBF),HL
                                    ; LD    HL,2F00H ; ディスクI／Oバッファ
                                    ; LD    (_DTBUF),HL
                                    ; LD    A,80 ; 最大トラック数
                                    ; LD    (_MXTRK),A
                                
                                ;   ディスクI／O初期化
                                    ; CALL  SOSSI
                                
                                
                                
                                ;   タイトル表示
000641 0641 11A006          10      LD  DE,title_message
000644 0644 CDE51F          17      CALL _MSX
                                
                                ;   メモリの情報を表示
000647 0647 CDE21F          17      CALL _MPRNT
00064A 064A 4D41494E20333030        DB  'MAIN 3000H-',00H
            30482D00            
000656 0656 2A6A1F          16      LD  HL,(_MEMAX)
000659 0659 2B               6      DEC HL
00065A 065A CDBE1F          17      CALL _print_hex_4_digit
00065D 065D CDE21F          17      CALL _MPRNT
000660 0660 480D00                  DB  'H',0DH,00H
000663 0663 CDE21F          17      CALL _MPRNT
000666 0666 574F524B20303030        DB  'WORK 0000H-',00H
            30482D00            
000672 0672 2A681F          16      LD  HL,(_WKSIZ)
000675 0675 2B               6      DEC HL
000676 0676 CDBE1F          17      CALL _print_hex_4_digit
000679 0679 CDE21F          17      CALL _MPRNT
00067C 067C 480D00                  DB  'H',0DH,00H
                                
                                ;   文字列入力バッファの80バイトをクリア
00067F 067F 2A761F          16      LD  HL,(_KBFAD)
000682 0682 5D               4      LD  E,L
000683 0683 54               4      LD  D,H
000684 0684 13               6      INC DE  ;DE←[_KBFAD]＋1
000685 0685 014F00          10      LD  BC,79
000688 0688 70               7      LD  (HL),B  ;[_KBFAD]←0
000689 0689 EDB0                    LDIR
                                
                                ;   ホット･スタートへ
00068B 068B 2A7E1F          16      LD  HL,(_USR)
00068E 068E EB               4      EX  DE,HL   ;DE←ジャンプ先
00068F 068F 21FA1F          10      LD  HL,_HOT
000692 0692 E5              11      PUSH HL ;戻りアドレス（_HOT）
000693 0693 227E1F          16      LD  (_USR),HL   ;[_USR]の再設定
000696 0696 EB               4      EX  DE,HL   ;HL←ジャンプ先
000697 0697 ED5B761F        20      LD  DE,(_KBFAD) ;DE←[_KBFAD]
00069B 069B AF               4      XOR A
00069C 069C E9               4      JP  (HL)    ;旧[_USR]の内容にジャンプ
                                
                                ;#BOOT（2036H）の本体
                                ; S-OSを終えます。
                                ;注：フィジカル･ルーチンboot_entity（全レジスタ破壊）を呼び出します。
                                
00069D 069D                         DS  3
                                
                                ;コールド･スタート時のメッセージ
       06A0                     title_message:
0006A0 06A0 3C3C3C3C3C20532D        DB  '<<<<< S-OS  SWORD >>>>>',CR
            4F53202053574F52    
            44203E3E3E3E3E0D    
0006B8 06B8 00                      DB  00H
                                
                                
       06B9                     BOOT:
0006B9 06B9 C3A10B          10      JP  boot_entity
                                
                                
                                ;===============================
                                ;バージョン･ナンバーの取り出し
                                ;===============================
                                
                                ;#VER（1FF7H）の本体
                                ; Hに機種別情報、LにS-OSのバージョンを返します。
                                ;入力   なし
                                ;出力   H←機種別情報、L←S-OSのバージョン
                                ;破壊   HL
                                ;〈機種別情報〉
                                ;00H    MZ-80K／C／1200
                                ;01H    MZ-700
                                ;02H    MZ-1500
                                ;10H    MZ-80B
                                ;11H    MZ-2000／2200
                                ;12H    MZ-2500
                                ;20H    X1
                                ;21H    X1turbo
                                ;22H    X1（筑紫版）
                                ;30H    PC-8801（ROM）
                                ;31H    PC-8001
                                ;32H    PC-8801（オールRAM）
                                ;40H    FM-7／77
                                ;50H    SMC-777
                                ;60H    PASOPIA
                                ;61H    PASOPIA7
                                ;70H    PC-286
                                ;80H    X68000
                                ;90H    MSX／2／2＋／turboR（ANK専用版）
                                ;91H    MSX／2／2＋／turboR（漢字対応版）
                                ;95H    SORD M23
                                ;〈S-OSのバージョン〉
                                ; SWORDでは、「20H」。
       06BC                     VER:
0006BC 06BC F5              11      PUSH    AF
0006BD 06BD D5              11      PUSH    DE
0006BE 06BE C5              11      PUSH    BC
0006BF 06BF 212095          10      LD  HL,9520H    ;SORD M23，S-OS V2.0
0006C2 06C2 C1              10      POP BC
0006C3 06C3 D1              10      POP DE
0006C4 06C4 F1              10      POP AF
0006C5 06C5 C9              10      RET
                                
                                
                                ;===============
                                ;表示ルーチン
                                ;===============
                                
                                
                                
                                ;#PRNTS（1FF1H）の本体
                                ; スペースを1つ表示します。
                                ;入力   なし
                                ;出力   なし
                                ;破壊   F（実際なし）
       06C6                     PRNTS:
0006C6 06C6 F5              11      PUSH    AF
0006C7 06C7 3E20             7      LD  A,' '
0006C9 06C9 CDF41F          17      CALL _PRINT
0006CC 06CC F1              10      POP AF
0006CD 06CD C9              10      RET
                                
                                
                                ;#LTNL（1FFEH）の本体
                                ; 改行します。
                                ;入力   なし
                                ;出力   なし
                                ;破壊   なし
       06CE                     LTNL:
0006CE 06CE F5              11      PUSH    AF
0006CF 06CF 3E0D             7      LD  A,0DH
0006D1 06D1 CDF41F          17      CALL _PRINT
0006D4 06D4 F1              10      POP AF
0006D5 06D5 C9              10      RET
                                
                                
                                ;#NL（1FEBH）の本体
                                ; 行頭でなければ、改行します。
                                ;入力   なし
                                ;出力   なし
                                ;破壊   なし
                                ;注：
                                ; 行頭でなければ改行します。
                                ; このサブルーチンを書いて下さい。
       06D6                     NL:
0006D6 06D6 D5              11      PUSH DE
0006D7 06D7 C5              11      PUSH BC
                                
0006D8 06D8 CDF710          17      CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
                                    ; cursor_XY_ADDRからX座標を取得
0006DB 06DB 2A02FF          16      LD  HL,(cursor_XY_ADDR+2)       ; HLにX座標をロード (2バイト)
                                    ; cursor_XY_ADDR+2からY座標を取得
0006DE 06DE ED5B00FF        20      LD  DE,(cursor_XY_ADDR)     ; DEにY座標をロード (2バイト)
0006E2 06E2 B7               4      OR  A ; フラグをクリア
0006E3 06E3 BD               4      CP  L ; X座標が0かチェック
0006E4 06E4 2803            12      JR  Z,NLRET ; X座標が0ならリターン
0006E6 06E6 CDCE06          17      CALL LTNL ; 改行を実行
       06E9                     NLRET:
0006E9 06E9 C1              10      POP BC
0006EA 06EA D1              10      POP DE
0006EB 06EB C9              10      RET
                                
                                
                                ;
                                ;#MSG（1FE8H）の本体
                                ; DEレジスタの示すアドレスから0DHが出現するまでアスキーコードとみなし文字列表示する。
                                ;入力   DE←文字列先頭アドレス
                                ;出力   なし
                                ;破壊   F（実際なし）
                                ;注：0DHは表示しません。
                                ; このサブルーチンを完成させてください。
       06EC                     MSG:
0006EC 06EC F5              11      PUSH    AF
0006ED 06ED E5              11      PUSH    HL
0006EE 06EE D5              11      PUSH    DE
0006EF 06EF C5              11      PUSH    BC
       06F0                     MSGLP:
0006F0 06F0 1A               7      LD  A,(DE)  ; 文字を取得
0006F1 06F1 FE0D             7      CP  CR      ; 改行コードか？
0006F3 06F3 2806            12      JR  Z,MSGSKP; 改行コードなら終了へ
0006F5 06F5 CDF41F          17      CALL _PRINT ; 文字を表示
0006F8 06F8 13               6      INC DE      ; アドレスを一つ進める
0006F9 06F9 18F5            12      JR  MSGLP
       06FB                     MSGSKP: 
0006FB 06FB C1              10      POP BC
0006FC 06FC D1              10      POP DE
0006FD 06FD E1              10      POP HL
0006FE 06FE F1              10      POP AF
0006FF 06FF C9              10      RET
                                
                                ;#MSX（1FE5H）の本体
                                ; DEレジスタの示すアドレスから00Hが出現するまでアスキーコードとみなし文字列表示する。
                                ;入力   DE←文字列先頭アドレス
                                ;出力   なし
                                ;破壊   F（実際なし）
                                ;注：00Hは表示しません。
       0700                     MSX:
000700 0700 F5              11      PUSH    AF
000701 0701 E5              11      PUSH    HL
000702 0702 D5              11      PUSH    DE
000703 0703 C5              11      PUSH    BC
       0704                     MSXLP:
000704 0704 1A               7      LD  A,(DE) ; 文字を取得
000705 0705 FE00             7      CP  00H ; 終了コードか？
000707 0707 2806            12      JR  Z,MSXSKP    ; 終了コードなら終了へ
                                
000709 0709 CD3C0C          17      CALL PRINT ; 文字を表示
00070C 070C 13               6      INC DE  ; アドレスを一つ進める
00070D 070D 18F5            12      JR  MSXLP
       070F                     MSXSKP: 
00070F 070F C1              10      POP BC
000710 0710 D1              10      POP DE
000711 0711 E1              10      POP HL
000712 0712 F1              10      POP AF
000713 0713 C9              10      RET
                                
                                ;#MPRNT（1FE2H）本体
                                ; このサブルーチンをコールした次のアドレスから00Hが出現するまでアスキーコードとみなし、文字列表示する。
                                ;入力   「CALL ＃MPRNT」の次のアドレス～←文字列とみなす
                                ;出力   なし
                                ;破壊   AF，DE（実際AF）
                                ;注：
                                ; 00Hは表示しません。
                                ; 「REDA」などがDE保存を期待しているので、DEを保存します。
                                ; このサブルーチンを完成させてください。
       0714                     MPRNT:
000714 0714 E3              19      EX  (SP),HL ;HL←インライン･パラのアドレス，スタック←HL
000715 0715 D5              11      PUSH DE
000716 0716 C5              11      PUSH BC
000717 0717 EB               4      EX  DE,HL ; DE←インライン･パラのアドレス
       0718                     MRPLP:
000718 0718 FE00             7      CP 00H
00071A 071A 2806            12      JR  Z,MPRRET ; もし最初の文字が00Hなら何も表示せずにリターン
00071C 071C CD0007          17      CALL MSX ; DEの指す文字列を表示
00071F 071F 13               6      INC DE ; 次のアドレスへ
000720 0720 18F6            12      JR  MRPLP
       0722                     MPRRET:
000722 0722 EB               4      EX  DE,HL ; HL←インライン･パラのアドレス，DE←元の値
000723 0723 C1              10      POP BC
000724 0724 D1              10      POP DE
000725 0725 E3              19      EX  (SP),HL ;スタック←インライン･パラの次のアドレス，HL←元の値
                                ;   XOR A
000726 0726 C9              10      RET
                                
                                ; TAB(1FDFH)の本体
                                ; Bレジスタの値と、カーソルのX座標との差を計算して、その結果の数だけスペースを表示する。
       0727                     TAB:
000727 0727 F5              11      PUSH    AF
000728 0728 E5              11      PUSH    HL
000729 0729 D5              11      PUSH    DE
00072A 072A C5              11      PUSH    BC
00072B 072B CDF710          17      CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
                                    ; cursor_XY_ADDRからX座標を取得
00072E 072E 2A02FF          16      LD  HL,(cursor_XY_ADDR+2)       ; HLにX座標をロード (2バイト)
                                    ; Bレジスタの値とX座標との差を計算
000731 0731 78               4      LD  A,B
000732 0732 95               4      SUB L   ; A = B - X座標
000733 0733 380C            12      JR  C,TABERR    ; 結果が負ならエラー
000735 0735 6F               4      LD  L,A ; Lにスペース数をセット
       0736                         TABLP2:
000736 0736 3E20             7      LD  A,' '
000738 0738 CDF41F          17      CALL    _PRINT
00073B 073B 2D               4      DEC L
00073C 073C 20F8            12      JR  NZ,TABLP2 ; スペース数分ループ
00073E 073E AF               4      XOR A   ; CY=0
00073F 073F 1801            12      JR  TABRET
       0741                     TABERR:
000741 0741 37               4      SCF ; CY=1
       0742                     TABRET:
000742 0742 C1              10      POP BC
000743 0743 D1              10      POP DE
000744 0744 E1              10      POP HL
000745 0745 F1              10      POP AF
000746 0746 C9              10      RET
                                
                                ; #LPRINT(1FDCH)の本体
                                ; 未実装
       0747                     LPRINT:
000747 0747 C9              10      RET
                                
                                ;===============
                                ;16進数
                                ;===============
                                
                                ;#PRTHX print_hex_2_digit（1FC1H）の本体
                                ; Aレジスタの値を16進2桁で画面に表示する
                                ;入力   Acc←データ
                                ;出力   なし
                                ;破壊   AF
                                ; このサブルーチンを完成させてください。
       0748                     print_hex_2_digit:
000748 0748 F5              11      PUSH AF ;保存
000749 0749 47               4      LD  B,A ;Bにデータを保存
00074A 074A CB3F             8      SRL A   ;上位4ビットを取得
00074C 074C CB3F             8      SRL A   ; さらに1ビット右シフト
00074E 074E CB3F             8      SRL A   ; さらに1ビット右シフト
000750 0750 CB3F             8      SRL A   ; さらに1ビット右シフト
000752 0752 CD6B07          17      CALL    ASC ; 上位4ビットを16進数アスキーコードに変換
000755 0755 CDF41F          17      CALL    _PRINT  ; 文字表示
000758 0758 78               4      LD  A,B ;Bから元のデータを取得
000759 0759 E60F             7      AND 0FH ; 下位4ビットを取得
00075B 075B CD6B07          17      CALL    ASC ; 下位4ビットを16進数アスキーコードに変換
00075E 075E CDF41F          17      CALL    _PRINT  ; 文字表示
000761 0761 F1              10      POP AF  ;復元
000762 0762 C9              10      RET
                                
                                
                                ;#print_hex_4_digit（1FBEH）の本体
                                ; HLレジスタの値を16進4桁で表示する。
                                ;入力   HL←データ
                                ;出力   なし
                                ;破壊   AF
                                ; このサブルーチンを完成させてください。
       0763                     print_hex_4_digit:
000763 0763 7C               4      LD  A,H ; HLの上位バイトをAにロード
000764 0764 CDC11F          17      CALL    _print_hex_2_digit ; 2桁表示
000767 0767 7D               4      LD  A,L ; HLの下位バイトをAにロード
000768 0768 C3C11F          10      JP  _print_hex_2_digit ; 2桁表示
                                
                                
                                ;#ASC（1FBBH）の本体
                                ; Aレジスタの下位4ビットの値を16進数で表したときのアスキーコードに変換してAレジスタに格納する。
                                ;入力   Acc下位4ビット←データ
                                ;出力   Acc←16進数表示のアスキーコード
                                ;破壊   AF
                                ; このサブルーチンを書いてください。
       076B                     ASC:
00076B 076B E60F             7      AND 0FH ; 下位4ビットを取得
00076D 076D FE0A             7      CP  10
00076F 076F 3804            12      JR  C,ASCNUM
000771 0771 C637             7      ADD A,'A'-10    ; 10以上なら'A'～'F'に変換
000773 0773 1802            12      JR  ASCRET ; リターン
       0775                     ASCNUM:
000775 0775 C630             7      ADD A,'0'   ; 0～9なら'0'～'9'に変換
       0777                     ASCRET:
000777 0777 C9              10      RET
                                
                                ;#HEX（1FB8H）の本体
                                ; Aレジスタの内容を16進数で表したときのアスキーコードとしてバイナリに変換し、Aレジスタに格納する。
                                ;入力   Acc←16進数文字(アスキーコードで表現)
                                ;出力   Acc←データ（0～15）
                                ;   CY＝1（Acc＝14）ならエラー
                                ;破壊   AF
                                ;注：
                                ; 小文字に対応。
                                ; 汎用ルーチンconvert_lower_case_to_upper_case（AF破壊）を呼び出します。
       0778                     HEX:
000778 0778 CD220D          17      CALL    convert_lower_case_to_upper_case
00077B 077B D630             7      SUB '0' ; '0'のコードを引く
00077D 077D 3810            12      JR  C,HEXERR ; '0'未満はエラー
00077F 077F FE0A             7      CP  10 ; 10未満か？
000781 0781 380A            12      JR  C,HEXESC ; 10未満なら正常終了
000783 0783 FE11             7      CP  10+7    ;7＝「A」－（「9」＋1）
000785 0785 3808            12      JR  C,HEXERR
000787 0787 D607             7      SUB 7 ; 10以上なら'A'～'F'を0～5に変換
000789 0789 FE10             7      CP  16 ; 16以上はエラー
00078B 078B 3002            12      JR  NC,HEXERR
00078D 078D B7               4  HEXESC: OR  A ; CY←0
00078E 078E C9              10      RET
                                
00078F 078F 3E0E             7  HEXERR: LD  A,14    ;Bad Data
000791 0791 37               4      SCF ; CY←1
000792 0792 C9              10      RET
                                
                                ;#2HEX（1FB5H）の本体
                                ; DEレジスタの示すアドレスから2バイトの内容を、2桁の16進数で表現するアスキーコードとして、バイナリに変換し、HLに格納する。エラーがあればキャリフラグがセットされる。
                                ;入力   [DE～]←16進文字2桁
                                ;出力   Acc←データ
                                ;   DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
                                ;   CY＝1ならエラー
                                ;破壊   AF，DE
                                ;注：小文字に対応。
                                ; このサブルーチンを完成させてください。
       0793                     AHEX:
000793 0793 1A               7      LD  A,(DE) ; 16進1桁目取得
000794 0794 CD7807          17      CALL    HEX ; 1桁目変換
000797 0797 38F6            12      JR  C,HEXERR ; エラーならリターン
000799 0799 13               6      INC DE ; DEカウントアップ
00079A 079A 67               4      LD  H,A ; Hに格納
00079B 079B 1A               7      LD  A,(DE) ; 16進2桁目取得
00079C 079C CD7807          17      CALL    HEX ; 2桁目変換
00079F 079F 38EE            12      JR  C,HEXERR ; エラーならリターン
0007A1 07A1 13               6      INC DE ; DEカウントアップ
0007A2 07A2 6F               4      LD  L,A ; Lに格納
0007A3 07A3 C9              10      RET
                                
                                
                                ;#HLHEX（1FB2H）の本体
                                ; DEレジスタの示すアドレスから4バイトの内容を、4桁の16進数で表現するアスキーコードとして、バイナリに変換し、HLに格納する。エラーがあればキャリフラグがセットされる。
                                ;入力   [DE～]←16進文字4桁
                                ;出力   HL←データ
                                ;   DEはカウント･アップ（エラーを発生した時点でカウント･アップは停止）
                                ;   CY＝1ならエラー
                                ;破壊   AF，HL，DE
                                ;注：小文字に対応。
                                ; このサブルーチンを完成させてください。
       07A4                     HLHEX:
0007A4 07A4 CDB51F          17      CALL    _2HEX ; 先頭2桁を変換
0007A7 07A7 38E6            12      JR  C,HEXERR ; エラーならリターン
0007A9 07A9 65               4      LD  H,L ; HLの上位に格納
0007AA 07AA CDB51F          17      CALL    _2HEX ; 次の2桁を変換
0007AD 07AD 38E0            12      JR  C,HEXERR ; エラーならリターン
0007AF 07AF 6F               4      LD  L,A ; HLの下位に格納
0007B0 07B0 C9              10      RET
                                
                                
                                
                                ;===============
                                ;スクリーン制御
                                ;===============
                                
                                
                                ;#CSR（2018H）の本体
                                ; カーソル座標を読み出します。
                                ;入力   なし
                                ;出力   L←x座標、H←y座標
                                ;破壊   HL
                                ;注：CALC_CURSOR_XYを呼び出します。
       07B1                     CSR:
0007B1 07B1 F5              11      PUSH    AF
0007B2 07B2 D5              11      PUSH    DE
0007B3 07B3 C5              11      PUSH    BC
0007B4 07B4 CDF710          17      CALL CALC_CURSOR_XY ; CURSOR_LOCATEからX,Y座標を計算して、cursor_XY_ADDRに保存する。
0007B7 07B7 2A00FF          16      LD  HL,(cursor_XY_ADDR)     ; LにX座標をロード (2バイト)
0007BA 07BA C1              10      POP BC
0007BB 07BB D1              10      POP DE
0007BC 07BC F1              10      POP AF
0007BD 07BD C9              10      RET
                                
                                
                                ;#LOC（201EH）の本体
                                ; HLレジスタの値(L=X座標、H=Y座標)で指定するXY座標へカーソルの位置をセットする。
                                ;入力   L←x座標、H←y座標
                                ;出力   なし
                                ;破壊   AF（実際F）
                                ;注：
                                ; 「WALRUS」がAccの保存を期待しているので、Accは保存します。
                                ; 「ELFES IV」「TANGERINE」などでCYクリアが必要。
                                ; このサブルーチンを完成させてください。
       07BE                     LOC:
0007BE 07BE F5              11      PUSH    AF
0007BF 07BF E5              11      PUSH    HL
0007C0 07C0 D5              11      PUSH    DE
0007C1 07C1 C5              11      PUSH    BC
                                    ; 現在HLが移動したいカーソルの位置を指さしている。
                                    ; PRINT_CURSORはDEに現在のカーソルの位置が入っていることを期待している。
0007C2 07C2 EB               4      EX DE,HL    ; DE←移動先カーソル位置
0007C3 07C3 CDE110          17      CALL    PRINT_CURSOR ; カーソル位置を設定
0007C6 07C6 C1              10      POP BC
0007C7 07C7 D1              10      POP DE
0007C8 07C8 E1              10      POP HL
0007C9 07C9 F1              10      POP AF
0007CA 07CA B7               4      OR A    ;CY←0
0007CB 07CB C9              10      RET
                                
                                
                                ;#SCRN（201BH）の本体
                                ; HレジスタにY座標、LレジスタにX座標を格納してコールすると、画面上におけるその座標の文字を読み込み、Aレジスタに格納する。
                                ;入力   L←x座標、H←y座標
                                ;出力   Acc←文字
                                ;破壊   AF
                                ;注：
                                ; CYをクリアします。
                                ; このサブルーチンを完成させてください。
       07CC                     SCRN:
0007CC 07CC E5              11      PUSH    HL
0007CD 07CD D5              11      PUSH    DE
0007CE 07CE C5              11      PUSH    BC
                                ; VRAMにアクセスして、カーソル位置DEにある通常文字のアスキーコードを得る。
0007CF 07CF D3D2            11      OUT (0D2H),A ; access to RAM page 1
0007D1 07D1 1A               7      LD A,(DE) ; get character
0007D2 07D2 C1              10      POP BC
0007D3 07D3 D1              10      POP DE
0007D4 07D4 E1              10      POP HL
0007D5 07D5 B7               4      OR  A   ;CY←0
0007D6 07D6 C9              10      RET
                                
                                
                                ;#WIDCH（2030H）の本体
                                ; 表示桁数を変更します。SORD M23ではサポートしません。
                                ;入力   Acc←桁数
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
                                ; CY＝0でリターンします（ディスク･モジュールのため）。
       07D7                     WIDCH:
0007D7 07D7 B7               4      OR A    ;CY←0
0007D8 07D8 C9              10      RET
                                
                                ;LINCH（203CH）の本体
                                ; 表示行数を変更します。 SORD M23ではサポートしません。
                                ;入力   Acc←行数
                                ;   [_WIDTH]参照
                                ;出力   なし
                                ;破壊   AF，HL，DE，BC
       07D9                     LINCH0:
0007D9 07D9 C9              10      RET
                                
                                ;=======================
                                ;ビープ音を鳴らします
                                ;=======================
                                
                                
                                ;#BELL（1FC4H）の本体
                                ; ビープ音を鳴らします。
                                ;入力   なし
                                ;出力   なし
                                ;破壊   AF
       07DA                     BELL:
0007DA 07DA C9              10      RET
                                
                                
                                ;=======================
                                ;プリンタ･ルーチン
                                ;=======================
                                
                                
                                ;#LPRNT（1FDCH）本体
                                ; プリンタ1文字出力。SORD M23ではサポートしません。
                                ;入力   Acc←文字
                                ;出力   CY＝1ならエラー（Acc＝1）
                                ;破壊   AF
                                ;注：
                                ; 0DHは、0DH＋0AHに変換します。
                                ; 00H、0AH、1AHは、無視します。
       07DB                     LPRNT:
0007DB 07DB C9              10      RET
                                
                                ;#LPTON（1FD9H）の本体
                                ; 表示をプリンタ出力モードにします。SORD M23ではサポートしません。
                                ;入力   なし
                                ;出力   [_LPSW]←1
                                ;破壊   なし
                                ;注：
       07DC                     LPTON:
0007DC 07DC C9              10      RET
                                
                                ;#LPTOF（1FD6H）の本体
                                ; 表示を非プリンタ出力モードにします。SORD M23ではサポートしません。
                                ;入力   なし
                                ;出力   [_LPSW]←0
                                ;破壊   なし
       07DD                     LPTOF:
0007DD 07DD C9              10      RET
                                
                                
                                ;===============
                                ;入力ルーチン
                                ;===============
                                
                                ;#GETKY（1FD0H）の本体
                                ; キー入力（入力待ちなし、エコー･バックなし）。
                                ;入力   なし
                                ;出力   Acc←文字
                                ;破壊   AF
                                ;注：
                                ; 常にオート･リピートがかかっています。
                                ; フィジカル･ルーチンreal_time_input_key_entity（AF，HL，DE，BC破壊）を呼び出します。
       07DE                     GETKY:
0007DE 07DE C9              10      RET
                                
                                ;#BRKEY（1FCDH）の本体
                                ; ^Cチェックします（入力待ちなし、エコー･バックなし）。
                                ;入力   なし
                                ;出力   ZF＝1なら^Cが押されています
                                ;破壊   AF
                                ;注：
                                ; 常にオート･リピートがかかっています。
                                ; フィジカル･ルーチンreal_time_input_key_entity（AF，HL，DE，BC破壊）を呼び出します。
                                ; ^C（03H）とESC（1BH）をブレイク･キーとみなします。
       07DF                     BRKEY:
0007DF 07DF E5              11      PUSH    HL
0007E0 07E0 D5              11      PUSH    DE
0007E1 07E1 C5              11      PUSH    BC
0007E2 07E2 CD7D0C          17      CALL    real_time_input_key_entity
0007E5 07E5 FE03             7      CP  03H ;^C
0007E7 07E7 2806            12      JR  Z,BRKRET
0007E9 07E9 FE1B             7      CP  1BH ;ESC
0007EB 07EB 2802            12      JR  Z,BRKRET
0007ED 07ED F6FF             7      OR  0FFH    ;ZF←0，CY←0
       07EF                     BRKRET:
0007EF 07EF C1              10      POP BC
0007F0 07F0 D1              10      POP DE
0007F1 07F1 E1              10      POP HL
0007F2 07F2 C9              10      RET
                                
                                
                                ;#PAUSE（1FC7H）の本体
                                ; ポーズ処理。
                                ; どのタイミングでも、
                                ;^Cが入力されればインライン･パラのアドレスにジャンプします。
                                ;何もキーが押されていなければ、そのままリターンします。
                                ; スペースが押されれば一時停止し、他のキーが押されればリターンします。
                                ;入力   「CALL ＃PAUSE」の次のアドレス←^C入力時の飛び先
                                ;出力   なし
                                ;破壊   AF
       07F3                     PAUSE:
0007F3 07F3 E3              19      EX  (SP),HL ;スタック←HL，HL←インライン･パラのアドレス
0007F4 07F4 D5              11      PUSH    DE
0007F5 07F5 C5              11      PUSH    BC
0007F6 07F6 5E               7      LD  E,(HL)
0007F7 07F7 23               6      INC HL
0007F8 07F8 56               7      LD  D,(HL)
0007F9 07F9 23               6      INC HL
0007FA 07FA 222108          16      LD  (PAURET),HL ;リターン･アドレス
0007FD 07FD ED532808        20      LD  (PAUREB),DE ;インライン･パラ
000801 0801 CDCD1F          17      CALL    _BRKEY
000804 0804 281D            12      JR  Z,PAUBRK
000806 0806 CDD01F          17      CALL    _GETKY
000809 0809 FE20             7      CP  ' '
00080B 080B 200F            12      JR  NZ,PAUESC
                                
00080D 080D CDCD1F          17  PAULP:  CALL    _BRKEY
000810 0810 2811            12      JR  Z,PAUBRK
000812 0812 CDD01F          17      CALL    _GETKY
000815 0815 B7               4      OR  A
000816 0816 28F5            12      JR  Z,PAULP
000818 0818 FE20             7      CP  ' '
00081A 081A 28F1            12      JR  Z,PAULP
                                
00081C 081C C1              10  PAUESC: POP BC
00081D 081D D1              10      POP DE
00081E 081E E1              10      POP HL
00081F 081F AF               4      XOR A
000820 0820 C3                      DB  0C3H    ;「JP」
000821 0821                     PAURET: DS  2
                                
000823 0823 C1              10  PAUBRK: POP BC
000824 0824 D1              10      POP DE
000825 0825 E1              10      POP HL
000826 0826 AF               4      XOR A
000827 0827 C3                      DB  0C3H    ;「JP」
